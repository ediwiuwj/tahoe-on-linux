diff --git a/tools/datos_macos.py b/tools/datos_macos.py
new file mode 100755
index 0000000..8982cbd
--- /dev/null
+++ b/tools/datos_macos.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+# datos_macos.py <raíz>: prepara el volumen de datos de un macOS completo extraído (tools/yaa.py), como hace el instalador
+# en un Mac recién instalado:
+#   1. /System/Volumes/Data se crea copiando la plantilla /System/Library/Templates/Data (con permisos, fechas, enlaces y
+#      atributos extendidos), si aún no existe.
+#   2. Los firmlinks de /usr/share/firmlinks (/Applications, /Library, /Users, /private...) unen el volumen del sistema con
+#      el de datos. Linux no los tiene: cada uno se presenta como un enlace simbólico relativo hacia
+#      System/Volumes/Data/<destino>. Si en el lado del sistema había contenido, se mueve antes al lado de datos.
+# Es idempotente: se puede repetir sin estropear nada.
+# Algunas carpetas de la plantilla son solo de root en macOS (p. ej. private/var/db/dslocal/nodes/Default, sin permiso de
+# paso para nadie más): sin ser root, el script se vuelve a ejecutar en un espacio de usuario donde el usuario es root
+# (unshare -r), igual que tahoe-run, y así puede leerlas; los archivos siguen siendo del usuario.
+import os, shutil, sys
+
+def copia(src, dst):
+    if os.path.lexists(dst): return
+    tmp = dst + ".copiando"                                # a medias no cuenta: se copia aparte y se renombra al final
+    if os.path.lexists(tmp): shutil.rmtree(tmp)
+    shutil.copytree(src, tmp, symlinks=True, copy_function=shutil.copy2)
+    shutil.copystat(src, tmp)
+    os.rename(tmp, dst)
+
+def mezcla(src, dst):
+    """Mueve el contenido de src (lado del sistema) a dst (lado de datos) sin pisar lo que ya haya en dst."""
+    os.makedirs(dst, exist_ok=True)
+    for n in os.listdir(src):
+        a, b = os.path.join(src, n), os.path.join(dst, n)
+        if os.path.isdir(a) and not os.path.islink(a) and os.path.isdir(b) and not os.path.islink(b): mezcla(a, b)
+        elif not os.path.lexists(b): os.rename(a, b)
+    shutil.rmtree(src)
+
+def main():
+    if os.getuid() != 0:
+        os.execvp("unshare", ["unshare", "-r", sys.executable, os.path.abspath(__file__)] + sys.argv[1:])
+    root = os.path.abspath(sys.argv[1])
+    data = os.path.join(root, "System/Volumes/Data")
+    tmpl = os.path.join(root, "System/Library/Templates/Data")
+    if not os.path.isdir(data) or not os.listdir(data):
+        if os.path.isdir(data): os.rmdir(data)
+        copia(tmpl, data); print("volumen de datos creado desde la plantilla")
+    n = 0
+    for line in open(os.path.join(root, "usr/share/firmlinks")):
+        if not line.strip(): continue
+        sysp, datap = line.rstrip("\n").split("\t")
+        s = os.path.join(root, sysp.lstrip("/")); d = os.path.join(data, datap)
+        if os.path.islink(s): continue                                    # ya hecho
+        if os.path.isdir(s): mezcla(s, d)
+        else: os.makedirs(d, exist_ok=True)
+        os.makedirs(os.path.dirname(s), exist_ok=True)
+        os.symlink(os.path.relpath(d, os.path.dirname(s)), s)
+        n += 1
+    print(f"firmlinks: {n}")
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/dsc_dis.py b/tools/dsc_dis.py
new file mode 100644
index 0000000..6f7bd88
--- /dev/null
+++ b/tools/dsc_dis.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Desensambla código x86_64 de una dyld_shared_cache de macOS (ipsw solo desensambla arm64).
+
+Lee los bytes de la dirección pedida en el archivo de la caché que la mapea (principal o subcachés .01, .02...),
+los pasa por `objdump -b binary -m i386:x86-64` y anota los destinos de call/jmp/lea con los nombres de las listas
+de símbolos de ~/.cache/tahoe-syms (las que genera tahoe-run al arrancar).
+
+Uso: dsc_dis.py <caché> <símbolo o 0xdirección> [bytes]   (por defecto 0x400 bytes)
+"""
+import glob
+import os
+import re
+import struct
+import subprocess
+import sys
+import tempfile
+
+
+def mapeos(ruta):
+    with open(ruta, 'rb') as f:
+        h = f.read(0x40)
+        off, cnt = struct.unpack_from('<II', h, 0x10)
+        f.seek(off)
+        crudo = f.read(32 * cnt)
+    return [struct.unpack_from('<QQQII', crudo, 32 * i)[:3] for i in range(cnt)]   # dirección, tamaño, posición
+
+
+def leer(cache, dir_, n):
+    for arch in sorted(glob.glob(cache + '*')):
+        if arch.endswith('.map') or arch.endswith('.atlas'):
+            continue
+        try:
+            ms = mapeos(arch)
+        except (OSError, struct.error):
+            continue
+        for addr, tam, pos in ms:
+            if addr <= dir_ < addr + tam:
+                with open(arch, 'rb') as f:
+                    f.seek(pos + dir_ - addr)
+                    return f.read(min(n, addr + tam - dir_))
+    sys.exit(f'0x{dir_:x} no está en la caché')
+
+
+def simbolos():
+    tabla = {}
+    for txt in glob.glob(os.path.expanduser('~/.cache/tahoe-syms/*/*.txt')):
+        img = os.path.basename(txt)[:-4]
+        with open(txt, errors='replace') as f:
+            for ln in f:
+                m = re.match(r'(0x[0-9a-f]+): \([^)]*\)\s+(\S.*)$', ln.strip())
+                if m:
+                    tabla.setdefault(int(m.group(1), 16), f'{m.group(2)} [{img}]')
+    return tabla
+
+
+def main():
+    cache, quien = sys.argv[1], sys.argv[2]
+    n = int(sys.argv[3], 0) if len(sys.argv) > 3 else 0x400
+    sims = simbolos()
+    if quien.startswith('0x'):
+        dir_ = int(quien, 16)
+    else:
+        cands = [a for a, s in sims.items() if s.split(' [')[0] == quien]
+        if not cands:
+            sys.exit(f'no encuentro {quien}')
+        dir_ = cands[0]
+    datos = leer(cache, dir_, n)
+    with tempfile.NamedTemporaryFile(suffix='.bin') as t:
+        t.write(datos)
+        t.flush()
+        sal = subprocess.run(['objdump', '-D', '-b', 'binary', '-m', 'i386:x86-64', f'--adjust-vma=0x{dir_:x}', t.name],
+                             capture_output=True, text=True).stdout
+    def cadena(a):
+        try:
+            b = leer(cache, a, 200)
+        except SystemExit:
+            return None
+        z = b.split(b'\0')[0]
+        if 3 <= len(z) and all(32 <= c < 127 for c in z):
+            return z.decode()
+        return None
+
+    def puntero(a):
+        try:
+            b = leer(cache, a, 8)
+        except SystemExit:
+            return None
+        if len(b) < 8:
+            return None
+        return struct.unpack('<Q', b)[0] & 0xfffffffffff   # sin los bits altos de las cadenas de punteros
+
+    for ln in sal.splitlines():
+        m = re.search(r'0x([0-9a-f]{9,})', ln)
+        if m:
+            a = int(m.group(1), 16)
+            if a in sims:
+                ln += f'    ; {sims[a]}'
+            else:
+                c = cadena(a)
+                q = puntero(a)
+                if c:
+                    ln += f'    ; "{c}"'
+                elif q and q in sims:
+                    ln += f'    ; -> {sims[q]}'
+                elif q and cadena(q):
+                    ln += f'    ; -> "{cadena(q)}"'
+                elif q:
+                    # CFString constante: {isa, flags, char*, longitud}
+                    r = puntero(a + 16)
+                    if r and cadena(r):
+                        ln += f'    ; @"{cadena(r)}"'
+        m2 = re.match(r'\s*([0-9a-f]+):', ln)
+        if m2 and int(m2.group(1), 16) in sims and int(m2.group(1), 16) != dir_:
+            print(f'--- {sims[int(m2.group(1), 16)]}')
+        print(ln)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/fix_symlinks.sh b/tools/fix_symlinks.sh
new file mode 100755
index 0000000..5983146
--- /dev/null
+++ b/tools/fix_symlinks.sh
@@ -0,0 +1,38 @@
+#!/bin/bash
+# fix_symlinks.sh [raíz] [--aplicar]: repara los enlaces simbólicos absolutos del sistema de macOS extraído.
+# En macOS muchos enlaces son absolutos (/etc/rc.cdrom -> /usr/libexec/rc_script_wrapper). En Linux es el kernel quien los
+# sigue, así que deben apuntar a la ruta dentro de la raíz (raíz + destino); tahoe-run le quita ese prefijo a readlink y el
+# programa ve el destino original. Al extraer, algunos quedaron apuntando a una ruta del anfitrión que no existe (p. ej. sin
+# la carpeta «macOS Base System»): sin ellos no arranca, entre otros, /etc/rc.cdrom (las tareas de arranque de la Recovery).
+# Solo toca enlaces absolutos ROTOS cuyo destino se encuentre dentro de la raíz; sin --aplicar solo los lista.
+#   tools/fix_symlinks.sh                       # raíz por omisión: ~/macos26/base/macOS Base System
+#   tools/fix_symlinks.sh "$TAHOE_ROOT" --aplicar
+ROOT="${1:-$HOME/macos26/base/macOS Base System}"
+[ "$1" = "--aplicar" ] && ROOT="$HOME/macos26/base/macOS Base System"
+APLICAR=0; for a in "$@"; do [ "$a" = "--aplicar" ] && APLICAR=1; done
+ROOT="$(cd "$ROOT" && pwd)" || exit 1
+n=0; sin=0
+while IFS= read -r -d '' l; do
+	t="$(readlink "$l")"
+	case "$t" in /*) ;; *) continue;; esac
+	[ -e "$l" ] && continue                                   # el enlace funciona: no se toca
+	case "$t" in "$ROOT"/*) rest="${t#"$ROOT"}";; *) rest="$t";; esac
+	# el destino de macOS es el sufijo más largo de la ruta que exista dentro de la raíz (quita prefijos del anfitrión)
+	# (de más largo a más corto, con al menos dos componentes para no casar por un nombre suelto)
+	nuevo=""; s="$rest"
+	while :; do
+		case "$s" in /*/*) ;; *) break;; esac
+		if [ -e "$ROOT$s" ] || [ -L "$ROOT$s" ]; then nuevo="$ROOT$s"; break; fi
+		s="/${s#/*/}"
+	done
+	# sin destino dentro de la raíz (también falta en macOS, p. ej. /etc/localtime): si la ruta es la de la carpeta que contiene
+	# la raíz (el prefijo que dejó la extracción), se pone la raíz en su lugar y el enlace queda colgando como en macOS
+	PADRE="$(dirname "$ROOT")"
+	case "$t" in "$ROOT"/*) ;; "$PADRE"/*) [ -z "$nuevo" ] && nuevo="$ROOT${t#"$PADRE"}";; esac
+	rel="${l#"$ROOT"}"
+	if [ -z "$nuevo" ]; then sin=$((sin + 1)); echo "sin destino: $rel -> $t"; continue; fi
+	echo "$rel -> ${nuevo#"$ROOT"}"
+	[ $APLICAR = 1 ] && ln -sfn "$nuevo" "$l"
+	n=$((n + 1))
+done < <(find "$ROOT" -xdev -type l -print0)
+echo "enlaces a reparar: $n (sin destino en la raíz: $sin)$([ $APLICAR = 1 ] && echo ', reparados' || echo '; con --aplicar se reparan')"
diff --git a/tools/historico_darling/NOTA.md b/tools/historico_darling/NOTA.md
new file mode 100644
index 0000000..74ead0e
--- /dev/null
+++ b/tools/historico_darling/NOTA.md
@@ -0,0 +1,14 @@
+# Herramientas históricas de Darling (no usar)
+
+Estas tres herramientas son de la primera etapa del proyecto, de antes de que existiera `tahoe-run`, cuando se
+probó si [Darling](https://github.com/darlinghq/darling) servía para arrancar macOS 26. La conclusión fue hacer una
+capa propia: **`tahoe-run` no usa código de Darling** ni necesita estas herramientas para compilarse, arrancar macOS ni
+probarse. Se guardan solo como registro de cómo se llegó a esa decisión.
+
+| Herramienta | Qué hacía |
+|---|---|
+| `build_darling_codespace.sh` | En un GitHub Codespace, clonaba Darling con sus submódulos y compilaba dos piezas suyas: `mldr` (su cargador de programas Mach-O) y `darlingserver` (su servidor que imita al núcleo). No compila nada de este proyecto. |
+| `dyld_iterate.py` | Ejecutaba un programa de macOS 26 dentro de Darling y, cada vez que faltaba una biblioteca, la sacaba de la `dyld_shared_cache` y reintentaba, para ver hasta dónde llegaba Darling. |
+| `compare_syscalls.py` | Contaba cuántas llamadas al sistema BSD y trampas Mach del XNU de Apple implementa Darling. |
+
+Las compilaciones de `tahoe-run` son ligeras (`tahoe-run/build.sh`, unos segundos) y se hacen en la propia PC.
diff --git a/tools/historico_darling/build_darling_codespace.sh b/tools/historico_darling/build_darling_codespace.sh
new file mode 100755
index 0000000..61ac665
--- /dev/null
+++ b/tools/historico_darling/build_darling_codespace.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+# Compila las partes de Linux de Darling (mldr y darlingserver) en un GitHub Codespace.
+# Probado en un codespace "standardLinux32gb" (4 núcleos, 16 GB, Ubuntu 24.04) con Darling 60ba801d.
+#
+#   gh codespace create -R <usuario>/<repo> -m standardLinux32gb --idle-timeout 30m --retention-period 24h
+#   gh codespace ssh -c <nombre> -- 'bash -s' < tools/build_darling_codespace.sh
+#
+# Notas aprendidas:
+#  * Compilar en /tmp: está en un disco aparte (~118 GB). /workspaces solo tiene ~12 GB libres.
+#  * git-lfs está instalado en el codespace y el submódulo src/external/swift intenta bajar bibliotecas
+#    precompiladas de un servidor que pide credenciales. GIT_LFS_SKIP_SMUDGE=1 lo evita.
+#  * Si el clon se aborta a mitad, los submódulos quedan con el commit correcto pero SIN archivos
+#    (solo el fichero .git). "git submodule status" no lo delata: hay que forzar un reset en cada uno.
+set -euxo pipefail
+export DEBIAN_FRONTEND=noninteractive GIT_LFS_SKIP_SMUDGE=1
+
+sudo apt-get update -qq
+sudo apt-get install -y -qq cmake clang bison flex libfuse-dev libudev-dev pkg-config libc6-dev-i386 \
+  gcc-multilib libcairo2-dev libgl1-mesa-dev libtiff-dev libfreetype6-dev libelf-dev libxml2-dev \
+  libegl1-mesa-dev libglu1-mesa-dev libfontconfig1-dev libbsd-dev ninja-build libxrandr-dev \
+  libxcursor-dev libgif-dev libavcodec-dev libavformat-dev libswresample-dev libavutil-dev \
+  libpulse-dev libdbus-1-dev libxkbfile-dev libcap-dev llvm-dev libvulkan-dev libcap2-bin python3 lld
+
+cd /tmp
+[ -d darling ] || git clone --depth 1 --recurse-submodules --shallow-submodules -j4 https://github.com/darlinghq/darling.git darling || true
+cd darling
+git submodule update --init --recursive --depth 1 -j4
+git submodule foreach --recursive --quiet 'git reset --hard -q HEAD'
+
+mkdir -p build && cd build
+cmake .. -G Ninja -DCMAKE_BUILD_TYPE=Release -DTARGET_i386=OFF -DENABLE_METAL=OFF \
+  -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++
+ninja -j4 mldr darlingserver
+ls -la src/startup/mldr/mldr src/external/darlingserver/darlingserver
diff --git a/tools/historico_darling/compare_syscalls.py b/tools/historico_darling/compare_syscalls.py
new file mode 100644
index 0000000..ee8e08e
--- /dev/null
+++ b/tools/historico_darling/compare_syscalls.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Compara las syscalls BSD y las trampas Mach de un XNU de Apple con las que implementa Darling.
+
+Uso: compare_syscalls.py <xnu> <darling>
+  <xnu>     fuente de apple-oss-distributions/xnu (p. ej. xnu-12377.121.6)
+  <darling> clon de darlinghq/darling con submódulos
+
+Darling implementa las syscalls en espacio de usuario (libsystem_kernel/emulation); aquí se cuentan las
+entradas de sus tablas. Es una medida aproximada: una syscall puede resolverse por otra vía.
+"""
+import glob
+import os
+import re
+import sys
+
+xnu, darling = sys.argv[1:3]
+emu = f'{darling}/src/external/xnu/darling/src/libsystem_kernel/emulation/src/xnu_syscall'
+
+# --- syscalls BSD
+table = open(f'{emu}/bsd/bsd_syscall_table.c').read()
+have = {int(n): v for n, v in re.findall(r'^\s*\[(\d+)\]\s*=\s*([A-Za-z_0-9]+),', table, re.M)}
+want = {}
+for line in open(f'{xnu}/bsd/kern/syscalls.master'):
+    g = re.match(r'^(\d+)\s+(\S+)\s+(\S+)\s+\{\s*(.*?)\s*\}', line)
+    if not g or 'nosys' in g.group(4):
+        continue
+    nm = re.search(r'(\w+)\s*\(', g.group(4))
+    want[int(g.group(1))] = nm.group(1) if nm else '?'
+missing = sorted(n for n in want if n not in have)
+newer = [n for n in missing if n > max(have)]
+print(f'BSD: XNU {len(want)} reales, Darling {len(have)} -> faltan {len(missing)} '
+      f'({len(newer)} con número posterior a {max(have)})')
+print('  nuevas:', ', '.join(f'{n}:{want[n]}' for n in newer))
+
+# --- trampas Mach
+x = open(f'{xnu}/osfmk/kern/syscall_sw.c').read()
+x = x[x.index('mach_trap_table'):]
+traps = {int(n): v for n, v in re.findall(r'/\*\s*(\d+)\s*\*/\s*MACH_TRAP\(\s*(\w+)', x)}
+traps = {n: v for n, v in traps.items() if 'invalid' not in v}
+mach = {}
+for f in glob.glob(f'{emu}/mach/**/*.c', recursive=True):
+    if re.search(r'table|trap', os.path.basename(f)):
+        for n, v in re.findall(r'\[(\d+)\]\s*=\s*([A-Za-z_0-9]+)', open(f, errors='ignore').read()):
+            mach[int(n)] = v
+mm = sorted(n for n in traps if n not in mach)
+print(f'Mach: XNU {len(traps)} reales, Darling {len(mach)} -> faltan {len(mm)}')
+print('  ', ', '.join(f'{n}:{traps[n]}' for n in mm))
