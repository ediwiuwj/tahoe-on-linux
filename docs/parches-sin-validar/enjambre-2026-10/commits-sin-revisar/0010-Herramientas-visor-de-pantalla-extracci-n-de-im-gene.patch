@@ -0,0 +1,17 @@
+#!/bin/bash
+# build.sh: compila desde Linux los programas de macOS de esta carpeta (x86_64, Mach-O) con clang y ld64.lld, sin SDK de
+# Apple: las bibliotecas del sistema se describen con stubs .tbd mínimos (solo los símbolos que se usan). Se ejecutan en
+# tahoe-run (tools/macos-shell.sh). Uso: tools/macos/build.sh  -> tools/macos/bin/
+cd "$(dirname "$(readlink -f "$0")")" || exit 1
+mkdir -p bin obj
+tbd() {   # tbd <install-name> <símbolos...>
+	printf -- '--- !tapi-tbd\ntbd-version: 4\ntargets: [ x86_64-macos ]\ninstall-name: '"'%s'"'\nexports:\n  - targets: [ x86_64-macos ]\n    symbols: [ %s ]\n...\n' "$1" "$(shift; echo "$@" | sed 's/ /, /g')"
+}
+tbd /usr/lib/libSystem.B.dylib _open _read _write _close _lseek _malloc _free _unlink _printf _strlen _memcpy _snprintf _getline ___stdinp ___stack_chk_fail ___stack_chk_guard dyld_stub_binder > obj/libSystem.tbd
+tbd /usr/lib/libcompression.dylib _compression_decode_buffer > obj/libcompression.tbd
+for src in *.c; do
+	n="${src%.c}"
+	clang -target x86_64-apple-macos13 -O2 -ffreestanding -fno-builtin -nostdinc -c "$src" -o "obj/$n.o" || exit 1
+	ld64.lld -arch x86_64 -platform_version macos 13.0 26.0 -o "bin/$n" "obj/$n.o" obj/libSystem.tbd obj/libcompression.tbd || exit 1
+	echo "bin/$n"
+done
diff --git a/tools/macos/decmpfs.c b/tools/macos/decmpfs.c
new file mode 100644
index 0000000..5158e04
--- /dev/null
+++ b/tools/macos/decmpfs.c
@@ -0,0 +1,84 @@
+// decmpfs: reconstruye archivos con compresión transparente de APFS/HFS+ (decmpfs) que un extractor dejó como tres piezas:
+// el archivo vacío, "archivo:com.apple.decmpfs" (cabecera) y "archivo:com.apple.ResourceFork" (bloques comprimidos).
+// Es un programa de macOS (se ejecuta dentro de tahoe-run) porque usa compression_decode_buffer de libcompression de
+// Apple, la única que trae LZBITMAP. Lee de la entrada estándar las rutas de los archivos (una por línea), escribe cada
+// uno descomprimido en su lugar y borra las dos piezas. Compilar: tools/macos/build.sh
+//
+// Cabecera decmpfs (16 bytes, little endian): "fpmc", tipo (u32), tamaño sin comprimir (u64); en los tipos «attr» los
+// datos van detrás de la cabecera, en los «rsrc» en el resource fork: una tabla de desplazamientos u32 (bloques de 64 KB)
+// seguida de los bloques. Un bloque que empieza por 0xFF (lzfse/lzbitmap) o 0x06 (lzvn) va sin comprimir.
+typedef unsigned long size_t; typedef long ssize_t; typedef unsigned int u32; typedef unsigned long long u64;
+int open(const char*, int, ...); ssize_t read(int, void*, size_t); ssize_t write(int, const void*, size_t); int close(int);
+long lseek(int, long, int); void* malloc(size_t); void free(void*); int unlink(const char*); int printf(const char*, ...);
+size_t strlen(const char*); void* memcpy(void*, const void*, size_t); int snprintf(char*, size_t, const char*, ...);
+ssize_t getline(char**, size_t*, void*); extern void* __stdinp;
+size_t compression_decode_buffer(unsigned char*, size_t, const unsigned char*, size_t, void*, int);
+enum { ALG_ZLIB = 0x205, ALG_LZFSE = 0x801, ALG_LZVN = 0x900, ALG_LZBITMAP = 0x702 };
+#define O_WRONLY 1
+#define O_TRUNC 0x400
+#define CHUNK 65536
+
+static unsigned char* slurp(const char* p, long* n) {
+	int fd = open(p, 0); if (fd < 0) return 0;
+	long sz = lseek(fd, 0, 2); lseek(fd, 0, 0);
+	unsigned char* b = malloc(sz ? sz : 1); long got = 0;
+	while (got < sz) { ssize_t r = read(fd, b + got, sz - got); if (r <= 0) break; got += r; }
+	close(fd); *n = got; return got == sz ? b : 0;
+}
+static int alg_of(u32 t) {
+	switch (t) { case 3: case 4: return ALG_ZLIB; case 7: case 8: return ALG_LZVN; case 11: case 12: return ALG_LZFSE; case 13: case 14: return ALG_LZBITMAP; }
+	return -1;
+}
+// un bloque: sin comprimir si empieza por la marca correspondiente; si no, decodificar (zlib de decmpfs lleva cabecera
+// de 2 bytes de zlib que libcompression no quiere)
+static long chunk(int alg, const unsigned char* in, long n, unsigned char* out, long cap) {
+	if (n == 0) return 0;
+	if ((alg == ALG_LZVN && in[0] == 0x06) || (alg != ALG_LZVN && alg != ALG_ZLIB && in[0] == 0xFF) || (alg == ALG_ZLIB && (in[0] & 0x0F) == 0x0F)) {
+		if (n - 1 > cap) return -1; memcpy(out, in + 1, n - 1); return n - 1;
+	}
+	if (alg == ALG_ZLIB) { in += 2; n -= 2; }
+	return (long)compression_decode_buffer(out, cap, in, n, 0, alg);
+}
+static int one(const char* path) {
+	char hp[4096], rp[4096]; snprintf(hp, sizeof hp, "%s:com.apple.decmpfs", path); snprintf(rp, sizeof rp, "%s:com.apple.ResourceFork", path);
+	long hn; unsigned char* h = slurp(hp, &hn);
+	if (!h || hn < 16 || h[0] != 'f' || h[1] != 'p' || h[2] != 'm' || h[3] != 'c') { printf("cabecera mala: %s\n", path); return 1; }
+	u32 type; u64 size; memcpy(&type, h + 4, 4); memcpy(&size, h + 8, 8);
+	int alg = alg_of(type);
+	unsigned char* out = malloc(size ? size : 1); long done = 0;
+	if (type == 1) { memcpy(out, h + 16, size); done = size; }                      // sin comprimir, en la cabecera
+	else if (alg < 0) { printf("tipo %u no soportado: %s\n", type, path); return 1; }
+	else if (type % 2 == 1) { done = chunk(alg, h + 16, hn - 16, out, size); }        // datos tras la cabecera
+	else {
+		long rn; unsigned char* r = slurp(rp, &rn);
+		if (!r) { printf("sin resource fork: %s\n", path); return 1; }
+		if (type == 4) {                                                       // zlib: formato clásico de resource fork
+			u32 doff = (u32)r[0] << 24 | r[1] << 16 | r[2] << 8 | r[3];
+			const unsigned char* t = r + doff + 4; u32 cnt; memcpy(&cnt, t, 4);
+			for (u32 i = 0; i < cnt && done >= 0; i++) { u32 o, l; memcpy(&o, t + 4 + i * 8, 4); memcpy(&l, t + 8 + i * 8, 4);
+				long k = chunk(alg, t + o, l, out + done, size - done); if (k < 0) done = -1; else done += k; }
+		} else {
+			u32 first; memcpy(&first, r, 4); u32 cnt = first / 4 - 1;
+			for (u32 i = 0; i < cnt && done >= 0; i++) { u32 a, b; memcpy(&a, r + i * 4, 4); memcpy(&b, r + i * 4 + 4, 4);
+				long cap = size - done < CHUNK ? (long)(size - done) : CHUNK;
+				long k = chunk(alg, r + a, (long)b - a, out + done, cap); if (k <= 0 && cap > 0) done = -1; else done += k; }
+		}
+		free(r);
+	}
+	if (done != (long)size) { printf("tamaño %ld en vez de %llu (tipo %u): %s\n", done, size, type, path); return 1; }
+	int fd = open(path, O_WRONLY | O_TRUNC); if (fd < 0) { printf("no puedo escribir: %s\n", path); return 1; }
+	long w = 0; while (w < done) { ssize_t k = write(fd, out + w, done - w); if (k <= 0) break; w += k; }
+	close(fd); free(out); free(h);
+	if (w != done) { printf("escritura corta: %s\n", path); return 1; }
+	unlink(hp); unlink(rp);
+	return 0;
+}
+int main(void) {
+	char* line = 0; size_t cap = 0; ssize_t n; int ok = 0, mal = 0;
+	while ((n = getline(&line, &cap, __stdinp)) > 0) {
+		if (line[n - 1] == '\n') line[--n] = 0;
+		if (n) { if (one(line)) mal++; else ok++; }
+	}
+	printf("descomprimidos %d, con error %d\n", ok, mal);
+	return mal != 0;
+}
diff --git a/tools/preconfigurar.py b/tools/preconfigurar.py
new file mode 100755
index 0000000..2df4a06
--- /dev/null
+++ b/tools/preconfigurar.py
@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""preconfigurar.py: deja el macOS completo configurado como lo hacen las empresas, sin pasar por el Asistente de
+configuración, para probar con un usuario normal y no dudar de si algo falla «porque macOS no está configurado».
+
+  preconfigurar.py aplicar <raíz> <usuario> [nombre completo] [idioma]   (idioma por omisión es_MX)
+  preconfigurar.py deshacer <raíz>
+
+Se ejecuta desde tools/preconfigurar.sh, dentro de un espacio de usuarios de Linux en el que se es root (igual que
+tahoe-run): parte de /private/var/db/dslocal no es legible para el usuario de Linux.
+
+aplicar:
+  1. Copia de seguridad de lo que se toca en ~/.config/tahoe-run/preconfig/ (fuera del repositorio).
+  2. Crea un administrador como lo haría sysadminctl: registro en dslocal (uid 501, grupo staff 20, shell zsh, UUID
+     propio), contraseña con SALTED-SHA512-PBKDF2 (lo que guarda macOS en ShadowHashData; la contraseña se pide aquí y no
+     se guarda en ningún sitio), alta en el grupo admin y carpeta /Users/<usuario> copiada de la plantilla de macOS.
+  3. Idioma y región en /Library/Preferences/.GlobalPreferences.plist (AppleLanguages, AppleLocale) y en las del
+     usuario (~/Library/Preferences/.GlobalPreferences.plist), como deja el Asistente.
+  4. /private/var/db/.AppleSetupDone: el Asistente de configuración se da por hecho. El índice de dslocal (sqlindex) se
+     aparta para que opendirectoryd lo rehaga con el usuario nuevo.
+  Si algo falla a mitad, se deshace lo hecho.
+deshacer: restaura la copia de seguridad, borra el usuario y su carpeta y quita .AppleSetupDone.
+"""
+import getpass
+import hashlib
+import json
+import os
+import plistlib
+import shutil
+import sys
+import time
+import uuid
+
+GUARDA = os.path.expanduser("~/.config/tahoe-run/preconfig")
+DSLOCAL = "private/var/db/dslocal/nodes/Default"
+GLOBAL = "Library/Preferences/.GlobalPreferences.plist"
+SETUPDONE = "private/var/db/.AppleSetupDone"
+UID = 501
+ITERACIONES = 45000                          # del orden de lo que usa macOS para las cuentas locales
+
+
+def leer(p):
+    with open(p, "rb") as f:
+        return plistlib.load(f)
+
+
+def escribir(p, d):
+    tmp = p + ".tmp"
+    with open(tmp, "wb") as f:
+        plistlib.dump(d, f, fmt=plistlib.FMT_BINARY)
+    os.replace(tmp, p)
+
+
+def respaldo(raiz, rels):
+    os.makedirs(GUARDA, exist_ok=True)
+    estado = os.path.join(GUARDA, "estado.json")
+    if os.path.exists(estado):
+        sys.exit("ya hay una preconfiguración aplicada (usa «deshacer» antes de volver a aplicar)")
+    copias = {}
+    for rel in rels:
+        src = os.path.join(raiz, rel)
+        if os.path.exists(src):
+            dst = os.path.join(GUARDA, rel.replace("/", "__"))
+            shutil.copy2(src, dst)
+            copias[rel] = dst
+        else:
+            copias[rel] = None                   # no existía: al deshacer se borra
+    return estado, copias
+
+
+def aplicar(raiz, usuario, nombre, idioma):
+    if not usuario.isascii() or not usuario.replace("_", "").isalnum() or usuario[0].isdigit() or usuario != usuario.lower():
+        sys.exit("el nombre corto debe ser minúsculas, letras y números (p. ej. «ana»)")
+    users = os.path.join(raiz, DSLOCAL, "users")
+    if os.path.exists(os.path.join(raiz, "Users", usuario)):
+        sys.exit(f"ya existe /Users/{usuario}")
+    if os.path.exists(os.path.join(users, usuario + ".plist")):
+        sys.exit(f"el usuario {usuario} ya existe en este macOS")
+    for f in os.listdir(users):                  # uid libre
+        try:
+            if str(UID) in leer(os.path.join(users, f)).get("uid", []):
+                sys.exit(f"el uid {UID} ya está en uso ({f})")
+        except Exception:
+            pass
+    clave = getpass.getpass(f"Contraseña para {usuario} en macOS: ")
+    if clave != getpass.getpass("Repítela: "):
+        sys.exit("no coinciden")
+    if not clave:
+        sys.exit("la contraseña no puede estar vacía")
+
+    # El índice de dslocal (sqlindex) se aparta como hacen las herramientas de despliegue: opendirectoryd lo rehace al
+    # arrancar con el usuario nuevo. Se devuelve al deshacer.
+    indices = [f"{DSLOCAL}/{n}" for n in ("sqlindex", "sqlindex-shm", "sqlindex-wal")]
+    rels = [f"{DSLOCAL}/groups/admin.plist", GLOBAL, SETUPDONE] + indices
+    estado, copias = respaldo(raiz, rels)
+    with open(estado, "w") as f:               # apuntado antes de tocar nada: si algo falla, se puede deshacer
+        json.dump({"usuario": usuario, "casa": f"/Users/{usuario}", "copias": copias, "fecha": time.strftime("%Y-%m-%d %H:%M")}, f, indent=1)
+    try:
+        hacer(raiz, usuario, nombre, idioma, clave, indices)
+    except BaseException:
+        print("algo falló: se deshace lo hecho", file=sys.stderr)
+        deshacer(raiz)
+        raise
+    print(f"listo: usuario «{usuario}» (uid {UID}, administrador), idioma {idioma}, Asistente de configuración saltado.")
+    print("para volver atrás: tools/preconfigurar.sh deshacer")
+
+
+def hacer(raiz, usuario, nombre, idioma, clave, indices):
+    users = os.path.join(raiz, DSLOCAL, "users")
+    # 2. el usuario (formato de dslocal: cada valor es una lista)
+    sal = os.urandom(32)
+    entropia = hashlib.pbkdf2_hmac("sha512", clave.encode(), sal, ITERACIONES, 128)
+    shadow = plistlib.dumps({"SALTED-SHA512-PBKDF2": {"entropy": entropia, "iterations": ITERACIONES, "salt": sal}},
+                            fmt=plistlib.FMT_BINARY)
+    guid = str(uuid.uuid4()).upper()
+    casa = f"/Users/{usuario}"
+    escribir(os.path.join(users, usuario + ".plist"), {
+        "name": [usuario], "realname": [nombre], "uid": [str(UID)], "gid": ["20"], "home": [casa],
+        "shell": ["/bin/zsh"], "generateduid": [guid], "passwd": ["********"],
+        "authentication_authority": [";ShadowHash;HASHLIST:<SALTED-SHA512-PBKDF2>"], "ShadowHashData": [shadow],
+        "hint": [""], "_writers_passwd": [usuario], "_writers_hint": [usuario], "_writers_picture": [usuario],
+        "_writers_realname": [usuario], "_writers_UserCertificate": [usuario], "_writers_jpegphoto": [usuario],
+    })
+    admin_p = os.path.join(raiz, DSLOCAL, "groups", "admin.plist")
+    admin = leer(admin_p)
+    admin.setdefault("users", []).append(usuario)
+    admin.setdefault("groupmembers", []).append(guid)
+    escribir(admin_p, admin)
+
+    plantilla = os.path.join(raiz, "System/Library/User Template")
+    destino = os.path.join(raiz, casa.lstrip("/"))
+    shutil.copytree(os.path.join(plantilla, "Non_localized"), destino, symlinks=True)
+    loc = os.path.join(plantilla, "Spanish.lproj")
+    if os.path.isdir(loc):
+        shutil.copytree(loc, destino, symlinks=True, dirs_exist_ok=True)
+
+    # 3. idioma y región
+    gp_p = os.path.join(raiz, GLOBAL)
+    # vacía (como viene en la imagen) o sin crear: sin preferencias; si tiene algo que no se puede leer, falla (y se deshace)
+    gp = leer(gp_p) if os.path.exists(gp_p) and os.path.getsize(gp_p) > 0 else {}
+    lengua = idioma.split("_")[0]
+    gp["AppleLanguages"] = [idioma.replace("_", "-"), lengua]
+    gp["AppleLocale"] = idioma
+    escribir(gp_p, gp)
+    # y en las del propio usuario, como deja el Asistente (defaults read -g lee estas)
+    up = os.path.join(destino, "Library/Preferences")
+    os.makedirs(up, exist_ok=True)
+    escribir(os.path.join(up, ".GlobalPreferences.plist"), {"AppleLanguages": gp["AppleLanguages"], "AppleLocale": idioma})
+
+    # 4. Asistente de configuración hecho
+    open(os.path.join(raiz, SETUPDONE), "w").close()
+    for rel in indices:
+        p = os.path.join(raiz, rel)
+        if os.path.exists(p):
+            os.remove(p)
+
+
+def deshacer(raiz):
+    estado = os.path.join(GUARDA, "estado.json")
+    if not os.path.exists(estado):
+        sys.exit("no hay ninguna preconfiguración aplicada")
+    e = json.load(open(estado))
+    for rel, copia in e["copias"].items():
+        dst = os.path.join(raiz, rel)
+        if copia and os.path.exists(copia):
+            shutil.copy2(copia, dst)
+            os.remove(copia)
+        elif os.path.exists(dst):
+            os.remove(dst)
+    u = os.path.join(raiz, DSLOCAL, "users", e["usuario"] + ".plist")
+    if os.path.exists(u):
+        os.remove(u)
+    casa = os.path.join(raiz, e["casa"].lstrip("/"))
+    if os.path.isdir(casa):
+        shutil.rmtree(casa)
+    os.remove(estado)
+    print(f"deshecho: sin el usuario «{e['usuario']}», idioma y Asistente de configuración como estaban.")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) >= 4 and sys.argv[1] == "aplicar":
+        aplicar(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) > 4 else sys.argv[3],
+                sys.argv[5] if len(sys.argv) > 5 else "es_MX")
+    elif len(sys.argv) == 3 and sys.argv[1] == "deshacer":
+        deshacer(sys.argv[2])
+    else:
+        sys.exit(__doc__)
