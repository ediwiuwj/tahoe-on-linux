+/// Copia un bloque de Objective-C para que sobreviva a la llamada (o None si no hay bloque).
+pub fn copiar_bloque(b: Id) -> Option<*mut c_void> {
+    if b.is_null() {
+        return None;
+    }
+    // SAFETY: b es un bloque de Objective-C.
+    Some(unsafe { _Block_copy(b) })
