+/// Una comprobación que solo aplica si el marco de Apple tiene esa clase: si no, se cuenta como saltada.
+fn chequear_si(inf: &mut Informe, nombre: &str, aplica: bool, f: impl FnOnce() -> Result<(), String>) {
