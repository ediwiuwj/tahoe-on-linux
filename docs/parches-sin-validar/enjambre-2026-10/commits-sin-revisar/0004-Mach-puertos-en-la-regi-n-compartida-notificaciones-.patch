+static long bsd_psynch_rw_rdlock(struct ctx* c) { return rw_lock(c, NUCLEO_RW_LECTURA); }
+static long bsd_psynch_rw_wrlock(struct ctx* c) { return rw_lock(c, NUCLEO_RW_ESCRITURA); }
