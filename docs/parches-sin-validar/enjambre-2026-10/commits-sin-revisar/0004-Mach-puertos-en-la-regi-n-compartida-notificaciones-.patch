+		while (!e.listo) pthread_cond_wait(&e.cv, &ps_lock);
+		valor = e.valor;
+		nucleo_rw_fin_espera(ranura, rw_ahora());
+		r = 0;
+	}
+	pthread_mutex_unlock(&ps_lock);
