-							if (out) { memcpy(out, sb + bo, bl); *len = bl; }
+							if (!out) { if (err) *err = D_ENOMEM; free(sb); free(lc); return NULL; }
+							memcpy(out, sb + bo, bl); *len = bl;
 							break;
 						}
 					}
@@ -126,12 +141,13 @@ static uint8_t* cs_blob_fd(int fd, uint32_t slot, uint32_t* len) {
 	}
 	return out;
