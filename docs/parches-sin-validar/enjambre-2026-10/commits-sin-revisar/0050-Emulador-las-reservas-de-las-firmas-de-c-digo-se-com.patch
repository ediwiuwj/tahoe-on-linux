+						// El offset del índice va en big-endian, como el resto del SuperBlob (XNU: ubc_subr.c:556,
+						// ntohl(blobIndex->offset)).
+						for (uint64_t k = 0; k < count && 12 + (k + 1) * 8 <= dsz; k++) {
