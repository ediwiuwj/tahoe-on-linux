+					uint64_t doff = rd32(lc + off + 8), dsz = rd32(lc + off + 12);
+					uint8_t* sb = malloc(dsz ? dsz : 1);
+					if (!sb) { if (err) *err = D_ENOMEM; free(lc); return NULL; }
+					if (dsz >= 12 && pread(fd, sb, dsz, (off_t)(base + doff)) == (ssize_t)dsz && be32(sb) == 0xfade0cc0) {
 						uint32_t count = be32(sb + 8);
