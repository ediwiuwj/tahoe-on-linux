+//! tahoe-metal: el driver Metal de tahoe-run. Es el ejecutable de TahoeMetal.bundle, que Metal carga porque el
+//! IOAccelerator emulado (tahoe-run con TAHOE_METAL) lo nombra en MetalPluginName; su clase principal, TahoeMTLDevice,
+//! es el MTLDevice. Por debajo, los comandos irán a tahoe-gpu (Vulkan en Linux).
+//!
+//! Fase actual: escucha. La clase hereda de _MTLDevice (la base de Metal.framework) y apunta en el registro qué le pide
+//! Metal (selectores que no tiene, respondsToSelector:...), para ir implementando justo lo que hace falta.
+
+pub mod canal;
+pub mod clases;
+pub mod objc;
+pub mod render;
+
+use std::ffi::c_void;
+use std::io::Write;
+use std::sync::OnceLock;
+
+use objc::{Bool, Class, Id, Sel};
+
+/// Registro: /private/var/tmp/tahoe-metal.log dentro de macOS (y la salida de errores).
+pub fn registro(s: &str) {
+    let linea = format!("tahoe-metal[{}]: {s}\n", std::process::id());
+    let _ = std::io::stderr().write_all(linea.as_bytes());
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open("/private/var/tmp/tahoe-metal.log") {
+        let _ = f.write_all(linea.as_bytes());
+    }
+}
+
+static MADRE: OnceLock<usize> = OnceLock::new();
+
+fn madre() -> Class {
+    *MADRE.get().unwrap_or(&0) as Class
+}
+
+/// -[_MTLDevice initWithAcceleratorPort:] es abstracta (lanza una excepción y devuelve nil): la base se inicia con init
+/// y el puerto del acelerador se guarda aquí.
+extern "C-unwind" fn init_con_puerto(this: Id, _cmd: Sel, puerto: u32) -> Id {
+    registro(&format!("-[TahoeMTLDevice initWithAcceleratorPort:{puerto:#x}]"));
+    // SAFETY: init de NSObject (vía _MTLDevice).
+    let r: Id = unsafe { objc::super0(this, madre(), objc::sel("init")) };
+    PUERTO.store(puerto, std::sync::atomic::Ordering::Relaxed);
+    clases::DISPOSITIVO.store(r, std::sync::atomic::Ordering::Relaxed);
+    if canal::gpu(puerto).is_none() {
+        // sin servidor de GPU no hay dispositivo: Metal sigue sin él
+        registro("  sin GPU: initWithAcceleratorPort: devuelve nil");
+        return std::ptr::null_mut();
+    }
+    registro(&format!("  -> {r:?}"));
+    r
+}
+
+fn info() -> canal::protocolo::Info {
+    canal::gpu_ya().map(|g| g.info.clone()).unwrap_or_default()
+}
+
+extern "C-unwind" fn registry_id(_this: Id, _cmd: Sel) -> u64 {
+    info().registry_id
+}
+
+extern "C-unwind" fn max_buffer(_this: Id, _cmd: Sel) -> u64 {
+    info().max_buffer
+}
+
+// ------------------------------------------------------------------ creación de objetos (MTLDevice)
+
+extern "C-unwind" fn nueva_cola(_this: Id, _cmd: Sel) -> Id {
+    clases::nueva_cola()
+}
+extern "C-unwind" fn nueva_cola_max(_this: Id, _cmd: Sel, _n: u64) -> Id {
+    clases::nueva_cola()
+}
+extern "C-unwind" fn nuevo_buffer(_this: Id, _cmd: Sel, len: u64, opciones: u64) -> Id {
+    clases::nuevo_buffer(len as usize, opciones, None).unwrap_or_else(|e| {
+        registro(&format!("newBufferWithLength:{len}: {e}"));
+        std::ptr::null_mut()
+    })
+}
+extern "C-unwind" fn nuevo_buffer_datos(_this: Id, _cmd: Sel, p: *const u8, len: u64, opciones: u64) -> Id {
+    // SAFETY: Metal garantiza len bytes en p.
+    let d = if p.is_null() { None } else { Some(unsafe { std::slice::from_raw_parts(p, len as usize) }) };
+    clases::nuevo_buffer(len as usize, opciones, d).unwrap_or_else(|e| {
+        registro(&format!("newBufferWithBytes:length:{len}: {e}"));
+        std::ptr::null_mut()
+    })
+}
+extern "C-unwind" fn biblioteca_datos(_this: Id, _cmd: Sel, datos: Id, error: *mut Id) -> Id {
+    // SAFETY: datos es un dispatch_data_t.
+    let v = unsafe { clases::bytes_de_dispatch_data(datos) };
+    clases::nueva_biblioteca(&v, error)
+}
+fn biblioteca_ruta(ruta: &str, error: *mut Id) -> Id {
+    match std::fs::read(ruta) {
+        Ok(v) => clases::nueva_biblioteca(&v, error),
+        Err(e) => {
+            registro(&format!("biblioteca {ruta}: {e}"));
+            std::ptr::null_mut()
+        }
+    }
+}
+extern "C-unwind" fn biblioteca_archivo(_this: Id, _cmd: Sel, ruta: Id, error: *mut Id) -> Id {
+    biblioteca_ruta(&objc::texto(ruta), error)
+}
+extern "C-unwind" fn biblioteca_url(_this: Id, _cmd: Sel, url: Id, error: *mut Id) -> Id {
+    // SAFETY: url es un NSURL.
+    let ruta = objc::texto(unsafe { objc::m0(url, "path") });
+    biblioteca_ruta(&ruta, error)
+}
+extern "C-unwind" fn pipeline_funcion(_this: Id, _cmd: Sel, f: Id, error: *mut Id) -> Id {
+    clases::nuevo_pipeline(f, error)
+}
+
+#[repr(C)]
+struct MTLSize {
+    w: u64,
+    h: u64,
+    d: u64,
+}
+extern "C-unwind" fn max_hilos(_this: Id, _cmd: Sel) -> MTLSize {
+    let m = info().max_hilos_grupo.max(64) as u64;
+    MTLSize { w: m, h: m, d: 64 }
+}
+extern "C-unwind" fn memoria_grupo(_this: Id, _cmd: Sel) -> u64 {
+    info().memoria_grupo as u64
+}
+extern "C-unwind" fn si(_this: Id, _cmd: Sel) -> Bool {
+    1
+}
+extern "C-unwind" fn no(_this: Id, _cmd: Sel) -> Bool {
+    0
+}
+extern "C-unwind" fn trabajo_recomendado(_this: Id, _cmd: Sel) -> u64 {
+    1 << 30
+}
+/// supportsFamily: las de Mac de Metal 2 (MTLGPUFamilyMac1 = 2001, Mac2 = 2002, Common1-2 = 3001-3002).
+extern "C-unwind" fn familia(_this: Id, _cmd: Sel, f: i64) -> Bool {
+    matches!(f, 2001 | 2002 | 3001 | 3002) as Bool
+}
+/// supportsFeatureSet: los de macOS GPUFamily1/2 (10000-10005).
+extern "C-unwind" fn feature_set(_this: Id, _cmd: Sel, f: u64) -> Bool {
+    (10000..=10005).contains(&f) as Bool
+}
+
+/// featureProfile (privado): 0 por ahora (el que usa un Mac sin GPU de Apple).
+extern "C-unwind" fn perfil(_this: Id, _cmd: Sel) -> u64 {
+    0
+}
+
+static PUERTO: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+extern "C-unwind" fn puerto_acelerador(_this: Id, _cmd: Sel) -> u32 {
+    PUERTO.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+static SERVICIO: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+extern "C-unwind" fn poner_servicio(_this: Id, _cmd: Sel, servicio: u32) {
+    registro(&format!("_setAcceleratorService:{servicio:#x}"));
+    SERVICIO.store(servicio, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Selectores que la clase no tiene: firma genérica (devuelve un objeto) para que lleguen a forwardInvocation:.
+extern "C-unwind" fn firma_metodo(this: Id, cmd: Sel, s: Sel) -> Id {
+    // SAFETY: NSObject implementa methodSignatureForSelector:; NSMethodSignature existe con Foundation.
+    unsafe {
+        let r: Id = objc::super1(this, madre(), cmd, s);
+        if !r.is_null() {
+            return r;
+        }
+        objc::m1(objc::clase("NSMethodSignature"), "signatureWithObjCTypes:", c"@@:".as_ptr())
+    }
+}
+
+/// Fase de escucha: un mensaje que no se implementa se apunta y devuelve 0/nil (en vez de lanzar una excepción).
+extern "C-unwind" fn reenviar(_this: Id, _cmd: Sel, inv: Id) {
+    // SAFETY: inv es un NSInvocation.
+    let s: Sel = unsafe { objc::m0(inv, "selector") };
+    registro(&format!("sin implementar: -{}", objc::nombre_sel(s)));
+}
+
+extern "C-unwind" fn nombre(_this: Id, _cmd: Sel) -> Id {
+    let n = info().nombre;
+    objc::nsstring(if n.is_empty() { "Tahoe GPU" } else { &n })
+}
+
+extern "C-unwind" fn responde(this: Id, cmd: Sel, s: Sel) -> Bool {
+    // SAFETY: NSObject implementa respondsToSelector:.
+    let r: Bool = unsafe { objc::super1(this, madre(), cmd, s) };
+    registro(&format!("respondsToSelector:{} -> {r}", objc::nombre_sel(s)));
+    r
+}
+
+extern "C-unwind" fn resolver(_cls: Class, _cmd: Sel, s: Sel) -> Bool {
+    registro(&format!("+resolveInstanceMethod:{} (no implementado)", objc::nombre_sel(s)));
+    0
+}
+
+/// Crea la clase TahoeMTLDevice al cargar el bundle (antes de que NSBundle pida la clase principal).
+extern "C" fn registrar() {
+    let base = objc::clase("_MTLDevice");
+    if base.is_null() {
+        for n in ["NSObject", "_MTLDevice", "MTLIOAccelDevice", "MTLIGAccelDevice", "_MTLCommandQueue", "MTLCompiler", "NSBundle"] {
+            registro(&format!("objc_getClass({n}) = {:?}", objc::clase(n)));
+        }
+        registro("no está _MTLDevice (¿Metal.framework sin cargar?)");
+        return;
+    }
+    let _ = MADRE.set(base as usize);
+    let nombre_c = c"TahoeMTLDevice";
+    // SAFETY: clase nueva con una madre existente; los métodos llevan las firmas de sus tipos.
+    unsafe {
+        let cls = objc::objc_allocateClassPair(base, nombre_c.as_ptr(), 0);
+        if cls.is_null() {
+            registro("TahoeMTLDevice ya existe");
+            return;
+        }
+        objc::metodo(cls, "initWithAcceleratorPort:", init_con_puerto as *const c_void, "@@:I");
+        objc::metodo(cls, "name", nombre as *const c_void, "@@:");
+        objc::metodo(cls, "acceleratorPort", puerto_acelerador as *const c_void, "I@:");
+        objc::metodo(cls, "_setAcceleratorService:", poner_servicio as *const c_void, "v@:I");
+        objc::metodo(cls, "registryID", registry_id as *const c_void, "Q@:");
+        objc::metodo(cls, "maxBufferLength", max_buffer as *const c_void, "Q@:");
+        objc::metodo(cls, "featureProfile", perfil as *const c_void, "Q@:");
+        for (n, imp, t) in [
+            ("newCommandQueue", nueva_cola as *const c_void, "@@:"),
+            ("newCommandQueueWithMaxCommandBufferCount:", nueva_cola_max as *const c_void, "@@:Q"),
+            ("newBufferWithLength:options:", nuevo_buffer as *const c_void, "@@:QQ"),
+            ("newBufferWithBytes:length:options:", nuevo_buffer_datos as *const c_void, "@@:^vQQ"),
+            ("newLibraryWithData:error:", biblioteca_datos as *const c_void, "@@:@^@"),
+            ("newLibraryWithFile:error:", biblioteca_archivo as *const c_void, "@@:@^@"),
+            ("newLibraryWithURL:error:", biblioteca_url as *const c_void, "@@:@^@"),
+            ("newComputePipelineStateWithFunction:error:", pipeline_funcion as *const c_void, "@@:@^@"),
+            ("maxThreadsPerThreadgroup", max_hilos as *const c_void, "{MTLSize=QQQ}@:"),
+            ("maxThreadgroupMemoryLength", memoria_grupo as *const c_void, "Q@:"),
+            ("recommendedMaxWorkingSetSize", trabajo_recomendado as *const c_void, "Q@:"),
+            ("hasUnifiedMemory", si as *const c_void, "c@:"),
+            ("isLowPower", si as *const c_void, "c@:"),
+            ("isHeadless", no as *const c_void, "c@:"),
+            ("isRemovable", no as *const c_void, "c@:"),
+            ("supportsFamily:", familia as *const c_void, "c@:q"),
+            ("supportsFeatureSet:", feature_set as *const c_void, "c@:Q"),
+        ] {
+            objc::metodo(cls, n, imp, t);
+        }
+        objc::metodo(cls, "methodSignatureForSelector:", firma_metodo as *const c_void, "@@::");
+        objc::metodo(cls, "forwardInvocation:", reenviar as *const c_void, "v@:@");
+        objc::metodo(cls, "respondsToSelector:", responde as *const c_void, "c@::");
+        // MTLAddDevice comprueba conformsToProtocol:@protocol(MTLDevice)
+        for p in [c"MTLDevice", c"MTLDeviceSPI"] {
+            let pr = objc::objc_getProtocol(p.as_ptr());
+            if !pr.is_null() {
+                objc::class_addProtocol(cls, pr);
+            } else {
+                registro(&format!("no está el protocolo {p:?}"));
+            }
+        }
+        let meta = objc::object_getClass(cls);
+        objc::metodo(meta, "resolveInstanceMethod:", resolver as *const c_void, "c@::");
+        objc::objc_registerClassPair(cls);
+        render::registrar(cls);
+    }
+    clases::registrar();
+    registro("TahoeMTLDevice registrada (madre _MTLDevice)");
+}
+
+#[used]
+#[link_section = "__DATA,__mod_init_func"]
+static CONSTRUCTOR: extern "C" fn() = registrar;
diff --git a/tahoe-metal/src/objc.rs b/tahoe-metal/src/objc.rs
new file mode 100644
index 0000000..84239ae
--- /dev/null
+++ b/tahoe-metal/src/objc.rs
@@ -0,0 +1,167 @@
+//! Lo justo del runtime de Objective-C de macOS (libobjc) para crear clases y mandar mensajes desde Rust, sin crates.
+
+#![allow(non_camel_case_types)]
+
+use std::ffi::{c_char, c_void, CStr, CString};
+
+pub type Id = *mut c_void;
+pub type Class = *mut c_void;
+pub type Sel = *const c_void;
+pub type Imp = *const c_void;
+pub type Bool = i8;
+
+#[repr(C)]
+pub struct ObjcSuper {
+    pub receiver: Id,
+    pub super_class: Class,
+}
+
+#[link(name = "objc")]
+extern "C" {
+    pub fn objc_getClass(name: *const c_char) -> Class;
+    pub fn objc_allocateClassPair(superclass: Class, name: *const c_char, extra: usize) -> Class;
+    pub fn objc_registerClassPair(cls: Class);
+    pub fn class_addMethod(cls: Class, name: Sel, imp: Imp, types: *const c_char) -> Bool;
+    pub fn class_getName(cls: Class) -> *const c_char;
+    pub fn class_getSuperclass(cls: Class) -> Class;
+    pub fn object_getClass(obj: Id) -> Class;
+    pub fn sel_registerName(name: *const c_char) -> Sel;
+    pub fn sel_getName(sel: Sel) -> *const c_char;
+    pub fn objc_getProtocol(name: *const c_char) -> *mut c_void;
+    pub fn class_addProtocol(cls: Class, proto: *mut c_void) -> Bool;
+    pub fn objc_msgSend();
+    pub fn objc_msgSend_stret();
+    pub fn objc_msgSendSuper();
+    pub fn class_getInstanceMethod(cls: Class, s: Sel) -> *mut c_void;
+    pub fn method_getImplementation(m: *mut c_void) -> Imp;
+    pub fn method_setImplementation(m: *mut c_void, imp: Imp) -> Imp;
+}
+
+/// Selector por nombre.
+pub fn sel(nombre: &str) -> Sel {
+    let c = CString::new(nombre).unwrap();
+    // SAFETY: cadena C válida; el runtime la copia.
+    unsafe { sel_registerName(c.as_ptr()) }
+}
+
+pub fn clase(nombre: &str) -> Class {
+    let c = CString::new(nombre).unwrap();
+    // SAFETY: cadena C válida.
+    unsafe { objc_getClass(c.as_ptr()) }
+}
+
+pub fn nombre_sel(s: Sel) -> String {
+    // SAFETY: un selector del runtime tiene nombre.
+    unsafe { CStr::from_ptr(sel_getName(s)).to_string_lossy().into_owned() }
+}
+
+pub fn nombre_clase(c: Class) -> String {
+    if c.is_null() {
+        return "(nil)".into();
+    }
+    // SAFETY: clase del runtime.
+    unsafe { CStr::from_ptr(class_getName(c)).to_string_lossy().into_owned() }
+}
+
+/// objc_msgSend con la firma de cada llamada (0, 1, 2 o 3 argumentos).
+///
+/// # Safety
+/// `obj` debe responder a `s` con esa firma.
+pub unsafe fn m0<R>(obj: Id, s: &str) -> R {
+    let f: unsafe extern "C" fn(Id, Sel) -> R = std::mem::transmute(objc_msgSend as *const ());
+    f(obj, sel(s))
+}
+/// # Safety
+/// Ver `m0`.
+pub unsafe fn m1<A, R>(obj: Id, s: &str, a: A) -> R {
+    let f: unsafe extern "C" fn(Id, Sel, A) -> R = std::mem::transmute(objc_msgSend as *const ());
+    f(obj, sel(s), a)
+}
+/// # Safety
+/// Ver `m0`.
+pub unsafe fn m2<A, B, R>(obj: Id, s: &str, a: A, b: B) -> R {
+    let f: unsafe extern "C" fn(Id, Sel, A, B) -> R = std::mem::transmute(objc_msgSend as *const ());
+    f(obj, sel(s), a, b)
+}
+/// # Safety
+/// Ver `m0`.
+pub unsafe fn m3<A, B, C, R>(obj: Id, s: &str, a: A, b: B, c: C) -> R {
+    let f: unsafe extern "C" fn(Id, Sel, A, B, C) -> R = std::mem::transmute(objc_msgSend as *const ());
+    f(obj, sel(s), a, b, c)
+}
+/// Mensaje que devuelve una estructura de más de 16 bytes (en x86_64 va por objc_msgSend_stret).
+///
+/// # Safety
+/// Ver `m0`.
+pub unsafe fn m0_stret<R>(obj: Id, s: &str) -> R {
+    let f: unsafe extern "C" fn(Id, Sel) -> R = std::mem::transmute(objc_msgSend_stret as *const ());
+    f(obj, sel(s))
+}
+
+/// Mensaje a la superclase `sup` (la implementación de la clase madre): sin argumentos.
+///
+/// # Safety
+/// Ver `m0`.
+pub unsafe fn super0<R>(obj: Id, sup: Class, s: Sel) -> R {
+    let mut os = ObjcSuper { receiver: obj, super_class: sup };
+    let f: unsafe extern "C" fn(*mut ObjcSuper, Sel) -> R = std::mem::transmute(objc_msgSendSuper as *const ());
+    f(&mut os, s)
+}
+/// Mensaje a la superclase `sup` (la implementación de la clase madre): 1 argumento.
+///
+/// # Safety
+/// Ver `m0`.
+pub unsafe fn super1<A, R>(obj: Id, sup: Class, s: Sel, a: A) -> R {
+    let mut os = ObjcSuper { receiver: obj, super_class: sup };
+    let f: unsafe extern "C" fn(*mut ObjcSuper, Sel, A) -> R = std::mem::transmute(objc_msgSendSuper as *const ());
+    f(&mut os, s, a)
+}
+
+/// NSString de una cadena de Rust (autoliberada).
+pub fn nsstring(s: &str) -> Id {
+    let c = CString::new(s).unwrap_or_default();
+    // SAFETY: NSString existe en todo proceso con Foundation (Metal la carga).
+    unsafe {
+        let f: unsafe extern "C" fn(Id, Sel, *const c_char) -> Id = std::mem::transmute(objc_msgSend as *const ());
+        f(clase("NSString"), sel("stringWithUTF8String:"), c.as_ptr())
+    }
+}
+
+/// Texto de un NSString (o "(nil)").
+pub fn texto(s: Id) -> String {
+    if s.is_null() {
+        return "(nil)".into();
+    }
+    // SAFETY: objeto que responde a UTF8String.
+    unsafe {
+        let f: unsafe extern "C" fn(Id, Sel) -> *const c_char = std::mem::transmute(objc_msgSend as *const ());
+        let p = f(s, sel("UTF8String"));
+        if p.is_null() {
+            "(nil)".into()
+        } else {
+            CStr::from_ptr(p).to_string_lossy().into_owned()
+        }
+    }
+}
+
+/// Añade un método a la clase (o a la metaclase, para los de clase).
+pub fn metodo(cls: Class, nombre: &str, imp: Imp, tipos: &str) {
+    let t = CString::new(tipos).unwrap();
+    // SAFETY: clase en construcción; el runtime copia los tipos.
+    unsafe {
+        class_addMethod(cls, sel(nombre), imp, t.as_ptr());
+    }
+}
+
+/// Clase de un objeto (nil si el objeto es nil).
+pub fn clase_de(o: Id) -> Class {
+    if o.is_null() {
+        return std::ptr::null_mut();
+    }
+    // SAFETY: objeto de Objective-C.
+    unsafe { object_getClass(o) }
+}
+
+pub fn es_nulo(p: *const c_void) -> bool {
+    p.is_null()
+}
diff --git a/tahoe-metal/src/render.rs b/tahoe-metal/src/render.rs
new file mode 100644
index 0000000..1acb0b6
--- /dev/null
+++ b/tahoe-metal/src/render.rs
@@ -0,0 +1,750 @@
+//! Texturas, samplers y render: MTLTexture (también sobre IOSurface), MTLSamplerState, MTLRenderPipelineState y
+//! MTLRenderCommandEncoder, más las function constants (newFunctionWithName:constantValues:error:).
+//!
+//! Las function constants se guardan en un objeto de Metal (MTLFunctionConstantValuesInternal) que no deja leerlas:
+//! sus tres métodos de dar valores se interceptan y los valores se apuntan aquí, por objeto, antes de seguir.
+
+use std::collections::HashMap;
+use std::ffi::{c_char, c_int, c_void};
+use std::sync::{Mutex, OnceLock};
+
+use crate::canal::{self, protocolo};
+use crate::clases::{self, crear, estado, nueva_clase, nuevo_id, poner_error, retener, soltar, Clase, CommandBuffer, ConEtiqueta, Encoder, Funcion, Metodo};
+use crate::objc::{self, Bool, Class, Id, Imp, Sel};
+use crate::registro;
+use protocolo::{clase, orden, tipo, Escritor};
+
+extern "C" {
+    fn dlopen(p: *const c_char, modo: c_int) -> *mut c_void;
+    fn dlsym(h: *mut c_void, s: *const c_char) -> *mut c_void;
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+pub struct MTLRegion {
+    pub x: u64,
+    pub y: u64,
+    pub z: u64,
+    pub w: u64,
+    pub h: u64,
+    pub d: u64,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+pub struct MTLClearColor {
+    pub r: f64,
+    pub g: f64,
+    pub b: f64,
+    pub a: f64,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+pub struct MTLViewport {
+    pub x: f64,
+    pub y: f64,
+    pub w: f64,
+    pub h: f64,
+    pub zn: f64,
+    pub zf: f64,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+pub struct MTLScissorRect {
+    pub x: u64,
+    pub y: u64,
+    pub w: u64,
+    pub h: u64,
+}
+
+pub struct ClasesRender {
+    pub textura: Clase,
+    pub sampler: Clase,
+    pub pipeline: Clase,
+    pub encoder: Clase,
+}
+
+static CLASES: OnceLock<ClasesRender> = OnceLock::new();
+
+fn clases_render() -> &'static ClasesRender {
+    CLASES.get().expect("clases de render sin registrar")
+}
+
+macro_rules! con_etiqueta {
+    ($t:ty) => {
+        impl ConEtiqueta for $t {
+            fn etiqueta(&mut self) -> &mut Id {
+                &mut self.etiqueta
+            }
+        }
+    };
+}
+
+fn pedir(t: u32, cuerpo: &[u8]) -> Result<Vec<u8>, String> {
+    let g = canal::gpu_ya().ok_or("sin servidor de GPU")?;
+    let mut c = g.canal.lock().map_err(|_| "canal envenenado")?;
+    c.pedir(t, cuerpo).map_err(|e| e.to_string())
+}
+
+// ------------------------------------------------------------------ texturas
+
+pub struct Textura {
+    pub id: u32,
+    tipo: u64,
+    formato: u64,
+    ancho: u64,
+    alto: u64,
+    prof: u64,
+    niveles: u64,
+    capas: u64,
+    muestras: u64,
+    uso: u64,
+    almacen: u64,
+    superficie: Id,
+    plano: u64,
+    etiqueta: Id,
+}
+con_etiqueta!(Textura);
+
+impl Drop for Textura {
+    fn drop(&mut self) {
+        clases::liberar_en_servidor(clase::TEXTURA, self.id);
+        if !self.superficie.is_null() {
+            // SAFETY: IOSurface retenida al crear la textura (CFRetain/CFRelease son retain/release).
+            unsafe { objc::m0::<()>(self.superficie, "release") };
+        }
+        soltar(self.etiqueta);
+    }
+}
+
+/// Funciones de IOSurface.framework.
+fn iosurface(nombre: &std::ffi::CStr) -> *mut c_void {
+    // SAFETY: dlopen/dlsym de un framework del sistema.
+    unsafe { dlsym(dlopen(c"/System/Library/Frameworks/IOSurface.framework/IOSurface".as_ptr(), 2), nombre.as_ptr()) }
+}
+
+fn nueva_textura(desc: Id, superficie: Id, plano: u64) -> Id {
+    // SAFETY: desc es un MTLTextureDescriptor (propiedades del protocolo).
+    let (tipo, formato, mut ancho, mut alto, prof, niveles, capas, muestras, uso, almacen): (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = unsafe {
+        (
+            objc::m0(desc, "textureType"),
+            objc::m0(desc, "pixelFormat"),
+            objc::m0(desc, "width"),
+            objc::m0(desc, "height"),
+            objc::m0(desc, "depth"),
+            objc::m0(desc, "mipmapLevelCount"),
+            objc::m0(desc, "arrayLength"),
+            objc::m0(desc, "sampleCount"),
+            objc::m0(desc, "usage"),
+            objc::m0(desc, "storageMode"),
+        )
+    };
+    let mut ruta = String::new();
+    let mut bpr = 0u64;
+    if !superficie.is_null() {
+        // SAFETY: funciones de IOSurface con sus firmas.
+        unsafe {
+            let id: extern "C" fn(Id) -> u32 = std::mem::transmute(iosurface(c"IOSurfaceGetID"));
+            let fila: extern "C" fn(Id) -> u64 = std::mem::transmute(iosurface(c"IOSurfaceGetBytesPerRow"));
+            let w: extern "C" fn(Id) -> u64 = std::mem::transmute(iosurface(c"IOSurfaceGetWidth"));
+            let h: extern "C" fn(Id) -> u64 = std::mem::transmute(iosurface(c"IOSurfaceGetHeight"));
+            let plantilla = canal::gpu_ya().map(|g| g.ruta_superficies.clone()).unwrap_or_default();
+            ruta = plantilla.replace("%u", &id(superficie).to_string());
+            bpr = fila(superficie);
+            if ancho == 0 {
+                ancho = w(superficie);
+            }
+            if alto == 0 {
+                alto = h(superficie);
+            }
+        }
+    }
+    let id = nuevo_id();
+    let mut e = Escritor::default();
+    e.u32(id).u32(tipo as u32).u32(formato as u32).u32(ancho as u32).u32(alto as u32).u32(prof.max(1) as u32).u32(niveles.max(1) as u32).u32(capas.max(1) as u32).u32(uso as u32).texto(&ruta).u64(bpr);
+    if let Err(er) = pedir(tipo::TEXTURA, &e.0) {
+        registro(&format!("textura {ancho}x{alto} formato {formato}: {er}"));
+        return std::ptr::null_mut();
+    }
+    let superficie = retener(superficie);
+    crear(&clases_render().textura, Textura { id, tipo, formato, ancho, alto, prof: prof.max(1), niveles: niveles.max(1), capas: capas.max(1), muestras: muestras.max(1), uso, almacen, superficie, plano, etiqueta: std::ptr::null_mut() })
+}
+
+extern "C-unwind" fn dev_textura(_this: Id, _cmd: Sel, desc: Id) -> Id {
+    nueva_textura(desc, std::ptr::null_mut(), 0)
+}
+extern "C-unwind" fn dev_textura_superficie(_this: Id, _cmd: Sel, desc: Id, sup: Id, plano: u64) -> Id {
+    nueva_textura(desc, sup, plano)
+}
+
+macro_rules! getter {
+    ($n:ident, $campo:ident) => {
+        extern "C-unwind" fn $n(this: Id, _cmd: Sel) -> u64 {
+            estado::<Textura>(this).map(|t| t.$campo).unwrap_or(0)
+        }
+    };
+}
+getter!(tex_tipo, tipo);
+getter!(tex_formato, formato);
+getter!(tex_ancho, ancho);
+getter!(tex_alto, alto);
+getter!(tex_prof, prof);
+getter!(tex_niveles, niveles);
+getter!(tex_capas, capas);
+getter!(tex_muestras, muestras);
+getter!(tex_uso, uso);
+getter!(tex_almacen, almacen);
+getter!(tex_plano, plano);
+
+extern "C-unwind" fn tex_superficie(this: Id, _cmd: Sel) -> Id {
+    estado::<Textura>(this).map(|t| t.superficie).unwrap_or(std::ptr::null_mut())
+}
+extern "C-unwind" fn tex_nil(_this: Id, _cmd: Sel) -> Id {
+    std::ptr::null_mut()
+}
+extern "C-unwind" fn tex_no(_this: Id, _cmd: Sel) -> Bool {
+    0
+}
+
+fn subir(this: Id, r: MTLRegion, nivel: u64, capa: u64, p: *const u8, bpr: u64, bpi: u64) {
+    let Some(t) = estado::<Textura>(this) else { return };
+    let tam = if r.d > 1 { bpi * r.d } else { bpr * r.h.max(1) } as usize;
+    // SAFETY: Metal garantiza los bytes de la región en p.
+    let datos = unsafe { std::slice::from_raw_parts(p, tam) };
+    let mut e = Escritor::default();
+    e.u32(t.id).u32(nivel as u32).u32(capa as u32).u32(r.x as u32).u32(r.y as u32).u32(r.z as u32).u32(r.w as u32).u32(r.h as u32).u32(r.d.max(1) as u32).u32(bpr as u32).bytes(datos);
+    if let Err(er) = pedir(tipo::TEXTURA_SUBIR, &e.0) {
+        registro(&format!("replaceRegion: {er}"));
+    }
+}
+extern "C-unwind" fn tex_reemplazar(this: Id, _cmd: Sel, r: MTLRegion, nivel: u64, p: *const u8, bpr: u64) {
+    subir(this, r, nivel, 0, p, bpr, bpr * r.h);
+}
+extern "C-unwind" fn tex_reemplazar_capa(this: Id, _cmd: Sel, r: MTLRegion, nivel: u64, capa: u64, p: *const u8, bpr: u64, bpi: u64) {
+    subir(this, r, nivel, capa, p, bpr, bpi);
+}
+fn bajar(this: Id, p: *mut u8, bpr: u64, r: MTLRegion, nivel: u64, capa: u64) {
+    let Some(t) = estado::<Textura>(this) else { return };
+    let mut e = Escritor::default();
+    e.u32(t.id).u32(nivel as u32).u32(capa as u32).u32(r.x as u32).u32(r.y as u32).u32(r.w as u32).u32(r.h as u32).u32(bpr as u32);
+    match pedir(tipo::TEXTURA_BAJAR, &e.0) {
+        Ok(v) => {
+            let mut l = protocolo::Lector::new(&v);
+            if let Ok(b) = l.bytes() {
+                // SAFETY: el destino tiene bpr × alto bytes.
+                unsafe { std::ptr::copy_nonoverlapping(b.as_ptr(), p, b.len().min((bpr * r.h) as usize)) };
+            }
+        }
+        Err(er) => registro(&format!("getBytes: {er}")),
+    }
+}
+extern "C-unwind" fn tex_obtener(this: Id, _cmd: Sel, p: *mut u8, bpr: u64, r: MTLRegion, nivel: u64) {
+    bajar(this, p, bpr, r, nivel, 0);
+}
+extern "C-unwind" fn tex_obtener_capa(this: Id, _cmd: Sel, p: *mut u8, bpr: u64, _bpi: u64, r: MTLRegion, nivel: u64, capa: u64) {
+    bajar(this, p, bpr, r, nivel, capa);
+}
+
+// ------------------------------------------------------------------ samplers
+
+pub struct Sampler {
+    pub id: u32,
+    etiqueta: Id,
+}
+con_etiqueta!(Sampler);
+
+impl Drop for Sampler {
+    fn drop(&mut self) {
+        clases::liberar_en_servidor(clase::SAMPLER, self.id);
+        soltar(self.etiqueta);
+    }
+}
+
+extern "C-unwind" fn dev_sampler(_this: Id, _cmd: Sel, d: Id) -> Id {
+    let id = nuevo_id();
+    let mut e = Escritor::default();
+    // SAFETY: d es un MTLSamplerDescriptor.
+    unsafe {
+        let u = |s: &str| -> u32 { objc::m0::<u64>(d, s) as u32 };
+        e.u32(id).u32(u("minFilter")).u32(u("magFilter")).u32(u("mipFilter")).u32(u("sAddressMode")).u32(u("tAddressMode")).u32(u("rAddressMode"));
+        e.u32(objc::m0::<Bool>(d, "normalizedCoordinates") as u32).u32(u("maxAnisotropy"));
+        e.u32(objc::m0::<f32>(d, "lodMinClamp").to_bits()).u32(objc::m0::<f32>(d, "lodMaxClamp").to_bits());
+        e.u32(u("compareFunction")).u32(u("borderColor"));
+    }
+    if let Err(er) = pedir(tipo::SAMPLER, &e.0) {
+        registro(&format!("sampler: {er}"));
+        return std::ptr::null_mut();
+    }
+    crear(&clases_render().sampler, Sampler { id, etiqueta: std::ptr::null_mut() })
+}
+
+// ------------------------------------------------------------------ function constants
+
+/// Valores dados a cada MTLFunctionConstantValues (por la dirección del objeto): índice (u32::MAX: por nombre), nombre,
+/// MTLDataType y bytes.
+type Constantes = Vec<(u32, String, u32, Vec<u8>)>;
+static CONSTANTES: Mutex<Option<HashMap<usize, Constantes>>> = Mutex::new(None);
+static ORIGINALES: OnceLock<[usize; 3]> = OnceLock::new();
+
+/// Bytes de un valor de MTLDataType.
+fn tam_tipo(t: u64) -> usize {
+    match t {
+        3..=6 => 4 * (t - 2) as usize,
+        16..=19 => 2 * (t - 15) as usize,
+        29..=36 => 4 * ((t - 29) % 4 + 1) as usize,
+        37..=44 => 2 * ((t - 37) % 4 + 1) as usize,
+        45..=56 => ((t - 45) % 4 + 1) as usize,
+        81..=88 => 8,
+        _ => 4,
+    }
+}
+
+fn apuntar(obj: Id, indice: u32, nombre: String, tipo_d: u64, p: *const u8) {
+    // SAFETY: Metal pasa un valor de ese tipo en p.
+    let b = unsafe { std::slice::from_raw_parts(p, tam_tipo(tipo_d)) }.to_vec();
+    if let Ok(mut g) = CONSTANTES.lock() {
+        let v = g.get_or_insert_with(HashMap::new).entry(obj as usize).or_default();
+        v.retain(|x| !(x.0 == indice && x.1 == nombre));
+        v.push((indice, nombre, tipo_d as u32, b));
+    }
+}
+
+extern "C-unwind" fn fc_indice(this: Id, cmd: Sel, p: *const u8, t: u64, i: u64) {
+    apuntar(this, i as u32, String::new(), t, p);
+    // SAFETY: la implementación original de Metal con la misma firma.
+    unsafe {
+        let f: extern "C-unwind" fn(Id, Sel, *const u8, u64, u64) = std::mem::transmute(ORIGINALES.get().unwrap()[0]);
+        f(this, cmd, p, t, i)
+    }
+}
+extern "C-unwind" fn fc_nombre(this: Id, cmd: Sel, p: *const u8, t: u64, n: Id) {
+    apuntar(this, u32::MAX, objc::texto(n), t, p);
+    // SAFETY: ver fc_indice.
+    unsafe {
+        let f: extern "C-unwind" fn(Id, Sel, *const u8, u64, Id) = std::mem::transmute(ORIGINALES.get().unwrap()[1]);
+        f(this, cmd, p, t, n)
+    }
+}
+extern "C-unwind" fn fc_rango(this: Id, cmd: Sel, p: *const u8, t: u64, r: clases::NSRange) {
+    let paso = tam_tipo(t);
+    for k in 0..r.len {
+        // SAFETY: r.len valores consecutivos.
+        apuntar(this, (r.loc + k) as u32, String::new(), t, unsafe { p.add(k as usize * paso) });
+    }
+    // SAFETY: ver fc_indice.
+    unsafe {
+        let f: extern "C-unwind" fn(Id, Sel, *const u8, u64, clases::NSRange) = std::mem::transmute(ORIGINALES.get().unwrap()[2]);
+        f(this, cmd, p, t, r)
+    }
+}
+
+fn interceptar_constantes() {
+    let cls = objc::clase("MTLFunctionConstantValuesInternal");
+    if cls.is_null() {
+        registro("no está MTLFunctionConstantValuesInternal: sin function constants");
+        return;
+    }
+    // SAFETY: métodos existentes de esa clase; las nuevas implementaciones llaman a las originales.
+    unsafe {
+        let m = |s: &str| objc::class_getInstanceMethod(cls, objc::sel(s));
+        let (a, b, c) = (m("setConstantValue:type:atIndex:"), m("setConstantValue:type:withName:"), m("setConstantValues:type:withRange:"));
+        if a.is_null() || b.is_null() || c.is_null() {
+            registro("MTLFunctionConstantValuesInternal sin los métodos esperados");
+            return;
+        }
+        let _ = ORIGINALES.set([objc::method_getImplementation(a) as usize, objc::method_getImplementation(b) as usize, objc::method_getImplementation(c) as usize]);
+        objc::method_setImplementation(a, fc_indice as Imp);
+        objc::method_setImplementation(b, fc_nombre as Imp);
+        objc::method_setImplementation(c, fc_rango as Imp);
+    }
+}
+
+/// Las constantes de un MTLFunctionConstantValues, serializadas como las pide el protocolo.
+fn serializar_constantes(valores: Id) -> Vec<u8> {
+    let v = CONSTANTES.lock().ok().and_then(|g| g.as_ref().and_then(|m| m.get(&(valores as usize)).cloned())).unwrap_or_default();
+    let mut e = Escritor::default();
+    e.u32(v.len() as u32);
+    for (i, n, t, b) in v {
+        e.u32(i);
+        if i == u32::MAX {
+            e.texto(&n);
+        }
+        e.u32(t).bytes(&b);
+    }
+    e.0
+}
+
+extern "C-unwind" fn bib_funcion_constantes(this: Id, cmd: Sel, nombre: Id, valores: Id, error: *mut Id) -> Id {
+    // SAFETY: newFunctionWithName: de nuestra biblioteca.
+    let f: Id = unsafe { objc::m1(this, "newFunctionWithName:", nombre) };
+    let _ = cmd;
+    if f.is_null() {
+        poner_error(error, &format!("la biblioteca no tiene «{}»", objc::texto(nombre)));
+        return f;
+    }
+    if let Some(fs) = estado::<Funcion>(f) {
+        fs.constantes = serializar_constantes(valores);
+    }
+    f
+}
