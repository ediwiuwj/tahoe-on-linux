+++ b/tahoe-gpu/src/protocolo.rs
@@ -0,0 +1,218 @@
+//! Protocolo entre el driver Metal de macOS (tahoe-metal, dentro de cada proceso de macOS) y el servidor de GPU de
+//! Linux (`tahoe-gpu servir`, el único proceso que usa Vulkan). Lo comparten los dos crates (tahoe-metal lo incluye con
+//! `#[path]`): sin dependencias.
+//!
+//! Por un socket Unix (el de la propiedad TahoeGPUSocket del IOAccelerator emulado): mensajes con cabecera
+//! `[u32 longitud del cuerpo][u32 tipo]` y el cuerpo en little-endian. Cada petición tiene una respuesta, en orden. Los
+//! datos grandes (buffers, superficies) irán por memoria compartida en /dev/shm, no por el socket.
+
+use std::io::{self, Read, Write};
+
+pub const VERSION: u32 = 1;
+
+/// Tipos de mensaje.
+pub mod tipo {
+    /// driver → servidor: versión del protocolo. Respuesta: `Info`.
+    pub const HOLA: u32 = 1;
+    /// driver → servidor: buffer en memoria compartida {u32 id, u64 tamaño, texto ruta en /dev/shm}. Respuesta vacía.
+    pub const BUFFER: u32 = 2;
+    /// driver → servidor: soltar un objeto {u32 clase (`clase::*`), u32 id}. Respuesta vacía.
+    pub const LIBERAR: u32 = 3;
+    /// driver → servidor: biblioteca {u32 id, bytes del metallib}. Respuesta: {u32 n, n × texto nombre de función}.
+    pub const BIBLIOTECA: u32 = 4;
+    /// driver → servidor: pipeline de cómputo {u32 id, u32 biblioteca, texto función}. Respuesta: {u32 ancho SIMD,
+    /// u32 máximo de hilos por grupo, u32 memoria de grupo estática}.
+    pub const PIPELINE_COMPUTO: u32 = 5;
+    /// driver → servidor: un command buffer {bytes órdenes (`orden::*`)}; se ejecuta entero. Respuesta: {u32 estado
+    /// (0 bien), texto error}.
+    pub const COMANDOS: u32 = 6;
+    /// driver → servidor: textura {u32 id, u32 tipo (MTLTextureType), u32 formato (MTLPixelFormat), u32 ancho, u32 alto,
+    /// u32 profundidad, u32 niveles, u32 capas, u32 uso (MTLTextureUsage), texto IOSurface ("" o la ruta en /dev/shm),
+    /// u64 bytes por fila de la IOSurface}. Respuesta vacía.
+    pub const TEXTURA: u32 = 7;
+    /// driver → servidor: replaceRegion {u32 id, u32 nivel, u32 capa, u32 x, u32 y, u32 z, u32 ancho, u32 alto,
+    /// u32 prof, u32 bytes por fila, bytes píxeles}. Respuesta vacía.
+    pub const TEXTURA_SUBIR: u32 = 8;
+    /// driver → servidor: getBytes {u32 id, u32 nivel, u32 capa, u32 x, u32 y, u32 ancho, u32 alto, u32 bytes por fila}.
+    /// Respuesta: {bytes píxeles}.
+    pub const TEXTURA_BAJAR: u32 = 9;
+    /// driver → servidor: sampler {u32 id, u32 min, u32 mag, u32 mip (MTLSamplerMinMagFilter/MipFilter), 3 × u32
+    /// direcciones (MTLSamplerAddressMode), u32 normalizadas, u32 anisotropía, f32 lod mín, f32 lod máx, u32 comparación,
+    /// u32 color de borde}. Respuesta vacía.
+    pub const SAMPLER: u32 = 10;
+    /// driver → servidor: pipeline de render {u32 id, u32 biblioteca vertex, texto función vertex, constantes vertex,
+    /// u32 biblioteca fragment (0: sin fragment), texto función fragment, constantes fragment, u32 n atributos, n × {u32
+    /// atributo, u32 formato (MTLVertexFormat), u32 offset, u32 buffer}, u32 n layouts, n × {u32 buffer, u32 paso, u32
+    /// función de paso}, u32 n colores, n × {u32 formato (MTLPixelFormat), u32 mezcla activa, 6 × u32 factores y
+    /// operaciones (MTLBlendFactor/MTLBlendOperation: src rgb, dst rgb, op rgb, src alfa, dst alfa, op alfa), u32
+    /// máscara (MTLColorWriteMask)}, u32 formato de profundidad, u32 clase de topología}. Constantes: {u32 n, n × {u32
+    /// índice, u32 tipo (MTLDataType), bytes valor}}. Respuesta vacía.
+    pub const PIPELINE_RENDER: u32 = 11;
+    /// servidor → driver: error (texto).
+    pub const ERROR: u32 = 0xffff_ffff;
+}
+
+/// Clases de objeto para LIBERAR.
+pub mod clase {
+    pub const BUFFER: u32 = 1;
+    pub const BIBLIOTECA: u32 = 2;
+    pub const PIPELINE: u32 = 3;
+    pub const TEXTURA: u32 = 4;
+    pub const SAMPLER: u32 = 5;
+    pub const PIPELINE_RENDER: u32 = 6;
+}
+
+/// Órdenes dentro de COMANDOS: `u32 orden` y sus argumentos.
+pub mod orden {
+    /// {u32 pipeline}
+    pub const PIPELINE: u32 = 1;
+    /// {u32 índice, u32 buffer, u64 desplazamiento}
+    pub const BUFFER: u32 = 2;
+    /// {u32 índice, bytes datos} (setBytes:length:atIndex:)
+    pub const BYTES: u32 = 3;
+    /// {3 × u32 grupos, 3 × u32 hilos por grupo} (dispatchThreadgroups:threadsPerThreadgroup:)
+    pub const GRUPOS: u32 = 4;
+    /// {3 × u32 hilos, 3 × u32 hilos por grupo} (dispatchThreads:threadsPerThreadgroup:)
+    pub const HILOS: u32 = 5;
+    /// {u32 índice, u32 bytes} (setThreadgroupMemoryLength:atIndex:)
+    pub const MEMORIA_GRUPO: u32 = 6;
+    /// {u32 origen, u64 desplazamiento, u32 destino, u64 desplazamiento, u64 bytes}
+    pub const COPIA_BUFFER: u32 = 7;
+    /// fin de un encoder (los enlaces se olvidan)
+    pub const FIN: u32 = 8;
+    /// {u32 índice, u32 textura} (setTexture:atIndex: de cómputo)
+    pub const TEXTURA: u32 = 9;
+    /// {u32 índice, u32 sampler}
+    pub const SAMPLER: u32 = 10;
+    /// empieza un pase de render {u32 n colores, n × {u32 textura, u32 nivel, u32 capa, u32 carga (MTLLoadAction),
+    /// u32 guardar (MTLStoreAction), 4 × f32 color de limpiar}}
+    pub const PASE: u32 = 11;
+    /// {u32 pipeline de render}
+    pub const PIPELINE_RENDER: u32 = 12;
+    /// {u32 etapa (0 vertex, 1 fragment), u32 índice, u32 buffer, u64 desplazamiento}
+    pub const BUFFER_ETAPA: u32 = 13;
+    /// {u32 etapa, u32 índice, bytes datos}
+    pub const BYTES_ETAPA: u32 = 14;
+    /// {u32 etapa, u32 índice, u32 textura}
+    pub const TEXTURA_ETAPA: u32 = 15;
+    /// {u32 etapa, u32 índice, u32 sampler}
+    pub const SAMPLER_ETAPA: u32 = 16;
+    /// {6 × f32: x, y, ancho, alto, profundidad mín y máx}
+    pub const VIEWPORT: u32 = 17;
+    /// {4 × u32: x, y, ancho, alto}
+    pub const TIJERA: u32 = 18;
+    /// {u32 MTLCullMode, u32 MTLWinding}
+    pub const CULL: u32 = 19;
+    /// dibujo {u32 MTLPrimitiveType, u32 primero, u32 cuenta, u32 instancias, u32 primera instancia}
+    pub const DIBUJAR: u32 = 20;
+    /// dibujo con índices {u32 MTLPrimitiveType, u32 cuenta, u32 MTLIndexType, u32 buffer, u64 desplazamiento,
+    /// u32 instancias, i32 base de vértices, u32 primera instancia}
+    pub const DIBUJAR_INDICES: u32 = 21;
+    /// fin del pase de render (se ejecuta)
+    pub const FIN_PASE: u32 = 22;
+}
+
+/// Lo que el servidor cuenta de la GPU (MTLDevice: name, registryID, maxBufferLength...).
+#[derive(Debug, Clone, Default)]
+pub struct Info {
+    pub version: u32,
+    pub nombre: String,
+    pub registry_id: u64,
+    pub max_buffer: u64,
+    pub max_hilos_grupo: u32,
+    pub memoria_grupo: u32,
+    pub ancho_simd: u32,
+}
+
+#[derive(Default)]
+pub struct Escritor(pub Vec<u8>);
+
+impl Escritor {
+    pub fn u32(&mut self, x: u32) -> &mut Self {
+        self.0.extend_from_slice(&x.to_le_bytes());
+        self
+    }
+    pub fn u64(&mut self, x: u64) -> &mut Self {
+        self.0.extend_from_slice(&x.to_le_bytes());
+        self
+    }
+    pub fn texto(&mut self, s: &str) -> &mut Self {
+        self.u32(s.len() as u32);
+        self.0.extend_from_slice(s.as_bytes());
+        self
+    }
+    pub fn bytes(&mut self, b: &[u8]) -> &mut Self {
+        self.u32(b.len() as u32);
+        self.0.extend_from_slice(b);
+        self
+    }
+}
+
+pub struct Lector<'a> {
+    b: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> Lector<'a> {
+    pub fn new(b: &'a [u8]) -> Self {
+        Lector { b, pos: 0 }
+    }
+    fn tomar(&mut self, n: usize) -> io::Result<&'a [u8]> {
+        let r = self.b.get(self.pos..self.pos + n).ok_or_else(|| io::Error::new(io::ErrorKind::UnexpectedEof, "mensaje corto"))?;
+        self.pos += n;
+        Ok(r)
+    }
+    pub fn u32(&mut self) -> io::Result<u32> {
+        Ok(u32::from_le_bytes(self.tomar(4)?.try_into().unwrap()))
+    }
+    pub fn u64(&mut self) -> io::Result<u64> {
+        Ok(u64::from_le_bytes(self.tomar(8)?.try_into().unwrap()))
+    }
+    pub fn bytes(&mut self) -> io::Result<&'a [u8]> {
+        let n = self.u32()? as usize;
+        self.tomar(n)
+    }
+    pub fn texto(&mut self) -> io::Result<String> {
+        Ok(String::from_utf8_lossy(self.bytes()?).into_owned())
+    }
+}
+
+impl Info {
+    pub fn escribir(&self, e: &mut Escritor) {
+        e.u32(self.version).texto(&self.nombre).u64(self.registry_id).u64(self.max_buffer).u32(self.max_hilos_grupo).u32(self.memoria_grupo).u32(self.ancho_simd);
+    }
+    pub fn leer(l: &mut Lector) -> io::Result<Info> {
+        Ok(Info {
+            version: l.u32()?,
+            nombre: l.texto()?,
+            registry_id: l.u64()?,
+            max_buffer: l.u64()?,
+            max_hilos_grupo: l.u32()?,
+            memoria_grupo: l.u32()?,
+            ancho_simd: l.u32()?,
+        })
+    }
+}
+
+/// Manda un mensaje.
+pub fn enviar(w: &mut impl Write, tipo: u32, cuerpo: &[u8]) -> io::Result<()> {
+    let mut m = Vec::with_capacity(8 + cuerpo.len());
+    m.extend_from_slice(&(cuerpo.len() as u32).to_le_bytes());
+    m.extend_from_slice(&tipo.to_le_bytes());
+    m.extend_from_slice(cuerpo);
+    w.write_all(&m)
+}
+
+/// Recibe un mensaje: (tipo, cuerpo).
+pub fn recibir(r: &mut impl Read) -> io::Result<(u32, Vec<u8>)> {
+    let mut h = [0u8; 8];
+    r.read_exact(&mut h)?;
+    let n = u32::from_le_bytes(h[..4].try_into().unwrap()) as usize;
+    if n > 256 << 20 {
+        return Err(io::Error::new(io::ErrorKind::InvalidData, "mensaje demasiado grande"));
+    }
+    let tipo = u32::from_le_bytes(h[4..].try_into().unwrap());
+    let mut c = vec![0u8; n];
+    r.read_exact(&mut c)?;
+    Ok((tipo, c))
+}
diff --git a/tahoe-gpu/src/prueba.rs b/tahoe-gpu/src/prueba.rs
new file mode 100644
index 0000000..6fa174a
--- /dev/null
+++ b/tahoe-gpu/src/prueba.rs
@@ -0,0 +1,137 @@
+//! `tahoe-gpu prueba`: un kernel de cómputo sobre memoria compartida (memfd importado con
+//! VK_EXT_external_memory_host), comprobando el resultado desde la CPU en la misma memoria.
+
+use std::time::Instant;
+
+use ash::vk;
+
+use crate::shaders;
+use crate::vk::{err, Gpu, Res};
+
+const N: usize = 1 << 20; // un millón de enteros (4 MB)
+
+/// Memoria compartida: un memfd proyectado (así llegará la memoria de un MTLBuffer desde el proceso de macOS).
+struct Compartida {
+    ptr: *mut u32,
+    len: usize,
+}
+
+impl Compartida {
+    fn new(len: usize) -> Res<Compartida> {
+        // SAFETY: llamadas al sistema con argumentos válidos; el descriptor se cierra tras proyectar.
+        unsafe {
+            let fd = libc::memfd_create(c"tahoe-gpu-prueba".as_ptr(), libc::MFD_CLOEXEC);
+            if fd < 0 || libc::ftruncate(fd, len as libc::off_t) != 0 {
+                return Err("memfd_create/ftruncate".into());
+            }
+            let p = libc::mmap(std::ptr::null_mut(), len, libc::PROT_READ | libc::PROT_WRITE, libc::MAP_SHARED, fd, 0);
+            libc::close(fd);
+            if p == libc::MAP_FAILED {
+                return Err("mmap".into());
+            }
+            Ok(Compartida { ptr: p.cast(), len })
+        }
+    }
+    fn datos(&mut self) -> &mut [u32] {
+        // SAFETY: proyección propia de len bytes, alineada a página.
+        unsafe { std::slice::from_raw_parts_mut(self.ptr, self.len / 4) }
+    }
+}
+
+impl Drop for Compartida {
+    fn drop(&mut self) {
+        // SAFETY: proyección creada en new y que ya nadie usa.
+        unsafe { libc::munmap(self.ptr.cast(), self.len) };
+    }
+}
+
+pub fn prueba(g: &Gpu) -> Res<()> {
+    let hm = g.host_memory.as_ref().ok_or("la GPU no tiene VK_EXT_external_memory_host")?;
+    let d = &g.device;
+    let size = (N * 4) as vk::DeviceSize;
+    let mut mem = Compartida::new(N * 4)?;
+    for (i, v) in mem.datos().iter_mut().enumerate() {
+        *v = i as u32;
+    }
+    // SAFETY: todas las llamadas usan objetos de este dispositivo, creados aquí y destruidos al final; la memoria
+    // importada (mem) vive más que el buffer y la GPU termina (fence) antes de leerla.
+    unsafe {
+        let hp = {
+            let mut p = vk::MemoryHostPointerPropertiesEXT::default();
+            (hm.fp().get_memory_host_pointer_properties_ext)(d.handle(), vk::ExternalMemoryHandleTypeFlags::HOST_ALLOCATION_EXT, mem.ptr.cast(), &mut p)
+                .result()
+                .map_err(err("vkGetMemoryHostPointerPropertiesEXT"))?;
+            p
+        };
+        let mut ext = vk::ExternalMemoryBufferCreateInfo::default().handle_types(vk::ExternalMemoryHandleTypeFlags::HOST_ALLOCATION_EXT);
+        let bci = vk::BufferCreateInfo::default().size(size).usage(vk::BufferUsageFlags::STORAGE_BUFFER).push_next(&mut ext);
+        let buf = d.create_buffer(&bci, None).map_err(err("vkCreateBuffer"))?;
+        let req = d.get_buffer_memory_requirements(buf);
+        let ty = g
+            .memory_type(req.memory_type_bits & hp.memory_type_bits, vk::MemoryPropertyFlags::HOST_VISIBLE)
+            .ok_or("ningún tipo de memoria admite la memoria importada")?;
+        let mut imp = vk::ImportMemoryHostPointerInfoEXT::default()
+            .handle_type(vk::ExternalMemoryHandleTypeFlags::HOST_ALLOCATION_EXT)
+            .host_pointer(mem.ptr.cast());
+        let mai = vk::MemoryAllocateInfo::default().allocation_size(size).memory_type_index(ty).push_next(&mut imp);
+        let dm = d.allocate_memory(&mai, None).map_err(err("vkAllocateMemory (memoria importada)"))?;
+        d.bind_buffer_memory(buf, dm, 0).map_err(err("vkBindBufferMemory"))?;
+
+        let code = shaders::doble_mas_uno();
+        let sm = d.create_shader_module(&vk::ShaderModuleCreateInfo::default().code(&code), None).map_err(err("vkCreateShaderModule"))?;
+        let bind = [vk::DescriptorSetLayoutBinding::default()
+            .binding(0)
+            .descriptor_type(vk::DescriptorType::STORAGE_BUFFER)
+            .descriptor_count(1)
+            .stage_flags(vk::ShaderStageFlags::COMPUTE)];
+        let dsl = d.create_descriptor_set_layout(&vk::DescriptorSetLayoutCreateInfo::default().bindings(&bind), None).map_err(err("dsl"))?;
+        let dsls = [dsl];
+        let pl = d.create_pipeline_layout(&vk::PipelineLayoutCreateInfo::default().set_layouts(&dsls), None).map_err(err("pl"))?;
+        let stage = vk::PipelineShaderStageCreateInfo::default().stage(vk::ShaderStageFlags::COMPUTE).module(sm).name(c"main");
+        let cpi = [vk::ComputePipelineCreateInfo::default().stage(stage).layout(pl)];
+        let pipe = d.create_compute_pipelines(vk::PipelineCache::null(), &cpi, None).map_err(|(_, e)| format!("pipeline: {e:?}"))?[0];
+        let sizes = [vk::DescriptorPoolSize::default().ty(vk::DescriptorType::STORAGE_BUFFER).descriptor_count(1)];
+        let pool = d.create_descriptor_pool(&vk::DescriptorPoolCreateInfo::default().max_sets(1).pool_sizes(&sizes), None).map_err(err("pool"))?;
+        let set = d.allocate_descriptor_sets(&vk::DescriptorSetAllocateInfo::default().descriptor_pool(pool).set_layouts(&dsls)).map_err(err("set"))?[0];
+        let bi = [vk::DescriptorBufferInfo::default().buffer(buf).offset(0).range(size)];
+        let w = [vk::WriteDescriptorSet::default().dst_set(set).dst_binding(0).descriptor_type(vk::DescriptorType::STORAGE_BUFFER).buffer_info(&bi)];
+        d.update_descriptor_sets(&w, &[]);
+
+        let cp = d.create_command_pool(&vk::CommandPoolCreateInfo::default().queue_family_index(g.queue_family), None).map_err(err("cpool"))?;
+        let cb = d.allocate_command_buffers(&vk::CommandBufferAllocateInfo::default().command_pool(cp).command_buffer_count(1)).map_err(err("cb"))?[0];
+        d.begin_command_buffer(cb, &vk::CommandBufferBeginInfo::default()).map_err(err("begin"))?;
+        d.cmd_bind_pipeline(cb, vk::PipelineBindPoint::COMPUTE, pipe);
+        d.cmd_bind_descriptor_sets(cb, vk::PipelineBindPoint::COMPUTE, pl, 0, &[set], &[]);
+        d.cmd_dispatch(cb, (N / 64) as u32, 1, 1);
+        let bar = [vk::BufferMemoryBarrier::default()
+            .src_access_mask(vk::AccessFlags::SHADER_WRITE)
+            .dst_access_mask(vk::AccessFlags::HOST_READ)
+            .buffer(buf)
+            .size(vk::WHOLE_SIZE)];
+        d.cmd_pipeline_barrier(cb, vk::PipelineStageFlags::COMPUTE_SHADER, vk::PipelineStageFlags::HOST, vk::DependencyFlags::empty(), &[], &bar, &[]);
+        d.end_command_buffer(cb).map_err(err("end"))?;
+        let fence = d.create_fence(&vk::FenceCreateInfo::default(), None).map_err(err("fence"))?;
+        let cbs = [cb];
+        let t0 = Instant::now();
+        d.queue_submit(g.queue, &[vk::SubmitInfo::default().command_buffers(&cbs)], fence).map_err(err("vkQueueSubmit"))?;
+        d.wait_for_fences(&[fence], true, 5_000_000_000).map_err(err("vkWaitForFences"))?;
+        let dt = t0.elapsed();
+
+        let malos = mem.datos().iter().enumerate().filter(|&(i, &v)| v != (i as u32).wrapping_mul(2).wrapping_add(1)).count();
+        println!("{}: {} enteros en memoria compartida, {:.2} ms en la GPU, {} incorrectos", g.name(), N, dt.as_secs_f64() * 1e3, malos);
+
+        d.destroy_fence(fence, None);
+        d.destroy_command_pool(cp, None);
+        d.destroy_descriptor_pool(pool, None);
+        d.destroy_pipeline(pipe, None);
+        d.destroy_pipeline_layout(pl, None);
+        d.destroy_descriptor_set_layout(dsl, None);
+        d.destroy_shader_module(sm, None);
+        d.destroy_buffer(buf, None);
+        d.free_memory(dm, None);
+        if malos != 0 {
+            return Err(format!("{malos} resultados incorrectos"));
+        }
+    }
+    Ok(())
+}
