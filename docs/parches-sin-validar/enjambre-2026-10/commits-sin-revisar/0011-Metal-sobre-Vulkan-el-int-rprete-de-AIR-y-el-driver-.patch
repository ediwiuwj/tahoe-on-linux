+        50 => F::R16_SINT,
+        51 => F::R16_UNORM,
+        52 => F::R16_SNORM,
+        53 => F::R16_SFLOAT,
+        54 => F::B10G11R11_UFLOAT_PACK32,
+        55 => F::E5B9G9R9_UFLOAT_PACK32,
+        _ => return None,
+    })
+}
