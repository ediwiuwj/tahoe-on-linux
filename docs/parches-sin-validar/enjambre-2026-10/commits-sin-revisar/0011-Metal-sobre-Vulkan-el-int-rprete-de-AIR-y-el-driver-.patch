@@ -0,0 +1,694 @@
+//! Traducción de AIR (Metal) a SPIR-V (Vulkan) para la GPU del PC.
+//!
+//! Decisiones, pensadas para GPUs como la Haswell (sin enteros de 64 ni 16 bits, sin half, sin
+//! buffer_device_address):
+//! - Tipos: i1 → bool; i8/i16/i32 → u32 (con extensión de ceros: tras cada operación se recortan los bits); i64 → los
+//!   32 bits bajos (índices y desplazamientos); half y float → float de 32 bits (al bajar a half se redondea con
+//!   OpQuantizeToF16 para dar el mismo resultado).
+//! - Memoria: un puntero de Metal es «base + desplazamiento en bytes». Las bases son los buffers (un arreglo de
+//!   palabras de 32 bits por binding), la memoria privada de cada alloca, la de threadgroup y los datos constantes del
+//!   módulo. Cargas y guardados se componen de palabras (con desplazamientos para 8 y 16 bits y atómicos al guardar
+//!   trozos de palabra en memoria compartida).
+//! - Control de flujo: una función de un solo bloque se emite tal cual; con varios, como una máquina de estados (un
+//!   bucle con un switch sobre el bloque siguiente), que siempre es SPIR-V estructurado válido. Los valores que pasan
+//!   de un bloque a otro y los phi van por variables.
+//! - Function constants: antes de traducir se pliegan (ver `fc` y `sccp`) y solo se emiten los bloques alcanzables.
+//!
+//! Recursos (conjunto 0): buffer N de Metal → binding N; textura N → 32 + N (160 + N si se escribe en ella); sampler
+//! N → 192 + N; los samplers constantes del shader (constexpr) → 208 en adelante (con su estado en el enlace).
+
+use std::collections::HashMap;
+
+use rspirv::binary::Assemble;
+use rspirv::dr::{Builder, Operand};
+use rspirv::spirv::{self, BuiltIn, Capability, Decoration, Dim, ExecutionMode, ExecutionModel, FunctionControl, ImageFormat, ImageOperands, MemorySemantics, Scope, SelectionControl, StorageClass, Word};
+
+use super::interp::{self, Memoria, Mem, V};
+use super::ir::{BinOp, CastOp, Function, Inst, Module, Type, TypeId, ValueId, ValueKind};
+use super::{fc, inline, layout, sccp, Descripcion, Entrada, Etapa};
+
+pub type Res<T> = Result<T, String>;
+
+pub const BIND_TEXTURA: u32 = 32;
+pub const BIND_TEXTURA_ESCRITURA: u32 = 160;
+pub const BIND_SAMPLER: u32 = 192;
+pub const BIND_SAMPLER_FIJO: u32 = 208;
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Recurso {
+    /// Buffer de Metal (StorageBuffer de palabras); `escritura` si el shader escribe en él.
+    Buffer { indice: u32, escritura: bool },
+    /// Textura que se muestrea o lee (imagen muestreada).
+    Textura { indice: u32, dim: Dim, arreglo: bool },
+    /// Textura en la que se escribe (imagen de almacenamiento).
+    TexturaEscritura { indice: u32, dim: Dim, arreglo: bool },
+    Sampler { indice: u32 },
+    /// Sampler constante del shader: el estado de 64 bits de Metal (filtros, direcciones...).
+    SamplerFijo { estado: [u64; 2] },
+}
+
+#[derive(Debug, Clone)]
+pub struct Enlace {
+    pub binding: u32,
+    pub recurso: Recurso,
+}
+
+#[derive(Debug, Clone)]
+pub struct Traduccion {
+    pub spirv: Vec<u32>,
+    pub etapa: Etapa,
+    pub enlaces: Vec<Enlace>,
+    /// Varyings (nombre de Metal → location) que escribe un vertex shader o lee un fragment shader.
+    pub varyings: Vec<(String, u32)>,
+    /// Atributos de vértice: (índice de atributo de Metal, location, tipo LLVM legible).
+    pub atributos: Vec<(u32, u32, String)>,
+    /// Salidas de color de un fragment shader: índice de render target.
+    pub colores: Vec<u32>,
+    pub bloques: usize,
+    pub maquina_de_estados: bool,
+    /// Usa operaciones de subgrupo (SIMD-group de Metal): el pipeline pide subgrupos de 32 como en Apple.
+    pub subgrupos: bool,
+}
+
+#[derive(Default, Clone)]
+pub struct Opciones {
+    /// Valores de las function constants (índice → valor).
+    pub constantes: HashMap<u32, V>,
+    /// Locations de los varyings por nombre (las del vertex shader, para enlazar el fragment).
+    pub varyings: HashMap<String, u32>,
+    /// Descriptor set de los recursos (en un pipeline de render, uno por etapa: en Metal el buffer 0 del vertex shader
+    /// y el del fragment shader son distintos).
+    pub set: u32,
+}
+
+// ---------------------------------------------------------------- valores traducidos
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+enum Base {
+    Buf(u32),
+    /// Memoria de threadgroup que llega como argumento (índice de Metal).
+    WgArg(u32),
+    Priv(ValueId),
+    Glob(usize),
+    Wg(usize),
+    Nula,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+enum Off {
+    C(i64),
+    Id(Word),
+}
+
+#[derive(Debug, Clone, PartialEq)]
+enum TV {
+    Id(Word),
+    C(V),
+    Ptr(Base, Off),
+    Tex(u32),
+    Smp(Smp),
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+enum Smp {
+    Arg(u32),
+    Fijo(usize),
+    Lectura,
+}
+
+struct Tr<'a> {
+    m: &'a Module,
+    f: &'a Function,
+    an: &'a sccp::Analisis,
+    mem: &'a Memoria,
+    ent: &'a Entrada,
+    op: &'a Opciones,
+    b: Builder,
+    glsl: Word,
+    t_void: Word,
+    t_bool: Word,
+    t_u32: Word,
+    t_i32: Word,
+    t_f32: Word,
+    tcache: HashMap<TypeId, Word>,
+    vcache: HashMap<(Word, u32), Word>,
+    pcache: HashMap<(StorageClass, Word), Word>,
+    acache: HashMap<(Word, u32), Word>,
+    ccache: HashMap<(Word, u32), Word>,
+    vals: Vec<Option<TV>>,
+    // recursos
+    buffers: HashMap<u32, Word>,
+    buffers_escritos: Vec<u32>,
+    texturas: HashMap<(u32, bool), (Word, Word)>,
+    samplers: HashMap<Smp, Word>,
+    t_sampler: Word,
+    enlaces: Vec<Enlace>,
+    interfaz: Vec<Word>,
+    builtins: HashMap<BuiltIn, (Word, Word)>,
+    // memoria privada, de threadgroup y constante
+    privadas: HashMap<ValueId, Word>,
+    globales: HashMap<usize, Word>,
+    // control de flujo
+    multi: bool,
+    /// control de flujo estructurado (si no, máquina de estados)
+    estructurado: bool,
+    /// `bloque` se para antes del terminador (lo emite el estructurador)
+    sin_terminador: bool,
+    /// destino de las salidas de varios niveles del estructurador
+    var_destino: Word,
+    n_lazos: u32,
+    cabeceras_lazo: Vec<Word>,
+    vars: HashMap<ValueId, Word>,
+    var_estado: Word,
+    etiquetas: HashMap<usize, Word>,
+    sel_merge: Word,
+    // salidas
+    salidas: Vec<(Word, Descripcion)>,
+    varyings_out: Vec<(String, u32)>,
+    atributos: Vec<(u32, u32, String)>,
+    colores: Vec<u32>,
+    grid: Option<Word>,
+    usa_demote: bool,
+    usa_subgrupos: bool,
+    /// Capacidades que piden los recursos usados (Sampled1D, SampledCubeArray...).
+    capacidades: Vec<Capability>,
+    /// descriptor set de los recursos (Opciones::set)
+    set: u32,
+    /// Base de los punteros que cruzan bloques (la variable guarda solo el desplazamiento).
+    bases: HashMap<ValueId, Base>,
+    /// Valores que son siempre la misma textura o sampler (phi/select con la textura nula): se resuelven sin variable.
+    fijos: HashMap<ValueId, TV>,
+    /// Tamaño del grupo de un kernel (constantes de especialización 0, 1 y 2).
+    wg_size: Option<Word>,
+    t_bloque: Option<Word>,
+    /// Tipo de muestra de cada textura (0 real, 1 sin signo, 2 con signo), del tipo de su argumento.
+    tipos_textura: HashMap<u32, u8>,
+    wg_args: HashMap<u32, Word>,
+}
+
+fn espacio(m: &Module, t: TypeId) -> Option<u32> {
+    match m.types.get(t)? {
+        Type::Ptr(a) => Some(*a),
+        _ => None,
+    }
+}
+
+impl<'a> Tr<'a> {
+    // ------------------------------------------------------------ tipos y constantes
+
+    fn vec_t(&mut self, e: Word, n: u32) -> Word {
+        if n == 1 {
+            return e;
+        }
+        if let Some(&t) = self.vcache.get(&(e, n)) {
+            return t;
+        }
+        let t = self.b.type_vector(e, n);
+        self.vcache.insert((e, n), t);
+        t
+    }
+
+    fn ptr_t(&mut self, sc: StorageClass, t: Word) -> Word {
+        if let Some(&p) = self.pcache.get(&(sc, t)) {
+            return p;
+        }
+        let p = self.b.type_pointer(None, sc, t);
+        self.pcache.insert((sc, t), p);
+        p
+    }
+
+    fn arr_t(&mut self, e: Word, n: u32) -> Word {
+        if let Some(&t) = self.acache.get(&(e, n)) {
+            return t;
+        }
+        let len = self.cu(n);
+        let t = self.b.type_array(e, len);
+        self.acache.insert((e, n), t);
+        t
+    }
+
+    /// Tipo SPIR-V de un tipo LLVM (los punteros no tienen: se tratan aparte).
+    fn ty(&mut self, t: TypeId) -> Res<Word> {
+        if let Some(&w) = self.tcache.get(&t) {
+            return Ok(w);
+        }
+        let w = match self.m.types[t].clone() {
+            Type::Void => self.t_void,
+            Type::Int(1) => self.t_bool,
+            Type::Int(_) => self.t_u32,
+            Type::Half | Type::BFloat | Type::Float => self.t_f32,
+            Type::Vector(n, e) => {
+                let e = self.ty(e)?;
+                self.vec_t(e, n)
+            }
+            Type::Array(n, e) => {
+                let e = self.ty(e)?;
+                self.arr_t(e, n as u32)
+            }
+            Type::Struct { elems, .. } => {
+                let es: Vec<Word> = elems.iter().map(|&e| self.ty(e)).collect::<Res<_>>()?;
+                self.b.type_struct(es)
+            }
+            other => return Err(format!("tipo sin traducción: {other:?}")),
+        };
+        self.tcache.insert(t, w);
+        Ok(w)
+    }
+
+    fn cu(&mut self, v: u32) -> Word {
+        let t = self.t_u32;
+        self.c32(t, v)
+    }
+    fn cf(&mut self, v: f32) -> Word {
+        let t = self.t_f32;
+        self.c32(t, v.to_bits())
+    }
+    fn c32(&mut self, t: Word, v: u32) -> Word {
+        if let Some(&c) = self.ccache.get(&(t, v)) {
+            return c;
+        }
+        let c = self.b.constant_bit32(t, v);
+        self.ccache.insert((t, v), c);
+        c
+    }
+    fn cbool(&mut self, v: bool) -> Word {
+        let t = self.t_bool;
+        if v { self.b.constant_true(t) } else { self.b.constant_false(t) }
+    }
+
+    /// Una constante como SPIR-V del tipo LLVM `t`.
+    fn constante(&mut self, t: TypeId, v: &V) -> Res<Word> {
+        let st = self.ty(t)?;
+        Ok(match (&self.m.types[t].clone(), v) {
+            (_, V::Undef) => self.b.constant_null(st),
+            (Type::Int(1), V::Int(_, x)) => self.cbool(*x != 0),
+            (Type::Int(_), V::Int(_, x)) => self.cu(*x as u32),
+            (Type::Half | Type::BFloat | Type::Float, V::Real(_, x)) => self.cf(*x as f32),
+            (Type::Vector(_, e), V::Vec(xs)) | (Type::Array(_, e), V::Agg(xs)) => {
+                let e = *e;
+                let cs: Vec<Word> = xs.iter().map(|x| self.constante(e, x)).collect::<Res<_>>()?;
+                self.b.constant_composite(st, cs)
+            }
+            (Type::Struct { elems, .. }, V::Agg(xs)) => {
+                let elems = elems.clone();
+                let cs: Vec<Word> = elems.iter().zip(xs).map(|(&e, x)| self.constante(e, x)).collect::<Res<_>>()?;
+                self.b.constant_composite(st, cs)
+            }
+            (ty, v) => return Err(format!("constante {v:?} de tipo {ty:?}")),
+        })
+    }
+
+    // ------------------------------------------------------------ valores
+
+    fn tv(&mut self, v: ValueId) -> Res<TV> {
+        if v >= 1_000_000_000 {
+            return Ok(TV::C(V::Undef)); // argumento de metadatos
+        }
+        if let Some(x) = self.fijos.get(&v) {
+            return Ok(x.clone());
+        }
+        if let Some(Some(c)) = self.an.constantes.get(v) {
+            return Ok(match c {
+                V::Ptr(Mem::Global(g), off) => TV::Ptr(self.base_global(*g), Off::C(*off)),
+                V::Ptr(Mem::Null, _) => TV::Ptr(Base::Nula, Off::C(0)),
+                other => TV::C(other.clone()),
+            });
+        }
+        if let Some(Some(x)) = self.vals.get(v) {
+            return Ok(x.clone());
+        }
+        if let Some(&var) = self.vars.get(&v) {
+            // valor de otro bloque: por su variable
+            let t = self.f.values[v].ty;
+            if espacio(self.m, t).is_some() {
+                let base = *self.bases.get(&v).ok_or_else(|| {
+                    let d = |v: ValueId| match self.f.values[v].kind {
+                        ValueKind::Inst(b, k) => format!("{:?}", self.f.blocks[b].insts[k].inst),
+                        ref o => format!("{o:?}"),
+                    };
+                    let mut def = d(v);
+                    if let ValueKind::Inst(b, k) = self.f.values[v].kind {
+                        if let Inst::Phi { incoming } = &self.f.blocks[b].insts[k].inst {
+                            for (x, _) in incoming {
+                                def += &format!("; %{x} = {}", d(*x));
+                            }
+                        }
+                    }
+                    format!("puntero que cruza bloques sin base conocida: %{v} = {def}")
+                })?;
+                let o = self.b.load(self.t_u32, None, var, None, []).map_err(|e| format!("{e:?}"))?;
+                return Ok(TV::Ptr(base, Off::Id(o)));
+            }
+            let st = self.ty(t)?;
+            let x = self.b.load(st, None, var, None, []).map_err(|e| format!("{e:?}"))?;
+            return Ok(TV::Id(x));
+        }
+        Err(format!("valor {v} sin definir (tipo {})", super::tipo(self.m, self.f.values[v].ty)))
+    }
+
+    /// El valor como id de SPIR-V (materializa constantes).
+    fn id(&mut self, v: ValueId) -> Res<Word> {
+        let x = self.tv(v)?;
+        let t = self.f.values.get(v).map(|x| x.ty).unwrap_or(0);
+        self.id_de(&x, t)
+    }
+
+    fn id_de(&mut self, x: &TV, t: TypeId) -> Res<Word> {
+        match x {
+            TV::Id(w) => Ok(*w),
+            TV::C(c) => self.constante(t, c),
+            other => Err(format!("se esperaba un valor y es {other:?}")),
+        }
+    }
+
+    fn base_global(&self, g: usize) -> Base {
+        if self.m.globals[g].addrspace == 3 { Base::Wg(g) } else { Base::Glob(g) }
+    }
+
+    /// Variable global (de módulo), aunque haya una función seleccionada: rspirv la pondría en el bloque actual.
+    fn var_global(&mut self, pt: Word, sc: StorageClass, init: Option<Word>) -> Word {
+        let id = self.b.id();
+        let mut ops = vec![Operand::StorageClass(sc)];
+        if let Some(i) = init {
+            ops.push(Operand::IdRef(i));
+        }
+        let inst = rspirv::dr::Instruction::new(spirv::Op::Variable, Some(pt), Some(id), ops);
+        self.b.module_mut().types_global_values.push(inst);
+        id
+    }
+
+    fn ext(&mut self, t: Word, op: u32, args: &[Word]) -> Word {
+        let ops: Vec<Operand> = args.iter().map(|&a| Operand::IdRef(a)).collect();
+        self.b.ext_inst(t, None, self.glsl, op, ops).unwrap()
+    }
+
+    // ------------------------------------------------------------ memoria
+
+    /// Variable de palabras de una base (la crea la primera vez).
+    fn var_base(&mut self, b: Base) -> Res<(Word, StorageClass)> {
+        match b {
+            Base::Buf(i) => {
+                if let Some(&v) = self.buffers.get(&i) {
+                    return Ok((v, StorageClass::StorageBuffer));
+                }
+                // un solo tipo de bloque para todos los buffers (rspirv reutiliza el arreglo: decorarlo una vez)
+                let st = match self.t_bloque {
+                    Some(st) => st,
+                    None => {
+                        let rt = self.b.type_runtime_array(self.t_u32);
+                        self.b.decorate(rt, Decoration::ArrayStride, [Operand::LiteralBit32(4)]);
+                        let st = self.b.type_struct([rt]);
+                        self.b.decorate(st, Decoration::Block, []);
+                        self.b.member_decorate(st, 0, Decoration::Offset, [Operand::LiteralBit32(0)]);
+                        self.t_bloque = Some(st);
+                        st
+                    }
+                };
+                let pt = self.ptr_t(StorageClass::StorageBuffer, st);
+                let v = self.var_global(pt, StorageClass::StorageBuffer, None);
+                self.b.decorate(v, Decoration::DescriptorSet, [Operand::LiteralBit32(self.set)]);
+                self.b.decorate(v, Decoration::Binding, [Operand::LiteralBit32(i)]);
+                self.buffers.insert(i, v);
+                self.interfaz.push(v);
+                Ok((v, StorageClass::StorageBuffer))
+            }
+            Base::WgArg(i) => {
+                if let Some(&v) = self.wg_args.get(&i) {
+                    return Ok((v, StorageClass::Workgroup));
+                }
+                // tamaño en palabras: constante de especialización 16 + índice (la fija la app con
+                // setThreadgroupMemoryLength; por omisión 4096 palabras = 16 KB)
+                let n = self.b.spec_constant_bit32(self.t_u32, 4096);
+                self.b.decorate(n, Decoration::SpecId, [Operand::LiteralBit32(16 + i)]);
+                let at = self.b.type_array(self.t_u32, n);
+                let pt = self.ptr_t(StorageClass::Workgroup, at);
+                let v = self.var_global(pt, StorageClass::Workgroup, None);
+                self.wg_args.insert(i, v);
+                self.interfaz.push(v);
+                Ok((v, StorageClass::Workgroup))
+            }
+            Base::Priv(a) => self.privadas.get(&a).map(|&v| (v, StorageClass::Function)).ok_or_else(|| "alloca sin variable".to_string()),
+            Base::Wg(g) | Base::Glob(g) => {
+                let sc = if matches!(b, Base::Wg(_)) { StorageClass::Workgroup } else { StorageClass::Private };
+                if let Some(&v) = self.globales.get(&g) {
+                    return Ok((v, sc));
+                }
+                let gl = &self.m.globals[g];
+                let n = layout::size(self.m, gl.ty).div_ceil(4).max(1) as u32;
+                let at = self.arr_t(self.t_u32, n);
+                let pt = self.ptr_t(sc, at);
+                let init = if sc == StorageClass::Private {
+                    // datos constantes: los bytes de la memoria (ya especializada)
+                    let bytes = self.mem.globales.get(g).cloned().unwrap_or_default();
+                    let ws: Vec<Word> = (0..n as usize)
+                        .map(|k| {
+                            let mut w = [0u8; 4];
+                            for (j, x) in w.iter_mut().enumerate() {
+                                *x = bytes.get(k * 4 + j).copied().unwrap_or(0);
+                            }
+                            u32::from_le_bytes(w)
+                        })
+                        .collect::<Vec<_>>()
+                        .into_iter()
+                        .map(|w| self.cu(w))
+                        .collect();
+                    Some(self.b.constant_composite(at, ws))
+                } else {
+                    None
+                };
+                let v = self.var_global(pt, sc, init);
+                self.globales.insert(g, v);
+                self.interfaz.push(v);
+                Ok((v, sc))
+            }
+            Base::Nula => Err("acceso a un puntero nulo".into()),
+        }
+    }
+
+    fn off_mas(&mut self, o: Off, n: i64) -> Off {
+        match o {
+            Off::C(c) => Off::C(c + n),
+            Off::Id(id) => {
+                if n == 0 {
+                    return Off::Id(id);
+                }
+                let c = self.cu(n as u32);
+                Off::Id(self.b.i_add(self.t_u32, None, id, c).unwrap())
+            }
+        }
+    }
+
+    fn off_id(&mut self, o: Off) -> Word {
+        match o {
+            Off::C(c) => self.cu(c as u32),
+            Off::Id(id) => id,
+        }
+    }
+
+    /// Puntero a la palabra que contiene el byte `o`.
+    fn palabra(&mut self, b: Base, o: Off) -> Res<(Word, StorageClass)> {
+        let (var, sc) = self.var_base(b)?;
+        let idx = match o {
+            Off::C(c) => self.cu((c >> 2) as u32),
+            Off::Id(id) => {
+                let dos = self.cu(2);
+                self.b.shift_right_logical(self.t_u32, None, id, dos).unwrap()
+            }
+        };
+        let pt = self.ptr_t(sc, self.t_u32);
+        let p = if sc == StorageClass::StorageBuffer {
+            let cero = self.cu(0);
+            self.b.access_chain(pt, None, var, [cero, idx]).unwrap()
+        } else {
+            self.b.access_chain(pt, None, var, [idx]).unwrap()
+        };
+        Ok((p, sc))
+    }
+
+    /// Desplazamiento en bits dentro de la palabra (para trozos de 8 o 16 bits).
+    fn bits_en_palabra(&mut self, o: Off) -> Word {
+        match o {
+            Off::C(c) => self.cu(((c & 3) * 8) as u32),
+            Off::Id(id) => {
+                let tres = self.cu(3);
+                let a = self.b.bitwise_and(self.t_u32, None, id, tres).unwrap();
+                self.b.shift_left_logical(self.t_u32, None, a, tres).unwrap() // ×8
+            }
+        }
+    }
+
+    fn cargar(&mut self, b: Base, o: Off, t: TypeId) -> Res<Word> {
+        if b == Base::Nula {
+            // puntero nulo (buffer ausente en esta variante): 0; solo en caminos que el shader no toma
+            let st = self.ty(t)?;
+            return Ok(self.b.constant_null(st));
+        }
+        let tipo = self.m.types[t].clone();
+        match tipo {
+            Type::Int(32) | Type::Int(64) | Type::Float => {
+                let (p, _) = self.palabra(b, o)?;
+                let w = self.b.load(self.t_u32, None, p, None, []).unwrap();
+                Ok(if matches!(tipo, Type::Float) { self.b.bitcast(self.t_f32, None, w).unwrap() } else { w })
+            }
+            Type::Int(n) if n < 32 => {
+                let (p, _) = self.palabra(b, o)?;
+                let w = self.b.load(self.t_u32, None, p, None, []).unwrap();
+                let sh = self.bits_en_palabra(o);
+                let x = self.b.shift_right_logical(self.t_u32, None, w, sh).unwrap();
+                let mk = self.cu(if n <= 8 { 0xff } else { 0xffff });
+                let x = self.b.bitwise_and(self.t_u32, None, x, mk).unwrap();
+                if n == 1 {
+                    let cero = self.cu(0);
+                    return Ok(self.b.i_not_equal(self.t_bool, None, x, cero).unwrap());
+                }
+                Ok(x)
+            }
+            Type::BFloat => {
+                let (p, _) = self.palabra(b, o)?;
+                let w = self.b.load(self.t_u32, None, p, None, []).unwrap();
+                let sh = self.bits_en_palabra(o);
+                let x = self.b.shift_right_logical(self.t_u32, None, w, sh).unwrap();
+                let c16 = self.cu(16);
+                let x = self.b.shift_left_logical(self.t_u32, None, x, c16).unwrap();
+                Ok(self.b.bitcast(self.t_f32, None, x).unwrap())
+            }
+            Type::Half => {
+                let (p, _) = self.palabra(b, o)?;
+                let w = self.b.load(self.t_u32, None, p, None, []).unwrap();
+                let sh = self.bits_en_palabra(o);
+                let x = self.b.shift_right_logical(self.t_u32, None, w, sh).unwrap();
+                let v2 = self.vec_t(self.t_f32, 2);
+                let h = self.ext(v2, 62, &[x]); // UnpackHalf2x16
+                Ok(self.b.composite_extract(self.t_f32, None, h, [0]).unwrap())
+            }
+            Type::Vector(n, e) => {
+                let es = layout::elem_size(self.m, t) as i64;
+                let mut cs = Vec::with_capacity(n as usize);
+                for k in 0..n as i64 {
+                    let ok = self.off_mas(o, k * es);
+                    cs.push(self.cargar(b, ok, e)?);
+                }
+                let st = self.ty(t)?;
+                Ok(self.b.composite_construct(st, None, cs).unwrap())
+            }
+            Type::Array(n, e) => {
+                let es = layout::size(self.m, e) as i64;
+                let mut cs = Vec::with_capacity(n as usize);
+                for k in 0..n as i64 {
+                    let ok = self.off_mas(o, k * es);
+                    cs.push(self.cargar(b, ok, e)?);
+                }
+                let st = self.ty(t)?;
+                Ok(self.b.composite_construct(st, None, cs).unwrap())
+            }
+            Type::Struct { elems, .. } => {
+                let offs = layout::offsets(self.m, t);
+                let mut cs = Vec::with_capacity(elems.len());
+                for (&e, off) in elems.iter().zip(offs) {
+                    let ok = self.off_mas(o, off as i64);
+                    cs.push(self.cargar(b, ok, e)?);
+                }
+                let st = self.ty(t)?;
+                Ok(self.b.composite_construct(st, None, cs).unwrap())
+            }
+            other => Err(format!("load de {other:?}")),
+        }
+    }
+
+    fn guardar(&mut self, b: Base, o: Off, t: TypeId, v: Word) -> Res<()> {
+        if b == Base::Nula {
+            return Ok(());
+        }
+        if let Base::Buf(i) = b {
+            if !self.buffers_escritos.contains(&i) {
+                self.buffers_escritos.push(i);
+            }
+        }
+        let tipo = self.m.types[t].clone();
+        match tipo {
+            Type::Int(32) | Type::Int(64) | Type::Float => {
+                let (p, _) = self.palabra(b, o)?;
+                let w = if matches!(tipo, Type::Float) { self.b.bitcast(self.t_u32, None, v).unwrap() } else { v };
+                self.b.store(p, w, None, []).unwrap();
+                Ok(())
+            }
+            Type::Int(n) if n < 32 => {
+                let x = if n == 1 {
+                    let (uno, cero) = (self.cu(1), self.cu(0));
+                    self.b.select(self.t_u32, None, v, uno, cero).unwrap()
+                } else {
+                    v
+                };
+                self.guardar_trozo(b, o, x, if n <= 8 { 0xff } else { 0xffff })
+            }
+            Type::BFloat => {
+                let r = self.a_bf16(v, 1, self.t_f32);
+                let u = self.b.bitcast(self.t_u32, None, r).unwrap();
+                let c16 = self.cu(16);
+                let bits = self.b.shift_right_logical(self.t_u32, None, u, c16).unwrap();
+                self.guardar_trozo(b, o, bits, 0xffff)
+            }
+            Type::Half => {
+                let cero = self.cf(0.0);
+                let v2 = self.vec_t(self.t_f32, 2);
+                let par = self.b.composite_construct(v2, None, [v, cero]).unwrap();
+                let bits = self.ext(self.t_u32, 58, &[par]); // PackHalf2x16
+                self.guardar_trozo(b, o, bits, 0xffff)
+            }
+            Type::Vector(..) | Type::Array(..) => {
+                let (n, e) = match tipo {
+                    Type::Vector(n, e) => (n as u64, e),
+                    Type::Array(n, e) => (n, e),
+                    _ => unreachable!(),
+                };
+                let es = if matches!(tipo, Type::Vector(..)) { layout::elem_size(self.m, t) } else { layout::size(self.m, e) } as i64;
+                let st_e = self.ty(e)?;
+                for k in 0..n as i64 {
+                    let x = self.b.composite_extract(st_e, None, v, [k as u32]).unwrap();
+                    let ok = self.off_mas(o, k * es);
+                    self.guardar(b, ok, e, x)?;
+                }
+                Ok(())
+            }
+            Type::Struct { elems, .. } => {
+                let offs = layout::offsets(self.m, t);
+                for (k, (&e, off)) in elems.iter().zip(offs).enumerate() {
+                    let st_e = self.ty(e)?;
+                    let x = self.b.composite_extract(st_e, None, v, [k as u32]).unwrap();
+                    let ok = self.off_mas(o, off as i64);
+                    self.guardar(b, ok, e, x)?;
+                }
+                Ok(())
+            }
+            other => Err(format!("store de {other:?}")),
+        }
+    }
+
+    /// Guarda los bits bajos de `x` (máscara `mk`) en su sitio dentro de la palabra: en memoria compartida con dos
+    /// atómicos (borrar y poner), para no pisar los bytes vecinos que escriban otros hilos.
+    fn guardar_trozo(&mut self, b: Base, o: Off, x: Word, mk: u32) -> Res<()> {
+        let (p, sc) = self.palabra(b, o)?;
+        let sh = self.bits_en_palabra(o);
+        let mkc = self.cu(mk);
+        let xm = self.b.bitwise_and(self.t_u32, None, x, mkc).unwrap();
+        let val = self.b.shift_left_logical(self.t_u32, None, xm, sh).unwrap();
+        let mk_sh = self.b.shift_left_logical(self.t_u32, None, mkc, sh).unwrap();
+        let inv = self.b.not(self.t_u32, None, mk_sh).unwrap();
+        if sc == StorageClass::Function || sc == StorageClass::Private {
+            let w = self.b.load(self.t_u32, None, p, None, []).unwrap();
+            let w = self.b.bitwise_and(self.t_u32, None, w, inv).unwrap();
+            let w = self.b.bitwise_or(self.t_u32, None, w, val).unwrap();
+            self.b.store(p, w, None, []).unwrap();
+        } else {
+            let scope = self.cu(if sc == StorageClass::Workgroup { Scope::Workgroup as u32 } else { Scope::Device as u32 });
+            let sem = self.cu(0);
+            self.b.atomic_and(self.t_u32, None, p, scope, sem, inv).unwrap();
+            self.b.atomic_or(self.t_u32, None, p, scope, sem, val).unwrap();
+        }
+        Ok(())
+    }
+}
+
+pub use self::traducir_impl::traducir;
+#[path = "spirv_inst.rs"]
+mod traducir_impl;
diff --git a/tahoe-gpu/src/air/spirv_estructura.rs b/tahoe-gpu/src/air/spirv_estructura.rs
new file mode 100644
index 0000000..ede8e59
--- /dev/null
+++ b/tahoe-gpu/src/air/spirv_estructura.rs
@@ -0,0 +1,385 @@
+//! Control de flujo estructurado: el CFG de LLVM (reducible) pasa a bucles y selecciones de SPIR-V con el algoritmo
+//! de «Beyond Relooper» (N. Ramsey, ICFP 2022), en vez de la máquina de estados (bucle + switch sobre el bloque).
+//!
+//! Con la máquina de estados los hilos de un grupo que llegan a una barrera por caminos de distinta longitud no
+//! reconvergen y la GPU se cuelga (Intel cuenta las barreras por hilo de hardware, no por carril); los shaders grandes
+//! además hacen fallar al compilador de Mesa. Aquí los hilos reconvergen en los bloques de fusión.
+//!
+//! Esquema: árbol de dominadores; un nodo con dos o más aristas hacia delante es de «fusión» y se emite tras un
+//! bloque que lo envuelve (las ramas que llegan a él salen de ese bloque); una cabecera de bucle abre un bucle (las
+//! aristas hacia atrás son «continue»). Los bloques se emiten como bucles de una vuelta. SPIR-V solo deja salir del
+//! bucle más interno, así que una salida a varios niveles guarda su destino en una variable y va saliendo bucle a
+//! bucle; en la fusión de cada uno se mira si ha llegado.
+
+use super::*;
+
+/// El CFG vivo (aristas que SCCP no descarta) con orden, dominadores y bucles.
+pub(super) struct Cfg {
+    suc: Vec<Vec<usize>>,
+    /// posición en el postorden inverso (usize::MAX: inalcanzable)
+    rpo: Vec<usize>,
+    /// hijos en el árbol de dominadores, en postorden inverso
+    hijos: Vec<Vec<usize>>,
+    cabecera: Vec<bool>,
+    fusion: Vec<bool>,
+}
+
+impl Cfg {
+    /// Analiza la función; error si el CFG no es reducible (entonces se usa la máquina de estados).
+    pub(super) fn nuevo(f: &Function, an: &sccp::Analisis) -> Res<Cfg> {
+        let n = f.blocks.len();
+        let mut suc = vec![Vec::new(); n];
+        for &b in &an.orden {
+            suc[b] = sucesores_vivos(f, an, b);
+        }
+        let mut rpo = vec![usize::MAX; n];
+        for (k, &b) in an.orden.iter().enumerate() {
+            rpo[b] = k;
+        }
+        let mut pred = vec![Vec::new(); n];
+        for &b in &an.orden {
+            for &s in &suc[b] {
+                pred[s].push(b);
+            }
+        }
+        // dominadores (Cooper, Harvey y Kennedy)
+        let entrada = *an.orden.first().ok_or("función sin bloques")?;
+        let mut idom = vec![usize::MAX; n];
+        idom[entrada] = entrada;
+        let mut cambio = true;
+        while cambio {
+            cambio = false;
+            for &b in an.orden.iter().skip(1) {
+                let mut nuevo = usize::MAX;
+                for &p in &pred[b] {
+                    if idom[p] == usize::MAX {
+                        continue;
+                    }
+                    nuevo = if nuevo == usize::MAX { p } else { interseccion(&idom, &rpo, p, nuevo) };
+                }
+                if nuevo != usize::MAX && idom[b] != nuevo {
+                    idom[b] = nuevo;
+                    cambio = true;
+                }
+            }
+        }
+        let domina = |a: usize, mut b: usize| -> bool {
+            loop {
+                if a == b {
+                    return true;
+                }
+                if b == entrada || idom[b] == usize::MAX {
+                    return false;
+                }
+                b = idom[b];
+            }
+        };
+        let mut hijos = vec![Vec::new(); n];
+        for &b in an.orden.iter().skip(1) {
+            hijos[idom[b]].push(b);
+        }
+        let mut cabecera = vec![false; n];
+        let mut adelante = vec![0usize; n];
+        for &b in &an.orden {
+            for &s in &suc[b] {
+                if rpo[s] <= rpo[b] {
+                    if !domina(s, b) {
+                        return Err("control de flujo irreducible".into());
+                    }
+                    cabecera[s] = true;
+                } else {
+                    adelante[s] += 1;
+                }
+            }
+        }
+        let fusion = adelante.iter().map(|&k| k >= 2).collect();
+        Ok(Cfg { suc, rpo, hijos, cabecera, fusion })
+    }
+}
+
+fn interseccion(idom: &[usize], rpo: &[usize], mut a: usize, mut b: usize) -> usize {
+    while a != b {
+        while rpo[a] > rpo[b] {
+            a = idom[a];
+        }
+        while rpo[b] > rpo[a] {
+            b = idom[b];
+        }
+    }
+    a
+}
+
+/// Sucesores por las aristas vivas (las condiciones constantes solo llevan a un lado).
+fn sucesores_vivos(f: &Function, an: &sccp::Analisis, b: usize) -> Vec<usize> {
+    let cte = |v: ValueId| an.constantes.get(v).cloned().flatten().and_then(|x| x.int());
+    let mut r = match f.blocks[b].insts.last().map(|i| &i.inst) {
+        Some(Inst::Br(t)) => vec![*t],
+        Some(Inst::CondBr { c, t, f: fl }) => match cte(*c) {
+            Some(1) => vec![*t],
+            Some(0) => vec![*fl],
+            _ => vec![*t, *fl],
+        },
+        Some(Inst::Switch { v, default, cases }) => match cte(*v) {
+            Some(x) => vec![cases.iter().find(|(c, _)| cte(*c) == Some(x)).map(|(_, b)| *b).unwrap_or(*default)],
+            None => {
+                let mut d = vec![*default];
+                d.extend(cases.iter().map(|(_, b)| *b));
+                d
+            }
+        },
+        _ => Vec::new(),
+    };
+    r.retain(|&s| an.alcanzables.get(s).copied().unwrap_or(false));
+    r
+}
+
+/// Un bucle de SPIR-V abierto: el de una cabecera (continue = volver a ella) o un bloque de una vuelta seguido del
+/// nodo de fusión `seguido_de` (salir = ir a ese nodo).
+struct Lazo {
+    cabecera: Option<usize>,
+    seguido_de: Option<usize>,
+    merge: Word,
+    cont: Word,
+    /// código de este lazo en la variable de destino: 2n salir, 2n+1 continuar
+    n: u32,
+    /// alguna salida de varios niveles pasa por aquí (en su fusión hay que mirar el destino)
+    pasan: bool,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Destino {
+    Salir,
+    Continuar,
+}
+
+impl Tr<'_> {
+    /// Emite el cuerpo de la función con control de flujo estructurado.
+    pub(super) fn emitir_estructurado(&mut self) -> Res<()> {
+        let cfg = Cfg::nuevo(self.f, self.an)?;
+        let entrada = self.an.orden[0];
+        let mut lazos = Vec::new();
+        self.arbol(&cfg, &mut lazos, entrada)?;
+        if self.b.selected_block().is_some() {
+            self.b.ret().unwrap();
+        }
+        Ok(())
+    }
+
+    /// doTree: el nodo `x` con lo que domina.
+    fn arbol(&mut self, cfg: &Cfg, lazos: &mut Vec<Lazo>, x: usize) -> Res<()> {
+        let mut ys: Vec<usize> = cfg.hijos[x].iter().copied().filter(|&y| cfg.fusion[y]).collect();
+        ys.sort_by_key(|&y| std::cmp::Reverse(cfg.rpo[y]));
+        if cfg.cabecera[x] {
+            self.abrir_lazo(lazos, Some(x), None);
+            self.dentro(cfg, lazos, x, &ys)?;
+            self.cerrar_lazo(lazos)?;
+            Ok(())
+        } else {
+            self.dentro(cfg, lazos, x, &ys)
+        }
+    }
+
+    /// nodeWithin: el código de `x` envuelto en un bloque por cada hijo de fusión (el de mayor orden, el de fuera).
+    fn dentro(&mut self, cfg: &Cfg, lazos: &mut Vec<Lazo>, x: usize, ys: &[usize]) -> Res<()> {
+        if let Some((&y, resto)) = ys.split_first() {
+            self.abrir_lazo(lazos, None, Some(y));
+            self.dentro(cfg, lazos, x, resto)?;
+            self.cerrar_lazo(lazos)?;
+            if self.b.selected_block().is_some() {
+                self.arbol(cfg, lazos, y)?;
+            }
+            return Ok(());
+        }
+        self.sin_terminador = true;
+        let r = self.bloque(x);
+        self.sin_terminador = false;
+        r?;
+        self.salida(cfg, lazos, x)
+    }
+
+    /// El terminador del bloque `x`.
+    fn salida(&mut self, cfg: &Cfg, lazos: &mut Vec<Lazo>, x: usize) -> Res<()> {
+        let f = self.f;
+        let term = &f.blocks[x].insts.last().ok_or("bloque vacío")?.inst;
+        let suc = &cfg.suc[x];
+        match term {
+            Inst::Ret(_) | Inst::Unreachable => return self.terminador(x, term),
+            _ if suc.len() == 1 || suc.iter().all(|&s| s == suc[0]) => {
+                let t = *suc.first().ok_or("salto sin destino vivo")?;
+                return self.ir_a(cfg, lazos, x, t);
+            }
+            Inst::CondBr { c, t, f: fl } => {
+                let cid = self.id(*c)?;
+                self.si(cfg, lazos, x, cid, *t, *fl)
+            }
+            Inst::Switch { v, default, cases } => {
+                // cadena de comparaciones (siempre estructurada y válida)
+                let xv = self.id(*v)?;
+                let mut casos: Vec<(u32, usize)> = Vec::new();
+                for (cv, b) in cases {
+                    let k = match self.tv(*cv)? {
+                        TV::C(V::Int(_, k)) => k as u32,
+                        _ => return Err("caso de switch no constante".into()),
+                    };
+                    casos.push((k, *b));
+                }
+                self.cadena_switch(cfg, lazos, x, xv, &casos, *default)
+            }
+            _ => Err("terminador desconocido".into()),
+        }
+    }
+
+    fn cadena_switch(&mut self, cfg: &Cfg, lazos: &mut Vec<Lazo>, x: usize, xv: Word, casos: &[(u32, usize)], defecto: usize) -> Res<()> {
+        let Some((&(k, t), resto)) = casos.split_first() else { return self.ir_a(cfg, lazos, x, defecto) };
+        let kc = self.cu(k);
+        let c = self.b.i_equal(self.t_bool, None, xv, kc).unwrap();
+        let (lt, lf, lm) = (self.b.id(), self.b.id(), self.b.id());
+        self.b.selection_merge(lm, SelectionControl::NONE).unwrap();
+        self.b.branch_conditional(c, lt, lf, []).unwrap();
+        self.b.begin_block(Some(lt)).unwrap();
+        self.ir_a(cfg, lazos, x, t)?;
+        let a = self.cerrar_rama(lm);
+        self.b.begin_block(Some(lf)).unwrap();
+        self.cadena_switch(cfg, lazos, x, xv, resto, defecto)?;
+        let b = self.cerrar_rama(lm);
+        self.fusion_de_seleccion(lm, a || b);
+        Ok(())
+    }
+
+    fn si(&mut self, cfg: &Cfg, lazos: &mut Vec<Lazo>, x: usize, c: Word, t: usize, fl: usize) -> Res<()> {
+        let (lt, lf, lm) = (self.b.id(), self.b.id(), self.b.id());
+        self.b.selection_merge(lm, SelectionControl::NONE).unwrap();
+        self.b.branch_conditional(c, lt, lf, []).unwrap();
+        self.b.begin_block(Some(lt)).unwrap();
+        self.ir_a(cfg, lazos, x, t)?;
+        let a = self.cerrar_rama(lm);
+        self.b.begin_block(Some(lf)).unwrap();
+        self.ir_a(cfg, lazos, x, fl)?;
+        let b = self.cerrar_rama(lm);
+        self.fusion_de_seleccion(lm, a || b);
+        Ok(())
+    }
+
+    /// Si la rama sigue abierta, salta a la fusión; dice si lo hizo.
+    fn cerrar_rama(&mut self, lm: Word) -> bool {
+        if self.b.selected_block().is_some() {
+            self.b.branch(lm).unwrap();
+            true
+        } else {
+            false
+        }
+    }
+
+    /// El bloque de fusión de una selección: abierto si alguna rama llega, si no inalcanzable.
+    fn fusion_de_seleccion(&mut self, lm: Word, alcanzable: bool) {
+        self.b.begin_block(Some(lm)).unwrap();
+        if !alcanzable {
+            self.b.unreachable().unwrap();
+        }
+    }
+
+    /// doBranch: de `x` a `t` (los phi de `t` reciben su valor antes).
+    fn ir_a(&mut self, cfg: &Cfg, lazos: &mut Vec<Lazo>, x: usize, t: usize) -> Res<()> {
+        self.copiar_phis(x, t)?;
+        if cfg.rpo[t] <= cfg.rpo[x] {
+            let i = lazos.iter().rposition(|l| l.cabecera == Some(t)).ok_or("continue a un bucle que no está abierto")?;
+            self.escapar(lazos, i, Destino::Continuar);
+            Ok(())
+        } else if cfg.fusion[t] {
+            let i = lazos.iter().rposition(|l| l.seguido_de == Some(t)).ok_or("salto a una fusión sin bloque abierto")?;
+            self.escapar(lazos, i, Destino::Salir);
+            Ok(())
+        } else {
+            self.arbol(cfg, lazos, t)
+        }
+    }
+
+    /// Sale hacia el lazo `i` (salir de él o continuarlo) desde el más interno.
+    fn escapar(&mut self, lazos: &mut [Lazo], i: usize, d: Destino) {
+        let k = lazos.len() - 1;
+        if i == k {
+            let destino = if d == Destino::Salir { lazos[k].merge } else { lazos[k].cont };
+            self.b.branch(destino).unwrap();
+            return;
+        }
+        let codigo = lazos[i].n * 2 + (d == Destino::Continuar) as u32;
+        let c = self.cu(codigo);
+        self.b.store(self.var_destino, c, None, []).unwrap();
+        for l in lazos[i..].iter_mut() {
+            l.pasan = true;
+        }
+        self.b.branch(lazos[k].merge).unwrap();
+    }
+
+    fn abrir_lazo(&mut self, lazos: &mut Vec<Lazo>, cabecera: Option<usize>, seguido_de: Option<usize>) {
+        let (h, cuerpo, merge, cont) = (self.b.id(), self.b.id(), self.b.id(), self.b.id());
+        self.b.branch(h).unwrap();
+        self.b.begin_block(Some(h)).unwrap();
+        self.b.loop_merge(merge, cont, spirv::LoopControl::NONE, []).unwrap();
+        self.b.branch(cuerpo).unwrap();
+        self.b.begin_block(Some(cuerpo)).unwrap();
+        self.n_lazos += 1;
+        lazos.push(Lazo { cabecera, seguido_de, merge, cont, n: self.n_lazos, pasan: false });
+        self.cabeceras_lazo.push(h);
+    }
+
+    fn cerrar_lazo(&mut self, lazos: &mut Vec<Lazo>) -> Res<()> {
+        let l = lazos.pop().ok_or("cerrar un lazo que no está abierto")?;
+        let h = self.cabeceras_lazo.pop().ok_or("lazo sin cabecera")?;
+        if self.b.selected_block().is_some() {
+            self.b.branch(l.merge).unwrap();
+        }
+        // continue: deja el destino a cero (llegó) y vuelve a la cabecera; un bloque de una vuelta no repite
+        self.b.begin_block(Some(l.cont)).unwrap();
+        if l.cabecera.is_some() {
+            let cero = self.cu(0);
+            self.b.store(self.var_destino, cero, None, []).unwrap();
+            self.b.branch(h).unwrap();
+        } else {
+            let falso = self.cbool(false);
+            self.b.branch_conditional(falso, h, l.merge, []).unwrap();
+        }
+        self.b.begin_block(Some(l.merge)).unwrap();
+        if l.pasan {
+            // si la salida era a este lazo, ha llegado; si es a otro de fuera, se sigue saliendo
+            let d = self.b.load(self.t_u32, None, self.var_destino, None, []).unwrap();
+            let mio = self.cu(l.n * 2);
+            let cero = self.cu(0);
+            let es_mio = self.b.i_equal(self.t_bool, None, d, mio).unwrap();
+            let nd = self.b.select(self.t_u32, None, es_mio, cero, d).unwrap();
+            self.b.store(self.var_destino, nd, None, []).unwrap();
+            let sigue = self.b.i_not_equal(self.t_bool, None, nd, cero).unwrap();
+            let (la, lm) = (self.b.id(), self.b.id());
+            self.b.selection_merge(lm, SelectionControl::NONE).unwrap();
+            self.b.branch_conditional(sigue, la, lm, []).unwrap();
+            self.b.begin_block(Some(la)).unwrap();
+            match lazos.last_mut() {
+                Some(fuera) => {
+                    fuera.pasan = true;
+                    let (fm, fc, fn_) = (fuera.merge, fuera.cont, fuera.n);
+                    let es_cont = fuera.cabecera.is_some();
+                    if es_cont {
+                        let cc = self.cu(fn_ * 2 + 1);
+                        let c = self.b.i_equal(self.t_bool, None, nd, cc).unwrap();
+                        let (a1, a2, m2) = (self.b.id(), self.b.id(), self.b.id());
+                        self.b.selection_merge(m2, SelectionControl::NONE).unwrap();
+                        self.b.branch_conditional(c, a1, a2, []).unwrap();
+                        self.b.begin_block(Some(a1)).unwrap();
+                        self.b.branch(fc).unwrap();
+                        self.b.begin_block(Some(a2)).unwrap();
+                        self.b.branch(fm).unwrap();
+                        self.b.begin_block(Some(m2)).unwrap();
+                        self.b.unreachable().unwrap();
+                    } else {
+                        self.b.branch(fm).unwrap();
+                    }
+                }
+                None => {
+                    self.b.unreachable().unwrap();
+                }
+            }
+            self.b.begin_block(Some(lm)).unwrap();
+        }
+        Ok(())
+    }
+}
diff --git a/tahoe-gpu/src/air/spirv_inst.rs b/tahoe-gpu/src/air/spirv_inst.rs
new file mode 100644
index 0000000..5bb2831
--- /dev/null
+++ b/tahoe-gpu/src/air/spirv_inst.rs
@@ -0,0 +1,974 @@
+//! Traducción de la función de entrada: interfaz (argumentos, builtins, recursos, salidas), control de flujo e
+//! instrucciones (incluidas las funciones `air.*` y `llvm.*`). Ver la descripción general en `spirv.rs`.
+
+use super::*;
+
+/// Traduce el punto de entrada `e` del módulo.
+pub fn traducir(m: &Module, e: &Entrada, op: &Opciones) -> Res<Traduccion> {
+    // estructurado si se puede; si el CFG no se deja (irreducible...), máquina de estados
+    if std::env::var_os("TAHOE_MAQUINA").is_none() {
+        match traducir_modo(m, e, op, true) {
+            Ok(t) => return Ok(t),
+            Err(err) if err.starts_with("estructura: ") => {}
+            Err(err) => return Err(err),
+        }
+    }
+    traducir_modo(m, e, op, false)
+}
+
+fn traducir_modo(m: &Module, e: &Entrada, op: &Opciones, estructurado: bool) -> Res<Traduccion> {
+    let esp = fc::especializar(m, &op.constantes)?;
+    let f = inline::inline_todo(m, e.funcion)?;
+    let an = sccp::analizar(m, &f, &esp.memoria, &esp.definidas);
+    let mut b = Builder::new();
+    b.set_version(1, 5); // Vulkan 1.2 admite SPIR-V 1.5 (interfaz con todas las globales, select de vectores)
+    for c in [Capability::Shader, Capability::ImageQuery, Capability::StorageImageWriteWithoutFormat, Capability::SampledImageArrayDynamicIndexing] {
+        b.capability(c);
+    }
+    b.memory_model(spirv::AddressingModel::Logical, spirv::MemoryModel::GLSL450);
+    let glsl = b.ext_inst_import("GLSL.std.450");
+    let t_void = b.type_void();
+    let t_bool = b.type_bool();
+    let t_u32 = b.type_int(32, 0);
+    let t_i32 = b.type_int(32, 1);
+    let t_f32 = b.type_float(32);
+    let t_sampler = b.type_sampler();
+    let reach = an.alcanzables.iter().filter(|&&x| x).count();
+    let mut t = Tr {
+        m,
+        f: &f,
+        an: &an,
+        mem: &esp.memoria,
+        ent: e,
+        op,
+        b,
+        glsl,
+        t_void,
+        t_bool,
+        t_u32,
+        t_i32,
+        t_f32,
+        tcache: HashMap::new(),
+        vcache: HashMap::new(),
+        pcache: HashMap::new(),
+        acache: HashMap::new(),
+        ccache: HashMap::new(),
+        vals: vec![None; f.values.len()],
+        buffers: HashMap::new(),
+        buffers_escritos: Vec::new(),
+        texturas: HashMap::new(),
+        samplers: HashMap::new(),
+        t_sampler,
+        enlaces: Vec::new(),
+        interfaz: Vec::new(),
+        builtins: HashMap::new(),
+        privadas: HashMap::new(),
+        globales: HashMap::new(),
+        multi: reach > 1,
+        estructurado,
+        sin_terminador: false,
+        var_destino: 0,
+        n_lazos: 0,
+        cabeceras_lazo: Vec::new(),
+        vars: HashMap::new(),
+        var_estado: 0,
+        etiquetas: HashMap::new(),
+        sel_merge: 0,
+        salidas: Vec::new(),
+        varyings_out: Vec::new(),
+        atributos: Vec::new(),
+        colores: Vec::new(),
+        grid: None,
+        usa_demote: false,
+        usa_subgrupos: false,
+        capacidades: Vec::new(),
+        set: op.set,
+        bases: HashMap::new(),
+        fijos: HashMap::new(),
+        wg_size: None,
+        t_bloque: None,
+        tipos_textura: HashMap::new(),
+        wg_args: HashMap::new(),
+    };
+    t.emitir()?;
+    // recursos usados
+    let mut enlaces = std::mem::take(&mut t.enlaces);
+    let mut bufs: Vec<u32> = t.buffers.keys().copied().collect();
+    bufs.sort();
+    for i in bufs {
+        let escritura = t.buffers_escritos.contains(&i);
+        if !escritura {
+            let v = t.buffers[&i];
+            t.b.decorate(v, Decoration::NonWritable, []);
+        }
+        enlaces.push(Enlace { binding: i, recurso: Recurso::Buffer { indice: i, escritura } });
+    }
+    if t.usa_demote {
+        t.b.capability(Capability::DemoteToHelperInvocation);
+        t.b.extension("SPV_EXT_demote_to_helper_invocation");
+    }
+    let mut caps = std::mem::take(&mut t.capacidades);
+    caps.sort_by_key(|c| *c as u32);
+    caps.dedup();
+    for c in caps {
+        t.b.capability(c);
+    }
+    if t.usa_subgrupos {
+        // (sin GroupNonUniformArithmetic: la GPU no la tiene; las reducciones van con shuffles)
+        for c in [Capability::GroupNonUniform, Capability::GroupNonUniformShuffle, Capability::GroupNonUniformShuffleRelative, Capability::GroupNonUniformQuad, Capability::GroupNonUniformBallot, Capability::GroupNonUniformVote] {
+            t.b.capability(c);
+        }
+    }
+    let colores = t.colores.clone();
+    let varyings = t.varyings_out.clone();
+    let atributos = t.atributos.clone();
+    let spirv = t.b.module().assemble();
+    Ok(Traduccion { spirv, etapa: e.etapa, enlaces, varyings, atributos, colores, bloques: reach, maquina_de_estados: reach > 1 && !estructurado, subgrupos: t.usa_subgrupos })
+}
+
+fn nombre_air<'a>(m: &'a Module, f: &Function, callee: ValueId) -> &'a str {
+    match f.values.get(callee).map(|v| &v.kind) {
+        Some(ValueKind::Function(g)) => &m.functions[*g].name,
+        _ => "",
+    }
+}
+
+impl Tr<'_> {
+    fn emitir(&mut self) -> Res<()> {
+        let modelo = match self.ent.etapa {
+            Etapa::Kernel => ExecutionModel::GLCompute,
+            Etapa::Vertex => ExecutionModel::Vertex,
+            Etapa::Fragment => ExecutionModel::Fragment,
+        };
+        if self.ent.etapa == Etapa::Kernel {
+            // tamaño del grupo: constantes de especialización 0, 1 y 2 (lo fija la app al despachar)
+            let v3 = self.vec_t(self.t_u32, 3);
+            let x = self.b.spec_constant_bit32(self.t_u32, 1);
+            let y = self.b.spec_constant_bit32(self.t_u32, 1);
+            let z = self.b.spec_constant_bit32(self.t_u32, 1);
+            for (k, c) in [x, y, z].into_iter().enumerate() {
+                self.b.decorate(c, Decoration::SpecId, [Operand::LiteralBit32(k as u32)]);
+            }
+            let wg = self.b.spec_constant_composite(v3, [x, y, z]);
+            self.b.decorate(wg, Decoration::BuiltIn, [Operand::BuiltIn(BuiltIn::WorkgroupSize)]);
+            self.wg_size = Some(wg);
+        }
+        // variables de la función (antes del cuerpo): las de los valores que cruzan bloques, los phi y las allocas
+        let fty = self.b.type_function(self.t_void, []);
+        let fun = self.b.begin_function(self.t_void, None, FunctionControl::NONE, fty).map_err(|e| format!("{e:?}"))?;
+        self.b.begin_block(None).unwrap();
+        self.preparar_variables()?;
+        self.argumentos()?;
+        self.analizar_bases();
+        if self.ent.etapa == Etapa::Kernel {
+            self.limite_de_rejilla()?;
+        }
+        let orden: Vec<usize> = self.an.orden.clone();
+        if !self.multi {
+            for &bb in &orden {
+                self.bloque(bb)?;
+            }
+        } else if self.estructurado {
+            let cero = self.cu(0);
+            self.b.store(self.var_destino, cero, None, []).unwrap();
+            self.emitir_estructurado().map_err(|e| format!("estructura: {e}"))?;
+        } else {
+            // máquina de estados: entrada → cabecera (bucle) → switch sobre el bloque → caso → fusión → continuar
+            let cab = self.b.id();
+            let disp = self.b.id();
+            let cont = self.b.id();
+            let fin = self.b.id();
+            self.sel_merge = self.b.id();
+            for &bb in &orden {
+                let l = self.b.id();
+                self.etiquetas.insert(bb, l);
+            }
+            let cero = self.cu(orden.first().copied().unwrap_or(0) as u32);
+            self.b.store(self.var_estado, cero, None, []).unwrap();
+            self.b.branch(cab).unwrap();
+            self.b.begin_block(Some(cab)).unwrap();
+            self.b.loop_merge(fin, cont, spirv::LoopControl::NONE, []).unwrap();
+            self.b.branch(disp).unwrap();
+            self.b.begin_block(Some(disp)).unwrap();
+            let s = self.b.load(self.t_u32, None, self.var_estado, None, []).unwrap();
+            self.b.selection_merge(self.sel_merge, SelectionControl::NONE).unwrap();
+            let casos: Vec<(Operand, Word)> = orden.iter().map(|bb| (Operand::LiteralBit32(*bb as u32), self.etiquetas[bb])).collect();
+            self.b.switch(s, self.sel_merge, casos).unwrap();
+            for &bb in &orden {
+                let l = self.etiquetas[&bb];
+                self.b.begin_block(Some(l)).unwrap();
+                self.bloque(bb)?;
+            }
+            self.b.begin_block(Some(self.sel_merge)).unwrap();
+            self.b.branch(cont).unwrap();
+            self.b.begin_block(Some(cont)).unwrap();
+            self.b.branch(cab).unwrap();
+            self.b.begin_block(Some(fin)).unwrap();
+            self.b.unreachable().unwrap();
+        }
+        self.b.end_function().unwrap();
+        let nombre = "main";
+        let interfaz = self.interfaz.clone();
+        self.b.entry_point(modelo, fun, nombre, interfaz);
+        match self.ent.etapa {
+            Etapa::Kernel => {}
+            Etapa::Fragment => self.b.execution_mode(fun, ExecutionMode::OriginUpperLeft, []),
+            Etapa::Vertex => {}
+        }
+        Ok(())
+    }
+
+    fn preparar_variables(&mut self) -> Res<()> {
+        let f = self.f;
+        // allocas: memoria privada en palabras
+        for blk in &f.blocks {
+            for ins in &blk.insts {
+                if let Inst::Alloca { ty, n, .. } = &ins.inst {
+                    let k = self.an.constantes.get(*n).cloned().flatten().and_then(|x| x.int()).unwrap_or(1).max(1);
+                    let words = (layout::size(self.m, *ty) * k).div_ceil(4).max(1) as u32;
+                    let at = self.arr_t(self.t_u32, words);
+                    let pt = self.ptr_t(StorageClass::Function, at);
+                    let v = self.b.variable(pt, None, StorageClass::Function, None);
+                    self.privadas.insert(ins.val.unwrap(), v);
+                }
+            }
+        }
+        if !self.multi {
+            return Ok(());
+        }
+        let pu = self.ptr_t(StorageClass::Function, self.t_u32);
+        self.var_estado = self.b.variable(pu, None, StorageClass::Function, None);
+        self.var_destino = self.b.variable(pu, None, StorageClass::Function, None);
+        // bloque de definición de cada valor y usos fuera de él
+        let mut def_bloque: HashMap<ValueId, usize> = HashMap::new();
+        for (bi, blk) in f.blocks.iter().enumerate() {
+            for ins in &blk.insts {
+                if let Some(v) = ins.val {
+                    def_bloque.insert(v, bi);
+                }
+            }
+        }
+        let mut cruzan: Vec<ValueId> = Vec::new();
+        for (bi, blk) in f.blocks.iter().enumerate() {
+            if !self.an.alcanzables[bi] {
+                continue;
+            }
+            for ins in &blk.insts {
+                let usados: Vec<ValueId> = match &ins.inst {
+                    Inst::Phi { incoming } => incoming.iter().map(|(v, _)| *v).collect(),
+                    other => operandos(other),
+                };
+                let es_phi = matches!(ins.inst, Inst::Phi { .. });
+                for u in usados {
+                    if let Some(&db) = def_bloque.get(&u) {
+                        if (db != bi || es_phi) && !cruzan.contains(&u) && self.an.constantes.get(u).cloned().flatten().is_none() {
+                            cruzan.push(u);
+                        }
+                    }
+                }
+                if es_phi {
+                    if let Some(v) = ins.val {
+                        if !cruzan.contains(&v) {
+                            cruzan.push(v);
+                        }
+                    }
+                }
+            }
+        }
+        for v in cruzan {
+            let t = f.values[v].ty;
+            // punteros: la variable guarda el desplazamiento; texturas y samplers no cruzan por variables
+            let st = if espacio(self.m, t).is_some() { self.t_u32 } else { self.ty(t)? };
+            let pt = self.ptr_t(StorageClass::Function, st);
+            let var = self.b.variable(pt, None, StorageClass::Function, None);
+            self.vars.insert(v, var);
+        }
+        Ok(())
+    }
+
+    // ------------------------------------------------------------ interfaz de entrada
+
+    fn builtin(&mut self, bi: BuiltIn, ty: Word, sc: StorageClass) -> Word {
+        if let Some(&(v, _)) = self.builtins.get(&bi) {
+            return v;
+        }
+        let pt = self.ptr_t(sc, ty);
+        let v = self.var_global(pt, sc, None);
+        self.b.decorate(v, Decoration::BuiltIn, [Operand::BuiltIn(bi)]);
+        self.builtins.insert(bi, (v, ty));
+        self.interfaz.push(v);
+        v
+    }
+
+    /// Valor de un builtin de entrada convertido al tipo del argumento (uint, uint2, uint3, ushort...).
+    fn leer_builtin(&mut self, bi: BuiltIn, n_bi: u32, t_arg: TypeId) -> Res<Word> {
+        let tb = self.vec_t(self.t_u32, n_bi);
+        let var = self.builtin(bi, tb, StorageClass::Input);
+        let x = self.b.load(tb, None, var, None, []).unwrap();
+        let n_arg = match self.m.types[t_arg] {
+            Type::Vector(n, _) => n,
+            _ => 1,
+        };
+        Ok(if n_arg == n_bi {
+            x
+        } else if n_arg == 1 {
+            self.b.composite_extract(self.t_u32, None, x, [0]).unwrap()
+        } else {
+            let st = self.vec_t(self.t_u32, n_arg);
+            let comps: Vec<u32> = (0..n_arg).collect();
+            self.b.vector_shuffle(st, None, x, x, comps).unwrap()
+        })
+    }
+
+    fn argumentos(&mut self) -> Res<()> {
+        let args = self.f.args.clone();
+        let descs = self.ent.argumentos.clone();
+        for d in &descs {
+            let Some(&v) = args.get(d.indice as usize) else { continue };
+            let t_arg = self.f.values[v].ty;
+            if let Some(pred) = self.predicado(d) {
+                if !pred {
+                    self.vals[v] = Some(TV::C(V::Undef));
+                    continue;
+                }
+            }
+            let tv = match d.clase.as_str() {
+                "air.buffer" | "air.indirect_buffer" => {
+                    let i = d.int_tras("air.location_index").unwrap_or(0) as u32;
+                    if d.int_tras("air.address_space") == Some(3) { TV::Ptr(Base::WgArg(i), Off::C(0)) } else { TV::Ptr(Base::Buf(i), Off::C(0)) }
+                }
+                "air.texture" => {
+                    let i = d.int_tras("air.location_index").unwrap_or(0) as u32;
+                    let nombre = d.txt_tras("air.arg_type_name").unwrap_or("");
+                    let k = if nombre.contains("<uint") || nombre.contains("<ushort") || nombre.contains("<uchar") { 1 } else if nombre.contains("<int") || nombre.contains("<short") || nombre.contains("<char") { 2 } else { 0 };
+                    self.tipos_textura.insert(i, k);
+                    TV::Tex(i)
+                }
+                "air.sampler" => TV::Smp(Smp::Arg(d.int_tras("air.location_index").unwrap_or(0) as u32)),
+                "air.thread_position_in_grid" => TV::Id(self.leer_builtin(BuiltIn::GlobalInvocationId, 3, t_arg)?),
+                "air.thread_position_in_threadgroup" => TV::Id(self.leer_builtin(BuiltIn::LocalInvocationId, 3, t_arg)?),
+                "air.threadgroup_position_in_grid" => TV::Id(self.leer_builtin(BuiltIn::WorkgroupId, 3, t_arg)?),
+                "air.threadgroups_per_grid" => TV::Id(self.leer_builtin(BuiltIn::NumWorkgroups, 3, t_arg)?),
+                "air.thread_index_in_threadgroup" => TV::Id(self.leer_builtin(BuiltIn::LocalInvocationIndex, 1, t_arg)?),
+                "air.threads_per_threadgroup" => {
+                    let g = self.wg_size.ok_or("tamaño de grupo fuera de un kernel")?;
+                    let n = match self.m.types[t_arg] { Type::Vector(n, _) => n, _ => 1 };
+                    TV::Id(if n == 3 { g } else if n == 1 { self.b.composite_extract(self.t_u32, None, g, [0]).unwrap() } else {
+                        let st = self.vec_t(self.t_u32, n);
+                        self.b.vector_shuffle(st, None, g, g, [0, 1]).unwrap()
+                    })
+                }
+                "air.threads_per_grid" => {
+                    let g = self.rejilla()?;
+                    let n = match self.m.types[t_arg] { Type::Vector(n, _) => n, _ => 1 };
+                    TV::Id(if n == 3 { g } else if n == 1 { self.b.composite_extract(self.t_u32, None, g, [0]).unwrap() } else {
+                        let st = self.vec_t(self.t_u32, n);
+                        self.b.vector_shuffle(st, None, g, g, [0, 1]).unwrap()
+                    })
+                }
+                "air.simdgroups_per_threadgroup" => {
+                    self.usa_subgrupos = true;
+                    TV::Id(self.leer_builtin(BuiltIn::NumSubgroups, 1, t_arg)?)
+                }
+                "air.thread_index_in_simdgroup" => {
+                    self.usa_subgrupos = true;
+                    TV::Id(self.leer_builtin(BuiltIn::SubgroupLocalInvocationId, 1, t_arg)?)
+                }
+                "air.simdgroup_index_in_threadgroup" => {
+                    self.usa_subgrupos = true;
+                    TV::Id(self.leer_builtin(BuiltIn::SubgroupId, 1, t_arg)?)
+                }
+                "air.thread_index_in_quadgroup" | "air.quadgroup_index_in_threadgroup" | "air.quadgroups_per_threadgroup" => {
+                    let x = match d.clase.as_str() {
+                        "air.thread_index_in_quadgroup" => {
+                            let l = self.leer_builtin(BuiltIn::SubgroupLocalInvocationId, 1, t_arg)?;
+                            self.usa_subgrupos = true;
+                            let tres = self.cu(3);
+                            self.b.bitwise_and(self.t_u32, None, l, tres).unwrap()
+                        }
+                        "air.quadgroup_index_in_threadgroup" => {
+                            let l = self.leer_builtin(BuiltIn::LocalInvocationIndex, 1, t_arg)?;
+                            let dos = self.cu(2);
+                            self.b.shift_right_logical(self.t_u32, None, l, dos).unwrap()
+                        }
+                        _ => {
+                            let g = self.wg_size.ok_or("tamaño de grupo fuera de un kernel")?;
+                            let gx = self.b.composite_extract(self.t_u32, None, g, [0]).unwrap();
+                            let gy = self.b.composite_extract(self.t_u32, None, g, [1]).unwrap();
+                            let gz = self.b.composite_extract(self.t_u32, None, g, [2]).unwrap();
+                            let xy = self.b.i_mul(self.t_u32, None, gx, gy).unwrap();
+                            let n = self.b.i_mul(self.t_u32, None, xy, gz).unwrap();
+                            let tres = self.cu(3);
+                            let n3 = self.b.i_add(self.t_u32, None, n, tres).unwrap();
+                            let dos = self.cu(2);
+                            self.b.shift_right_logical(self.t_u32, None, n3, dos).unwrap()
+                        }
+                    };
+                    TV::Id(x)
+                }
+                "air.threads_per_simdgroup" => {
+                    self.usa_subgrupos = true;
+                    TV::Id(self.leer_builtin(BuiltIn::SubgroupSize, 1, t_arg)?)
+                }
+                "air.vertex_id" => TV::Id(self.leer_entero(BuiltIn::VertexIndex)?),
+                "air.instance_id" => TV::Id(self.leer_entero(BuiltIn::InstanceIndex)?),
+                "air.base_vertex" => TV::Id(self.leer_entero(BuiltIn::BaseVertex)?),
+                "air.base_instance" => TV::Id(self.leer_entero(BuiltIn::BaseInstance)?),
+                "air.vertex_input" => {
+                    let attr = d.int_tras("air.location_index").unwrap_or(0) as u32;
+                    let loc = self.atributos.len() as u32;
+                    let st = self.ty(t_arg)?;
+                    let pt = self.ptr_t(StorageClass::Input, st);
+                    let var = self.var_global(pt, StorageClass::Input, None);
+                    self.b.decorate(var, Decoration::Location, [Operand::LiteralBit32(attr)]);
+                    self.interfaz.push(var);
+                    self.atributos.push((attr, loc, super::super::tipo(self.m, t_arg)));
+                    TV::Id(self.b.load(st, None, var, None, []).unwrap())
+                }
+                "air.position" if self.ent.etapa == Etapa::Fragment => {
+                    let v4 = self.vec_t(self.t_f32, 4);
+                    let var = self.builtin(BuiltIn::FragCoord, v4, StorageClass::Input);
+                    TV::Id(self.b.load(v4, None, var, None, []).unwrap())
+                }
+                "air.front_facing" => {
+                    let var = self.builtin(BuiltIn::FrontFacing, self.t_bool, StorageClass::Input);
+                    TV::Id(self.b.load(self.t_bool, None, var, None, []).unwrap())
+                }
+                "air.fragment_input" => {
+                    let nombre = d.datos.iter().find_map(|x| match x { super::super::Dato::Txt(s) if s != "air.fragment_input" && !s.starts_with("air.") => Some(s.clone()), _ => None }).unwrap_or_default();
+                    let loc = match self.op.varyings.get(&nombre) {
+                        Some(&l) => l,
+                        None => self.varyings_out.len() as u32,
+                    };
+                    let st = self.ty(t_arg)?;
+                    let pt = self.ptr_t(StorageClass::Input, st);
+                    let var = self.var_global(pt, StorageClass::Input, None);
+                    self.b.decorate(var, Decoration::Location, [Operand::LiteralBit32(loc)]);
+                    self.interpolacion(var, d, t_arg);
+                    self.interfaz.push(var);
+                    self.varyings_out.push((nombre, loc));
+                    TV::Id(self.b.load(st, None, var, None, []).unwrap())
+                }
+                otra => return Err(format!("argumento {otra} sin soporte aún")),
+            };
+            self.vals[v] = Some(tv);
+        }
+        // salidas: variables de salida (se escriben en cada ret)
+        let salidas = self.ent.salidas.clone();
+        let ret_ty = match &self.m.types[self.f.ty] {
+            Type::Function { ret, .. } => *ret,
+            _ => 0,
+        };
+        let campos: Vec<TypeId> = match &self.m.types[ret_ty] {
+            Type::Struct { elems, .. } => elems.clone(),
+            Type::Void => Vec::new(),
+            _ => vec![ret_ty],
+        };
+        for (k, d) in salidas.iter().enumerate() {
+            let Some(&tc) = campos.get(k) else { break };
+            if self.predicado(d) == Some(false) {
+                self.salidas.push((0, d.clone()));
+                continue;
+            }
+            let st = self.ty(tc)?;
+            let pt = self.ptr_t(StorageClass::Output, st);
+            let var = self.var_global(pt, StorageClass::Output, None);
+            match d.clase.as_str() {
+                "air.position" => {
+                    self.b.decorate(var, Decoration::BuiltIn, [Operand::BuiltIn(BuiltIn::Position)]);
+                }
+                "air.point_size" => self.b.decorate(var, Decoration::BuiltIn, [Operand::BuiltIn(BuiltIn::PointSize)]),
+                "air.depth" => self.b.decorate(var, Decoration::BuiltIn, [Operand::BuiltIn(BuiltIn::FragDepth)]),
+                "air.vertex_output" => {
+                    let nombre = d.propios().first().and_then(|x| match x { super::super::Dato::Txt(s) => Some(s.clone()), _ => None }).unwrap_or_default();
+                    let loc = self.varyings_out.len() as u32;
+                    self.b.decorate(var, Decoration::Location, [Operand::LiteralBit32(loc)]);
+                    self.interpolacion(var, d, tc);
+                    self.varyings_out.push((nombre, loc));
+                }
+                "air.render_target" => {
+                    let rt = d.propios().first().and_then(|x| match x { super::super::Dato::Int(i) => Some(*i as u32), _ => None }).unwrap_or(0);
+                    self.b.decorate(var, Decoration::Location, [Operand::LiteralBit32(rt)]);
+                    self.colores.push(rt);
+                }
+                otra => return Err(format!("salida {otra} sin soporte aún")),
+            }
+            self.interfaz.push(var);
+            self.salidas.push((var, d.clone()));
+        }
+        Ok(())
+    }
+
+    fn leer_entero(&mut self, bi: BuiltIn) -> Res<Word> {
+        let var = self.builtin(bi, self.t_i32, StorageClass::Input);
+        let x = self.b.load(self.t_i32, None, var, None, []).unwrap();
+        Ok(self.b.bitcast(self.t_u32, None, x).unwrap())
+    }
+
+    fn interpolacion(&mut self, var: Word, d: &Descripcion, t: TypeId) {
+        let entero = matches!(self.m.types[t], Type::Int(_)) || matches!(self.m.types[t], Type::Vector(_, e) if matches!(self.m.types[e], Type::Int(_)));
+        if entero || d.tiene("air.flat") {
+            self.b.decorate(var, Decoration::Flat, []);
+        } else if d.tiene("air.no_perspective") {
+            self.b.decorate(var, Decoration::NoPerspective, []);
+        }
+        if d.tiene("air.centroid") && !entero {
+            self.b.decorate(var, Decoration::Centroid, []);
+        }
+    }
+
+    /// Si el argumento o la salida depende de una function constant, su valor (tras especializar).
+    fn predicado(&self, d: &Descripcion) -> Option<bool> {
+        if !d.tiene("air.function_constant") && d.clase != "air.function_constant" {
+            return None;
+        }
+        let g = d.datos.iter().find_map(|x| match x { super::super::Dato::Pred(g) => Some(*g), _ => None })?;
+        // tras especializar, el predicado está en la memoria de su global (un bool de Metal: un byte)
+        Some(self.mem.globales.get(g)?.first().copied().unwrap_or(0) != 0)
+    }
+
+    /// Tamaño de la rejilla (constantes de empuje: x, y, z en hilos).
+    /// Tamaño de la rejilla de Metal (en hilos), de la push constant (se lee en el bloque de entrada).
+    fn rejilla(&mut self) -> Res<Word> {
+        if let Some(g) = self.grid {
+            return Ok(g);
+        }
+        if self.ent.etapa != Etapa::Kernel {
+            return Err("tamaño de rejilla fuera de un kernel".into());
+        }
+        let v3 = self.vec_t(self.t_u32, 3);
+        let st = self.b.type_struct([v3]);
+        self.b.decorate(st, Decoration::Block, []);
+        self.b.member_decorate(st, 0, Decoration::Offset, [Operand::LiteralBit32(0)]);
+        let pt = self.ptr_t(StorageClass::PushConstant, st);
+        let var = self.var_global(pt, StorageClass::PushConstant, None);
+        self.interfaz.push(var);
+        let pv = self.ptr_t(StorageClass::PushConstant, v3);
+        let cero = self.cu(0);
+        let p = self.b.access_chain(pv, None, var, [cero]).unwrap();
+        let g = self.b.load(v3, None, p, None, []).unwrap();
+        self.grid = Some(g);
+        Ok(g)
+    }
+
+    /// En un kernel: los hilos fuera de la rejilla de Metal (dispatchThreads con grupos que no la dividen) salen ya.
+    fn limite_de_rejilla(&mut self) -> Res<()> {
+        let v3 = self.vec_t(self.t_u32, 3);
+        let g = self.rejilla()?;
+        let gidv = self.builtin(BuiltIn::GlobalInvocationId, v3, StorageClass::Input);
+        let gid = self.b.load(v3, None, gidv, None, []).unwrap();
+        let bv3 = self.vec_t(self.t_bool, 3);
+        let fuera = self.b.u_greater_than_equal(bv3, None, gid, g).unwrap();
+        let alguno = self.b.any(self.t_bool, None, fuera).unwrap();
+        let (salir, seguir) = (self.b.id(), self.b.id());
+        self.b.selection_merge(seguir, SelectionControl::NONE).unwrap();
+        self.b.branch_conditional(alguno, salir, seguir, []).unwrap();
+        self.b.begin_block(Some(salir)).unwrap();
+        self.b.ret().unwrap();
+        self.b.begin_block(Some(seguir)).unwrap();
+        Ok(())
+    }
+
+    // ------------------------------------------------------------ bloques
+
+    fn bloque(&mut self, bb: usize) -> Res<()> {
+        let f = self.f;
+        let insts = &f.blocks[bb].insts;
+        // los valores de otros bloques se releen de sus variables
+        let cruzan: Vec<ValueId> = self.vars.keys().copied().collect();
+        for v in cruzan {
+            self.vals[v] = None;
+        }
+        // phis: desde sus variables
+        for ins in insts {
+            if let Inst::Phi { .. } = ins.inst {
+                let v = ins.val.unwrap();
+                if self.an.constantes.get(v).cloned().flatten().is_some() || self.fijos.contains_key(&v) {
+                    continue;
+                }
+                let t = f.values[v].ty;
+                if espacio(self.m, t).is_some() {
+                    // phi de punteros: misma base en todas las entradas (se toma la de la primera ya traducida)
+                    let Inst::Phi { incoming } = &ins.inst else { unreachable!() };
+                    let base = self.bases.get(&v).copied().or_else(|| incoming.iter().find_map(|(x, _)| match self.tv(*x) { Ok(TV::Ptr(b, _)) => Some(b), _ => None }));
+                    let var = *self.vars.get(&v).ok_or("phi sin variable")?;
+                    let off = self.b.load(self.t_u32, None, var, None, []).unwrap();
+                    self.vals[v] = Some(TV::Ptr(base.ok_or("phi de punteros sin base conocida")?, Off::Id(off)));
+                } else {
+                    let var = *self.vars.get(&v).ok_or("phi sin variable")?;
+                    let st = self.ty(t)?;
+                    let x = self.b.load(st, None, var, None, []).unwrap();
+                    self.vals[v] = Some(TV::Id(x));
+                }
+            }
+        }
+        if self.b.selected_block().is_none() {
+            return Err(format!("el bloque {bb} empieza cerrado"));
+        }
+        for ins in insts {
+            if matches!(ins.inst, Inst::Phi { .. }) {
+                continue;
+            }
+            if let Some(v) = ins.val {
+                if let Some(Some(_)) = self.an.constantes.get(v) {
+                    continue; // constante plegada
+                }
+            }
+            if self.b.selected_block().is_none() {
+                return Err(format!("el bloque {bb} quedó cerrado antes de {:?}", ins.inst));
+            }
+            let es_term = matches!(ins.inst, Inst::Br(_) | Inst::CondBr { .. } | Inst::Switch { .. } | Inst::Ret(_) | Inst::Unreachable);
+            if es_term {
+                if self.sin_terminador {
+                    return Ok(());
+                }
+                self.terminador(bb, &ins.inst)?;
+                return Ok(());
+            }
+            if let Inst::Alloca { .. } = ins.inst {
+                let v = ins.val.unwrap();
+                self.vals[v] = Some(TV::Ptr(Base::Priv(v), Off::C(0)));
+                if self.vars.contains_key(&v) {
+                    self.bases.insert(v, Base::Priv(v));
+                    let (var, c) = (self.vars[&v], self.cu(0));
+                    self.b.store(var, c, None, []).unwrap();
+                }
+                continue;
+            }
+            let r = self.instruccion(&ins.inst, ins.ty).map_err(|e| format!("{e} (en {:?})", ins.inst))?;
+            if self.b.selected_block().is_none() {
+                return Err(format!("{:?} cerró el bloque {bb}", ins.inst));
+            }
+            if let (Some(v), Some(r)) = (ins.val, r) {
+                // si cruza bloques, a su variable
+                if let Some(&var) = self.vars.get(&v) {
+                    match &r {
+                        TV::Id(id) => self.b.store(var, *id, None, []).unwrap(),
+                        TV::Ptr(base, o) => {
+                            self.bases.insert(v, *base);
+                            let o = self.off_id(*o);
+                            self.b.store(var, o, None, []).unwrap();
+                        }
+                        TV::C(c) => {
+                            let t = f.values[v].ty;
+                            let id = self.constante(t, c)?;
+                            self.b.store(var, id, None, []).unwrap();
+                        }
+                        _ => {}
+                    }
+                }
+                self.vals[v] = Some(r);
+            }
+        }
+        Err(format!("bloque {bb} sin terminador"))
+    }
+
+    /// Base de cada puntero de la función, antes de traducir (para los que cruzan bloques y los phi, sobre todo en
+    /// bucles, cuya entrada puede venir de un bloque aún sin traducir): argumentos, allocas y globales, y de ahí por
+    /// GEP, casts, select y phi hasta que no cambia nada. Los que mezclan bases distintas no entran.
+    fn analizar_bases(&mut self) {
+        let f = self.f;
+        let mut base: HashMap<ValueId, Option<Base>> = HashMap::new(); // None: bases distintas
+        let inicial = |tr: &Self, v: ValueId| -> Option<Option<Base>> {
+            if let Some(Some(TV::Ptr(b, _))) = tr.vals.get(v) {
+                return Some(Some(*b));
+            }
+            match tr.an.constantes.get(v).cloned().flatten() {
+                Some(V::Ptr(Mem::Global(g), _)) => Some(Some(tr.base_global(g))),
+                _ => match f.values.get(v).map(|x| &x.kind) {
+                    Some(ValueKind::Global(g)) => Some(Some(tr.base_global(*g))),
+                    _ => None,
+                },
+            }
+        };
+        for _ in 0..64 {
+            let mut cambio = false;
+            for (bb, blk) in f.blocks.iter().enumerate() {
+                if !self.an.alcanzables.get(bb).copied().unwrap_or(false) {
+                    continue;
+                }
+                for ins in &blk.insts {
+                    let Some(v) = ins.val else { continue };
+                    if espacio(self.m, f.values[v].ty).is_none() {
+                        continue;
+                    }
+                    let de = |x: ValueId, base: &HashMap<ValueId, Option<Base>>| -> Option<Option<Base>> { base.get(&x).copied().or_else(|| inicial(self, x)) };
+                    let fuentes: Vec<ValueId> = match &ins.inst {
+                        Inst::Alloca { .. } => {
+                            if base.insert(v, Some(Base::Priv(v))) != Some(Some(Base::Priv(v))) {
+                                cambio = true;
+                            }
+                            continue;
+                        }
+                        Inst::Gep { ptr, .. } => vec![*ptr],
+                        Inst::Cast { v: x, .. } => vec![*x],
+                        Inst::Select { t, f: fl, .. } => vec![*t, *fl],
+                        Inst::Phi { incoming } => incoming.iter().filter(|(_, pb)| self.an.alcanzables.get(*pb).copied().unwrap_or(false)).map(|(x, _)| *x).collect(),
+                        _ => continue,
+                    };
+                    // encuentro: las desconocidas (undef, nulos, aún sin saber) no cuentan
+                    let mut r: Option<Option<Base>> = None;
+                    for x in fuentes {
+                        match de(x, &base) {
+                            None | Some(Some(Base::Nula)) => {}
+                            Some(b) => {
+                                r = Some(match (r, b) {
+                                    (None, b) => b,
+                                    (Some(Some(a)), Some(b)) if a == b => Some(a),
+                                    _ => None,
+                                })
+                            }
+                        }
+                    }
+                    if let Some(r) = r {
+                        if base.get(&v) != Some(&r) {
+                            // solo baja: de una base a «distintas»
+                            let nuevo = match base.get(&v) { Some(Some(a)) if Some(*a) != r => None, _ => r };
+                            if base.get(&v) != Some(&nuevo) {
+                                base.insert(v, nuevo);
+                                cambio = true;
+                            }
+                        }
+                    }
+                }
+            }
+            if !cambio {
+                break;
+            }
+        }
+        for (v, b) in base {
+            if let Some(b) = b {
+                self.bases.entry(v).or_insert(b);
+            }
+        }
+        // texturas y samplers: la misma en todas las entradas (sin contar la nula)
+        for _ in 0..16 {
+            let mut cambio = false;
+            for (bb, blk) in f.blocks.iter().enumerate() {
+                if !self.an.alcanzables.get(bb).copied().unwrap_or(false) {
+                    continue;
+                }
+                for ins in &blk.insts {
+                    let Some(v) = ins.val else { continue };
+                    if self.fijos.contains_key(&v) {
+                        continue;
+                    }
+                    let fuentes: Vec<ValueId> = match &ins.inst {
+                        Inst::Select { t, f: fl, .. } => vec![*t, *fl],
+                        Inst::Phi { incoming } => incoming.iter().filter(|(_, pb)| self.an.alcanzables.get(*pb).copied().unwrap_or(false)).map(|(x, _)| *x).collect(),
+                        Inst::Cast { v: x, .. } => vec![*x],
+                        _ => continue,
+                    };
+                    let mut r: Option<TV> = None;
+                    let mut ok = true;
+                    for x in fuentes {
+                        let tvx = self.fijos.get(&x).cloned().or_else(|| match self.vals.get(x) {
+                            Some(Some(t @ (TV::Tex(_) | TV::Smp(_)))) => Some(t.clone()),
+                            _ => None,
+                        });
+                        let nula = match f.values[x].kind {
+                            ValueKind::Inst(b2, k2) => matches!(&f.blocks[b2].insts[k2].inst, Inst::Call { callee, .. } if nombre_air(self.m, f, *callee).starts_with("air.get_null_texture")),
+                            ValueKind::Const(_) => true,
+                            _ => false,
+                        };
+                        // argumentos que no están en esta variante (function constants): undef, como la nula
+                        let ausente = matches!(self.vals.get(x), Some(Some(TV::C(V::Undef)))) || matches!(self.fijos.get(&x), Some(TV::Ptr(Base::Nula, _)));
+                        match (tvx, &r) {
+                            (Some(TV::Ptr(Base::Nula, _)), _) => {}
+                            (Some(t), None) => r = Some(t),
+                            (Some(t), Some(a)) if t == *a => {}
+                            (None, _) if nula || ausente => {}
+                            _ => ok = false,
+                        }
+                    }
+                    // solo nulas: es la textura nula
+                    let r = if ok && r.is_none() && espacio(self.m, f.values[v].ty) == Some(1) { Some(TV::Ptr(Base::Nula, Off::C(0))) } else { r };
+                    if std::env::var_os("TAHOE_AIR_DEBUG").is_some() && matches!(ins.inst, Inst::Phi { .. }) && espacio(self.m, f.values[v].ty).is_some() {
+                        eprintln!("fijos: %{v} ok={ok} r={r:?} fuentes={:?}", match &ins.inst { Inst::Phi { incoming } => incoming.iter().map(|(x, _)| (self.vals.get(*x).cloned(), f.values[*x].kind.clone())).collect::<Vec<_>>(), _ => vec![] });
+                    }
+                    if let (true, Some(t)) = (ok, r) {
+                        self.fijos.insert(v, t);
+                        cambio = true;
+                    }
+                }
+            }
+            if !cambio {
+                break;
+            }
+        }
+    }
+
+    /// Antes de saltar de `desde` a `hacia`: los phi de `hacia` reciben su valor (todos leídos antes de escribir).
+    fn copiar_phis(&mut self, desde: usize, hacia: usize) -> Res<()> {
+        let f = self.f;
+        let mut pares = Vec::new();
+        for ins in &f.blocks[hacia].insts {
+            let Inst::Phi { incoming } = &ins.inst else { continue };
+            let v = ins.val.unwrap();
+            let Some(&var) = self.vars.get(&v) else { continue };
+            if self.fijos.contains_key(&v) {
+                continue;
+            }
+            let Some((x, _)) = incoming.iter().find(|(_, b)| *b == desde) else { continue };
+            let t = f.values[v].ty;
+            let tvx = self.tv(*x)?;
+            let id = match tvx {
+                TV::Ptr(_, o) => self.off_id(o),
+                other => self.id_de(&other, t)?,
+            };
+            pares.push((var, id));
+        }
+        for (var, id) in pares {
+            self.b.store(var, id, None, []).unwrap();
+        }
+        Ok(())
+    }
+
+    fn saltar(&mut self, desde: usize, hacia: usize) -> Res<()> {
+        self.copiar_phis(desde, hacia)?;
+        let c = self.cu(hacia as u32);
+        self.b.store(self.var_estado, c, None, []).unwrap();
+        Ok(())
+    }
+
+    fn terminador(&mut self, bb: usize, i: &Inst) -> Res<()> {
+        match i {
+            Inst::Ret(v) => {
+                self.escribir_salidas(*v)?;
+                self.b.ret().unwrap();
+                return Ok(());
+            }
+            Inst::Unreachable => {
+                self.b.ret().unwrap();
+                return Ok(());
+            }
+            _ => {}
+        }
+        if !self.multi {
+            return Err("salto en una función de un solo bloque".into());
+        }
+        match i {
+            Inst::Br(t) => self.saltar(bb, *t)?,
+            Inst::CondBr { c, t, f } => {
+                match self.tv(*c)? {
+                    TV::C(V::Int(_, x)) => self.saltar(bb, if x != 0 { *t } else { *f })?,
+                    _ => {
+                        let cid = self.id(*c)?;
+                        // los phi de los dos destinos se rellenan en ramas separadas
+                        let (lt, lf, lm) = (self.b.id(), self.b.id(), self.b.id());
+                        self.b.selection_merge(lm, SelectionControl::NONE).unwrap();
+                        self.b.branch_conditional(cid, lt, lf, []).unwrap();
+                        self.b.begin_block(Some(lt)).unwrap();
+                        self.saltar(bb, *t)?;
+                        self.b.branch(lm).unwrap();
+                        self.b.begin_block(Some(lf)).unwrap();
+                        self.saltar(bb, *f)?;
+                        self.b.branch(lm).unwrap();
+                        self.b.begin_block(Some(lm)).unwrap();
+                    }
+                }
+            }
+            Inst::Switch { v, default, cases } => {
+                let x = self.id(*v)?;
+                let lm = self.b.id();
+                let ld = self.b.id();
+                let mut dest = Vec::new();
+                let mut etiquetas = Vec::new();
+                for (cv, b) in cases {
+                    let k = match self.tv(*cv)? {
+                        TV::C(V::Int(_, k)) => k as u32,
+                        _ => return Err("caso de switch no constante".into()),
+                    };
+                    let l = self.b.id();
+                    dest.push((Operand::LiteralBit32(k), l));
+                    etiquetas.push((l, *b));
+                }
+                self.b.selection_merge(lm, SelectionControl::NONE).unwrap();
+                self.b.switch(x, ld, dest).unwrap();
+                for (l, b) in etiquetas {
+                    self.b.begin_block(Some(l)).unwrap();
+                    self.saltar(bb, b)?;
+                    self.b.branch(lm).unwrap();
+                }
+                self.b.begin_block(Some(ld)).unwrap();
+                self.saltar(bb, *default)?;
+                self.b.branch(lm).unwrap();
+                self.b.begin_block(Some(lm)).unwrap();
+            }
+            _ => unreachable!(),
+        }
+        self.b.branch(self.sel_merge).unwrap();
+        Ok(())
+    }
+
+    fn escribir_salidas(&mut self, v: Option<ValueId>) -> Res<()> {
+        let Some(v) = v else { return Ok(()) };
+        if self.salidas.is_empty() {
+            return Ok(());
+        }
+        let t = self.f.values[v].ty;
+        let x = self.tv(v)?;
+        let struct_ret = matches!(self.m.types[t], Type::Struct { .. });
+        let salidas = self.salidas.clone();
+        for (k, (var, _)) in salidas.iter().enumerate() {
+            if *var == 0 {
+                continue;
+            }
+            let (tc, val) = if struct_ret {
+                let tc = match &self.m.types[t] { Type::Struct { elems, .. } => elems[k], _ => unreachable!() };
+                let id = match &x {
+                    TV::C(V::Agg(es)) => self.constante(tc, &es[k])?,
+                    TV::C(V::Undef) => {
+                        let st = self.ty(tc)?;
+                        self.b.constant_null(st)
+                    }
+                    other => {
+                        let agg = self.id_de(other, t)?;
+                        let st = self.ty(tc)?;
+                        self.b.composite_extract(st, None, agg, [k as u32]).unwrap()
+                    }
+                };
+                (tc, id)
+            } else {
+                (t, self.id_de(&x, t)?)
+            };
+            let _ = tc;
+            self.b.store(*var, val, None, []).unwrap();
+        }
+        Ok(())
+    }
+}
+
+/// Valores que usa una instrucción (sin los phi).
+pub(super) fn operandos(i: &Inst) -> Vec<ValueId> {
+    match i {
+        Inst::Bin { a, b, .. } | Inst::Cmp { a, b, .. } => vec![*a, *b],
+        Inst::FNeg(a) | Inst::Freeze(a) | Inst::Cast { v: a, .. } => vec![*a],
+        Inst::Select { c, t, f } => vec![*c, *t, *f],
+        Inst::ExtractElt { v, i } => vec![*v, *i],
+        Inst::InsertElt { v, e, i } => vec![*v, *e, *i],
+        Inst::Shuffle { a, b, mask } => vec![*a, *b, *mask],
+        Inst::ExtractVal { v, .. } => vec![*v],
+        Inst::InsertVal { agg, v, .. } => vec![*agg, *v],
+        Inst::Load { ptr, .. } => vec![*ptr],
+        Inst::Store { ptr, val, .. } => vec![*ptr, *val],
+        Inst::Gep { ptr, idx, .. } => {
+            let mut v = vec![*ptr];
+            v.extend(idx);
+            v
+        }
+        Inst::Alloca { n, .. } => vec![*n],
+        Inst::Call { args, .. } => args.iter().copied().filter(|&a| a < 1_000_000_000).collect(),
+        Inst::CondBr { c, .. } => vec![*c],
+        Inst::Switch { v, .. } => vec![*v],
+        Inst::Ret(Some(v)) => vec![*v],
+        Inst::AtomicRmw { ptr, val, .. } => vec![*ptr, *val],
+        Inst::CmpXchg { ptr, cmp, new } => vec![*ptr, *cmp, *new],
+        _ => Vec::new(),
+    }
+}
