+/// # Safety
+/// `d` debe ser un dispatch_data_t.
+pub unsafe fn bytes_de_dispatch_data(d: Id) -> Vec<u8> {
+    let mut p: *const c_void = std::ptr::null();
+    let mut n = 0usize;
+    let m = dispatch_data_create_map(d, &mut p, &mut n);
