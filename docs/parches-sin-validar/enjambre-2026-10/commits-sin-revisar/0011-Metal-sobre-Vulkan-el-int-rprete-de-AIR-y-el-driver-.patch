diff --git a/tahoe-gpu/src/air/fc.rs b/tahoe-gpu/src/air/fc.rs
new file mode 100644
index 0000000..4dedf5e
--- /dev/null
+++ b/tahoe-gpu/src/air/fc.rs
@@ -0,0 +1,126 @@
+//! Function constants de Metal. En AIR son globales del espacio constant (`@..MTL_FC_INIT_<índice>_<tipo>`) listadas en
+//! `!air.function_constants` como `!{ptr @global, !"tipo", !"nombre", i32 índice, i1 obligatoria}`. Además, un
+//! constructor global (en `@llvm.global_ctors`) calcula a partir de ellas otras globales (los predicados
+//! `__metal_implicit_fc_pred_N` que deciden qué argumentos y salidas existen, y constantes derivadas). Al crear un
+//! pipeline se especializa: se escriben los valores dados, se ejecuta el constructor con el intérprete y la memoria
+//! resultante hace de constante en la traducción (las ramas que dependen de ella se pliegan).
+
+use std::collections::HashMap;
+
+use super::interp::{self, Memoria, Mem, V};
+use super::ir::{Const, Md, Module, Type, ValueKind};
+
+pub type Res<T> = Result<T, String>;
+
+#[derive(Debug, Clone)]
+pub struct FuncConst {
+    pub global: usize,
+    pub tipo: String,
+    pub nombre: String,
+    pub indice: u32,
+}
+
+fn md_global(m: &Module, i: Option<usize>) -> Option<usize> {
+    match m.md.get(i?)? {
+        Md::Value(_, v) => match &m.values.get(*v)?.kind {
+            ValueKind::Global(g) => Some(*g),
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
+fn md_int(m: &Module, i: Option<usize>) -> Option<i64> {
+    match m.md.get(i?)? {
+        Md::Value(_, v) => match &m.values.get(*v)?.kind {
+            ValueKind::Const(Const::Int(n)) => Some(*n as i64),
+            ValueKind::Const(Const::Null) => Some(0),
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
+/// Las function constants declaradas en el módulo.
+pub fn constantes(m: &Module) -> Vec<FuncConst> {
+    let Some(nodos) = m.named_md.get("air.function_constants") else { return Vec::new() };
+    nodos
+        .iter()
+        .filter_map(|&n| {
+            let o = m.md_node(n)?;
+            Some(FuncConst {
+                global: md_global(m, o.first().copied().flatten())?,
+                tipo: o.get(1).copied().flatten().and_then(|i| m.md_str(i)).unwrap_or("").to_string(),
+                nombre: o.get(2).copied().flatten().and_then(|i| m.md_str(i)).unwrap_or("").to_string(),
+                indice: md_int(m, o.get(3).copied().flatten())? as u32,
+            })
+        })
+        .collect()
+}
+
+/// Resultado de especializar: la memoria de las globales tras el constructor y qué constantes se dieron.
+pub struct Especializacion {
+    pub memoria: Memoria,
+    pub definidas: Vec<usize>,
+}
+
+/// Especializa con `valores` (índice de la function constant → valor). Las que no se den quedan sin definir
+/// (air.is_function_constant_defined da falso).
+pub fn especializar(m: &Module, valores: &HashMap<u32, V>) -> Res<Especializacion> {
+    let mut mem = Memoria::nueva(m);
+    let mut definidas = Vec::new();
+    for fc in constantes(m) {
+        if let Some(v) = valores.get(&fc.indice) {
+            let ty = m.globals[fc.global].ty;
+            // un bool de Metal es un i8 en memoria
+            let v = match (&m.types[ty], v) {
+                (Type::Int(8), V::Int(1, x)) => V::Int(8, *x),
+                (_, v) => v.clone(),
+            };
+            mem.guardar(m, &V::Ptr(Mem::Global(fc.global), 0), ty, &v).map_err(|e| format!("constante {}: {e}", fc.nombre))?;
+            definidas.push(fc.global);
+        }
+    }
+    // constructores globales: @llvm.global_ctors = [{ i32 prioridad, ptr función, ptr datos }]
+    let ctores: Vec<usize> = m
+        .globals
+        .iter()
+        .find(|g| g.name == "llvm.global_ctors")
+        .and_then(|g| g.init)
+        .and_then(|i| match &m.values.get(i)?.kind {
+            ValueKind::Const(Const::Aggregate(es)) => Some(es.clone()),
+            _ => None,
+        })
+        .unwrap_or_default()
+        .into_iter()
+        .filter_map(|e| match &m.values.get(e)?.kind {
+            ValueKind::Const(Const::Aggregate(campos)) => match &m.values.get(*campos.get(1)?)?.kind {
+                ValueKind::Function(f) => Some(*f),
+                _ => None,
+            },
+            _ => None,
+        })
+        .collect();
+    let def = definidas.clone();
+    let mut externas = move |nombre: &str, args: &[V]| -> Option<Option<V>> {
+        match nombre {
+            "air.is_function_constant_defined" => match args.first()? {
+                V::Ptr(Mem::Global(g), _) => Some(Some(V::Int(1, def.contains(g) as u64))),
+                _ => None,
+            },
+            // un bool de function constant normalizado a 0/1
+            n if n.starts_with("air.normalize_function_constant_predicate") => match args.first()? {
+                V::Int(w, x) => Some(Some(V::Int(*w, (*x != 0) as u64))),
+                V::Undef => Some(Some(V::Int(8, 0))),
+                _ => None,
+            },
+            n if n.starts_with("llvm.lifetime") || n.starts_with("llvm.dbg") => Some(None),
+            _ => None,
+        }
+    };
+    for f in ctores {
+        let mut pasos = 0;
+        interp::ejecutar(m, f, &[], &mut mem, &mut externas, &mut pasos).map_err(|e| format!("constructor {}: {e}", m.functions[f].name))?;
+    }
+    Ok(Especializacion { memoria: mem, definidas })
+}
diff --git a/tahoe-gpu/src/air/inline.rs b/tahoe-gpu/src/air/inline.rs
new file mode 100644
index 0000000..0db4a2f
--- /dev/null
+++ b/tahoe-gpu/src/air/inline.rs
@@ -0,0 +1,190 @@
+//! Inlining en el IR: las llamadas a funciones definidas en el módulo (las internas `fastcc` que deja el compilador
+//! de Metal) se sustituyen por su cuerpo. Así el traductor a SPIR-V solo ve una función, con todos sus punteros
+//! locales a la vista (un puntero de Metal se traduce como «buffer + desplazamiento» y no puede pasar de una función
+//! de SPIR-V a otra).
+
+use super::ir::{BasicBlock, Function, Inst, Instr, Module, Value, ValueId, ValueKind};
+
+pub type Res<T> = Result<T, String>;
+
+/// Devuelve una copia de la función con todas las llamadas a funciones del módulo sustituidas (en profundidad).
+pub fn inline_todo(m: &Module, fi: usize) -> Res<Function> {
+    let mut f = m.functions[fi].clone();
+    let mut vueltas = 0;
+    loop {
+        let pos = f.blocks.iter().enumerate().find_map(|(b, blk)| {
+            blk.insts.iter().position(|i| es_llamada_interna(m, &f, i)).map(|k| (b, k))
+        });
+        let Some((b, k)) = pos else { return Ok(f) };
+        vueltas += 1;
+        if vueltas > 1000 {
+            return Err("demasiadas llamadas internas (¿recursión?)".into());
+        }
+        insertar(m, &mut f, b, k)?;
+    }
+}
+
+fn es_llamada_interna(m: &Module, f: &Function, i: &Instr) -> bool {
+    if let Inst::Call { callee, .. } = &i.inst {
+        if let Some(ValueKind::Function(c)) = f.values.get(*callee).map(|v| &v.kind) {
+            return !m.functions[*c].is_proto;
+        }
+    }
+    false
+}
+
+/// Sustituye la llamada en (bloque b, instrucción k).
+fn insertar(m: &Module, f: &mut Function, b: usize, k: usize) -> Res<()> {
+    let llamada = f.blocks[b].insts[k].clone();
+    let Inst::Call { callee, args, .. } = &llamada.inst else { unreachable!() };
+    let ValueKind::Function(ci) = f.values[*callee].kind else { unreachable!() };
+    let callee_f = &m.functions[ci];
+    if callee_f.blocks.is_empty() {
+        return Err(format!("{}: sin cuerpo", callee_f.name));
+    }
+    // 1) partir el bloque: [0..k) se queda en b; (k..] pasa a un bloque nuevo `cont`
+    let resto: Vec<Instr> = f.blocks[b].insts.split_off(k + 1);
+    f.blocks[b].insts.pop(); // la llamada
+    let cont = f.blocks.len();
+    f.blocks.push(BasicBlock { insts: resto });
+    // los sucesores de b ahora lo son de cont: sus phis deben nombrar a cont
+    for s in sucesores(&f.blocks[cont]) {
+        for ins in &mut f.blocks[s].insts {
+            if let Inst::Phi { incoming } = &mut ins.inst {
+                for (_, pb) in incoming.iter_mut() {
+                    if *pb == b {
+                        *pb = cont;
+                    }
+                }
+            }
+        }
+    }
+    // las instrucciones movidas a cont cambian de bloque en la tabla de valores
+    for (pos, ins) in f.blocks[cont].insts.iter().enumerate() {
+        if let Some(v) = ins.val {
+            f.values[v].kind = ValueKind::Inst(cont, pos);
+        }
+    }
+    // 2) copiar los valores del llamado: los globales y constantes del módulo coinciden (mismo prefijo de la tabla);
+    //    los argumentos se sustituyen por los de la llamada; constantes locales e instrucciones, nuevos números
+    let n_mod = m.values.len();
+    let mut mapa: Vec<ValueId> = Vec::with_capacity(callee_f.values.len());
+    let base_bloque = f.blocks.len();
+    for (v, val) in callee_f.values.iter().enumerate() {
+        if v < n_mod {
+            mapa.push(v);
+            continue;
+        }
+        match &val.kind {
+            ValueKind::Arg(i) => mapa.push(*args.get(*i).ok_or("faltan argumentos en la llamada")?),
+            ValueKind::Inst(bb, pos) => {
+                mapa.push(f.values.len());
+                f.values.push(Value { ty: val.ty, kind: ValueKind::Inst(base_bloque + bb, *pos) });
+            }
+            _ => {
+                mapa.push(f.values.len());
+                f.values.push(val.clone());
+            }
+        }
+    }
+    // las constantes copiadas que nombran otras constantes locales (agregados): a los números nuevos
+    for (v, _) in callee_f.values.iter().enumerate().skip(n_mod) {
+        let nv = mapa[v];
+        if let ValueKind::Const(super::ir::Const::Aggregate(ids)) = &f.values[nv].kind {
+            let ids2: Vec<ValueId> = ids.iter().map(|&i| mapa.get(i).copied().unwrap_or(i)).collect();
+            f.values[nv].kind = ValueKind::Const(super::ir::Const::Aggregate(ids2));
+        }
+    }
+    let mv = |v: ValueId| -> ValueId { if v >= 1_000_000_000 { v } else { mapa.get(v).copied().unwrap_or(v) } };
+    let mb = |x: usize| base_bloque + x;
+    // 3) copiar los bloques del llamado; cada ret salta a cont y aporta su valor al phi del resultado
+    let mut rets: Vec<(Option<ValueId>, usize)> = Vec::new();
+    for (bi, blk) in callee_f.blocks.iter().enumerate() {
+        let mut nb = BasicBlock::default();
+        for ins in &blk.insts {
+            let val = ins.val.map(mv);
+            let inst = match &ins.inst {
+                Inst::Ret(v) => {
+                    rets.push((v.map(mv), mb(bi)));
+                    Inst::Br(cont)
+                }
+                other => remapear(other, &mv, &mb),
+            };
+            nb.insts.push(Instr { inst, ty: ins.ty, val });
+        }
+        f.blocks.push(nb);
+    }
+    // 4) b salta a la entrada del llamado
+    f.blocks[b].insts.push(Instr { inst: Inst::Br(base_bloque), ty: llamada.ty, val: None });
+    // 5) el resultado: un phi al principio de cont con los valores de los ret
+    if let Some(res) = llamada.val {
+        let inc: Vec<(ValueId, usize)> = rets.iter().filter_map(|(v, bb)| v.map(|v| (v, *bb))).collect();
+        if inc.len() == 1 {
+            // un solo ret: el resultado es ese valor; se sustituye en todos los usos
+            sustituir(f, res, inc[0].0);
+        } else {
+            f.blocks[cont].insts.insert(0, Instr { inst: Inst::Phi { incoming: inc }, ty: llamada.ty, val: Some(res) });
+            for (pos, ins) in f.blocks[cont].insts.iter().enumerate() {
+                if let Some(v) = ins.val {
+                    f.values[v].kind = ValueKind::Inst(cont, pos);
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+pub fn sucesores(b: &BasicBlock) -> Vec<usize> {
+    match b.insts.last().map(|i| &i.inst) {
+        Some(Inst::Br(t)) => vec![*t],
+        Some(Inst::CondBr { t, f, .. }) => vec![*t, *f],
+        Some(Inst::Switch { default, cases, .. }) => {
+            let mut v = vec![*default];
+            v.extend(cases.iter().map(|(_, b)| *b));
+            v
+        }
+        _ => Vec::new(),
+    }
+}
+
+/// Cambia todos los usos del valor `de` por `a`.
+fn sustituir(f: &mut Function, de: ValueId, a: ValueId) {
+    let mv = |v: ValueId| if v == de { a } else { v };
+    let mb = |x: usize| x;
+    for blk in &mut f.blocks {
+        for ins in &mut blk.insts {
+            ins.inst = remapear(&ins.inst, &mv, &mb);
+        }
+    }
+}
+
+/// Copia de la instrucción con los valores y bloques renombrados.
+pub fn remapear(i: &Inst, v: &dyn Fn(ValueId) -> ValueId, b: &dyn Fn(usize) -> usize) -> Inst {
+    match i {
+        Inst::Bin { op, a, b: x } => Inst::Bin { op: *op, a: v(*a), b: v(*x) },
+        Inst::FNeg(a) => Inst::FNeg(v(*a)),
+        Inst::Cast { op, v: x } => Inst::Cast { op: *op, v: v(*x) },
+        Inst::Cmp { pred, a, b: x } => Inst::Cmp { pred: *pred, a: v(*a), b: v(*x) },
+        Inst::Select { c, t, f } => Inst::Select { c: v(*c), t: v(*t), f: v(*f) },
+        Inst::ExtractElt { v: x, i } => Inst::ExtractElt { v: v(*x), i: v(*i) },
+        Inst::InsertElt { v: x, e, i } => Inst::InsertElt { v: v(*x), e: v(*e), i: v(*i) },
+        Inst::Shuffle { a, b: x, mask } => Inst::Shuffle { a: v(*a), b: v(*x), mask: v(*mask) },
+        Inst::ExtractVal { v: x, idx } => Inst::ExtractVal { v: v(*x), idx: idx.clone() },
+        Inst::InsertVal { agg, v: x, idx } => Inst::InsertVal { agg: v(*agg), v: v(*x), idx: idx.clone() },
+        Inst::Load { ptr, align } => Inst::Load { ptr: v(*ptr), align: *align },
+        Inst::Store { ptr, val, align } => Inst::Store { ptr: v(*ptr), val: v(*val), align: *align },
+        Inst::Gep { src_ty, ptr, idx, inbounds } => Inst::Gep { src_ty: *src_ty, ptr: v(*ptr), idx: idx.iter().map(|&x| v(x)).collect(), inbounds: *inbounds },
+        Inst::Alloca { ty, n, align } => Inst::Alloca { ty: *ty, n: v(*n), align: *align },
+        Inst::Call { fnty, callee, args } => Inst::Call { fnty: *fnty, callee: v(*callee), args: args.iter().map(|&x| v(x)).collect() },
+        Inst::Phi { incoming } => Inst::Phi { incoming: incoming.iter().map(|&(x, bb)| (v(x), b(bb))).collect() },
+        Inst::Br(t) => Inst::Br(b(*t)),
+        Inst::CondBr { c, t, f } => Inst::CondBr { c: v(*c), t: b(*t), f: b(*f) },
+        Inst::Switch { v: x, default, cases } => Inst::Switch { v: v(*x), default: b(*default), cases: cases.iter().map(|&(c, bb)| (v(c), b(bb))).collect() },
+        Inst::Ret(x) => Inst::Ret(x.map(v)),
+        Inst::Unreachable => Inst::Unreachable,
+        Inst::Freeze(x) => Inst::Freeze(v(*x)),
+        Inst::AtomicRmw { op, ptr, val } => Inst::AtomicRmw { op: *op, ptr: v(*ptr), val: v(*val) },
+        Inst::CmpXchg { ptr, cmp, new } => Inst::CmpXchg { ptr: v(*ptr), cmp: v(*cmp), new: v(*new) },
+        Inst::Fence => Inst::Fence,
+    }
+}
diff --git a/tahoe-gpu/src/air/interp.rs b/tahoe-gpu/src/air/interp.rs
new file mode 100644
index 0000000..4870d57
--- /dev/null
+++ b/tahoe-gpu/src/air/interp.rs
@@ -0,0 +1,1241 @@
+//! Intérprete del IR de AIR en la CPU. Sirve para tres cosas:
+//! - ejecutar el constructor global que deriva los predicados de las function constants (`__metal_implicit_fc_pred_N`)
+//!   a partir de los valores que da la app al crear el pipeline;
+//! - plegar constantes al traducir (`plegar`: las instrucciones sin memoria con operandos conocidos);
+//! - de referencia en las pruebas: el mismo kernel en la CPU y en la GPU deben dar lo mismo.
+
+use super::ir::{BinOp, CastOp, Const, Function, Inst, Module, Type, TypeId, ValueId, ValueKind};
+use super::layout;
+
+pub type Res<T> = Result<T, String>;
+
+/// Un valor concreto.
+#[derive(Debug, Clone, PartialEq)]
+pub enum V {
+    /// Entero de `bits` bits, guardado con extensión de ceros.
+    Int(u32, u64),
+    /// Real; `bits` es 16, 32 o 64 (el valor ya está redondeado a esa precisión).
+    Real(u32, f64),
+    Vec(Vec<V>),
+    Agg(Vec<V>),
+    Ptr(Mem, i64),
+    Undef,
+}
+
+/// Región de memoria a la que apunta un puntero.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Mem {
+    Null,
+    Global(usize),
+    Alloca(usize),
+    Function(usize),
+    /// Región externa (buffers de un kernel en las pruebas): número que da quien llama.
+    Externa(u32),
+}
+
+fn mask(bits: u32) -> u64 {
+    if bits >= 64 { u64::MAX } else { (1u64 << bits) - 1 }
+}
+
+fn sext(bits: u32, v: u64) -> i64 {
+    if bits == 0 || bits >= 64 {
+        return v as i64;
+    }
+    let s = 64 - bits;
+    ((v << s) as i64) >> s
+}
+
+/// bfloat16 (los 16 bits altos de un f32, redondeo al par más cercano). En el intérprete se marca con «17 bits».
+pub const BF16: u32 = 17;
+
+pub fn f32_a_bf16(x: f32) -> u16 {
+    let b = x.to_bits();
+    if x.is_nan() {
+        return ((b >> 16) | 0x40) as u16;
+    }
+    ((b + 0x7fff + ((b >> 16) & 1)) >> 16) as u16
+}
+
+pub fn bf16_a_f32(h: u16) -> f32 {
+    f32::from_bits((h as u32) << 16)
+}
+
+fn redondear(bits: u32, x: f64) -> f64 {
+    match bits {
+        16 => f16_a_f32(f32_a_f16(x as f32)) as f64,
+        BF16 => bf16_a_f32(f32_a_bf16(x as f32)) as f64,
+        32 => x as f32 as f64,
+        _ => x,
+    }
+}
+
+/// float → half (redondeo al más cercano).
+pub fn f32_a_f16(x: f32) -> u16 {
+    let b = x.to_bits();
+    let s = ((b >> 16) & 0x8000) as u16;
+    let e = ((b >> 23) & 0xff) as i32;
+    let m = b & 0x7f_ffff;
+    if e == 0xff {
+        return s | 0x7c00 | if m != 0 { 0x200 } else { 0 };
+    }
+    let e2 = e - 127 + 15;
+    if e2 >= 0x1f {
+        return s | 0x7c00;
+    }
+    if e2 <= 0 {
+        if e2 < -10 {
+            return s;
+        }
+        let m = m | 0x80_0000;
+        let shift = (14 - e2) as u32;
+        let half = 1 << (shift - 1);
+        let r = m >> shift;
+        let rem = m & ((1 << shift) - 1);
+        let r = if rem > half || (rem == half && r & 1 != 0) { r + 1 } else { r };
+        return s | r as u16;
+    }
+    let r = ((e2 as u32) << 10) | (m >> 13);
+    let rem = m & 0x1fff;
+    let r = if rem > 0x1000 || (rem == 0x1000 && r & 1 != 0) { r + 1 } else { r };
+    s | r as u16
+}
+
+pub fn f16_a_f32(h: u16) -> f32 {
+    let s = ((h & 0x8000) as u32) << 16;
+    let e = ((h >> 10) & 0x1f) as u32;
+    let m = (h & 0x3ff) as u32;
+    let b = if e == 0 {
+        if m == 0 {
+            s
+        } else {
+            // subnormal
+            let mut e = 127 - 15 + 1;
+            let mut m = m;
+            while m & 0x400 == 0 {
+                m <<= 1;
+                e -= 1;
+            }
+            s | (e << 23) | ((m & 0x3ff) << 13)
+        }
+    } else if e == 0x1f {
+        s | 0x7f80_0000 | (m << 13)
+    } else {
+        s | ((e + 127 - 15) << 23) | (m << 13)
+    };
+    f32::from_bits(b)
+}
+
+impl V {
+    pub fn int(&self) -> Option<u64> {
+        match self {
+            V::Int(_, v) => Some(*v),
+            _ => None,
+        }
+    }
+    pub fn real(&self) -> Option<f64> {
+        match self {
+            V::Real(_, v) => Some(*v),
+            _ => None,
+        }
+    }
+    fn elems(&self) -> Option<&[V]> {
+        match self {
+            V::Vec(v) | V::Agg(v) => Some(v),
+            _ => None,
+        }
+    }
+}
+
+/// El valor de una constante del IR.
+pub fn constante(m: &Module, values: &[super::ir::Value], ty: TypeId, c: &Const) -> Option<V> {
+    Some(match c {
+        Const::Null => cero(m, ty),
+        Const::Undef | Const::Poison => V::Undef,
+        Const::Int(n) => match &m.types[ty] {
+            Type::Int(w) => V::Int(*w, (*n as u64) & mask(*w)),
+            _ => return None,
+        },
+        Const::Float(b) => match &m.types[ty] {
+            Type::Half => V::Real(16, f16_a_f32(*b as u16) as f64),
+            Type::BFloat => V::Real(BF16, bf16_a_f32(*b as u16) as f64),
+            Type::Float => V::Real(32, f32::from_bits(*b as u32) as f64),
+            Type::Double => V::Real(64, f64::from_bits(*b)),
+            _ => return None,
+        },
+        Const::Aggregate(ids) => {
+            let mut v = Vec::with_capacity(ids.len());
+            for &i in ids {
+                let x = values.get(i)?;
+                v.push(match &x.kind {
+                    ValueKind::Const(c) => constante(m, values, x.ty, c)?,
+                    ValueKind::Global(g) => V::Ptr(Mem::Global(*g), 0),
+                    ValueKind::Function(f) => V::Ptr(Mem::Function(*f), 0),
+                    _ => return None,
+                });
+            }
+            if matches!(m.types[ty], Type::Vector(..)) { V::Vec(v) } else { V::Agg(v) }
+        }
+        Const::Data(d) => {
+            let e = match &m.types[ty] {
+                Type::Vector(_, e) | Type::Array(_, e) => *e,
+                _ => return None,
+            };
+            let v: Vec<V> = d
+                .iter()
+                .map(|&x| match &m.types[e] {
+                    Type::Int(w) => V::Int(*w, x & mask(*w)),
+                    Type::Half => V::Real(16, f16_a_f32(x as u16) as f64),
+                    Type::BFloat => V::Real(BF16, bf16_a_f32(x as u16) as f64),
+                    Type::Float => V::Real(32, f32::from_bits(x as u32) as f64),
+                    Type::Double => V::Real(64, f64::from_bits(x)),
+                    _ => V::Undef,
+                })
+                .collect();
+            if matches!(m.types[ty], Type::Vector(..)) { V::Vec(v) } else { V::Agg(v) }
+        }
+        Const::Str(s) => V::Agg(s.iter().map(|&b| V::Int(8, b as u64)).collect()),
+        Const::Expr { code, ops } => {
+            // CE_CAST [opcode, tipo, valor]: los usados en AIR (addrspacecast y bitcast de punteros)
+            if *code == 11 && ops.len() >= 3 && (ops[0] == 11 || ops[0] == 12) {
+                let x = values.get(ops[2] as usize)?;
+                return match &x.kind {
+                    ValueKind::Global(g) => Some(V::Ptr(Mem::Global(*g), 0)),
+                    ValueKind::Function(f) => Some(V::Ptr(Mem::Function(*f), 0)),
+                    ValueKind::Const(c) => constante(m, values, x.ty, c),
+                    _ => None,
+                };
+            }
+            // GEP constante: CE_GEP (32) [tipo base, banderas, (tipo, valor)*]; CE_INBOUNDS_GEP (20) y CE_GEP antiguo (12):
+            // [(tipo base), (tipo, valor)*] (con número impar de operandos, el primero es el tipo base)
+            let (src, pares) = match *code {
+                32 => (ops.first()?, ops.get(2..)?),
+                20 | 12 if ops.len() % 2 == 1 => (ops.first()?, ops.get(1..)?),
+                _ => return None,
+            };
+            let mut vals = Vec::new();
+            for par in pares.chunks(2) {
+                let x = values.get(*par.get(1)? as usize)?;
+                vals.push(match &x.kind {
+                    ValueKind::Global(g) => V::Ptr(Mem::Global(*g), 0),
+                    ValueKind::Function(f) => V::Ptr(Mem::Function(*f), 0),
+                    ValueKind::Const(c) => constante(m, values, x.ty, c)?,
+                    _ => return None,
+                });
+            }
+            let (base, idx) = vals.split_first()?;
+            return gep(m, *src as usize, base, idx);
+        }
+    })
+}
+
+/// El cero de un tipo.
+pub fn cero(m: &Module, ty: TypeId) -> V {
+    match &m.types[ty] {
+        Type::Int(w) => V::Int(*w, 0),
+        Type::Half => V::Real(16, 0.0),
+        Type::BFloat => V::Real(BF16, 0.0),
+        Type::Float => V::Real(32, 0.0),
+        Type::Double => V::Real(64, 0.0),
+        Type::Ptr(_) => V::Ptr(Mem::Null, 0),
+        Type::Vector(n, e) => V::Vec(vec![cero(m, *e); *n as usize]),
+        Type::Array(n, e) => V::Agg(vec![cero(m, *e); *n as usize]),
+        Type::Struct { elems, .. } => V::Agg(elems.iter().map(|&e| cero(m, e)).collect()),
+        _ => V::Undef,
+    }
+}
+
+fn real_bits(m: &Module, t: TypeId) -> Option<u32> {
+    match &m.types[t] {
+        Type::Half => Some(16),
+        Type::BFloat => Some(BF16),
+        Type::Float => Some(32),
+        Type::Double => Some(64),
+        Type::Vector(_, e) => real_bits(m, *e),
+        _ => None,
+    }
+}
+
+fn int_bits(m: &Module, t: TypeId) -> Option<u32> {
+    match &m.types[t] {
+        Type::Int(w) => Some(*w),
+        Type::Vector(_, e) => int_bits(m, *e),
+        _ => None,
+    }
+}
+
+/// Aplica `f` componente a componente (vectores) o al valor (escalares).
+fn por_comp(a: &V, b: &V, f: &impl Fn(&V, &V) -> Option<V>) -> Option<V> {
+    match (a, b) {
+        (V::Vec(x), V::Vec(y)) => Some(V::Vec(x.iter().zip(y).map(|(p, q)| por_comp(p, q, f)).collect::<Option<_>>()?)),
+        _ => f(a, b),
+    }
+}
+
+fn bin(op: BinOp, a: &V, b: &V) -> Option<V> {
+    por_comp(a, b, &|a, b| match (a, b) {
+        (V::Int(w, x), V::Int(_, y)) => {
+            let (w, x, y) = (*w, *x, *y);
+            let (sx, sy) = (sext(w, x), sext(w, y));
+            let r = match op {
+                BinOp::Add => x.wrapping_add(y),
+                BinOp::Sub => x.wrapping_sub(y),
+                BinOp::Mul => x.wrapping_mul(y),
+                // entre cero: indefinido en LLVM (y en la GPU, un valor cualquiera)
+                BinOp::UDiv => match x.checked_div(y) { Some(r) => r, None => return Some(V::Undef) },
+                BinOp::SDiv => match sx.checked_div(sy) { Some(r) => r as u64, None => return Some(V::Undef) },
+                BinOp::URem => match x.checked_rem(y) { Some(r) => r, None => return Some(V::Undef) },
+                BinOp::SRem => match sx.checked_rem(sy) { Some(r) => r as u64, None => return Some(V::Undef) },
+                BinOp::Shl => if y >= w as u64 { return Some(V::Undef) } else { x << y },
+                BinOp::LShr => if y >= w as u64 { return Some(V::Undef) } else { x >> y },
+                BinOp::AShr => if y >= w as u64 { return Some(V::Undef) } else { (sx >> y) as u64 },
+                BinOp::And => x & y,
+                BinOp::Or => x | y,
+                BinOp::Xor => x ^ y,
+            };
+            Some(V::Int(w, r & mask(w)))
+        }
+        (V::Real(w, x), V::Real(_, y)) => {
+            let r = match op {
+                BinOp::Add => x + y,
+                BinOp::Sub => x - y,
+                BinOp::Mul => x * y,
+                BinOp::UDiv | BinOp::SDiv => x / y, // fdiv llega con el mismo código
+                BinOp::URem | BinOp::SRem => x % y,
+                _ => return None,
+            };
+            Some(V::Real(*w, redondear(*w, r)))
+        }
+        (V::Undef, _) | (_, V::Undef) => Some(V::Undef),
+        _ => None,
+    })
+}
+
+fn cmp(pred: u32, a: &V, b: &V) -> Option<V> {
+    por_comp(a, b, &|a, b| {
+        let r = match (a, b) {
+            (V::Real(_, x), V::Real(_, y)) => {
+                let uno = x.is_nan() || y.is_nan();
+                match pred {
+                    0 => false,
+                    1 => !uno && x == y,
+                    2 => !uno && x > y,
+                    3 => !uno && x >= y,
+                    4 => !uno && x < y,
+                    5 => !uno && x <= y,
+                    6 => !uno && x != y,
+                    7 => !uno,
+                    8 => uno,
+                    9 => uno || x == y,
+                    10 => uno || x > y,
+                    11 => uno || x >= y,
+                    12 => uno || x < y,
+                    13 => uno || x <= y,
+                    14 => uno || x != y,
+                    15 => true,
+                    _ => return None,
+                }
+            }
+            (V::Int(w, x), V::Int(_, y)) => {
+                let (sx, sy) = (sext(*w, *x), sext(*w, *y));
+                match pred {
+                    32 => x == y,
+                    33 => x != y,
+                    34 => x > y,
+                    35 => x >= y,
+                    36 => x < y,
+                    37 => x <= y,
+                    38 => sx > sy,
+                    39 => sx >= sy,
+                    40 => sx < sy,
+                    41 => sx <= sy,
+                    _ => return None,
+                }
+            }
+            (V::Ptr(m1, o1), V::Ptr(m2, o2)) => match pred {
+                32 => m1 == m2 && o1 == o2,
+                33 => m1 != m2 || o1 != o2,
+                _ => return None,
+            },
+            _ => return None,
+        };
+        Some(V::Int(1, r as u64))
+    })
+}
+
+fn cast(m: &Module, op: CastOp, v: &V, to: TypeId) -> Option<V> {
+    let elem_to = match &m.types[to] {
+        Type::Vector(_, e) => *e,
+        _ => to,
+    };
+    if let V::Vec(x) = v {
+        if !matches!(op, CastOp::BitCast) {
+            return Some(V::Vec(x.iter().map(|e| cast(m, op, e, elem_to)).collect::<Option<_>>()?));
+        }
+    }
+    let tb = int_bits(m, to);
+    let tr = real_bits(m, to);
+    Some(match (op, v) {
+        (_, V::Undef) => V::Undef,
+        (CastOp::Trunc | CastOp::ZExt, V::Int(_, x)) => V::Int(tb?, x & mask(tb?)),
+        (CastOp::SExt, V::Int(w, x)) => V::Int(tb?, sext(*w, *x) as u64 & mask(tb?)),
+        (CastOp::FPToUI, V::Real(_, x)) => V::Int(tb?, (*x as u64) & mask(tb?)),
+        (CastOp::FPToSI, V::Real(_, x)) => V::Int(tb?, (*x as i64) as u64 & mask(tb?)),
+        (CastOp::UIToFP, V::Int(_, x)) => V::Real(tr?, redondear(tr?, *x as f64)),
+        (CastOp::SIToFP, V::Int(w, x)) => V::Real(tr?, redondear(tr?, sext(*w, *x) as f64)),
+        (CastOp::FPTrunc | CastOp::FPExt, V::Real(_, x)) => V::Real(tr?, redondear(tr?, *x)),
+        (CastOp::AddrSpaceCast | CastOp::BitCast, V::Ptr(..)) => v.clone(),
+        (CastOp::PtrToInt, V::Ptr(Mem::Null, o)) => V::Int(tb?, *o as u64 & mask(tb?)),
+        (CastOp::IntToPtr, V::Int(_, 0)) => V::Ptr(Mem::Null, 0),
+        (CastOp::BitCast, _) => {
+            let bytes = a_bytes_v(v)?;
+            de_bytes(m, to, &bytes)?
+        }
+        _ => return None,
+    })
+}
+
+/// Bytes de un valor según su propia forma (para bitcast entre tipos del mismo tamaño).
+fn a_bytes_v(v: &V) -> Option<Vec<u8>> {
+    Some(match v {
+        V::Int(w, x) => x.to_le_bytes()[..(*w as usize).div_ceil(8)].to_vec(),
+        V::Real(16, x) => f32_a_f16(*x as f32).to_le_bytes().to_vec(),
+        V::Real(32, x) => (*x as f32).to_le_bytes().to_vec(),
+        V::Real(_, x) => x.to_le_bytes().to_vec(),
+        V::Vec(e) => e.iter().map(a_bytes_v).collect::<Option<Vec<_>>>()?.concat(),
+        _ => return None,
+    })
+}
+
+/// Un valor del tipo `t` desde bytes (disposición de memoria de AIR).
+pub fn de_bytes(m: &Module, t: TypeId, b: &[u8]) -> Option<V> {
+    let rd = |n: usize| -> Option<u64> {
+        let s = b.get(..n)?;
+        let mut a = [0u8; 8];
+        a[..n].copy_from_slice(s);
+        Some(u64::from_le_bytes(a))
+    };
+    Some(match &m.types[t] {
+        Type::Int(w) => V::Int(*w, rd((*w as usize).div_ceil(8))? & mask(*w)),
+        Type::Half => V::Real(16, f16_a_f32(rd(2)? as u16) as f64),
+        Type::BFloat => V::Real(BF16, bf16_a_f32(rd(2)? as u16) as f64),
+        Type::Float => V::Real(32, f32::from_bits(rd(4)? as u32) as f64),
+        Type::Double => V::Real(64, f64::from_bits(rd(8)?)),
+        Type::Vector(n, e) => {
+            let es = layout::elem_size(m, t) as usize;
+            V::Vec((0..*n as usize).map(|i| de_bytes(m, *e, b.get(i * es..)?)).collect::<Option<_>>()?)
+        }
+        Type::Array(n, e) => {
+            let es = layout::size(m, *e) as usize;
+            V::Agg((0..*n as usize).map(|i| de_bytes(m, *e, b.get(i * es..)?)).collect::<Option<_>>()?)
+        }
+        Type::Struct { elems, .. } => {
+            let offs = layout::offsets(m, t);
+            V::Agg(elems.iter().zip(offs).map(|(&e, o)| de_bytes(m, e, b.get(o as usize..)?)).collect::<Option<_>>()?)
+        }
+        _ => return None,
+    })
+}
+
+/// Bytes de un valor del tipo `t` (lo inverso de `de_bytes`). Los punteros no se pueden guardar en memoria
+/// interpretada salvo nulos.
+pub fn a_bytes(m: &Module, t: TypeId, v: &V, out: &mut [u8]) -> Option<()> {
+    let wr = |out: &mut [u8], n: usize, x: u64| -> Option<()> {
+        out.get_mut(..n)?.copy_from_slice(&x.to_le_bytes()[..n]);
+        Some(())
+    };
+    match (&m.types[t], v) {
+        (_, V::Undef) => Some(()),
+        (Type::Int(w), V::Int(_, x)) => wr(out, (*w as usize).div_ceil(8), *x),
+        (Type::Half, V::Real(_, x)) => wr(out, 2, f32_a_f16(*x as f32) as u64),
+        (Type::BFloat, V::Real(_, x)) => wr(out, 2, f32_a_bf16(*x as f32) as u64),
+        (Type::Float, V::Real(_, x)) => wr(out, 4, (*x as f32).to_bits() as u64),
+        (Type::Double, V::Real(_, x)) => wr(out, 8, x.to_bits()),
+        (Type::Ptr(_), V::Ptr(Mem::Null, o)) => wr(out, 8, *o as u64),
+        (Type::Vector(_, e), V::Vec(xs)) => {
+            let es = layout::elem_size(m, t) as usize;
+            for (i, x) in xs.iter().enumerate() {
+                a_bytes(m, *e, x, out.get_mut(i * es..)?)?;
+            }
+            Some(())
+        }
+        (Type::Array(_, e), V::Agg(xs)) => {
+            let es = layout::size(m, *e) as usize;
+            for (i, x) in xs.iter().enumerate() {
+                a_bytes(m, *e, x, out.get_mut(i * es..)?)?;
+            }
+            Some(())
+        }
+        (Type::Struct { elems, .. }, V::Agg(xs)) => {
+            for ((&e, o), x) in elems.iter().zip(layout::offsets(m, t)).zip(xs) {
+                a_bytes(m, e, x, out.get_mut(o as usize..)?)?;
+            }
+            Some(())
+        }
+        _ => None,
+    }
+}
+
+fn agg_get(v: &V, idx: &[u32]) -> Option<V> {
+    let mut v = v.clone();
+    for &i in idx {
+        v = match v {
+            V::Undef => return Some(V::Undef),
+            _ => v.elems()?.get(i as usize)?.clone(),
+        };
+    }
+    Some(v)
+}
+
+fn agg_set(v: &V, idx: &[u32], x: V) -> Option<V> {
+    if idx.is_empty() {
+        return Some(x);
+    }
+    let mut e = match v {
+        V::Vec(e) | V::Agg(e) => e.clone(),
+        _ => return None,
+    };
+    let i = idx[0] as usize;
+    let n = agg_set(e.get(i)?, &idx[1..], x)?;
+    e[i] = n;
+    Some(if matches!(v, V::Vec(_)) { V::Vec(e) } else { V::Agg(e) })
+}
+
+/// Pliega una instrucción sin efectos con operandos conocidos. None si no se puede (falta un operando, tiene
+/// memoria o efectos, o no es una operación pura).
+pub fn plegar(m: &Module, f: &Function, inst: &Inst, ty: TypeId, get: &dyn Fn(ValueId) -> Option<V>) -> Option<V> {
+    Some(match inst {
+        Inst::Bin { op, a, b } => bin(*op, &get(*a)?, &get(*b)?)?,
+        Inst::FNeg(a) => match get(*a)? {
+            V::Real(w, x) => V::Real(w, -x),
+            V::Vec(xs) => V::Vec(xs.into_iter().map(|x| if let V::Real(w, x) = x { V::Real(w, -x) } else { x }).collect()),
+            v => v,
+        },
+        Inst::Cast { op, v } => cast(m, *op, &get(*v)?, ty)?,
+        Inst::Cmp { pred, a, b } => cmp(*pred, &get(*a)?, &get(*b)?)?,
+        Inst::Select { c, t, f: fl } => match get(*c)? {
+            V::Int(_, x) => if x != 0 { get(*t)? } else { get(*fl)? },
+            V::Vec(cs) => {
+                let (tv, fv) = (get(*t)?, get(*fl)?);
+                let (te, fe) = (tv.elems()?, fv.elems()?);
+                V::Vec(cs.iter().enumerate().map(|(i, c)| if c.int() != Some(0) { te[i].clone() } else { fe[i].clone() }).collect())
+            }
+            _ => return None,
+        },
+        Inst::ExtractElt { v, i } => {
+            let i = get(*i)?.int()? as usize;
+            match get(*v)? {
+                V::Vec(e) => e.get(i)?.clone(),
+                V::Undef => V::Undef,
+                _ => return None,
+            }
+        }
+        Inst::InsertElt { v, e, i } => {
+            let i = get(*i)?.int()? as u32;
+            let base = match get(*v)? {
+                V::Undef => match &m.types[ty] {
+                    Type::Vector(n, _) => V::Vec(vec![V::Undef; *n as usize]),
+                    _ => return None,
+                },
+                x => x,
+            };
+            agg_set(&base, &[i], get(*e)?)?
+        }
+        Inst::Shuffle { a, b, mask: mk } => {
+            let n = match &m.types[f.values[*a].ty] {
+                Type::Vector(n, _) => *n as usize,
+                _ => return None,
+            };
+            let ex = |v: V| -> Vec<V> { match v { V::Vec(e) => e, _ => vec![V::Undef; n] } };
+            let (av, bv) = (ex(get(*a)?), ex(get(*b).unwrap_or(V::Undef)));
+            let mv = match get(*mk)? {
+                V::Vec(e) => e,
+                V::Undef => vec![V::Undef; match &m.types[ty] { Type::Vector(k, _) => *k as usize, _ => return None }],
+                _ => return None,
+            };
+            V::Vec(mv.iter().map(|x| match x.int() {
+                Some(k) if (k as usize) < n => av[k as usize].clone(),
+                Some(k) => bv.get(k as usize - n).cloned().unwrap_or(V::Undef),
+                None => V::Undef,
+            }).collect())
+        }
+        Inst::ExtractVal { v, idx } => agg_get(&get(*v)?, idx)?,
+        Inst::InsertVal { agg, v, idx } => {
+            let base = match get(*agg)? {
+                V::Undef => cero_undef(m, ty),
+                x => x,
+            };
+            agg_set(&base, idx, get(*v)?)?
+        }
+        Inst::Freeze(v) => match get(*v)? {
+            V::Undef => cero(m, ty),
+            x => x,
+        },
+        _ => return None,
+    })
+}
+
+/// Un agregado del tipo con todos sus elementos indefinidos (base de insertvalue sobre undef).
+fn cero_undef(m: &Module, ty: TypeId) -> V {
+    match &m.types[ty] {
+        Type::Vector(n, _) => V::Vec(vec![V::Undef; *n as usize]),
+        Type::Array(n, _) => V::Agg(vec![V::Undef; *n as usize]),
+        Type::Struct { elems, .. } => V::Agg(vec![V::Undef; elems.len()]),
+        _ => V::Undef,
+    }
+}
