+/// MTLBlendFactor
+pub fn factor(f: u32) -> vk::BlendFactor {
+    use vk::BlendFactor as B;
+    match f {
+        0 => B::ZERO,
+        1 => B::ONE,
+        2 => B::SRC_COLOR,
+        3 => B::ONE_MINUS_SRC_COLOR,
+        4 => B::SRC_ALPHA,
+        5 => B::ONE_MINUS_SRC_ALPHA,
+        6 => B::DST_COLOR,
+        7 => B::ONE_MINUS_DST_COLOR,
+        8 => B::DST_ALPHA,
+        9 => B::ONE_MINUS_DST_ALPHA,
+        10 => B::SRC_ALPHA_SATURATE,
+        11 => B::CONSTANT_COLOR,
+        12 => B::ONE_MINUS_CONSTANT_COLOR,
+        13 => B::CONSTANT_ALPHA,
+        14 => B::ONE_MINUS_CONSTANT_ALPHA,
+        15 => B::SRC1_COLOR,
+        16 => B::ONE_MINUS_SRC1_COLOR,
+        17 => B::SRC1_ALPHA,
+        18 => B::ONE_MINUS_SRC1_ALPHA,
+        _ => B::ONE,
+    }
+}
+
+/// MTLBlendOperation
+pub fn operacion(o: u32) -> vk::BlendOp {
+    match o {
+        1 => vk::BlendOp::SUBTRACT,
+        2 => vk::BlendOp::REVERSE_SUBTRACT,
+        3 => vk::BlendOp::MIN,
+        4 => vk::BlendOp::MAX,
+        _ => vk::BlendOp::ADD,
+    }
+}
+
+/// MTLColorWriteMask (rojo 8, verde 4, azul 2, alfa 1)
+pub fn mascara(m: u32) -> vk::ColorComponentFlags {
+    let mut r = vk::ColorComponentFlags::empty();
+    if m & 8 != 0 {
+        r |= vk::ColorComponentFlags::R;
+    }
+    if m & 4 != 0 {
+        r |= vk::ColorComponentFlags::G;
+    }
+    if m & 2 != 0 {
+        r |= vk::ColorComponentFlags::B;
+    }
+    if m & 1 != 0 {
+        r |= vk::ColorComponentFlags::A;
+    }
+    r
+}
+
+/// MTLPrimitiveType → topología de Vulkan (punto 0, línea 1, tira de líneas 2, triángulo 3, tira de triángulos 4).
+pub fn topologia(p: u32) -> vk::PrimitiveTopology {
+    match p {
+        0 => vk::PrimitiveTopology::POINT_LIST,
+        1 => vk::PrimitiveTopology::LINE_LIST,
+        2 => vk::PrimitiveTopology::LINE_STRIP,
+        4 => vk::PrimitiveTopology::TRIANGLE_STRIP,
+        _ => vk::PrimitiveTopology::TRIANGLE_LIST,
+    }
+}
+
+/// MTLSamplerAddressMode
+pub fn direccion(a: u32) -> vk::SamplerAddressMode {
+    match a {
+        1 => vk::SamplerAddressMode::MIRROR_CLAMP_TO_EDGE,
+        2 => vk::SamplerAddressMode::REPEAT,
+        3 => vk::SamplerAddressMode::MIRRORED_REPEAT,
+        4 | 5 => vk::SamplerAddressMode::CLAMP_TO_BORDER,
+        _ => vk::SamplerAddressMode::CLAMP_TO_EDGE,
+    }
+}
+
+/// MTLTextureType → forma del motor
+pub fn forma(t: u32) -> Option<crate::motor::Forma> {
+    use crate::motor::Forma;
+    Some(match t {
+        0 => Forma::D1,
+        1 => Forma::D1Array,
+        2 | 4 => Forma::D2,
+        3 | 8 => Forma::D2Array,
+        5 => Forma::Cubo,
+        6 => Forma::CuboArray,
+        7 => Forma::D3,
+        _ => return None,
+    })
+}
+
+/// Bytes por texel de un formato de Vulkan (los que salen de `pixel`).
+pub fn bytes_de(f: vk::Format) -> Option<u32> {
+    (1..=600).find_map(|m| pixel(m).filter(|(g, _)| *g == f).map(|(_, b)| b))
+}
+
+/// Aspecto de un formato (color, profundidad o estarcido).
+pub fn aspecto(f: vk::Format) -> vk::ImageAspectFlags {
+    match f {
+        vk::Format::D16_UNORM | vk::Format::D32_SFLOAT => vk::ImageAspectFlags::DEPTH,
+        vk::Format::S8_UINT => vk::ImageAspectFlags::STENCIL,
+        vk::Format::D24_UNORM_S8_UINT | vk::Format::D32_SFLOAT_S8_UINT => vk::ImageAspectFlags::DEPTH | vk::ImageAspectFlags::STENCIL,
+        _ => vk::ImageAspectFlags::COLOR,
+    }
+}
diff --git a/tahoe-gpu/src/informe.rs b/tahoe-gpu/src/informe.rs
new file mode 100644
index 0000000..59ab8a1
--- /dev/null
+++ b/tahoe-gpu/src/informe.rs
@@ -0,0 +1,209 @@
+//! `tahoe-gpu informe`: qué pide Metal 2 (familia Mac2, la de los Mac con Intel) y cómo se cubre en esta GPU.
+//! Cada punto sale como «nativo» (Vulkan lo da tal cual), «emulado» (lo resuelve tahoe-gpu, normalmente al traducir
+//! los shaders de Metal a SPIR-V) o «falta» (no hay forma razonable en esta GPU).
+
+use ash::vk;
+
+use crate::vk::Gpu;
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Estado {
+    Nativo,
+    Emulado,
+    Falta,
+}
+
+pub struct Punto {
+    pub que: &'static str,
+    pub estado: Estado,
+    pub nota: String,
+}
+
+/// Lo que se mira de la GPU (separado de Vulkan para poder probar la evaluación sin GPU).
+#[derive(Default, Clone)]
+pub struct Capacidades {
+    pub api: (u32, u32),
+    pub image_cube_array: bool,
+    pub bc: bool,
+    pub d32s8: bool,
+    pub msaa4: bool,
+    pub anisotropy: bool,
+    pub independent_blend: bool,
+    pub dual_src_blend: bool,
+    pub depth_clamp: bool,
+    pub fill_lines: bool,
+    pub layer_from_vertex: bool,
+    pub color_attachments: u32,
+    pub tessellation: bool,
+    pub multi_draw_indirect: bool,
+    pub first_instance: bool,
+    pub max_tex_2d: u32,
+    pub shared_memory: u32,
+    pub max_invocations: u32,
+    pub subgroup_ops: vk::SubgroupFeatureFlags,
+    pub subgroup_stages: vk::ShaderStageFlags,
+    pub float16: bool,
+    pub int64: bool,
+    pub int16: bool,
+    pub variable_pointers: bool,
+    pub buffer_device_address: bool,
+    pub descriptor_indexing: bool,
+    pub vertex_stores: bool,
+    pub storage_read_without_format: bool,
+    pub shader_interlock: bool,
+    pub sample_locations: bool,
+    pub timeline: bool,
+    pub host_memory: bool,
+    pub unified_memory: bool,
+    pub max_storage_buffer: u32,
+}
+
+pub fn capacidades(g: &Gpu) -> Capacidades {
+    let i = &g.instance;
+    let mut f11 = vk::PhysicalDeviceVulkan11Features::default();
+    let mut f12 = vk::PhysicalDeviceVulkan12Features::default();
+    let mut f2 = vk::PhysicalDeviceFeatures2::default().push_next(&mut f11).push_next(&mut f12);
+    let mut sg = vk::PhysicalDeviceSubgroupProperties::default();
+    let mut p2 = vk::PhysicalDeviceProperties2::default().push_next(&mut sg);
+    // SAFETY: dispositivo físico de esta instancia; cadenas pNext válidas mientras dura la llamada.
+    unsafe {
+        i.get_physical_device_features2(g.phys, &mut f2);
+        i.get_physical_device_properties2(g.phys, &mut p2);
+    }
+    let f = f2.features;
+    let l = &g.props.limits;
+    // SAFETY: consulta de un formato en este dispositivo físico.
+    let d32s8 = unsafe { i.get_physical_device_format_properties(g.phys, vk::Format::D32_SFLOAT_S8_UINT) }
+        .optimal_tiling_features
+        .contains(vk::FormatFeatureFlags::DEPTH_STENCIL_ATTACHMENT);
+    let unified_memory = (0..g.mem_props.memory_type_count).any(|k| {
+        g.mem_props.memory_types[k as usize]
+            .property_flags
+            .contains(vk::MemoryPropertyFlags::DEVICE_LOCAL | vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT)
+    });
+    let v = g.props.api_version;
+    Capacidades {
+        api: (vk::api_version_major(v), vk::api_version_minor(v)),
+        image_cube_array: f.image_cube_array != 0,
+        bc: f.texture_compression_bc != 0,
+        d32s8,
+        msaa4: l.framebuffer_color_sample_counts.contains(vk::SampleCountFlags::TYPE_4),
+        anisotropy: f.sampler_anisotropy != 0,
+        independent_blend: f.independent_blend != 0,
+        dual_src_blend: f.dual_src_blend != 0,
+        depth_clamp: f.depth_clamp != 0,
+        fill_lines: f.fill_mode_non_solid != 0,
+        layer_from_vertex: f12.shader_output_layer != 0 && f12.shader_output_viewport_index != 0,
+        color_attachments: l.max_color_attachments,
+        tessellation: f.tessellation_shader != 0,
+        multi_draw_indirect: f.multi_draw_indirect != 0,
+        first_instance: f.draw_indirect_first_instance != 0,
+        max_tex_2d: l.max_image_dimension2_d,
+        shared_memory: l.max_compute_shared_memory_size,
+        max_invocations: l.max_compute_work_group_invocations,
+        subgroup_ops: sg.supported_operations,
+        subgroup_stages: sg.supported_stages,
+        float16: f12.shader_float16 != 0,
+        int64: f.shader_int64 != 0,
+        int16: f.shader_int16 != 0,
+        variable_pointers: f11.variable_pointers != 0,
+        buffer_device_address: f12.buffer_device_address != 0,
+        descriptor_indexing: f12.descriptor_indexing != 0 && f12.runtime_descriptor_array != 0,
+        vertex_stores: f.vertex_pipeline_stores_and_atomics != 0,
+        storage_read_without_format: f.shader_storage_image_read_without_format != 0,
+        shader_interlock: g.has_ext("VK_EXT_fragment_shader_interlock"),
+        sample_locations: g.has_ext("VK_EXT_sample_locations"),
+        timeline: f12.timeline_semaphore != 0,
+        host_memory: g.host_memory.is_some(),
+        unified_memory,
+        max_storage_buffer: l.max_storage_buffer_range,
+    }
+}
+
+fn si(b: bool, nativo: Estado) -> Estado {
+    if b { Estado::Nativo } else { nativo }
+}
+
+/// Requisitos de Metal 2 (MTLGPUFamilyMac2) frente a las capacidades.
+pub fn evaluar(c: &Capacidades) -> Vec<Punto> {
+    use Estado::*;
+    let p = |que, estado, nota: &str| Punto { que, estado, nota: nota.to_string() };
+    let sg_need = vk::SubgroupFeatureFlags::BASIC | vk::SubgroupFeatureFlags::VOTE | vk::SubgroupFeatureFlags::BALLOT
+        | vk::SubgroupFeatureFlags::SHUFFLE | vk::SubgroupFeatureFlags::ARITHMETIC;
+    let sg_ok = c.subgroup_ops.contains(sg_need)
+        && c.subgroup_stages.contains(vk::ShaderStageFlags::COMPUTE | vk::ShaderStageFlags::FRAGMENT);
+    vec![
+        p("Vulkan 1.1 o más", si(c.api >= (1, 1), Falta), &format!("la GPU da {}.{}", c.api.0, c.api.1)),
+        p("Memoria compartida CPU/GPU (MTLStorageModeShared)", si(c.unified_memory && c.host_memory, if c.unified_memory { Emulado } else { Falta }),
+          "GPU integrada: memoria del anfitrión importada (VK_EXT_external_memory_host), sin copias"),
+        p("Texturas cube array", si(c.image_cube_array, Falta), ""),
+        p("Compresión BC (DXT)", si(c.bc, Emulado), "sin ella, se descomprimiría al subir la textura"),
+        p("Depth32Float_Stencil8", si(c.d32s8, Emulado), "sin él, profundidad y esténcil por separado"),
+        p("MSAA 4x", si(c.msaa4, Falta), ""),
+        p("Filtrado anisótropo", si(c.anisotropy, Emulado), ""),
+        p("Mezcla independiente y de dos fuentes", si(c.independent_blend && c.dual_src_blend, Falta), ""),
+        p("Depth clamp y relleno en líneas", si(c.depth_clamp && c.fill_lines, Emulado), ""),
+        p("Capa y viewport desde el vertex shader", si(c.layer_from_vertex, Falta), "render_target_array_index / viewport_array_index"),
+        p("8 attachments de color", si(c.color_attachments >= 8, Falta), &format!("{}", c.color_attachments)),
+        p("Teselado", si(c.tessellation, Emulado), "Metal lo hace con un kernel de cómputo y un post-tessellation vertex shader"),
+        p("Dibujo indirecto múltiple", si(c.multi_draw_indirect && c.first_instance, Emulado), ""),
+        p("Indirect command buffers", Emulado, "se reproducen como dibujos indirectos de Vulkan"),
+        p("Texturas de 16384", si(c.max_tex_2d >= 16384, Falta), &format!("máximo {}", c.max_tex_2d)),
+        p("Memoria de threadgroup de 32 KB", si(c.shared_memory >= 32768, Falta), &format!("{} bytes", c.shared_memory)),
+        p("1024 hilos por threadgroup", si(c.max_invocations >= 1024, Falta), &format!("{}", c.max_invocations)),
+        p("Funciones SIMD-group (Metal 2.1)", si(sg_ok, Emulado), "subgroups de Vulkan; sin ellos, por memoria de threadgroup"),
+        p("half (float de 16 bits)", si(c.float16, Emulado), "se calcula en float de 32 bits (más precisión, mismo resultado visual)"),
+        p("long/ulong (enteros de 64 bits)", si(c.int64, Emulado), "en pares de enteros de 32 bits"),
+        p("short/char (16 y 8 bits)", si(c.int16, Emulado), "ensanchados a 32 bits; en buffers, por bytes con desplazamientos"),
+        p("Punteros device/constant en shaders", si(c.buffer_device_address, if c.variable_pointers { Emulado } else { Falta }),
+          "sin buffer_device_address: puntero = (buffer, desplazamiento), con variable pointers"),
+        p("Argument buffers (tier 1)", Emulado, "como conjuntos de descriptores"),
+        p("Argument buffers tier 2", si(c.descriptor_indexing && c.buffer_device_address, Falta), "los Mac con Intel solo tienen tier 1"),
+        p("Escritura en buffers desde vertex shaders", si(c.vertex_stores, Falta), "poco usado (lo usan algunos juegos)"),
+        p("Texturas read_write sin formato fijo", si(c.storage_read_without_format, Emulado), "una variante del shader por formato de textura"),
+        p("Raster order groups", si(c.shader_interlock, Falta), "VK_EXT_fragment_shader_interlock"),
+        p("Posiciones de muestra programables", si(c.sample_locations, Falta), ""),
+        p("MTLSharedEvent / MTLFence", si(c.timeline, Emulado), "semáforos timeline"),
+        p("Buffers grandes", si(c.max_storage_buffer >= 1 << 30, Emulado), &format!("máximo {} MB por binding; los mayores se trocean", c.max_storage_buffer >> 20)),
+    ]
+}
+
+pub fn informe(g: &Gpu) {
+    let c = capacidades(g);
+    println!("GPU: {}  (Vulkan {}.{}, {} extensiones)", g.name(), c.api.0, c.api.1, g.extensions.len());
+    println!();
+    let pts = evaluar(&c);
+    for pt in &pts {
+        let e = match pt.estado {
+            Estado::Nativo => "nativo ",
+            Estado::Emulado => "emulado",
+            Estado::Falta => "FALTA  ",
+        };
+        if pt.nota.is_empty() { println!("  [{e}] {}", pt.que) } else { println!("  [{e}] {} — {}", pt.que, pt.nota) }
+    }
+    let n = |e| pts.iter().filter(|p| p.estado == e).count();
+    println!();
+    println!("Metal 2: {} nativos, {} emulados, {} faltan", n(Estado::Nativo), n(Estado::Emulado), n(Estado::Falta));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sin_nada_falta_lo_esencial() {
+        let pts = evaluar(&Capacidades::default());
+        let falta = |q: &str| pts.iter().find(|p| p.que.starts_with(q)).map(|p| p.estado);
+        assert_eq!(falta("Vulkan 1.1"), Some(Estado::Falta));
+        assert_eq!(falta("half"), Some(Estado::Emulado));
+        assert_eq!(falta("Indirect command buffers"), Some(Estado::Emulado));
+    }
+
+    #[test]
+    fn punteros_con_variable_pointers_se_emulan() {
+        let c = Capacidades { variable_pointers: true, ..Default::default() };
+        let pts = evaluar(&c);
+        let p = pts.iter().find(|p| p.que.starts_with("Punteros")).unwrap();
+        assert_eq!(p.estado, Estado::Emulado);
+    }
+}
diff --git a/tahoe-gpu/src/main.rs b/tahoe-gpu/src/main.rs
new file mode 100644
index 0000000..b3e4258
--- /dev/null
+++ b/tahoe-gpu/src/main.rs
@@ -0,0 +1,172 @@
+//! tahoe-gpu: la GPU del PC para el macOS que corre en tahoe-run (Metal sobre Vulkan, lado Linux).
+//!
+//! Por ahora, órdenes para conocer y probar la GPU y los shaders de Metal:
+//! - `tahoe-gpu informe`: el dispositivo Vulkan y, punto por punto, qué pide Metal 2 y cómo se cubre en esta GPU
+//!   (de forma nativa, emulado en el traductor de shaders o pendiente).
+//! - `tahoe-gpu prueba`: un shader de cómputo (SPIR-V generado aquí con rspirv) sobre memoria compartida: un memfd
+//!   proyectado e importado en Vulkan con VK_EXT_external_memory_host, que es como llegarán los MTLBuffer de macOS
+//!   (la misma memoria la ven el programa de macOS y la GPU, sin copias).
+//! - `tahoe-gpu metallib <archivo>`: las funciones de una biblioteca de shaders de Metal (tipo, versión AIR, bitcode).
+//! - `tahoe-gpu extraer <archivo> <función> <salida.bc>`: el bitcode AIR de una función (para mirarlo con llvm-dis).
+//! - `tahoe-gpu air <archivo> [función]`: lee el AIR de las funciones (todas o una) y resume cada punto de entrada.
+//! - `tahoe-gpu traducir <archivo> [función|-] [carpeta]`: traduce a SPIR-V (todas o una); con carpeta, guarda cada
+//!   `<función>.spv` (para spirv-val y spirv-dis).
+//! - `tahoe-gpu probar <archivo> <kernel> [ancho alto]`: ejecuta el kernel traducido en la GPU y el AIR en el
+//!   intérprete de la CPU con las mismas entradas, y compara.
+
+mod air;
+mod formatos;
+mod informe;
+mod metallib;
+mod motor;
+mod probar;
+mod probar_render;
+mod protocolo;
+mod render;
+mod prueba;
+mod servir;
+mod shaders;
+mod vk;
+
+fn main() {
+    let orden = std::env::args().nth(1).unwrap_or_default();
+    let r = match orden.as_str() {
+        "informe" => vk::Gpu::new().map(|g| informe::informe(&g)),
+        "prueba" => vk::Gpu::new().and_then(|g| prueba::prueba(&g)),
+        "metallib" => listar_metallib(std::env::args().nth(2)),
+        "extraer" => extraer(std::env::args().skip(2).collect()),
+        "air" => leer_air(std::env::args().skip(2).collect()),
+        "traducir" => traducir(std::env::args().skip(2).collect()),
+        "probar" => probar::probar(std::env::args().skip(2).collect()),
+        "servir" => servir::servir(std::env::args().skip(2).collect()),
+        "probar-render" => probar_render::probar_render(std::env::args().skip(2).collect()),
+        _ => {
+            eprintln!("uso: tahoe-gpu informe | prueba | metallib <archivo> | extraer <archivo> <función> <salida.bc> | air <archivo> [función] | traducir <archivo> [función] [carpeta] | probar <archivo> <kernel> [ancho alto] | servir <socket>");
+            std::process::exit(2);
+        }
+    };
+    if let Err(e) = r {
+        eprintln!("tahoe-gpu: {e}");
+        std::process::exit(1);
+    }
+}
+
+fn listar_metallib(ruta: Option<String>) -> vk::Res<()> {
+    let ruta = ruta.ok_or("falta el archivo .metallib")?;
+    let d = std::fs::read(&ruta).map_err(|e| format!("{ruta}: {e}"))?;
+    let b = metallib::Biblioteca::leer(&d)?;
+    println!("{ruta}: metallib {}.{}, tipo {}, {} funciones", b.version.0, b.version.1, b.tipo_archivo, b.funciones.len());
+    for f in &b.funciones {
+        let bc = b.bitcode(f)?;
+        let magia = bc.get(0..4).map(|m| u32::from_le_bytes(m.try_into().unwrap())).unwrap_or(0);
+        println!(
+            "  {:<9} {:<50} AIR {:?} MSL {:?}  bitcode {} bytes ({})",
+            format!("{:?}", f.tipo),
+            f.nombre,
+            f.air.unwrap_or_default(),
+            f.lenguaje.unwrap_or_default(),
+            bc.len(),
+            if magia == 0x0b17c0de || magia == 0xdec04342 { "LLVM" } else { "¿?" }
+        );
+    }
+    Ok(())
+}
+
+fn extraer(a: Vec<String>) -> vk::Res<()> {
+    let [ruta, nombre, salida] = <[String; 3]>::try_from(a).map_err(|_| "uso: extraer <archivo> <función> <salida.bc>")?;
+    let d = std::fs::read(&ruta).map_err(|e| format!("{ruta}: {e}"))?;
+    let b = metallib::Biblioteca::leer(&d)?;
+    let f = b.funciones.iter().find(|f| f.nombre == nombre).ok_or_else(|| format!("{nombre}: no está en {ruta}"))?;
+    std::fs::write(&salida, b.bitcode(f)?).map_err(|e| format!("{salida}: {e}"))
+}
+
+fn leer_air(a: Vec<String>) -> vk::Res<()> {
+    let ruta = a.first().ok_or("uso: air <archivo> [función]")?;
+    let d = std::fs::read(ruta).map_err(|e| format!("{ruta}: {e}"))?;
+    if d.starts_with(&[0xde, 0xc0, 0x17, 0x0b]) || d.starts_with(b"BC") {
+        // bitcode suelto (sacado con `extraer`)
+        let m = air::ir::leer(&d)?;
+        for e in air::entradas(&m) {
+            println!("{:?} {}: {}", e.etapa, m.functions[e.funcion].name, air::resumen(&m, e.funcion));
+        }
+        return Ok(());
+    }
+    let b = metallib::Biblioteca::leer(&d)?;
+    let (mut bien, mut mal) = (0, 0);
+    for f in b.funciones.iter().filter(|f| a.get(1).is_none_or(|n| *n == f.nombre)) {
+        match air::ir::leer(b.bitcode(f)?) {
+            Ok(m) => {
+                bien += 1;
+                for e in air::entradas(&m) {
+                    println!("{:?} {}: {}", e.etapa, m.functions[e.funcion].name, air::resumen(&m, e.funcion));
+                    if a.len() > 1 {
+                        let fcs = air::fc::constantes(&m);
+                        if !fcs.is_empty() {
+                            println!("    {} function constants; constructor sin valores: {}", fcs.len(),
+                                match air::fc::especializar(&m, &Default::default()) { Ok(_) => "bien".to_string(), Err(e) => e });
+                        }
+                        for x in &e.argumentos {
+                            println!("    arg {} {} {:?}", x.indice, x.clase, x.datos);
+                        }
+                        for x in &e.salidas {
+                            println!("    salida {} {} {:?}", x.indice, x.clase, x.datos);
+                        }
+                    }
+                }
+            }
+            Err(e) => {
+                mal += 1;
+                println!("ERROR {}: {e}", f.nombre);
+            }
+        }
+    }
+    println!("{bien} funciones leídas, {mal} con error");
+    Ok(())
+}
+
+fn traducir(a: Vec<String>) -> vk::Res<()> {
+    let ruta = a.first().ok_or("uso: traducir <archivo> [función|-] [carpeta]")?;
+    let solo = a.get(1).filter(|x| *x != "-");
+    let carpeta = a.get(2);
+    let d = std::fs::read(ruta).map_err(|e| format!("{ruta}: {e}"))?;
+    let b = metallib::Biblioteca::leer(&d)?;
+    let (mut bien, mut mal, mut maquinas) = (0, 0, 0usize);
+    let mut errores: std::collections::BTreeMap<String, usize> = Default::default();
+    for f in b.funciones.iter().filter(|f| solo.is_none_or(|n| *n == f.nombre)) {
+        let r = air::ir::leer(b.bitcode(f)?).and_then(|m| {
+            let e = air::entradas(&m).into_iter().next().ok_or("sin punto de entrada")?;
+            air::spirv::traducir(&m, &e, &Default::default())
+        });
+        match r {
+            Ok(t) => {
+                bien += 1;
+                maquinas += t.maquina_de_estados as usize;
+                if let Some(c) = carpeta {
+                    let bytes: Vec<u8> = t.spirv.iter().flat_map(|w| w.to_le_bytes()).collect();
+                    std::fs::write(format!("{c}/{}.spv", f.nombre), bytes).map_err(|e| e.to_string())?;
+                }
+                if solo.is_some() {
+                    println!("{} ({:?}): {} palabras, {} bloques{}", f.nombre, t.etapa, t.spirv.len(), t.bloques, if t.maquina_de_estados { " (máquina de estados)" } else { "" });
+                    for e in &t.enlaces {
+                        println!("    binding {}: {:?}", e.binding, e.recurso);
+                    }
+                }
+            }
+            Err(e) => {
+                mal += 1;
+                if solo.is_some() || std::env::var_os("TAHOE_ERRORES").is_some() {
+                    println!("ERROR {}: {e}", f.nombre);
+                }
+                let clave: String = e.split(" (en ").next().unwrap_or(&e).chars().take(90).collect();
+                *errores.entry(clave).or_default() += 1;
+            }
+        }
+    }
+    println!("{bien} traducidas ({maquinas} con máquina de estados), {mal} con error");
+    let mut v: Vec<_> = errores.into_iter().collect();
+    v.sort_by(|x, y| y.1.cmp(&x.1));
+    for (e, n) in v.iter().take(25) {
+        println!("  {n:4}  {e}");
+    }
+    Ok(())
+}
diff --git a/tahoe-gpu/src/metallib.rs b/tahoe-gpu/src/metallib.rs
new file mode 100644
index 0000000..38f426c
--- /dev/null
+++ b/tahoe-gpu/src/metallib.rs
@@ -0,0 +1,204 @@
+//! Bibliotecas de shaders de Metal (`.metallib`): cabecera "MTLB", lista de funciones con etiquetas (NAME, TYPE,
+//! HASH, MDSZ, OFFT, VERS...) y, al final, el bitcode LLVM (AIR) de cada función. Formato deducido de los archivos
+//! de macOS (ver `tahoe-gpu metallib <archivo>`).
+
+use crate::vk::Res;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Tipo {
+    Vertex,
+    Fragment,
+    Kernel,
+    Otro(u8),
+}
+
+#[derive(Debug, Clone)]
+pub struct Funcion {
+    pub nombre: String,
+    pub tipo: Tipo,
+    /// Desplazamiento del bitcode dentro de la sección de bitcode, y su tamaño.
+    pub bitcode_off: u64,
+    pub bitcode_len: u64,
+    /// Versiones AIR y del lenguaje (mayor, menor) si vienen.
+    pub air: Option<(u16, u16)>,
+    pub lenguaje: Option<(u16, u16)>,
+}
+
+#[derive(Debug)]
+pub struct Biblioteca<'a> {
+    pub datos: &'a [u8],
+    pub version: (u16, u16),
+    pub tipo_archivo: u8,
+    pub funciones: Vec<Funcion>,
+    pub bitcode: (u64, u64),
+}
+
+fn u16_at(b: &[u8], o: usize) -> Res<u16> {
+    b.get(o..o + 2).map(|s| u16::from_le_bytes([s[0], s[1]])).ok_or_else(|| format!("metallib corto (u16 en {o})"))
+}
+fn u32_at(b: &[u8], o: usize) -> Res<u32> {
+    b.get(o..o + 4).map(|s| u32::from_le_bytes(s.try_into().unwrap())).ok_or_else(|| format!("metallib corto (u32 en {o})"))
+}
+fn u64_at(b: &[u8], o: usize) -> Res<u64> {
+    b.get(o..o + 8).map(|s| u64::from_le_bytes(s.try_into().unwrap())).ok_or_else(|| format!("metallib corto (u64 en {o})"))
+}
+
+/// CPU_TYPE_AIR64: el trozo con bitcode AIR genérico de un metallib universal (los demás trozos de los archivos de
+/// macOS son binarios ya compilados para GPUs concretas de Apple).
+pub const CPU_AIR64: u32 = 0x0100_0017;
+
+/// Los trozos (tipo de CPU, subtipo, datos) de un archivo universal (cabecera fat de Mach-O, en big endian); None si
+/// no lo es.
+pub fn trozos(d: &[u8]) -> Option<Vec<(u32, u32, &[u8])>> {
+    let be = |o: usize| d.get(o..o + 4).map(|s| u32::from_be_bytes(s.try_into().unwrap()));
+    if be(0)? != 0xcafe_babe {
+        return None;
+    }
+    let n = be(4)? as usize;
+    (0..n)
+        .map(|i| {
+            let o = 8 + i * 20;
+            let (ty, sub, off, len) = (be(o)?, be(o + 4)?, be(o + 8)? as usize, be(o + 12)? as usize);
+            Some((ty, sub, d.get(off..off + len)?))
+        })
+        .collect()
+}
+
+impl<'a> Biblioteca<'a> {
+    /// Lee un metallib; si es universal, su trozo AIR64.
+    pub fn leer(d: &'a [u8]) -> Res<Biblioteca<'a>> {
+        if let Some(t) = trozos(d) {
+            let air = t.iter().find(|(ty, _, _)| *ty == CPU_AIR64).ok_or("metallib universal sin trozo AIR64")?;
+            return Self::leer(air.2);
+        }
+        if d.get(0..4) != Some(b"MTLB") {
+            return Err("no es un metallib (falta MTLB)".into());
+        }
+        let version = (u16_at(d, 6)?, u16_at(d, 8)?);
+        let tipo_archivo = d[10];
+        let tam = u64_at(d, 16)?;
+        if tam as usize != d.len() {
+            return Err(format!("tamaño de la cabecera ({tam}) distinto del archivo ({})", d.len()));
+        }
+        let (fl_off, _fl_len) = (u64_at(d, 24)? as usize, u64_at(d, 32)?);
+        let bitcode = (u64_at(d, 72)?, u64_at(d, 80)?);
+        let n = u32_at(d, fl_off)? as usize;
+        let mut p = fl_off + 4;
+        let mut funciones = Vec::with_capacity(n);
+        for _ in 0..n {
+            let largo = u32_at(d, p)? as usize; // tamaño de la entrada, incluido este campo
+            let fin = p + largo;
+            let mut q = p + 4;
+            let mut f = Funcion { nombre: String::new(), tipo: Tipo::Otro(255), bitcode_off: 0, bitcode_len: 0, air: None, lenguaje: None };
+            while q + 4 <= fin {
+                let etiqueta = &d[q..q + 4];
+                if etiqueta == b"ENDT" {
+                    break;
+                }
+                let tl = u16_at(d, q + 4)? as usize;
+                let v = d.get(q + 6..q + 6 + tl).ok_or("etiqueta fuera del archivo")?;
+                match etiqueta {
+                    b"NAME" => f.nombre = String::from_utf8_lossy(v.split(|&c| c == 0).next().unwrap_or(&[])).into_owned(),
+                    b"TYPE" => {
+                        f.tipo = match v.first() {
+                            Some(0) => Tipo::Vertex,
+                            Some(1) => Tipo::Fragment,
+                            Some(2) => Tipo::Kernel,
+                            Some(&x) => Tipo::Otro(x),
+                            None => Tipo::Otro(255),
+                        }
+                    }
+                    b"MDSZ" if tl >= 8 => f.bitcode_len = u64_at(v, 0)?,
+                    b"OFFT" if tl >= 24 => f.bitcode_off = u64_at(v, 16)?,
+                    b"VERS" if tl >= 8 => {
+                        f.air = Some((u16_at(v, 0)?, u16_at(v, 2)?));
+                        f.lenguaje = Some((u16_at(v, 4)?, u16_at(v, 6)?));
+                    }
+                    _ => {}
+                }
+                q += 6 + tl;
+            }
+            funciones.push(f);
+            p = fin;
+        }
+        Ok(Biblioteca { datos: d, version, tipo_archivo, funciones, bitcode })
+    }
+
+    /// El bitcode LLVM (AIR) de una función.
+    pub fn bitcode(&self, f: &Funcion) -> Res<&'a [u8]> {
+        let ini = (self.bitcode.0 + f.bitcode_off) as usize;
+        self.datos.get(ini..ini + f.bitcode_len as usize).ok_or_else(|| format!("bitcode de {} fuera del archivo", f.nombre))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Un metallib mínimo con una función, construido con el formato de arriba.
+    fn ejemplo() -> Vec<u8> {
+        let mut entrada = Vec::new();
+        let tag = |e: &mut Vec<u8>, t: &[u8], v: &[u8]| {
+            e.extend_from_slice(t);
+            e.extend_from_slice(&(v.len() as u16).to_le_bytes());
+            e.extend_from_slice(v);
+        };
+        tag(&mut entrada, b"NAME", b"k\0");
+        tag(&mut entrada, b"TYPE", &[2]);
+        tag(&mut entrada, b"MDSZ", &4u64.to_le_bytes());
+        let mut offt = vec![0u8; 16];
+        offt.extend_from_slice(&0u64.to_le_bytes());
+        tag(&mut entrada, b"OFFT", &offt);
+        entrada.extend_from_slice(b"ENDT");
+        let mut lista = 1u32.to_le_bytes().to_vec();
+        lista.extend_from_slice(&((entrada.len() + 4) as u32).to_le_bytes());
+        lista.extend_from_slice(&entrada);
+        let mut d = vec![0u8; 88];
+        d[0..4].copy_from_slice(b"MTLB");
+        let fl = 88u64;
+        let bc = fl + lista.len() as u64;
+        d.extend_from_slice(&lista);
+        d.extend_from_slice(&[0xde, 0xc0, 0x17, 0x0b]);
+        let tam = d.len() as u64;
+        d[16..24].copy_from_slice(&tam.to_le_bytes());
+        d[24..32].copy_from_slice(&fl.to_le_bytes());
+        d[32..40].copy_from_slice(&(lista.len() as u64).to_le_bytes());
+        d[72..80].copy_from_slice(&bc.to_le_bytes());
+        d[80..88].copy_from_slice(&4u64.to_le_bytes());
+        d
+    }
+
+    #[test]
+    fn lee_funciones() {
+        let d = ejemplo();
+        let b = Biblioteca::leer(&d).unwrap();
+        assert_eq!(b.funciones.len(), 1);
+        assert_eq!(b.funciones[0].nombre, "k");
+        assert_eq!(b.funciones[0].tipo, Tipo::Kernel);
+        assert_eq!(b.bitcode(&b.funciones[0]).unwrap(), &[0xde, 0xc0, 0x17, 0x0b]);
+    }
+
+    #[test]
+    fn universal_elige_air64() {
+        let m = ejemplo();
+        let mut d = Vec::new();
+        d.extend_from_slice(&0xcafe_babeu32.to_be_bytes());
+        d.extend_from_slice(&2u32.to_be_bytes());
+        let o1 = 8 + 2 * 20;
+        let o2 = o1 + 16;
+        for (ty, sub, off, len) in [(0x0100_0013u32, 0x53u32, o1, 16usize), (CPU_AIR64, 0xc, o2, m.len())] {
+            for v in [ty, sub, off as u32, len as u32, 4] {
+                d.extend_from_slice(&v.to_be_bytes());
+            }
+        }
+        d.extend_from_slice(&[0u8; 16]);
+        d.extend_from_slice(&m);
+        let b = Biblioteca::leer(&d).unwrap();
+        assert_eq!(b.funciones[0].nombre, "k");
+    }
+
+    #[test]
+    fn rechaza_otros_archivos() {
+        assert!(Biblioteca::leer(b"hola").is_err());
+    }
+}
diff --git a/tahoe-gpu/src/motor.rs b/tahoe-gpu/src/motor.rs
new file mode 100644
index 0000000..5434f6e
--- /dev/null
+++ b/tahoe-gpu/src/motor.rs
@@ -0,0 +1,475 @@
+//! Motor de ejecución sobre Vulkan: lo que hará con la GPU el driver Metal de macOS. Buffers en memoria compartida
+//! (memfd importado sin copias), texturas, samplers, pipelines a partir de shaders traducidos (`air::spirv`) y
+//! despachos de cómputo. Las órdenes se ejecutan una a una con espera (aún sin colas asíncronas).
+
+use std::collections::HashMap;
+
+use ash::vk;
+
+use crate::air::spirv::{Recurso, Traduccion};
+use crate::vk::{err, Gpu, Res};
+
+pub struct Motor {
+    pub gpu: Gpu,
+    pub(crate) pool: vk::CommandPool,
+    fijo: std::sync::OnceLock<vk::Sampler>,
+}
+
+/// Buffer de Metal: memoria compartida (memfd) que ven a la vez la CPU, macOS y la GPU.
+pub struct Buffer {
+    pub ptr: *mut u8,
+    pub len: usize,
+    pub(crate) buf: vk::Buffer,
+    mem: vk::DeviceMemory,
+}
+
+/// Forma de una textura (los tipos de MTLTextureType que hay en Vulkan).
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Forma {
+    D1,
+    D1Array,
+    D2,
+    D2Array,
+    D3,
+    Cubo,
+    CuboArray,
+}
+
+impl Forma {
+    /// La forma de una textura de un shader traducido.
+    pub fn de_spirv(dim: rspirv::spirv::Dim, arreglo: bool) -> Forma {
+        use rspirv::spirv::Dim;
+        match (dim, arreglo) {
+            (Dim::Dim1D, false) => Forma::D1,
+            (Dim::Dim1D, true) => Forma::D1Array,
+            (Dim::Dim3D, _) => Forma::D3,
+            (Dim::DimCube, false) => Forma::Cubo,
+            (Dim::DimCube, true) => Forma::CuboArray,
+            (_, true) => Forma::D2Array,
+            _ => Forma::D2,
+        }
+    }
+}
+
+pub struct Textura {
+    pub ancho: u32,
+    pub alto: u32,
+    /// profundidad (3D) o 1
+    pub prof: u32,
+    /// capas (arrays; 6 por cubo) o 1
+    pub capas: u32,
+    pub formato: vk::Format,
+    pub bpp: u32,
+    pub(crate) image: vk::Image,
+    mem: vk::DeviceMemory,
+    pub vista: vk::ImageView,
+}
+
+pub struct PipelineComputo {
+    pipeline: vk::Pipeline,
+    layout: vk::PipelineLayout,
+    set_layout: vk::DescriptorSetLayout,
+    enlaces: Vec<(u32, vk::DescriptorType)>,
+}
+
+/// Lo que se enlaza en un despacho, por binding.
+pub enum Enlazado<'a> {
+    Buffer(&'a Buffer),
+    /// buffer desde un desplazamiento (setBuffer:offset:atIndex:); alineado a minStorageBufferOffsetAlignment
+    BufferDesde(&'a Buffer, u64),
+    Textura(&'a Textura),
+    Sampler(vk::Sampler),
+}
+
+fn tipo_descriptor(r: &Recurso) -> vk::DescriptorType {
+    match r {
+        Recurso::Buffer { .. } => vk::DescriptorType::STORAGE_BUFFER,
+        Recurso::Textura { .. } => vk::DescriptorType::SAMPLED_IMAGE,
+        Recurso::TexturaEscritura { .. } => vk::DescriptorType::STORAGE_IMAGE,
+        Recurso::Sampler { .. } | Recurso::SamplerFijo { .. } => vk::DescriptorType::SAMPLER,
+    }
+}
+
+impl Motor {
+    pub fn new() -> Res<Motor> {
+        let gpu = Gpu::new()?;
+        let ci = vk::CommandPoolCreateInfo::default().queue_family_index(gpu.queue_family).flags(vk::CommandPoolCreateFlags::RESET_COMMAND_BUFFER);
+        // SAFETY: dispositivo válido.
+        let pool = unsafe { gpu.device.create_command_pool(&ci, None) }.map_err(err("vkCreateCommandPool"))?;
+        Ok(Motor { gpu, pool, fijo: std::sync::OnceLock::new() })
+    }
+
+    /// Graba y ejecuta órdenes, esperando a que acaben.
+    pub fn una_vez(&self, f: impl FnOnce(&ash::Device, vk::CommandBuffer)) -> Res<()> {
+        let d = &self.gpu.device;
+        // SAFETY: objetos de este dispositivo; se espera a la valla antes de liberar el command buffer.
+        unsafe {
+            let cb = d.allocate_command_buffers(&vk::CommandBufferAllocateInfo::default().command_pool(self.pool).command_buffer_count(1)).map_err(err("cb"))?[0];
+            d.begin_command_buffer(cb, &vk::CommandBufferBeginInfo::default().flags(vk::CommandBufferUsageFlags::ONE_TIME_SUBMIT)).map_err(err("begin"))?;
+            f(d, cb);
+            d.end_command_buffer(cb).map_err(err("end"))?;
+            let fence = d.create_fence(&vk::FenceCreateInfo::default(), None).map_err(err("fence"))?;
+            let cbs = [cb];
+            d.queue_submit(self.gpu.queue, &[vk::SubmitInfo::default().command_buffers(&cbs)], fence).map_err(err("vkQueueSubmit"))?;
+            let r = d.wait_for_fences(&[fence], true, 10_000_000_000).map_err(err("vkWaitForFences"));
+            d.destroy_fence(fence, None);
+            d.free_command_buffers(self.pool, &cbs);
+            r
+        }
+    }
+
+    /// Buffer sobre una memoria compartida ya proyectada (`ptr` alineado a página, `len` múltiplo de página).
+    ///
+    /// # Safety
+    /// `ptr` debe apuntar a `len` bytes proyectados que vivan más que el Buffer.
+    pub unsafe fn buffer_en(&self, ptr: *mut u8, len: usize) -> Res<Buffer> {
+        let d = &self.gpu.device;
+        let hm = self.gpu.host_memory.as_ref().ok_or("la GPU no puede importar memoria del anfitrión")?;
+        // SAFETY: lo garantiza quien llama (ptr válido); objetos de este dispositivo.
+        unsafe {
+            let mut hp = vk::MemoryHostPointerPropertiesEXT::default();
+            (hm.fp().get_memory_host_pointer_properties_ext)(d.handle(), vk::ExternalMemoryHandleTypeFlags::HOST_ALLOCATION_EXT, ptr.cast(), &mut hp)
+                .result()
+                .map_err(err("vkGetMemoryHostPointerPropertiesEXT"))?;
+            let mut ext = vk::ExternalMemoryBufferCreateInfo::default().handle_types(vk::ExternalMemoryHandleTypeFlags::HOST_ALLOCATION_EXT);
+            let usos = vk::BufferUsageFlags::STORAGE_BUFFER | vk::BufferUsageFlags::TRANSFER_SRC | vk::BufferUsageFlags::TRANSFER_DST | vk::BufferUsageFlags::VERTEX_BUFFER | vk::BufferUsageFlags::INDEX_BUFFER | vk::BufferUsageFlags::INDIRECT_BUFFER | vk::BufferUsageFlags::UNIFORM_BUFFER;
+            let buf = d.create_buffer(&vk::BufferCreateInfo::default().size(len as u64).usage(usos).push_next(&mut ext), None).map_err(err("vkCreateBuffer"))?;
+            let req = d.get_buffer_memory_requirements(buf);
+            let ty = self.gpu.memory_type(req.memory_type_bits & hp.memory_type_bits, vk::MemoryPropertyFlags::HOST_VISIBLE).ok_or("sin tipo de memoria para importar")?;
+            let mut imp = vk::ImportMemoryHostPointerInfoEXT::default().handle_type(vk::ExternalMemoryHandleTypeFlags::HOST_ALLOCATION_EXT).host_pointer(ptr.cast());
+            let mem = d.allocate_memory(&vk::MemoryAllocateInfo::default().allocation_size(len as u64).memory_type_index(ty).push_next(&mut imp), None).map_err(err("vkAllocateMemory"))?;
+            d.bind_buffer_memory(buf, mem, 0).map_err(err("vkBindBufferMemory"))?;
+            Ok(Buffer { ptr, len, buf, mem })
+        }
+    }
+
+    /// Copia entre buffers (blit de Metal: copyFromBuffer:...toBuffer:...).
+    pub fn copiar_buffer(&self, de: &Buffer, de_off: u64, a: &Buffer, a_off: u64, len: u64) -> Res<()> {
+        let r = [vk::BufferCopy::default().src_offset(de_off).dst_offset(a_off).size(len)];
+        self.una_vez(|d, cb| {
+            // SAFETY: objetos válidos durante la grabación.
+            unsafe { d.cmd_copy_buffer(cb, de.buf, a.buf, &r) }
+        })
+    }
+
+    /// Sampler para los samplers constantes de los shaders (lineal y sujeto al borde) mientras su estado de 64 bits no
+    /// se decodifique; uno por motor.
+    pub fn sampler_fijo(&self) -> Res<vk::Sampler> {
+        if let Some(s) = self.fijo.get() {
+            return Ok(*s);
+        }
+        let s = self.sampler(true)?;
+        let _ = self.fijo.set(s);
+        Ok(s)
+    }
+
+    /// Alineación que piden los desplazamientos de un storage buffer.
+    pub fn alineacion_buffer(&self) -> u64 {
+        self.gpu.props.limits.min_storage_buffer_offset_alignment
+    }
+
+    /// Buffer nuevo en un memfd propio (para pruebas).
+    pub fn buffer(&self, len: usize) -> Res<Buffer> {
+        let len = len.next_multiple_of(4096).max(4096);
+        // SAFETY: llamadas al sistema con argumentos válidos.
+        let ptr = unsafe {
+            let fd = libc::memfd_create(c"tahoe-buffer".as_ptr(), libc::MFD_CLOEXEC);
+            if fd < 0 || libc::ftruncate(fd, len as libc::off_t) != 0 {
+                return Err("memfd".into());
+            }
+            let p = libc::mmap(std::ptr::null_mut(), len, libc::PROT_READ | libc::PROT_WRITE, libc::MAP_SHARED, fd, 0);
+            libc::close(fd);
+            if p == libc::MAP_FAILED {
+                return Err("mmap".into());
+            }
+            p.cast::<u8>()
+        };
+        // SAFETY: proyección propia de len bytes que el Buffer no libera (vive lo que el proceso; es para pruebas).
+        unsafe { self.buffer_en(ptr, len) }
+    }
+
+    pub fn textura(&self, ancho: u32, alto: u32, formato: vk::Format) -> Res<Textura> {
+        self.textura_forma(Forma::D2, ancho, alto, 1, 1, formato)
+    }
+
+    /// Textura de cualquier forma: `prof` para 3D, `capas` para arrays (en cubos, número de cubos).
+    pub fn textura_forma(&self, forma: Forma, ancho: u32, alto: u32, prof: u32, capas: u32, formato: vk::Format) -> Res<Textura> {
+        self.textura_completa(forma, ancho, alto, prof, capas, 1, formato)
+    }
+
+    /// Usos que la GPU admite para un formato con tiling óptimo (sampled, storage, color attachment).
+    fn usos_formato(&self, formato: vk::Format) -> vk::ImageUsageFlags {
+        // SAFETY: dispositivo físico de esta instancia.
+        let p = unsafe { self.gpu.instance.get_physical_device_format_properties(self.gpu.phys, formato) }.optimal_tiling_features;
+        let mut u = vk::ImageUsageFlags::TRANSFER_SRC | vk::ImageUsageFlags::TRANSFER_DST;
+        if p.contains(vk::FormatFeatureFlags::SAMPLED_IMAGE) {
+            u |= vk::ImageUsageFlags::SAMPLED;
+        }
+        if p.contains(vk::FormatFeatureFlags::STORAGE_IMAGE) {
+            u |= vk::ImageUsageFlags::STORAGE;
+        }
+        if p.contains(vk::FormatFeatureFlags::COLOR_ATTACHMENT) {
+            u |= vk::ImageUsageFlags::COLOR_ATTACHMENT;
+        }
+        if p.contains(vk::FormatFeatureFlags::DEPTH_STENCIL_ATTACHMENT) {
+            u |= vk::ImageUsageFlags::DEPTH_STENCIL_ATTACHMENT;
+        }
+        u
+    }
+
+    /// Textura de cualquier forma y con `niveles` niveles de mipmap; los usos, los que admita el formato.
+    #[allow(clippy::too_many_arguments)]
+    pub fn textura_completa(&self, forma: Forma, ancho: u32, alto: u32, prof: u32, capas: u32, niveles: u32, formato: vk::Format) -> Res<Textura> {
+        let d = &self.gpu.device;
+        let bpp = match formato {
+            vk::Format::R32G32B32A32_SFLOAT | vk::Format::R32G32B32A32_UINT | vk::Format::R32G32B32A32_SINT => 16,
+            vk::Format::R16G16B16A16_SFLOAT => 8,
+            vk::Format::R8G8B8A8_UNORM | vk::Format::B8G8R8A8_UNORM | vk::Format::R32_SFLOAT | vk::Format::R32_UINT => 4,
+            vk::Format::R16_SFLOAT => 2,
+            vk::Format::R8_UNORM => 1,
+            f => crate::formatos::bytes_de(f).ok_or_else(|| format!("formato {f:?} sin tamaño conocido"))?,
+        };
+        let (tipo, vista_t) = match forma {
+            Forma::D1 => (vk::ImageType::TYPE_1D, vk::ImageViewType::TYPE_1D),
+            Forma::D1Array => (vk::ImageType::TYPE_1D, vk::ImageViewType::TYPE_1D_ARRAY),
+            Forma::D2 => (vk::ImageType::TYPE_2D, vk::ImageViewType::TYPE_2D),
+            Forma::D2Array => (vk::ImageType::TYPE_2D, vk::ImageViewType::TYPE_2D_ARRAY),
+            Forma::D3 => (vk::ImageType::TYPE_3D, vk::ImageViewType::TYPE_3D),
+            Forma::Cubo => (vk::ImageType::TYPE_2D, vk::ImageViewType::CUBE),
+            Forma::CuboArray => (vk::ImageType::TYPE_2D, vk::ImageViewType::CUBE_ARRAY),
+        };
+        let cubo = matches!(forma, Forma::Cubo | Forma::CuboArray);
+        let alto = if matches!(forma, Forma::D1 | Forma::D1Array) { 1 } else { alto };
+        let prof = if forma == Forma::D3 { prof.max(1) } else { 1 };
+        let capas = if cubo { capas.max(1) * 6 } else if matches!(forma, Forma::D1Array | Forma::D2Array) { capas.max(1) } else { 1 };
+        // SAFETY: objetos de este dispositivo.
+        unsafe {
+            let ci = vk::ImageCreateInfo::default()
+                .flags(if cubo { vk::ImageCreateFlags::CUBE_COMPATIBLE } else { vk::ImageCreateFlags::empty() })
+                .image_type(tipo)
+                .format(formato)
+                .extent(vk::Extent3D { width: ancho, height: alto, depth: prof })
+                .mip_levels(niveles.max(1))
+                .array_layers(capas)
+                .samples(vk::SampleCountFlags::TYPE_1)
+                .tiling(vk::ImageTiling::OPTIMAL)
+                .usage(self.usos_formato(formato))
+                .initial_layout(vk::ImageLayout::UNDEFINED);
+            let image = d.create_image(&ci, None).map_err(err("vkCreateImage"))?;
+            let req = d.get_image_memory_requirements(image);
+            let ty = self.gpu.memory_type(req.memory_type_bits, vk::MemoryPropertyFlags::DEVICE_LOCAL).ok_or("sin memoria para la imagen")?;
+            let mem = d.allocate_memory(&vk::MemoryAllocateInfo::default().allocation_size(req.size).memory_type_index(ty), None).map_err(err("vkAllocateMemory"))?;
+            d.bind_image_memory(image, mem, 0).map_err(err("vkBindImageMemory"))?;
+            let aspecto = crate::formatos::aspecto(formato);
+            let sr = vk::ImageSubresourceRange::default().aspect_mask(aspecto).level_count(niveles.max(1)).layer_count(capas);
+            let vista = d.create_image_view(&vk::ImageViewCreateInfo::default().image(image).view_type(vista_t).format(formato).subresource_range(sr), None).map_err(err("vkCreateImageView"))?;
+            let t = Textura { ancho, alto, prof, capas, formato, bpp, image, mem, vista };
+            // todas las texturas viven en GENERAL (se leen, muestrean y escriben sin más transiciones)
+            self.una_vez(|d, cb| {
+                let b = [vk::ImageMemoryBarrier::default().image(image).subresource_range(sr).old_layout(vk::ImageLayout::UNDEFINED).new_layout(vk::ImageLayout::GENERAL).dst_access_mask(vk::AccessFlags::MEMORY_READ | vk::AccessFlags::MEMORY_WRITE)];
+                d.cmd_pipeline_barrier(cb, vk::PipelineStageFlags::TOP_OF_PIPE, vk::PipelineStageFlags::ALL_COMMANDS, vk::DependencyFlags::empty(), &[], &[], &b);
+            })?;
+            Ok(t)
+        }
+    }
+
+    /// Copia de una región entre una textura y un buffer (subir: buffer → textura). `fila` en texeles (0: justa).
+    #[allow(clippy::too_many_arguments)]
+    pub fn copiar_region(&self, t: &Textura, b: &Buffer, b_off: u64, fila: u32, nivel: u32, capa: u32, origen: [i32; 3], tam: [u32; 3], subir: bool) -> Res<()> {
+        let region = [vk::BufferImageCopy::default()
+            .buffer_offset(b_off)
+            .buffer_row_length(fila)
+            .image_subresource(vk::ImageSubresourceLayers::default().aspect_mask(crate::formatos::aspecto(t.formato)).mip_level(nivel).base_array_layer(capa).layer_count(1))
+            .image_offset(vk::Offset3D { x: origen[0], y: origen[1], z: origen[2] })
+            .image_extent(vk::Extent3D { width: tam[0].max(1), height: tam[1].max(1), depth: tam[2].max(1) })];
+        self.una_vez(|d, cb| {
+            // SAFETY: objetos válidos durante la grabación.
+            unsafe {
+                if subir {
+                    d.cmd_copy_buffer_to_image(cb, b.buf, t.image, vk::ImageLayout::GENERAL, &region);
+                } else {
+                    d.cmd_copy_image_to_buffer(cb, t.image, vk::ImageLayout::GENERAL, b.buf, &region);
+                }
+            }
+        })
+    }
+
+    /// Sampler de un MTLSamplerDescriptor (ver protocolo::tipo::SAMPLER).
+    #[allow(clippy::too_many_arguments)]
+    pub fn sampler_desc(&self, min: u32, mag: u32, mip: u32, dir: [u32; 3], normalizadas: bool, aniso: u32, lod: [f32; 2], borde: u32) -> Res<vk::Sampler> {
+        let filtro = |f: u32| if f == 1 { vk::Filter::LINEAR } else { vk::Filter::NEAREST };
+        let a = |x: u32| crate::formatos::direccion(x);
+        let aniso_ok = aniso > 1 && self.gpu.props.limits.max_sampler_anisotropy > 1.0;
+        let mut ci = vk::SamplerCreateInfo::default()
+            .min_filter(filtro(min))
+            .mag_filter(filtro(mag))
+            .mipmap_mode(if mip == 2 { vk::SamplerMipmapMode::LINEAR } else { vk::SamplerMipmapMode::NEAREST })
+            .address_mode_u(a(dir[0]))
+            .address_mode_v(a(dir[1]))
+            .address_mode_w(a(dir[2]))
+            .anisotropy_enable(aniso_ok)
+            .max_anisotropy((aniso as f32).min(self.gpu.props.limits.max_sampler_anisotropy))
+            .min_lod(lod[0])
+            .max_lod(if mip == 0 { 0.25 } else { lod[1] })
+            .unnormalized_coordinates(!normalizadas)
+            .border_color(match borde {
+                1 => vk::BorderColor::FLOAT_OPAQUE_BLACK,
+                2 => vk::BorderColor::FLOAT_OPAQUE_WHITE,
+                _ => vk::BorderColor::FLOAT_TRANSPARENT_BLACK,
+            });
+        if !normalizadas {
+            // coordenadas sin normalizar: Vulkan pide un solo nivel y sujetar al borde
+            ci = ci.min_lod(0.0).max_lod(0.0).mipmap_mode(vk::SamplerMipmapMode::NEAREST).anisotropy_enable(false).address_mode_u(vk::SamplerAddressMode::CLAMP_TO_EDGE).address_mode_v(vk::SamplerAddressMode::CLAMP_TO_EDGE);
+        }
+        // SAFETY: dispositivo válido.
+        unsafe { self.gpu.device.create_sampler(&ci, None) }.map_err(err("vkCreateSampler"))
+    }
+
+    /// Copia entre una textura y un buffer (subir: buffer → textura).
+    pub fn copiar(&self, t: &Textura, b: &Buffer, subir: bool) -> Res<()> {
+        let region = [vk::BufferImageCopy::default()
+            .image_subresource(vk::ImageSubresourceLayers::default().aspect_mask(vk::ImageAspectFlags::COLOR).layer_count(t.capas))
+            .image_extent(vk::Extent3D { width: t.ancho, height: t.alto, depth: t.prof })];
+        self.una_vez(|d, cb| {
+            // SAFETY: objetos válidos durante la grabación.
+            unsafe {
+                if subir {
+                    d.cmd_copy_buffer_to_image(cb, b.buf, t.image, vk::ImageLayout::GENERAL, &region);
+                } else {
+                    d.cmd_copy_image_to_buffer(cb, t.image, vk::ImageLayout::GENERAL, b.buf, &region);
+                }
+            }
+        })
+    }
+
+    /// Sampler: lineal y con las coordenadas sujetas al borde (el estado de los samplers constantes de Metal aún no se
+    /// interpreta).
+    pub fn sampler(&self, lineal: bool) -> Res<vk::Sampler> {
+        let f = if lineal { vk::Filter::LINEAR } else { vk::Filter::NEAREST };
+        let ci = vk::SamplerCreateInfo::default()
+            .mag_filter(f)
+            .min_filter(f)
+            .address_mode_u(vk::SamplerAddressMode::CLAMP_TO_EDGE)
+            .address_mode_v(vk::SamplerAddressMode::CLAMP_TO_EDGE)
+            .address_mode_w(vk::SamplerAddressMode::CLAMP_TO_EDGE)
+            .max_lod(vk::LOD_CLAMP_NONE);
+        // SAFETY: dispositivo válido.
+        unsafe { self.gpu.device.create_sampler(&ci, None) }.map_err(err("vkCreateSampler"))
+    }
+
+    pub fn pipeline_computo(&self, t: &Traduccion, grupo: [u32; 3]) -> Res<PipelineComputo> {
+        let d = &self.gpu.device;
+        let enlaces: Vec<(u32, vk::DescriptorType)> = t.enlaces.iter().map(|e| (e.binding, tipo_descriptor(&e.recurso))).collect();
+        let binds: Vec<vk::DescriptorSetLayoutBinding> =
+            enlaces.iter().map(|&(b, ty)| vk::DescriptorSetLayoutBinding::default().binding(b).descriptor_type(ty).descriptor_count(1).stage_flags(vk::ShaderStageFlags::COMPUTE)).collect();
+        // SAFETY: objetos de este dispositivo; el SPIR-V viene del traductor (validado con spirv-val en las pruebas).
+        unsafe {
+            let set_layout = d.create_descriptor_set_layout(&vk::DescriptorSetLayoutCreateInfo::default().bindings(&binds), None).map_err(err("dsl"))?;
+            let sls = [set_layout];
+            let pc = [vk::PushConstantRange::default().stage_flags(vk::ShaderStageFlags::COMPUTE).offset(0).size(16)];
+            let layout = d.create_pipeline_layout(&vk::PipelineLayoutCreateInfo::default().set_layouts(&sls).push_constant_ranges(&pc), None).map_err(err("pl"))?;
+            let sm = d.create_shader_module(&vk::ShaderModuleCreateInfo::default().code(&t.spirv), None).map_err(err("vkCreateShaderModule"))?;
+            let mapas: Vec<vk::SpecializationMapEntry> = (0..3).map(|k| vk::SpecializationMapEntry::default().constant_id(k).offset(k * 4).size(4)).collect();
+            let datos: Vec<u8> = grupo.iter().flat_map(|x| x.to_le_bytes()).collect();
+            let spec = vk::SpecializationInfo::default().map_entries(&mapas).data(&datos);
+            let mut stage = vk::PipelineShaderStageCreateInfo::default().stage(vk::ShaderStageFlags::COMPUTE).module(sm).name(c"main").specialization_info(&spec);
+            // SIMD-groups de Metal: 32 hilos
+            let mut req = vk::PipelineShaderStageRequiredSubgroupSizeCreateInfo::default().required_subgroup_size(32);
+            if t.subgrupos && self.gpu.subgrupo_fijo {
+                stage = stage.push_next(&mut req);
+            }
+            let ci = [vk::ComputePipelineCreateInfo::default().stage(stage).layout(layout)];
+            let r = d.create_compute_pipelines(vk::PipelineCache::null(), &ci, None);
+            d.destroy_shader_module(sm, None);
+            let pipeline = r.map_err(|(_, e)| format!("vkCreateComputePipelines: {e:?}"))?[0];
+            Ok(PipelineComputo { pipeline, layout, set_layout, enlaces })
+        }
+    }
+
+    /// Despacha `grid` hilos (como dispatchThreads de Metal; los grupos de los bordes se recortan en el shader).
+    pub fn despachar(&self, p: &PipelineComputo, recursos: &HashMap<u32, Enlazado>, grid: [u32; 3], grupo: [u32; 3]) -> Res<()> {
+        let d = &self.gpu.device;
+        // SAFETY: objetos de este dispositivo; los recursos viven durante la llamada (se espera al final).
+        unsafe {
+            let mut tam: HashMap<vk::DescriptorType, u32> = HashMap::new();
+            for &(_, t) in &p.enlaces {
+                *tam.entry(t).or_default() += 1;
+            }
+            let sizes: Vec<vk::DescriptorPoolSize> = tam.iter().map(|(&t, &n)| vk::DescriptorPoolSize::default().ty(t).descriptor_count(n)).collect();
+            let pool = d.create_descriptor_pool(&vk::DescriptorPoolCreateInfo::default().max_sets(1).pool_sizes(if sizes.is_empty() { &[vk::DescriptorPoolSize { ty: vk::DescriptorType::SAMPLER, descriptor_count: 1 }] } else { &sizes }), None).map_err(err("pool"))?;
+            let sls = [p.set_layout];
+            let set = d.allocate_descriptor_sets(&vk::DescriptorSetAllocateInfo::default().descriptor_pool(pool).set_layouts(&sls)).map_err(err("set"))?[0];
+            let mut binfos = Vec::new();
+            let mut iinfos = Vec::new();
+            for &(b, ty) in &p.enlaces {
+                match recursos.get(&b) {
+                    Some(Enlazado::Buffer(buf)) => binfos.push((b, ty, vk::DescriptorBufferInfo::default().buffer(buf.buf).range(vk::WHOLE_SIZE))),
+                    Some(Enlazado::BufferDesde(buf, off)) => binfos.push((b, ty, vk::DescriptorBufferInfo::default().buffer(buf.buf).offset(*off).range(vk::WHOLE_SIZE))),
+                    Some(Enlazado::Textura(t)) => iinfos.push((b, ty, vk::DescriptorImageInfo::default().image_view(t.vista).image_layout(vk::ImageLayout::GENERAL))),
+                    Some(Enlazado::Sampler(s)) => iinfos.push((b, ty, vk::DescriptorImageInfo::default().sampler(*s))),
+                    None => return Err(format!("falta el recurso del binding {b}")),
+                }
+            }
+            let mut writes = Vec::new();
+            for (b, ty, info) in &binfos {
+                writes.push(vk::WriteDescriptorSet::default().dst_set(set).dst_binding(*b).descriptor_type(*ty).buffer_info(std::slice::from_ref(info)));
+            }
+            for (b, ty, info) in &iinfos {
+                writes.push(vk::WriteDescriptorSet::default().dst_set(set).dst_binding(*b).descriptor_type(*ty).image_info(std::slice::from_ref(info)));
+            }
+            d.update_descriptor_sets(&writes, &[]);
+            let grupos = [grid[0].div_ceil(grupo[0]), grid[1].div_ceil(grupo[1]), grid[2].div_ceil(grupo[2])];
+            let pc: Vec<u8> = grid.iter().chain(&[0u32]).flat_map(|x| x.to_le_bytes()).collect();
+            let r = self.una_vez(|d, cb| {
+                d.cmd_bind_pipeline(cb, vk::PipelineBindPoint::COMPUTE, p.pipeline);
+                d.cmd_bind_descriptor_sets(cb, vk::PipelineBindPoint::COMPUTE, p.layout, 0, &[set], &[]);
+                d.cmd_push_constants(cb, p.layout, vk::ShaderStageFlags::COMPUTE, 0, &pc);
+                d.cmd_dispatch(cb, grupos[0], grupos[1], grupos[2]);
+                let mb = [vk::MemoryBarrier::default().src_access_mask(vk::AccessFlags::SHADER_WRITE).dst_access_mask(vk::AccessFlags::HOST_READ | vk::AccessFlags::TRANSFER_READ)];
+                d.cmd_pipeline_barrier(cb, vk::PipelineStageFlags::COMPUTE_SHADER, vk::PipelineStageFlags::HOST | vk::PipelineStageFlags::TRANSFER, vk::DependencyFlags::empty(), &mb, &[], &[]);
+            });
+            d.destroy_descriptor_pool(pool, None);
+            r
+        }
+    }
+}
+
+impl Drop for Motor {
+    fn drop(&mut self) {
+        // SAFETY: se espera a que la GPU termine antes de destruir.
+        unsafe {
+            let _ = self.gpu.device.device_wait_idle();
+            self.gpu.device.destroy_command_pool(self.pool, None);
+        }
+    }
+}
+
+impl Buffer {
+    pub fn bytes(&self) -> &mut [u8] {
+        // SAFETY: proyección de len bytes que vive lo que el Buffer.
+        unsafe { std::slice::from_raw_parts_mut(self.ptr, self.len) }
+    }
+}
+
+#[allow(dead_code)]
+impl Textura {
+    pub fn destruir(self, m: &Motor) {
+        // SAFETY: nadie usa ya la textura.
+        unsafe {
+            m.gpu.device.destroy_image_view(self.vista, None);
+            m.gpu.device.destroy_image(self.image, None);
+            m.gpu.device.free_memory(self.mem, None);
+        }
+    }
+}
+
+#[allow(dead_code)]
+impl Buffer {
+    pub fn destruir(self, m: &Motor) {
+        // SAFETY: nadie usa ya el buffer.
+        unsafe {
+            m.gpu.device.destroy_buffer(self.buf, None);
+            m.gpu.device.free_memory(self.mem, None);
+        }
+    }
+}
diff --git a/tahoe-gpu/src/probar.rs b/tahoe-gpu/src/probar.rs
new file mode 100644
index 0000000..32b830c
--- /dev/null
+++ b/tahoe-gpu/src/probar.rs
@@ -0,0 +1,392 @@
+//! `tahoe-gpu probar <metallib> <kernel> [ancho alto]`: ejecuta un kernel de Metal traducido en la GPU y el mismo AIR
+//! en el intérprete de la CPU, con las mismas entradas, y compara las salidas (buffers y texturas en las que escribe).
+//! Para kernels sin memoria de threadgroup ni barreras (cada hilo es independiente en la CPU).
+
+use std::collections::HashMap;
+
+use ash::vk;
+
+use crate::air::interp::{self, Mem, Memoria, V};
+use crate::air::ir::{Module, Type};
+use crate::air::spirv::{self, Recurso};
+use crate::air::{self, Entrada};
+use crate::metallib;
+use crate::motor::{Enlazado, Forma, Motor};
+use crate::vk::Res;
+
+const TEX_ENTRADA: u32 = 512;
+const BUF: usize = 1 << 16;
+
+/// Valor de prueba de una textura de entrada en (x, y).
+fn patron(x: u32, y: u32) -> [f32; 4] {
+    let h = |v: f32| interp::f16_a_f32(interp::f32_a_f16(v));
+    [h(x as f32 / 512.0), h(y as f32 / 512.0), h(((x ^ y) & 255) as f32 / 255.0), 1.0]
+}
+
+fn valor_arg(m: &Module, t: usize, xyz: [u32; 3]) -> V {
+    match &m.types[t] {
+        Type::Int(w) => V::Int(*w, xyz[0] as u64),
+        Type::Vector(n, e) => {
+            let w = match m.types[*e] { Type::Int(w) => w, _ => 32 };
+            V::Vec((0..*n as usize).map(|k| V::Int(w, xyz[k] as u64)).collect())
+        }
+        _ => V::Undef,
+    }
+}
+
+pub fn probar(a: Vec<String>) -> Res<()> {
+    let [ruta, nombre] = [a.first(), a.get(1)].map(|x| x.cloned().unwrap_or_default());
+    let ancho: u32 = a.get(2).and_then(|x| x.parse().ok()).unwrap_or(64);
+    let alto: u32 = a.get(3).and_then(|x| x.parse().ok()).unwrap_or(64);
+    let d = std::fs::read(&ruta).map_err(|e| format!("{ruta}: {e}"))?;
+    let b = metallib::Biblioteca::leer(&d)?;
+    let f = b.funciones.iter().find(|f| f.nombre == nombre).ok_or("no está esa función")?;
+    let m = air::ir::leer(b.bitcode(f)?)?;
+    let e: Entrada = air::entradas(&m).into_iter().next().ok_or("sin punto de entrada")?;
+    let t = spirv::traducir(&m, &e, &Default::default())?;
+    let motor = Motor::new()?;
+    println!("{nombre}: {} palabras de SPIR-V, enlaces: {:?}", t.spirv.len(), t.enlaces.iter().map(|x| x.binding).collect::<Vec<_>>());
+
+    // recursos: buffers con un patrón; texturas de entrada 512×512 y de salida ancho×alto (RGBA32F)
+    let fmt = vk::Format::R32G32B32A32_SFLOAT;
+    let mut buffers = HashMap::new();
+    let mut texturas = HashMap::new();
+    let mut tex_cpu: HashMap<u32, (u32, u32, Vec<[f32; 4]>)> = HashMap::new();
+    let mut samplers = HashMap::new();
+    for en in &t.enlaces {
+        match &en.recurso {
+            Recurso::Buffer { indice, .. } => {
+                let buf = motor.buffer(BUF)?;
+                for (k, w) in buf.bytes().chunks_mut(4).enumerate() {
+                    w.copy_from_slice(&((k % 97) as f32 * 0.25).to_le_bytes());
+                }
+                buffers.insert(*indice, buf);
+            }
+            // una textura de Metal por índice: la misma imagen para leer (32+N) y escribir (160+N) si es read_write
+            Recurso::Textura { indice, dim, arreglo } | Recurso::TexturaEscritura { indice, dim, arreglo } => {
+                if texturas.contains_key(indice) {
+                    continue;
+                }
+                let leida = t.enlaces.iter().any(|x| matches!(x.recurso, Recurso::Textura { indice: i, .. } if i == *indice));
+                let escrita = t.enlaces.iter().any(|x| matches!(x.recurso, Recurso::TexturaEscritura { indice: i, .. } if i == *indice));
+                // 2D leída: 512×512 con el patrón; escrita: ancho×alto; otras formas: ×4 capas, ×16 de profundidad
+                let forma = Forma::de_spirv(*dim, *arreglo);
+                let (w, h) = if escrita { (ancho, alto) } else if forma == Forma::D2 { (TEX_ENTRADA, TEX_ENTRADA) } else { (64, 64) };
+                let tx = motor.textura_forma(forma, w, h, 16, 4, fmt)?;
+                let n = (tx.ancho * tx.alto * tx.prof * tx.capas) as usize;
+                let mut cpu = vec![[0.0f32; 4]; n];
+                if leida {
+                    let up = motor.buffer(n * 16)?;
+                    for i in 0..n as u32 {
+                        let (x, y) = (i % tx.ancho, (i / tx.ancho) % tx.alto);
+                        let p = patron(x, y);
+                        let o = i as usize * 16;
+                        for (c, v) in p.iter().enumerate() {
+                            up.bytes()[o + c * 4..o + c * 4 + 4].copy_from_slice(&v.to_le_bytes());
+                        }
+                        cpu[i as usize] = p;
+                    }
+                    motor.copiar(&tx, &up, true)?;
+                }
+                if forma == Forma::D2 {
+                    tex_cpu.insert(*indice, (tx.ancho, tx.alto, cpu));
+                }
+                texturas.insert(*indice, tx);
+            }
+            Recurso::Sampler { .. } | Recurso::SamplerFijo { .. } => {
+                samplers.insert(en.binding, motor.sampler(false)?);
+            }
+        }
+    }
+    // copias para la CPU (antes de que la GPU escriba)
+    let mut mem_cpu: HashMap<u32, Vec<u8>> = buffers.iter().map(|(&k, b)| (k, b.bytes().to_vec())).collect();
+    let mut rec: HashMap<u32, Enlazado> = HashMap::new();
+    for en in &t.enlaces {
+        let x = match &en.recurso {
+            Recurso::Buffer { indice, .. } => Enlazado::Buffer(&buffers[indice]),
+            Recurso::Textura { indice, .. } | Recurso::TexturaEscritura { indice, .. } => Enlazado::Textura(&texturas[indice]),
+            _ => Enlazado::Sampler(samplers[&en.binding]),
+        };
+        rec.insert(en.binding, x);
+    }
+    // sin argumentos que distingan a los hilos, el kernel es para un solo hilo (si no, todos harían lo mismo a la vez)
+    let por_hilo = e.argumentos.iter().any(|d| d.clase.starts_with("air.thread") || d.clase.starts_with("air.threadgroup_position") || d.clase.starts_with("air.simdgroup_index"));
+    let (grupo, rejilla) = if por_hilo { ([8u32, 8, 1], [ancho, alto]) } else { ([1, 1, 1], [1, 1]) };
+
+    // CPU primero (cada threadgroup con sus hilos turnándose en las barreras); si con estos datos el kernel no
+    // termina en un número razonable de pasos, no se lanza en la GPU (se colgaría)
+    let t0 = std::time::Instant::now();
+    let mut memoria = Memoria::nueva(&m);
+    let orden_buf: Vec<u32> = mem_cpu.keys().copied().collect();
+    for k in &orden_buf {
+        memoria.externas.push(std::mem::take(mem_cpu.get_mut(k).unwrap()));
+    }
+    let fun = air::inline::inline_todo(&m, e.funcion)?;
+    let cpu = cpu_kernel(&m, &e, &fun, &mut memoria, &orden_buf, &mut tex_cpu, rejilla, grupo);
+    println!("CPU: {:.2} ms", t0.elapsed().as_secs_f64() * 1e3);
+    let comparar_cpu = match &cpu {
+        Ok(()) => true,
+        Err(err) if err.contains("demasiados pasos") => return Err(format!("CPU: {err}; no se lanza en la GPU")),
+        Err(err) => {
+            println!("CPU: {err}");
+            false
+        }
+    };
+
+    let p = motor.pipeline_computo(&t, grupo)?;
+    if !comparar_cpu && std::env::var_os("TAHOE_GPU_FORZAR").is_none() {
+        // sin referencia no se sabe si con estos datos termina: no se arriesga a colgar la GPU
+        println!("pipeline creado; sin referencia de la CPU no se ejecuta (TAHOE_GPU_FORZAR=1 para ejecutarlo)");
+        return Ok(());
+    }
+    let t0 = std::time::Instant::now();
+    motor.despachar(&p, &rec, [rejilla[0], rejilla[1], 1], grupo)?;
+    println!("GPU: {:.2} ms", t0.elapsed().as_secs_f64() * 1e3);
+    if !comparar_cpu {
+        println!("GPU sin errores (sin referencia de la CPU)");
+        return Ok(());
+    }
+
+    // comparar
+    let mut total_mal = 0usize;
+    for en in &t.enlaces {
+        match &en.recurso {
+            Recurso::TexturaEscritura { indice, .. } if tex_cpu.contains_key(indice) => {
+                let tx = &texturas[indice];
+                let down = motor.buffer((ancho * alto * 16) as usize)?;
+                motor.copiar(tx, &down, false)?;
+                let (_, _, cpu) = &tex_cpu[indice];
+                let mut mal = 0;
+                let mut ejemplo = None;
+                for i in 0..(ancho * alto) as usize {
+                    for c in 0..4 {
+                        let o = i * 16 + c * 4;
+                        let g = f32::from_le_bytes(down.bytes()[o..o + 4].try_into().unwrap());
+                        let r = cpu[i][c];
+                        if (g - r).abs() > 1e-3 * r.abs().max(1.0) {
+                            mal += 1;
+                            ejemplo.get_or_insert((i, c, g, r));
+                        }
+                    }
+                }
+                println!("textura {indice}: {} valores, {mal} distintos{}", ancho * alto * 4, ejemplo.map(|(i, c, g, r)| format!(" (p. ej. píxel {i} canal {c}: GPU {g}, CPU {r})")).unwrap_or_default());
+                total_mal += mal;
+            }
+            Recurso::Buffer { indice, escritura: true } => {
+                let pos = orden_buf.iter().position(|b| b == indice).unwrap();
+                let cpu = &memoria.externas[pos];
+                let gpu = buffers[indice].bytes();
+                let mut mal = 0;
+                for k in (0..BUF).step_by(4) {
+                    let (g, r) = (f32::from_le_bytes(gpu[k..k + 4].try_into().unwrap()), f32::from_le_bytes(cpu[k..k + 4].try_into().unwrap()));
+                    if g.to_bits() != r.to_bits() && (g - r).abs() > 1e-3 * r.abs().max(1.0) {
+                        mal += 1;
+                    }
+                }
+                println!("buffer {indice}: {} palabras, {mal} distintas", BUF / 4);
+                total_mal += mal;
+            }
+            _ => {}
+        }
+    }
+    if total_mal > 0 {
+        return Err(format!("{total_mal} resultados distintos entre la GPU y la CPU"));
+    }
+    println!("GPU y CPU coinciden");
+    Ok(())
+}
+
+fn redondear_pub(bits: u32, x: f64) -> f64 {
+    match bits {
+        16 => interp::f16_a_f32(interp::f32_a_f16(x as f32)) as f64,
+        32 => x as f32 as f64,
+        _ => x,
+    }
+}
+
+/// Pasos máximos por hilo en la CPU.
+const PASOS_HILO: u64 = 2_000_000;
+
+fn vec3(m: &Module, t: usize, v: [u32; 3]) -> V {
+    valor_arg(m, t, v)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn cpu_kernel(
+    m: &Module,
+    e: &Entrada,
+    fun: &air::ir::Function,
+    memoria: &mut Memoria,
+    orden_buf: &[u32],
+    tex_cpu: &mut HashMap<u32, (u32, u32, Vec<[f32; 4]>)>,
+    [ancho, alto]: [u32; 2],
+    grupo: [u32; 3],
+) -> Res<()> {
+    let grupos = [ancho.div_ceil(grupo[0]), alto.div_ceil(grupo[1]), 1];
+    // buffers de threadgroup (air.buffer en address_space 3): una región por grupo, al final de las externas
+    let mut wg_args: HashMap<usize, u32> = HashMap::new();
+    for d in &e.argumentos {
+        if d.clase == "air.buffer" && d.int_tras("air.address_space") == Some(3) {
+            wg_args.insert(d.indice as usize, memoria.externas.len() as u32);
+            memoria.externas.push(vec![0u8; 4096 * 4]);
+        }
+    }
+    for gy in 0..grupos[1] {
+        for gx in 0..grupos[0] {
+            for &r in wg_args.values() {
+                memoria.externas[r as usize].fill(0);
+            }
+            let base_alloca = memoria.allocas.len();
+            let mut hilos = Vec::new();
+            for ly in 0..grupo[1] {
+                for lx in 0..grupo[0] {
+                    let (x, y) = (gx * grupo[0] + lx, gy * grupo[1] + ly);
+                    let mut args = Vec::new();
+                    for (k, &pv) in fun.args.iter().enumerate() {
+                        let t_arg = fun.values[pv].ty;
+                        let desc = e.argumentos.iter().find(|d| d.indice == k as i64);
+                        let v = match desc.map(|d| d.clase.as_str()) {
+                            Some("air.thread_position_in_grid") => vec3(m, t_arg, [x, y, 0]),
+                            Some("air.thread_position_in_threadgroup") => vec3(m, t_arg, [lx, ly, 0]),
+                            Some("air.threadgroup_position_in_grid") => vec3(m, t_arg, [gx, gy, 0]),
+                            Some("air.threadgroups_per_grid") => vec3(m, t_arg, grupos),
+                            Some("air.threads_per_threadgroup") => vec3(m, t_arg, grupo),
+                            Some("air.threads_per_grid") => vec3(m, t_arg, [ancho, alto, 1]),
+                            Some("air.thread_index_in_threadgroup") => vec3(m, t_arg, [ly * grupo[0] + lx, 0, 0]),
+                            Some("air.thread_index_in_simdgroup") => vec3(m, t_arg, [(ly * grupo[0] + lx) % 32, 0, 0]),
+                            Some("air.simdgroup_index_in_threadgroup") => vec3(m, t_arg, [(ly * grupo[0] + lx) / 32, 0, 0]),
+                            Some("air.threads_per_simdgroup") => vec3(m, t_arg, [32, 0, 0]),
+                            Some("air.simdgroups_per_threadgroup") => vec3(m, t_arg, [(grupo[0] * grupo[1]).div_ceil(32), 0, 0]),
+                            Some("air.thread_index_in_quadgroup") => vec3(m, t_arg, [(ly * grupo[0] + lx) % 4, 0, 0]),
+                            Some("air.quadgroups_per_threadgroup") => vec3(m, t_arg, [(grupo[0] * grupo[1]).div_ceil(4), 0, 0]),
+                            Some("air.quadgroup_index_in_threadgroup") => vec3(m, t_arg, [(ly * grupo[0] + lx) / 4, 0, 0]),
+                            Some("air.buffer") if wg_args.contains_key(&k) => V::Ptr(Mem::Externa(wg_args[&k]), 0),
+                            Some("air.buffer" | "air.indirect_buffer") => {
+                                let i = desc.unwrap().int_tras("air.location_index").unwrap_or(0) as u32;
+                                match orden_buf.iter().position(|&b| b == i) {
+                                    Some(pos) => V::Ptr(Mem::Externa(pos as u32), 0),
+                                    None => V::Undef, // sin uso en el kernel (la traducción no lo enlaza)
+                                }
+                            }
+                            Some("air.texture") => V::Ptr(Mem::Externa(1000 + desc.unwrap().int_tras("air.location_index").unwrap_or(0) as u32), 0),
+                            Some("air.sampler") => V::Undef,
+                            Some(c) => return Err(format!("argumento {c} sin valor en la CPU")),
+                            None => V::Undef,
+                        };
+                        args.push(v);
+                    }
+                    hilos.push((interp::Hilo::nuevo(fun, &args), 0u64, (), [x, y]));
+                }
+            }
+            // por turnos: cada vuelta lleva a todos a la siguiente barrera o función de SIMD-group; las de SIMD-group
+            // se calculan cuando han llegado todos los hilos que siguen vivos
+            #[derive(Clone)]
+            enum Espera {
+                Nada,
+                Barrera,
+                Simd(String, Vec<V>),
+                Fin,
+            }
+            let mut espera = vec![Espera::Nada; hilos.len()];
+            loop {
+                for (i, (h, pasos, _, [x, y])) in hilos.iter_mut().enumerate() {
+                    if !matches!(espera[i], Espera::Nada) {
+                        continue;
+                    }
+                    let mut ext = |nombre: &str, a: &[V]| externa_cpu(m, tex_cpu, nombre, a);
+                    espera[i] = match interp::correr(m, fun, h, memoria, &mut ext, pasos, PASOS_HILO).map_err(|err| format!("hilo ({x},{y}): {err}"))? {
+                        interp::Parada::Fin(_) => Espera::Fin,
+                        interp::Parada::Barrera => Espera::Barrera,
+                        interp::Parada::Colectiva(n, a) => Espera::Simd(n, a),
+                    };
+                }
+                if espera.iter().all(|e| matches!(e, Espera::Fin)) {
+                    break;
+                }
+                // SIMD-groups de 32 hilos seguidos: los que esperan en una función colectiva la resuelven juntos
+                let mut avance = false;
+                for g in (0..hilos.len()).step_by(32) {
+                    let fin = (g + 32).min(hilos.len());
+                    let nombre = (g..fin).find_map(|k| match &espera[k] { Espera::Simd(n, _) => Some(n.clone()), _ => None });
+                    let Some(nombre) = nombre else { continue };
+                    let args: Vec<Option<Vec<V>>> = (g..fin).map(|k| match &espera[k] { Espera::Simd(n, a) if *n == nombre => Some(a.clone()), _ => None }).collect();
+                    let res = interp::simd_cpu(&nombre, &args)?;
+                    for (k, r) in res.into_iter().enumerate() {
+                        if args[k].is_some() {
+                            hilos[g + k].0.reanudar(r);
+                            espera[g + k] = Espera::Nada;
+                            avance = true;
+                        }
+                    }
+                }
+                if !avance {
+                    // nadie en funciones colectivas: se sueltan las barreras
+                    for e in espera.iter_mut() {
+                        if matches!(e, Espera::Barrera) {
+                            *e = Espera::Nada;
+                        }
+                    }
+                }
+            }
+            memoria.allocas.truncate(base_alloca);
+        }
+    }
+    Ok(())
+}
+
+/// Llamadas air.* en la CPU: texturas (con las copias de `tex_cpu`) y matemáticas.
+fn externa_cpu(m: &Module, tex_cpu: &mut HashMap<u32, (u32, u32, Vec<[f32; 4]>)>, nombre: &str, a: &[V]) -> Option<Option<V>> {
+    let tex = |v: &V| match v { V::Ptr(Mem::Externa(n), _) if *n >= 1000 => Some(n - 1000), _ => None };
+    if nombre.starts_with("air.read_texture_2d.") {
+        let (w, h, px) = tex_cpu.get(&tex(&a[0])?)?;
+        let V::Vec(c) = &a[2] else { return None };
+        let (cx, cy) = (c[0].int()? as u32, c[1].int()? as u32);
+        let v = if cx < *w && cy < *h { px[(cy * w + cx) as usize] } else { [0.0; 4] };
+        let bits = if nombre.contains("f16") { 16 } else { 32 };
+        return Some(Some(V::Agg(vec![V::Vec(v.iter().map(|&q| V::Real(bits, redondear_pub(bits, q as f64))).collect()), V::Int(8, 0)])));
+    }
+    if nombre.starts_with("air.write_texture_2d.") {
+        let (w, h, px) = tex_cpu.get_mut(&tex(&a[0])?)?;
+        let V::Vec(c) = &a[1] else { return None };
+        let (cx, cy) = (c[0].int()? as u32, c[1].int()? as u32);
+        let V::Vec(val) = &a[2] else { return None };
+        if cx < *w && cy < *h {
+            let i = (cy * *w + cx) as usize;
+            for k in 0..4 {
+                px[i][k] = val.get(k).and_then(|x| x.real()).unwrap_or(0.0) as f32;
+            }
+        }
+        return Some(None);
+    }
+    if let Some(r) = nombre.strip_prefix("air.get_width_texture_2d").or_else(|| nombre.strip_prefix("air.get_height_texture_2d")) {
+        let _ = r;
+        let (w, h, _) = tex_cpu.get(&tex(&a[0])?)?;
+        return Some(Some(V::Int(32, if nombre.contains("width") { *w } else { *h } as u64)));
+    }
+    if nombre.starts_with("air.sample_texture_2d.") {
+        // sampler de las pruebas: nearest, coordenadas normalizadas, sujetas al borde
+        let (w, h, px) = tex_cpu.get(&tex(&a[0])?)?;
+        let V::Vec(c) = &a[2] else { return None };
+        let (u, v) = (c[0].real()?, c[1].real()?);
+        let cx = ((u * *w as f64).floor().max(0.0) as u32).min(w - 1);
+        let cy = ((v * *h as f64).floor().max(0.0) as u32).min(h - 1);
+        let t = px[(cy * w + cx) as usize];
+        let bits = if nombre.contains("f16") { 16 } else { 32 };
+        return Some(Some(V::Agg(vec![V::Vec(t.iter().map(|&q| V::Real(bits, redondear_pub(bits, q as f64))).collect()), V::Int(8, 0)])));
+    }
+    if nombre.starts_with("air.get_num_mip_levels") || nombre.starts_with("air.get_num_samples") {
+        return Some(Some(V::Int(32, 1)));
+    }
+    if nombre == "air.get_read_sampler" {
+        return Some(Some(V::Undef));
+    }
+    if nombre.starts_with("llvm.lifetime") || nombre.starts_with("air.mem.barrier") {
+        return Some(None);
+    }
+    if nombre.starts_with("llvm.") {
+        return interp::llvm_math(nombre, a).map(Some);
+    }
+    let fi = m.functions.iter().position(|f| f.name == nombre)?;
+    let ret = match &m.types[m.functions[fi].ty] { Type::Function { ret, .. } => *ret, _ => return None };
+    interp::air_math(m, nombre, a, ret).map(Some)
+}
