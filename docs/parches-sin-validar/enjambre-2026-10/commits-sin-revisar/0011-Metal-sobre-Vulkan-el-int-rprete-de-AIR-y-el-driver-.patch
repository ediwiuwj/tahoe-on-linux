+/// Intrínsecas llvm.* en la CPU (referencia).
+pub fn llvm_math(nombre: &str, args: &[V]) -> Option<V> {
+    let resto = nombre.strip_prefix("llvm.")?;
+    let base = resto.split('.').next()?;
+    let ent = |f: &dyn Fn(u32, u64, u64) -> u64| enteros_n(args, &|a| f(a[0].0, a[0].1, a.get(1).map(|x| x.1).unwrap_or(0)));
+    Some(match base {
+        "smax" => ent(&|w, x, y| sext(w, x).max(sext(w, y)) as u64)?,
+        "smin" => ent(&|w, x, y| sext(w, x).min(sext(w, y)) as u64)?,
+        "umax" => ent(&|_, x, y| x.max(y))?,
+        "umin" => ent(&|_, x, y| x.min(y))?,
+        "abs" if matches!(args[0], V::Int(..)) || matches!(&args[0], V::Vec(e) if matches!(e.first(), Some(V::Int(..)))) => {
+            enteros_n(&args[..1], &|a| sext(a[0].0, a[0].1).unsigned_abs())?
+        }
+        "ctpop" => enteros_n(&args[..1], &|a| a[0].1.count_ones() as u64)?,
+        "cttz" => enteros_n(&args[..1], &|a| if a[0].1 == 0 { a[0].0 as u64 } else { a[0].1.trailing_zeros() as u64 })?,
+        "ctlz" => enteros_n(&args[..1], &|a| if a[0].1 == 0 { a[0].0 as u64 } else { (a[0].1.leading_zeros() - (64 - a[0].0)) as u64 })?,
+        "bitreverse" => enteros_n(&args[..1], &|a| a[0].1.reverse_bits() >> (64 - a[0].0))?,
+        "bswap" => enteros_n(&args[..1], &|a| a[0].1.swap_bytes() >> (64 - a[0].0))?,
+        "fabs" => mapa1(&args[0], &f64::abs)?,
+        "floor" => mapa1(&args[0], &f64::floor)?,
+        "ceil" => mapa1(&args[0], &f64::ceil)?,
+        "trunc" => mapa1(&args[0], &f64::trunc)?,
+        "rint" | "nearbyint" | "roundeven" => mapa1(&args[0], &|x| { let r = x.round(); if (x - x.trunc()).abs() == 0.5 { 2.0 * (x / 2.0).round() } else { r } })?,
+        "round" => mapa1(&args[0], &f64::round)?,
+        "sqrt" => mapa1(&args[0], &f64::sqrt)?,
+        "exp2" => mapa1(&args[0], &f64::exp2)?,
+        "log2" => mapa1(&args[0], &f64::log2)?,
+        "exp" => mapa1(&args[0], &f64::exp)?,
+        "log" => mapa1(&args[0], &f64::ln)?,
+        "sin" => mapa1(&args[0], &f64::sin)?,
+        "cos" => mapa1(&args[0], &f64::cos)?,
+        "pow" => mapa_n(args, &|a| a[0].powf(a[1]))?,
+        "minnum" | "minimum" => mapa_n(args, &|a| a[0].min(a[1]))?,
+        "maxnum" | "maximum" => mapa_n(args, &|a| a[0].max(a[1]))?,
+        "fma" | "fmuladd" => mapa_n(args, &|a| a[0] * a[1] + a[2])?,
+        "copysign" => mapa_n(args, &|a| a[0].abs().copysign(a[1]))?,
+        _ => return None,
+    })
+}
+
+/// Atómicas de AIR en el intérprete (los hilos van de uno en uno: basta con leer y escribir).
+fn atomica_cpu(m: &Module, mem: &mut Memoria, nombre: &str, a: &[V], ty: TypeId) -> Res<Option<V>> {
+    let p: Vec<&str> = nombre.split('.').collect();
+    let op = p.get(3).copied().unwrap_or("");
+    if p.get(2) == Some(&"fence") {
+        return Ok(None);
+    }
+    let signo = p.get(4) == Some(&"s");
+    let real = p.last().is_some_and(|t| t.starts_with('f'));
+    let t32 = m.types.iter().position(|t| *t == Type::Int(32)).ok_or("sin tipo i32")?;
+    let viejo = mem.cargar(m, &a[0], t32)?;
+    let V::Int(_, x) = viejo else { return Err("atómica sobre un valor desconocido".into()) };
+    let bits = |v: &V| -> u64 { match v { V::Real(_, f) => (*f as f32).to_bits() as u64, o => o.int().unwrap_or(0) & 0xffff_ffff } };
+    let como = |x: u64| if real { V::Real(32, f32::from_bits(x as u32) as f64) } else { V::Int(32, x) };
+    let (nuevo, res) = match op {
+        "load" => (None, Some(como(x))),
+        "store" => (Some(bits(&a[1])), None),
+        "cmpxchg" => {
+            let esperado = mem.cargar(m, &a[1], t32)?.int().unwrap_or(0);
+            let ok = x == esperado;
+            mem.guardar(m, &a[1], t32, &V::Int(32, x))?;
+            let r = match m.types[ty] { Type::Int(w) => V::Int(w, ok as u64), _ => V::Int(1, ok as u64) };
+            (if ok { Some(bits(&a[2])) } else { None }, Some(r))
+        }
+        _ => {
+            let y = bits(&a[1]);
+            let n = if real {
+                let (fx, fy) = (f32::from_bits(x as u32), f32::from_bits(y as u32));
+                (match op { "add" => fx + fy, "sub" => fx - fy, "xchg" => fy, _ => return Err(format!("{nombre} sin referencia")) }).to_bits() as u64
+            } else {
+                let (sx, sy) = (x as u32 as i32, y as u32 as i32);
+                match op {
+                    "add" => x.wrapping_add(y),
+                    "sub" => x.wrapping_sub(y),
+                    "max" if signo => sx.max(sy) as u32 as u64,
+                    "min" if signo => sx.min(sy) as u32 as u64,
+                    "max" => x.max(y),
+                    "min" => x.min(y),
+                    "and" => x & y,
+                    "or" => x | y,
+                    "xor" => x ^ y,
+                    "xchg" => y,
+                    _ => return Err(format!("{nombre} sin referencia")),
+                }
+            };
+            (Some(n & 0xffff_ffff), Some(como(x)))
+        }
+    };
+    if let Some(n) = nuevo {
+        mem.guardar(m, &a[0], t32, &V::Int(32, n))?;
+    }
+    Ok(res)
+}
diff --git a/tahoe-gpu/src/air/ir.rs b/tahoe-gpu/src/air/ir.rs
new file mode 100644
index 0000000..af6deb0
--- /dev/null
+++ b/tahoe-gpu/src/air/ir.rs
@@ -0,0 +1,911 @@
+//! Lector del IR de LLVM en formato bitcode (el AIR de Metal es un módulo LLVM con funciones `air.*` y metadatos
+//! `!air.*`). El crate `llvm-bitcode` da los bloques y registros del flujo de bits; aquí se interpretan como en
+//! `BitcodeReader.cpp` de LLVM: tabla de tipos, valores globales (con nombres en STRTAB), constantes, metadatos y el
+//! cuerpo de cada función con la numeración relativa de operandos (versión 2 del módulo).
+
+use std::collections::HashMap;
+
+use llvm_bitcode::bitcode::{BitcodeElement, Payload};
+use llvm_bitcode::Bitcode;
+
+pub type Res<T> = Result<T, String>;
+
+// ---------------------------------------------------------------- flujo de bits normalizado
+
+/// Un registro: código y operandos (los campos y, si lo hay, el arreglo final del registro abreviado).
+#[derive(Debug, Clone)]
+pub struct Rec {
+    pub code: u64,
+    pub ops: Vec<u64>,
+    pub blob: Option<Vec<u8>>,
+}
+
+#[derive(Debug, Clone)]
+pub enum Elem {
+    Rec(Rec),
+    Blk(Blk),
+}
+
+#[derive(Debug, Clone)]
+pub struct Blk {
+    pub id: u32,
+    pub elems: Vec<Elem>,
+}
+
+impl Blk {
+    pub fn recs(&self) -> impl Iterator<Item = &Rec> {
+        self.elems.iter().filter_map(|e| if let Elem::Rec(r) = e { Some(r) } else { None })
+    }
+    pub fn blks(&self) -> impl Iterator<Item = &Blk> {
+        self.elems.iter().filter_map(|e| if let Elem::Blk(b) = e { Some(b) } else { None })
+    }
+}
+
+fn convertir(e: BitcodeElement) -> Elem {
+    match e {
+        BitcodeElement::Block(b) => Elem::Blk(Blk { id: b.id, elems: b.elements.into_iter().map(convertir).collect() }),
+        BitcodeElement::Record(mut r) => {
+            let mut ops = r.fields().to_vec();
+            let mut blob = None;
+            match r.take_payload() {
+                Some(Payload::Array(a)) => ops.extend(a),
+                Some(Payload::Char6String(s)) => ops.extend(s.bytes().map(u64::from)),
+                Some(Payload::Blob(b)) => blob = Some(b),
+                None => {}
+            }
+            Elem::Rec(Rec { code: r.id, ops, blob })
+        }
+    }
+}
+
+// Bloques (LLVMBitCodes.h)
+const MODULE: u32 = 8;
+const PARAMATTR: u32 = 9;
+const CONSTANTS: u32 = 11;
+const FUNCTION: u32 = 12;
+const VALUE_SYMTAB: u32 = 14;
+const METADATA: u32 = 15;
+const TYPE_NEW: u32 = 17;
+const STRTAB: u32 = 23;
+
+// ---------------------------------------------------------------- tipos
+
+pub type TypeId = usize;
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Type {
+    Void,
+    Half,
+    BFloat,
+    Float,
+    Double,
+    Label,
+    Metadata,
+    Token,
+    Int(u32),
+    /// Puntero opaco con su espacio de direcciones (AIR: 0 privado, 1 device, 2 constant, 3 threadgroup).
+    Ptr(u32),
+    Array(u64, TypeId),
+    Vector(u32, TypeId),
+    Struct { name: Option<String>, packed: bool, elems: Vec<TypeId> },
+    Function { vararg: bool, ret: TypeId, params: Vec<TypeId> },
+    Opaque(Option<String>),
+    Otro(u64),
+}
+
+// ---------------------------------------------------------------- valores
+
+pub type ValueId = usize;
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Const {
+    Null,
+    Undef,
+    Poison,
+    Int(i128),
+    /// Bits del número en coma flotante (half, float o double según el tipo).
+    Float(u64),
+    Aggregate(Vec<ValueId>),
+    /// Arreglo o vector de enteros o reales en crudo (CST_CODE_DATA).
+    Data(Vec<u64>),
+    Str(Vec<u8>),
+    /// Expresión constante: un código de instrucción con operandos (CE_CAST, CE_GEP...).
+    Expr { code: u64, ops: Vec<u64> },
+}
+
+#[derive(Debug, Clone)]
+pub enum ValueKind {
+    Function(usize),
+    Global(usize),
+    Const(Const),
+    Arg(usize),
+    /// Resultado de una instrucción: (bloque, posición).
+    Inst(usize, usize),
+    /// Valor de metadatos usado como operando (llamadas a llvm.dbg.* y similares).
+    Metadata(usize),
+}
+
+#[derive(Debug, Clone)]
+pub struct Value {
+    pub ty: TypeId,
+    pub kind: ValueKind,
+}
+
+// ---------------------------------------------------------------- instrucciones
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum BinOp {
+    Add,
+    Sub,
+    Mul,
+    UDiv,
+    SDiv,
+    URem,
+    SRem,
+    Shl,
+    LShr,
+    AShr,
+    And,
+    Or,
+    Xor,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CastOp {
+    Trunc,
+    ZExt,
+    SExt,
+    FPToUI,
+    FPToSI,
+    UIToFP,
+    SIToFP,
+    FPTrunc,
+    FPExt,
+    PtrToInt,
+    IntToPtr,
+    BitCast,
+    AddrSpaceCast,
+}
+
+#[derive(Debug, Clone)]
+pub enum Inst {
+    Bin { op: BinOp, a: ValueId, b: ValueId },
+    FNeg(ValueId),
+    Cast { op: CastOp, v: ValueId },
+    /// Predicado de LLVM: 0-15 comparaciones reales, 32-41 enteras.
+    Cmp { pred: u32, a: ValueId, b: ValueId },
+    Select { c: ValueId, t: ValueId, f: ValueId },
+    ExtractElt { v: ValueId, i: ValueId },
+    InsertElt { v: ValueId, e: ValueId, i: ValueId },
+    Shuffle { a: ValueId, b: ValueId, mask: ValueId },
+    ExtractVal { v: ValueId, idx: Vec<u32> },
+    InsertVal { agg: ValueId, v: ValueId, idx: Vec<u32> },
+    Load { ptr: ValueId, align: u32 },
+    Store { ptr: ValueId, val: ValueId, align: u32 },
+    Gep { src_ty: TypeId, ptr: ValueId, idx: Vec<ValueId>, inbounds: bool },
+    Alloca { ty: TypeId, n: ValueId, align: u32 },
+    Call { fnty: TypeId, callee: ValueId, args: Vec<ValueId> },
+    Phi { incoming: Vec<(ValueId, usize)> },
+    Br(usize),
+    CondBr { c: ValueId, t: usize, f: usize },
+    Switch { v: ValueId, default: usize, cases: Vec<(ValueId, usize)> },
+    Ret(Option<ValueId>),
+    Unreachable,
+    Freeze(ValueId),
+    AtomicRmw { op: u32, ptr: ValueId, val: ValueId },
+    CmpXchg { ptr: ValueId, cmp: ValueId, new: ValueId },
+    Fence,
+}
+
+#[derive(Debug, Clone)]
+pub struct Instr {
+    pub inst: Inst,
+    /// Tipo del resultado (Void si no da valor).
+    pub ty: TypeId,
+    /// Número de valor del resultado, si da valor.
+    pub val: Option<ValueId>,
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct BasicBlock {
+    pub insts: Vec<Instr>,
+}
+
+#[derive(Debug, Clone)]
+pub struct Function {
+    pub name: String,
+    pub ty: TypeId,
+    pub is_proto: bool,
+    /// Tabla de valores de la función: globales, constantes del módulo, argumentos, constantes de la función e
+    /// instrucciones, por número de valor.
+    pub values: Vec<Value>,
+    pub args: Vec<ValueId>,
+    pub blocks: Vec<BasicBlock>,
+}
+
+#[derive(Debug, Clone)]
+pub struct Global {
+    pub name: String,
+    /// Tipo del contenido (no el del puntero).
+    pub ty: TypeId,
+    pub addrspace: u32,
+    pub is_const: bool,
+    pub init: Option<ValueId>,
+}
+
+// ---------------------------------------------------------------- metadatos
+
+#[derive(Debug, Clone)]
+pub enum Md {
+    Str(String),
+    /// Un valor del módulo (número de valor global y su tipo).
+    Value(TypeId, ValueId),
+    Node(Vec<Option<usize>>),
+    Otro,
+}
+
+#[derive(Debug, Clone)]
+pub struct Module {
+    pub types: Vec<Type>,
+    pub functions: Vec<Function>,
+    pub globals: Vec<Global>,
+    /// Valores del ámbito del módulo (globales y constantes), por número de valor.
+    pub values: Vec<Value>,
+    pub md: Vec<Md>,
+    pub named_md: HashMap<String, Vec<usize>>,
+    pub triple: String,
+}
+
+// ---------------------------------------------------------------- lectura
+
+struct Lector {
+    types: Vec<Type>,
+    values: Vec<Value>,
+    functions: Vec<Function>,
+    globals: Vec<Global>,
+    md: Vec<Md>,
+    named_md: HashMap<String, Vec<usize>>,
+    strtab: Vec<u8>,
+    triple: String,
+}
+
+fn texto(ops: &[u64]) -> String {
+    ops.iter().map(|&c| c as u8 as char).collect()
+}
+
+fn signo(v: u64) -> i64 {
+    // VBR con signo en el bit bajo (emitSignedInt64)
+    if v & 1 == 0 { (v >> 1) as i64 } else if v != 1 { -((v >> 1) as i64) } else { i64::MIN }
+}
+
+impl Lector {
+    fn nombre(&self, off: u64, len: u64) -> String {
+        let (o, l) = (off as usize, len as usize);
+        self.strtab.get(o..o + l).map(|b| String::from_utf8_lossy(b).into_owned()).unwrap_or_default()
+    }
+
+    fn tipos(&mut self, b: &Blk) -> Res<()> {
+        let mut nombre: Option<String> = None;
+        for r in b.recs() {
+            let o = &r.ops;
+            let t = match r.code {
+                1 => continue, // NUMENTRY
+                2 => Type::Void,
+                3 => Type::Float,
+                4 => Type::Double,
+                5 => Type::Label,
+                6 => Type::Opaque(nombre.take()),
+                7 => Type::Int(o[0] as u32),
+                8 => Type::Ptr(o.get(1).copied().unwrap_or(0) as u32),
+                10 => Type::Half,
+                11 => Type::Array(o[0], o[1] as usize),
+                12 => Type::Vector(o[0] as u32, o[1] as usize),
+                16 => Type::Metadata,
+                18 => Type::Struct { name: None, packed: o[0] != 0, elems: o[1..].iter().map(|&x| x as usize).collect() },
+                19 => {
+                    nombre = Some(texto(o));
+                    continue;
+                }
+                20 => Type::Struct { name: nombre.take(), packed: o[0] != 0, elems: o[1..].iter().map(|&x| x as usize).collect() },
+                21 => Type::Function { vararg: o[0] != 0, ret: o[1] as usize, params: o[2..].iter().map(|&x| x as usize).collect() },
+                22 => Type::Token,
+                23 => Type::BFloat,
+                25 => Type::Ptr(o.first().copied().unwrap_or(0) as u32),
+                c => Type::Otro(c),
+            };
+            self.types.push(t);
+        }
+        Ok(())
+    }
+
+    fn ty(&self, t: TypeId) -> Res<&Type> {
+        self.types.get(t).ok_or_else(|| format!("tipo {t} fuera de la tabla"))
+    }
+
+    /// Bloque de constantes: añade valores a `values`.
+    fn constantes(&self, b: &Blk, values: &mut Vec<Value>) -> Res<()> {
+        let mut ty: TypeId = 0;
+        for r in b.recs() {
+            let o = &r.ops;
+            let c = match r.code {
+                1 => {
+                    ty = o[0] as usize;
+                    continue;
+                }
+                2 => Const::Null,
+                3 => Const::Undef,
+                26 => Const::Poison,
+                4 => Const::Int(signo(o[0]) as i128),
+                5 => {
+                    // entero ancho: palabras de 64 bits con signo
+                    let lo = signo(o[0]) as i128 as u128 & 0xffff_ffff_ffff_ffff;
+                    let hi = o.get(1).map(|&x| signo(x) as i128).unwrap_or(0);
+                    Const::Int(((hi << 64) as u128 | lo) as i128)
+                }
+                6 => Const::Float(o[0]),
+                7 => Const::Aggregate(o.iter().map(|&x| x as usize).collect()),
+                8 | 9 => {
+                    let mut s: Vec<u8> = o.iter().map(|&x| x as u8).collect();
+                    if r.code == 9 {
+                        s.push(0);
+                    }
+                    Const::Str(s)
+                }
+                22 => Const::Data(o.clone()),
+                c => Const::Expr { code: c, ops: o.clone() },
+            };
+            values.push(Value { ty, kind: ValueKind::Const(c) });
+        }
+        Ok(())
+    }
+
+    fn metadatos(&mut self, b: &Blk) -> Res<()> {
+        let mut nombre: Option<String> = None;
+        for r in b.recs() {
+            let o = &r.ops;
+            match r.code {
+                35 => {
+                    // METADATA_STRINGS: [cuenta, desplazamiento], blob = longitudes en VBR6 y luego los caracteres
+                    let (n, off) = (o[0] as usize, o[1] as usize);
+                    let blob = r.blob.as_deref().ok_or("METADATA_STRINGS sin blob")?;
+                    let mut lens = Vec::with_capacity(n);
+                    let mut bits = BitLector { d: blob, pos: 0 };
+                    for _ in 0..n {
+                        lens.push(bits.vbr(6)? as usize);
+                    }
+                    let mut p = off;
+                    for l in lens {
+                        let s = blob.get(p..p + l).ok_or("cadena de metadatos fuera del blob")?;
+                        self.md.push(Md::Str(String::from_utf8_lossy(s).into_owned()));
+                        p += l;
+                    }
+                }
+                1 => self.md.push(Md::Str(texto(o))),
+                2 => self.md.push(Md::Value(o[0] as usize, o[1] as usize)),
+                3 | 5 => self.md.push(Md::Node(o.iter().map(|&x| if x == 0 { None } else { Some(x as usize - 1) }).collect())),
+                4 => nombre = Some(texto(o)),
+                10 => {
+                    if let Some(n) = nombre.take() {
+                        self.named_md.insert(n, o.iter().map(|&x| x as usize).collect());
+                    }
+                }
+                6 | 11 | 36 | 38 | 39 => {} // KIND, ATTACHMENT, GLOBAL_DECL_ATTACHMENT, INDEX_OFFSET, INDEX: no ocupan número
+                _ => self.md.push(Md::Otro),
+            }
+        }
+        Ok(())
+    }
+
+    fn modulo(&mut self, m: &Blk) -> Res<()> {
+        // 1) tipos, atributos y constantes/valores globales en el orden del bloque
+        let mut cuerpos: Vec<&Blk> = Vec::new();
+        for e in &m.elems {
+            match e {
+                Elem::Blk(b) if b.id == TYPE_NEW => self.tipos(b)?,
+                Elem::Blk(b) if b.id == CONSTANTS => {
+                    let mut v = std::mem::take(&mut self.values);
+                    self.constantes(b, &mut v)?;
+                    self.values = v;
+                }
+                Elem::Blk(b) if b.id == METADATA => self.metadatos(b)?,
+                Elem::Blk(b) if b.id == FUNCTION => cuerpos.push(b),
+                Elem::Blk(b) if b.id == PARAMATTR || b.id == VALUE_SYMTAB => {}
+                Elem::Blk(_) => {}
+                Elem::Rec(r) => {
+                    let o = &r.ops;
+                    match r.code {
+                        2 => self.triple = texto(o),
+                        7 => {
+                            // GLOBALVAR v2: [strtab_off, strtab_size, tipo, isconst|explícito<<1|as<<2, initid, linkage, ...]
+                            let name = self.nombre(o[0], o[1]);
+                            let flags = o[3];
+                            let ty = o[2] as usize;
+                            let addrspace = if flags & 2 != 0 { (flags >> 2) as u32 } else if let Ok(Type::Ptr(a)) = self.ty(ty) { *a } else { 0 };
+                            let init = if o[4] != 0 { Some(o[4] as usize - 1) } else { None };
+                            let gi = self.globals.len();
+                            self.globals.push(Global { name, ty, addrspace, is_const: flags & 1 != 0, init });
+                            let pty = self.ptr_type(addrspace);
+                            self.values.push(Value { ty: pty, kind: ValueKind::Global(gi) });
+                        }
+                        8 => {
+                            // FUNCTION v2: [strtab_off, strtab_size, tipo, cc, isproto, linkage, ..., addrspace(16)]
+                            let name = self.nombre(o[0], o[1]);
+                            let fi = self.functions.len();
+                            let addrspace = o.get(18).copied().unwrap_or(0) as u32;
+                            self.functions.push(Function { name, ty: o[2] as usize, is_proto: o[4] != 0, values: Vec::new(), args: Vec::new(), blocks: Vec::new() });
+                            let pty = self.ptr_type(addrspace);
+                            self.values.push(Value { ty: pty, kind: ValueKind::Function(fi) });
+                        }
+                        14 => {
+                            // ALIAS: ocupa un número de valor
+                            self.values.push(Value { ty: o[2] as usize, kind: ValueKind::Const(Const::Undef) });
+                        }
+                        _ => {}
+                    }
+                }
+            }
+        }
+        // 2) cuerpos: en el orden de las funciones definidas
+        let definidas: Vec<usize> = (0..self.functions.len()).filter(|&i| !self.functions[i].is_proto).collect();
+        if definidas.len() != cuerpos.len() {
+            return Err(format!("{} funciones definidas y {} cuerpos", definidas.len(), cuerpos.len()));
+        }
+        for (fi, b) in definidas.into_iter().zip(cuerpos) {
+            if std::env::var_os("TAHOE_AIR_DEBUG").is_some() {
+                eprintln!("cuerpo {} ({} elementos)", self.functions[fi].name, b.elems.len());
+            }
+            self.cuerpo(fi, b).map_err(|e| format!("{}: {e}", self.functions[fi].name))?;
+        }
+        Ok(())
+    }
+
+    /// Un tipo puntero del espacio de direcciones (lo crea si no existe).
+    fn ptr_type(&mut self, a: u32) -> TypeId {
+        if let Some(i) = self.types.iter().position(|t| *t == Type::Ptr(a)) {
+            return i;
+        }
+        self.types.push(Type::Ptr(a));
+        self.types.len() - 1
+    }
+
+    #[allow(unused_assignments)]
+    fn cuerpo(&mut self, fi: usize, b: &Blk) -> Res<()> {
+        let fty = self.functions[fi].ty;
+        let params = match self.ty(fty)? {
+            Type::Function { params, .. } => params.clone(),
+            t => return Err(format!("la función no tiene tipo de función: {t:?}")),
+        };
+        let mut values = self.values.clone();
+        let mut args = Vec::new();
+        for (i, &p) in params.iter().enumerate() {
+            args.push(values.len());
+            values.push(Value { ty: p, kind: ValueKind::Arg(i) });
+        }
+        let mut blocks: Vec<BasicBlock> = Vec::new();
+        let mut cur = 0usize;
+        // tipos de los valores usados antes de definirse (en bucles, un bloque posterior puede dominar a uno anterior)
+        let mut fwd: HashMap<ValueId, TypeId> = HashMap::new();
+        let void = self.types.iter().position(|t| *t == Type::Void);
+        for e in &b.elems {
+            let r = match e {
+                Elem::Blk(sb) if sb.id == CONSTANTS => {
+                    self.constantes(sb, &mut values)?;
+                    continue;
+                }
+                Elem::Blk(sb) if sb.id == METADATA => {
+                    continue; // metadatos locales (valores de la función usados como metadatos)
+                }
+                Elem::Blk(_) => continue,
+                Elem::Rec(r) => r,
+            };
+            let o = &r.ops;
+            let next = values.len();
+            if std::env::var_os("TAHOE_AIR_DEBUG").is_some() {
+                eprintln!("  [{next}] código {} {:?}", r.code, o);
+            }
+            let mut p = 0usize;
+            // operando relativo; si es una referencia adelantada lleva su tipo detrás
+            macro_rules! vt {
+                () => {{
+                    let v = (next as u64).wrapping_sub(o[p]) as u32 as usize;
+                    p += 1;
+                    if v >= next {
+                        fwd.insert(v, o[p] as usize); // referencia adelantada: su tipo va detrás
+                        p += 1;
+                    }
+                    v
+                }};
+            }
+            macro_rules! rel {
+                () => {{
+                    let v = (next as u64).wrapping_sub(o[p]) as u32 as usize;
+                    p += 1;
+                    v
+                }};
+            }
+            let ty_of = |values: &Vec<Value>, fwd: &HashMap<ValueId, TypeId>, v: ValueId| values.get(v).map(|x| x.ty).or_else(|| fwd.get(&v).copied());
+            let mut res_ty: Option<TypeId> = None;
+            let inst = match r.code {
+                1 => {
+                    blocks = vec![BasicBlock::default(); o[0] as usize];
+                    continue;
+                }
+                2 => {
+                    let a = vt!();
+                    let bb = rel!();
+                    let op = match o[p] {
+                        0 => BinOp::Add,
+                        1 => BinOp::Sub,
+                        2 => BinOp::Mul,
+                        3 => BinOp::UDiv,
+                        4 => BinOp::SDiv,
+                        5 => BinOp::URem,
+                        6 => BinOp::SRem,
+                        7 => BinOp::Shl,
+                        8 => BinOp::LShr,
+                        9 => BinOp::AShr,
+                        10 => BinOp::And,
+                        11 => BinOp::Or,
+                        12 => BinOp::Xor,
+                        x => return Err(format!("binop {x}")),
+                    };
+                    res_ty = ty_of(&values, &fwd, a);
+                    Inst::Bin { op, a, b: bb }
+                }
+                3 => {
+                    let v = vt!();
+                    res_ty = Some(o[p] as usize);
+                    let op = match o[p + 1] {
+                        0 => CastOp::Trunc,
+                        1 => CastOp::ZExt,
+                        2 => CastOp::SExt,
+                        3 => CastOp::FPToUI,
+                        4 => CastOp::FPToSI,
+                        5 => CastOp::UIToFP,
+                        6 => CastOp::SIToFP,
+                        7 => CastOp::FPTrunc,
+                        8 => CastOp::FPExt,
+                        9 => CastOp::PtrToInt,
+                        10 => CastOp::IntToPtr,
+                        11 => CastOp::BitCast,
+                        12 => CastOp::AddrSpaceCast,
+                        x => return Err(format!("cast {x}")),
+                    };
+                    Inst::Cast { op, v }
+                }
+                56 => {
+                    let v = vt!();
+                    res_ty = ty_of(&values, &fwd, v);
+                    Inst::FNeg(v)
+                }
+                6 => {
+                    let v = vt!();
+                    let i = vt!();
+                    res_ty = match ty_of(&values, &fwd, v).and_then(|t| self.types.get(t)) {
+                        Some(Type::Vector(_, e)) => Some(*e),
+                        _ => None,
+                    };
+                    Inst::ExtractElt { v, i }
+                }
+                7 => {
+                    let v = vt!();
+                    let e2 = rel!();
+                    let i = vt!();
+                    res_ty = ty_of(&values, &fwd, v);
+                    Inst::InsertElt { v, e: e2, i }
+                }
+                8 => {
+                    let a = vt!();
+                    let bb = rel!();
+                    let mask = vt!();
+                    let (n, elt) = match (ty_of(&values, &fwd, mask).and_then(|t| self.types.get(t)), ty_of(&values, &fwd, a).and_then(|t| self.types.get(t))) {
+                        (Some(Type::Vector(n, _)), Some(Type::Vector(_, e))) => (*n, *e),
+                        (x, y) => return Err(format!("shufflevector sin vectores: máscara {x:?}, operando {y:?} (valor {a} de {next})")),
+                    };
+                    res_ty = Some(self.vec_type(n, elt));
+                    Inst::Shuffle { a, b: bb, mask }
+                }
+                9 | 28 => {
+                    let a = vt!();
+                    let bb = rel!();
+                    let pred = o[p] as u32;
+                    let at = ty_of(&values, &fwd, a).unwrap_or(0);
+                    let boolean = self.int_type(1);
+                    res_ty = Some(match self.types.get(at) {
+                        Some(Type::Vector(n, _)) => {
+                            let n = *n;
+                            self.vec_type(n, boolean)
+                        }
+                        _ => boolean,
+                    });
+                    Inst::Cmp { pred, a, b: bb }
+                }
+                29 => {
+                    let t = vt!();
+                    let f = rel!();
+                    let c = vt!();
+                    res_ty = ty_of(&values, &fwd, t);
+                    Inst::Select { c, t, f }
+                }
+                26 => {
+                    let v = vt!();
+                    let idx: Vec<u32> = o[p..].iter().map(|&x| x as u32).collect();
+                    let mut t = ty_of(&values, &fwd, v).unwrap_or(0);
+                    for &i in &idx {
+                        t = match self.ty(t)? {
+                            Type::Struct { elems, .. } => elems[i as usize],
+                            Type::Array(_, e) | Type::Vector(_, e) => *e,
+                            x => return Err(format!("extractvalue en {x:?}")),
+                        };
+                    }
+                    res_ty = Some(t);
+                    Inst::ExtractVal { v, idx }
+                }
+                27 => {
+                    let agg = vt!();
+                    let v = vt!();
+                    let idx: Vec<u32> = o[p..].iter().map(|&x| x as u32).collect();
+                    res_ty = ty_of(&values, &fwd, agg);
+                    Inst::InsertVal { agg, v, idx }
+                }
+                20 => {
+                    let ptr = vt!();
+                    res_ty = Some(o[p] as usize);
+                    let align = (1u32 << (o[p + 1] & 0x1f)) >> 1;
+                    Inst::Load { ptr, align }
+                }
+                41 => {
+                    let ptr = vt!();
+                    res_ty = Some(o[p] as usize);
+                    Inst::Load { ptr, align: 0 }
+                }
+                44 | 45 => {
+                    let ptr = vt!();
+                    let val = vt!();
+                    let align = (1u32 << (o.get(p).copied().unwrap_or(0) & 0x1f)) >> 1;
+                    Inst::Store { ptr, val, align }
+                }
+                43 => {
+                    let inbounds = o[0] & 1 != 0;
+                    let src_ty = o[1] as usize;
+                    p = 2;
+                    let ptr = vt!();
+                    let mut idx = Vec::new();
+                    while p < o.len() {
+                        idx.push(vt!());
+                    }
+                    // tipo: puntero del mismo espacio, o vector de punteros si alguno lo es
+                    res_ty = ty_of(&values, &fwd, ptr);
+                    for &i in &idx {
+                        if let Some(Type::Vector(n, _)) = ty_of(&values, &fwd, i).and_then(|t| self.types.get(t)) {
+                            let n = *n;
+                            let pt = res_ty.unwrap_or(0);
+                            res_ty = Some(self.vec_type(n, pt));
+                        }
+                    }
+                    Inst::Gep { src_ty, ptr, idx, inbounds }
+                }
+                19 => {
+                    // ALLOCA: [tipo asignado, tipo del número, número (absoluto), alineación y banderas]
+                    let ty = o[0] as usize;
+                    let n = o[2] as usize;
+                    let a = o[3];
+                    let align = ((1u64 << ((a & 0x1f) | ((a >> 8) & 0x7) << 5)) >> 1) as u32;
+                    res_ty = Some(self.ptr_type(0));
+                    Inst::Alloca { ty, n, align }
+                }
+                34 => {
+                    // CALL: [atributos, cc, (fmf), (tipo de función), callee, args...]
+                    let cc = o[1];
+                    p = 2;
+                    if cc & (1 << 17) != 0 {
+                        p += 1; // banderas fast-math
+                    }
+                    let explicit = cc & (1 << 15) != 0;
+                    let mut fnty = if explicit {
+                        p += 1;
+                        Some(o[p - 1] as usize)
+                    } else {
+                        None
+                    };
+                    let callee = vt!();
+                    if fnty.is_none() {
+                        fnty = match values.get(callee).map(|v| &v.kind) {
+                            Some(ValueKind::Function(f)) => Some(self.functions[*f].ty),
+                            _ => None,
+                        };
+                    }
+                    let fnty = fnty.ok_or("llamada sin tipo de función")?;
+                    let (ret, params, vararg) = match self.ty(fnty)? {
+                        Type::Function { ret, params, vararg } => (*ret, params.clone(), *vararg),
+                        t => return Err(format!("llamada con tipo {t:?}")),
+                    };
+                    let mut args = Vec::new();
+                    for &pt in &params {
+                        if matches!(self.ty(pt)?, Type::Metadata) {
+                            // argumento de metadatos: número de metadatos (no de valor)
+                            let m = o[p] as usize;
+                            p += 1;
+                            args.push(values.len() + 1_000_000_000 + m); // marcado: no es un valor
+                        } else {
+                            args.push(rel!());
+                        }
+                    }
+                    if vararg {
+                        while p < o.len() {
+                            args.push(vt!());
+                        }
+                    }
+                    res_ty = Some(ret);
+                    Inst::Call { fnty, callee, args }
+                }
+                16 => {
+                    // PHI: [tipo, (valor con signo relativo, bloque)*, (fmf)]
+                    res_ty = Some(o[0] as usize);
+                    let mut inc = Vec::new();
+                    let mut q = 1;
+                    while q + 1 < o.len() {
+                        let v = (next as i64 - signo(o[q])) as usize;
+                        inc.push((v, o[q + 1] as usize));
+                        q += 2;
+                    }
+                    Inst::Phi { incoming: inc }
+                }
+                11 => {
+                    if o.len() == 1 {
+                        Inst::Br(o[0] as usize)
+                    } else {
+                        p = 2;
+                        let c = rel!();
+                        Inst::CondBr { c, t: o[0] as usize, f: o[1] as usize }
+                    }
+                }
+                12 => {
+                    // SWITCH: [tipo, condición (relativa), defecto, (valor absoluto, bloque)*]
+                    p = 1;
+                    let v = rel!();
+                    let default = o[2] as usize;
+                    let cases = o[3..].chunks(2).filter(|c| c.len() == 2).map(|c| (c[0] as usize, c[1] as usize)).collect();
+                    Inst::Switch { v, default, cases }
+                }
+                10 => {
+                    if o.is_empty() {
+                        Inst::Ret(None)
+                    } else {
+                        Inst::Ret(Some(vt!()))
+                    }
+                }
+                15 => Inst::Unreachable,
+                58 => {
+                    let v = vt!();
+                    res_ty = ty_of(&values, &fwd, v);
+                    Inst::Freeze(v)
+                }
+                59 => {
+                    let ptr = vt!();
+                    let val = vt!();
+                    res_ty = ty_of(&values, &fwd, val);
+                    Inst::AtomicRmw { op: o[p] as u32, ptr, val }
+                }
+                46 => {
+                    let ptr = vt!();
+                    let cmp = vt!();
+                    let new = rel!();
+                    let it = ty_of(&values, &fwd, cmp).unwrap_or(0);
+                    let b1 = self.int_type(1);
+                    res_ty = Some(self.struct_type(vec![it, b1]));
+                    Inst::CmpXchg { ptr, cmp, new }
+                }
+                36 => Inst::Fence,
+                33 | 35 | 60 | 55 => continue, // DEBUG_LOC_AGAIN, DEBUG_LOC, BLOCKADDR_USERS, OPERAND_BUNDLE
+                c => return Err(format!("instrucción con código {c} no soportada")),
+            };
+            let termina = matches!(inst, Inst::Br(_) | Inst::CondBr { .. } | Inst::Switch { .. } | Inst::Ret(_) | Inst::Unreachable);
+            let ty = res_ty.unwrap_or_else(|| void.unwrap_or(0));
+            let da_valor = res_ty.is_some() && Some(ty) != void;
+            let val = if da_valor {
+                values.push(Value { ty, kind: ValueKind::Inst(cur, blocks.get(cur).map(|b| b.insts.len()).unwrap_or(0)) });
+                Some(next)
+            } else {
+                None
+            };
+            blocks.get_mut(cur).ok_or("instrucción fuera de los bloques declarados")?.insts.push(Instr { inst, ty, val });
+            if termina {
+                cur += 1;
+            }
+        }
+        if std::env::var_os("TAHOE_AIR_DEBUG").is_some() {
+            let consts = values.iter().skip(self.values.len()).filter(|v| matches!(v.kind, ValueKind::Const(_))).count();
+            eprintln!("{}: módulo {} valores, {} argumentos, {} constantes locales, {} en total", self.functions[fi].name, self.values.len(), params.len(), consts, values.len());
+        }
+        let f = &mut self.functions[fi];
+        f.values = values;
+        f.args = args;
+        f.blocks = blocks;
+        Ok(())
+    }
+
+    fn int_type(&mut self, w: u32) -> TypeId {
+        self.find_or_add(Type::Int(w))
+    }
+    fn vec_type(&mut self, n: u32, e: TypeId) -> TypeId {
+        self.find_or_add(Type::Vector(n, e))
+    }
+    fn struct_type(&mut self, elems: Vec<TypeId>) -> TypeId {
+        self.find_or_add(Type::Struct { name: None, packed: false, elems })
+    }
+    fn find_or_add(&mut self, t: Type) -> TypeId {
+        if let Some(i) = self.types.iter().position(|x| *x == t) {
+            return i;
+        }
+        self.types.push(t);
+        self.types.len() - 1
+    }
+}
+
+/// Lector de bits para el blob de METADATA_STRINGS (las longitudes van en VBR6).
+struct BitLector<'a> {
+    d: &'a [u8],
+    pos: usize,
+}
+
+impl BitLector<'_> {
+    fn bits(&mut self, n: usize) -> Res<u64> {
+        let mut v = 0u64;
+        for i in 0..n {
+            let byte = *self.d.get(self.pos / 8).ok_or("fin del blob")?;
+            v |= (((byte >> (self.pos % 8)) & 1) as u64) << i;
+            self.pos += 1;
+        }
+        Ok(v)
+    }
+    fn vbr(&mut self, n: usize) -> Res<u64> {
+        let mut v = 0u64;
+        let mut shift = 0;
+        loop {
+            let piece = self.bits(n)?;
+            v |= (piece & ((1 << (n - 1)) - 1)) << shift;
+            if piece & (1 << (n - 1)) == 0 {
+                return Ok(v);
+            }
+            shift += n - 1;
+        }
+    }
+}
+
+/// Lee un módulo de bitcode (con o sin la envoltura 0x0B17C0DE).
+pub fn leer(datos: &[u8]) -> Res<Module> {
+    let bc = Bitcode::new(datos).map_err(|e| format!("bitcode: {e:?}"))?;
+    let elems: Vec<Elem> = bc.elements.into_iter().map(convertir).collect();
+    let mut l = Lector { types: Vec::new(), values: Vec::new(), functions: Vec::new(), globals: Vec::new(), md: Vec::new(), named_md: HashMap::new(), strtab: Vec::new(), triple: String::new() };
+    for e in &elems {
+        if let Elem::Blk(b) = e {
+            if b.id == STRTAB {
+                if let Some(r) = b.recs().find(|r| r.code == 1) {
+                    l.strtab = r.blob.clone().unwrap_or_default();
+                }
+            }
+        }
+    }
+    let m = elems.iter().find_map(|e| if let Elem::Blk(b) = e { (b.id == MODULE).then_some(b) } else { None }).ok_or("no hay bloque de módulo")?;
+    l.modulo(m)?;
+    Ok(Module { types: l.types, functions: l.functions, globals: l.globals, values: l.values, md: l.md, named_md: l.named_md, triple: l.triple })
+}
+
+impl Module {
+    pub fn md_str(&self, i: usize) -> Option<&str> {
+        match self.md.get(i)? {
+            Md::Str(s) => Some(s),
+            _ => None,
+        }
+    }
+    pub fn md_node(&self, i: usize) -> Option<&[Option<usize>]> {
+        match self.md.get(i)? {
+            Md::Node(n) => Some(n),
+            _ => None,
+        }
+    }
+    pub fn function(&self, name: &str) -> Option<&Function> {
+        self.functions.iter().find(|f| f.name == name)
+    }
+}
diff --git a/tahoe-gpu/src/air/layout.rs b/tahoe-gpu/src/air/layout.rs
new file mode 100644
index 0000000..396eef6
--- /dev/null
+++ b/tahoe-gpu/src/air/layout.rs
@@ -0,0 +1,81 @@
+//! Disposición en memoria de los tipos de AIR (datalayout de `air64`): punteros de 64 bits; vectores alineados por su
+//! tamaño en bits (v96 → 128, v48 → 64: un float3 ocupa 16 bytes y un half3 8); estructuras con relleno natural salvo
+//! las empaquetadas.
+
+use super::ir::{Module, Type, TypeId};
+
+/// Alineación (en bytes) de un tipo.
+pub fn align(m: &Module, t: TypeId) -> u64 {
+    match &m.types[t] {
+        Type::Int(w) => ((*w as u64).div_ceil(8)).next_power_of_two().max(1),
+        Type::Half | Type::BFloat => 2,
+        Type::Float => 4,
+        Type::Double | Type::Ptr(_) => 8,
+        Type::Vector(n, e) => {
+            let bits = *n as u64 * bits_elem(m, *e);
+            bits.div_ceil(8).next_power_of_two().max(1)
+        }
+        Type::Array(_, e) => align(m, *e),
+        Type::Struct { packed: true, .. } => 1,
+        Type::Struct { elems, .. } => elems.iter().map(|&e| align(m, e)).max().unwrap_or(1),
+        _ => 1,
+    }
+}
+
+fn bits_elem(m: &Module, t: TypeId) -> u64 {
+    match &m.types[t] {
+        Type::Int(w) => *w as u64,
+        Type::Half | Type::BFloat => 16,
+        Type::Float => 32,
+        Type::Double | Type::Ptr(_) => 64,
+        _ => 8 * size(m, t),
+    }
+}
+
+/// Tamaño de almacenamiento (alloc size: con el relleno hasta la alineación), en bytes.
+pub fn size(m: &Module, t: TypeId) -> u64 {
+    let raw = match &m.types[t] {
+        Type::Int(w) => (*w as u64).div_ceil(8),
+        Type::Half | Type::BFloat => 2,
+        Type::Float => 4,
+        Type::Double | Type::Ptr(_) => 8,
+        Type::Vector(n, e) => (*n as u64 * bits_elem(m, *e)).div_ceil(8),
+        Type::Array(n, e) => n * size(m, *e),
+        Type::Struct { packed, elems, .. } => {
+            let mut off: u64 = 0;
+            for &e in elems {
+                if !packed {
+                    off = off.next_multiple_of(align(m, e));
+                }
+                off += size(m, e);
+            }
+            off
+        }
+        _ => 0,
+    };
+    raw.next_multiple_of(align(m, t))
+}
+
+/// Desplazamiento de cada campo de una estructura.
+pub fn offsets(m: &Module, t: TypeId) -> Vec<u64> {
+    let Type::Struct { packed, elems, .. } = &m.types[t] else { return Vec::new() };
+    let mut v = Vec::with_capacity(elems.len());
+    let mut off: u64 = 0;
+    for &e in elems {
+        if !packed {
+            off = off.next_multiple_of(align(m, e));
+        }
+        v.push(off);
+        off += size(m, e);
+    }
+    v
+}
+
+/// Desplazamiento de un elemento de vector (los elementos van seguidos, sin relleno).
+pub fn elem_size(m: &Module, t: TypeId) -> u64 {
+    match &m.types[t] {
+        Type::Vector(_, e) => bits_elem(m, *e).div_ceil(8),
+        Type::Array(_, e) => size(m, *e),
+        _ => size(m, t),
+    }
+}
diff --git a/tahoe-gpu/src/air/mod.rs b/tahoe-gpu/src/air/mod.rs
new file mode 100644
index 0000000..2705a9c
--- /dev/null
+++ b/tahoe-gpu/src/air/mod.rs
@@ -0,0 +1,187 @@
+//! AIR (el formato intermedio de los shaders de Metal): un módulo LLVM (ver `ir`) cuyos metadatos con nombre
+//! `!air.kernel`, `!air.vertex` y `!air.fragment` dicen qué funciones son puntos de entrada y qué es cada argumento:
+//! `!{i32 índice, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", ...}`.
+
+pub mod fc;
+pub mod inline;
+pub mod interp;
+pub mod ir;
+pub mod layout;
+pub mod sccp;
+pub mod spirv;
+
+use ir::{Const, Md, Module, Type, ValueKind};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Etapa {
+    Kernel,
+    Vertex,
+    Fragment,
+}
+
+/// Un elemento de la descripción de un argumento o de una salida: texto o entero.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Dato {
+    Txt(String),
+    Int(i64),
+    /// La global de un predicado de function constant (`!{ptr @__metal_implicit_fc_pred_N, !"bool", !"nombre"}`).
+    Pred(usize),
+    Otro,
+}
+
+#[derive(Debug, Clone)]
+pub struct Descripcion {
+    /// Índice del argumento (o de la salida).
+    pub indice: i64,
+    /// Lo que es: "air.buffer", "air.texture", "air.thread_position_in_grid", "air.position"...
+    pub clase: String,
+    pub datos: Vec<Dato>,
+}
+
+impl Descripcion {
+    /// El valor que sigue a la etiqueta `clave` (p. ej. "air.location_index" → índice de binding).
+    pub fn tras(&self, clave: &str) -> Option<&Dato> {
+        let i = self.datos.iter().position(|d| *d == Dato::Txt(clave.to_string()))?;
+        self.datos.get(i + 1)
+    }
+    pub fn int_tras(&self, clave: &str) -> Option<i64> {
+        match self.tras(clave)? {
+            Dato::Int(v) => Some(*v),
+            _ => None,
+        }
+    }
+    pub fn txt_tras(&self, clave: &str) -> Option<&str> {
+        match self.tras(clave)? {
+            Dato::Txt(s) => Some(s),
+            _ => None,
+        }
+    }
+    /// Los datos sin el predicado de function constant del principio (si lo hay).
+    pub fn propios(&self) -> &[Dato] {
+        match self.datos.first() {
+            Some(Dato::Txt(t)) if t == "air.function_constant" => self.datos.get(2..).unwrap_or(&[]),
+            _ => &self.datos,
+        }
+    }
+    pub fn tiene(&self, clave: &str) -> bool {
+        self.datos.iter().any(|d| *d == Dato::Txt(clave.to_string()))
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct Entrada {
+    pub etapa: Etapa,
+    /// Índice de la función en `Module::functions`.
+    pub funcion: usize,
+    pub argumentos: Vec<Descripcion>,
+    pub salidas: Vec<Descripcion>,
+}
+
+fn dato(m: &Module, i: Option<usize>) -> Dato {
+    let Some(i) = i else { return Dato::Otro };
+    match m.md.get(i) {
+        Some(Md::Str(s)) => Dato::Txt(s.clone()),
+        Some(Md::Value(_, v)) => match m.values.get(*v).map(|x| &x.kind) {
+            Some(ValueKind::Const(Const::Int(n))) => Dato::Int(*n as i64),
+            Some(ValueKind::Const(Const::Null)) => Dato::Int(0),
+            Some(ValueKind::Global(g)) => Dato::Pred(*g),
+            _ => Dato::Otro,
+        },
+        Some(Md::Node(ops)) => match ops.first().copied().flatten().map(|o| dato(m, Some(o))) {
+            Some(Dato::Pred(g)) => Dato::Pred(g),
+            _ => Dato::Otro,
+        },
+        _ => Dato::Otro,
+    }
+}
+
+fn descripciones(m: &Module, nodo: Option<usize>) -> Vec<Descripcion> {
+    let Some(lista) = nodo.and_then(|n| m.md_node(n)) else { return Vec::new() };
+    lista
+        .iter()
+        .filter_map(|&d| {
+            let ops = m.md_node(d?)?;
+            let datos: Vec<Dato> = ops.iter().map(|&o| dato(m, o)).collect();
+            let indice = match datos.first() {
+                Some(Dato::Int(v)) => *v,
+                _ => -1,
+            };
+            let (mut clase, mut resto) = match (datos.first(), datos.get(1)) {
+                (Some(Dato::Int(_)), Some(Dato::Txt(c))) => (c.clone(), datos[2..].to_vec()),
+                (Some(Dato::Txt(c)), _) => (c.clone(), datos[1..].to_vec()),
+                _ => (String::new(), datos.clone()),
+            };
+            // !"air.function_constant", !{predicado}, !"air.<clase real>", ...: la clase es la real y el predicado
+            // queda en los datos (como Pred)
+            if clase == "air.function_constant" {
+                if let Some(Dato::Txt(c)) = resto.get(1).cloned() {
+                    clase = c;
+                    let pred = resto[0].clone();
+                    resto = std::iter::once(Dato::Txt("air.function_constant".into())).chain(std::iter::once(pred)).chain(resto[2..].iter().cloned()).collect();
+                }
+            }
+            Some(Descripcion { indice, clase, datos: resto })
+        })
+        .collect()
+}
+
+/// Los puntos de entrada del módulo, según `!air.kernel`, `!air.vertex` y `!air.fragment`.
+pub fn entradas(m: &Module) -> Vec<Entrada> {
+    let mut v = Vec::new();
+    for (nombre, etapa) in [("air.kernel", Etapa::Kernel), ("air.vertex", Etapa::Vertex), ("air.fragment", Etapa::Fragment)] {
+        let Some(nodos) = m.named_md.get(nombre) else { continue };
+        for &n in nodos {
+            let Some(ops) = m.md_node(n) else { continue };
+            let funcion = match ops.first().copied().flatten().and_then(|i| m.md.get(i)) {
+                Some(Md::Value(_, val)) => match m.values.get(*val).map(|x| &x.kind) {
+                    Some(ValueKind::Function(f)) => *f,
+                    _ => continue,
+                },
+                _ => continue,
+            };
+            // kernel: !{fn, !{}, !{args}}; vertex/fragment: !{fn, !{salidas}, !{args}}
+            let salidas = descripciones(m, ops.get(1).copied().flatten());
+            let argumentos = descripciones(m, ops.get(2).copied().flatten());
+            v.push(Entrada { etapa, funcion, argumentos, salidas });
+        }
+    }
+    v
+}
+
+/// Resumen de una función para `tahoe-gpu air`: bloques, instrucciones y llamadas a air.* y llvm.*.
+pub fn resumen(m: &Module, f: usize) -> String {
+    let fun = &m.functions[f];
+    let n: usize = fun.blocks.iter().map(|b| b.insts.len()).sum();
+    let mut llamadas: Vec<String> = Vec::new();
+    for b in &fun.blocks {
+        for i in &b.insts {
+            if let ir::Inst::Call { callee, .. } = &i.inst {
+                if let Some(ValueKind::Function(c)) = fun.values.get(*callee).map(|v| &v.kind) {
+                    let nom = &m.functions[*c].name;
+                    if !llamadas.contains(nom) {
+                        llamadas.push(nom.clone());
+                    }
+                }
+            }
+        }
+    }
+    llamadas.sort();
+    format!("{} bloques, {} instrucciones; llama a: {}", fun.blocks.len(), n, llamadas.join(" "))
+}
+
+/// Nombre legible de un tipo (para mensajes).
+pub fn tipo(m: &Module, t: ir::TypeId) -> String {
+    match m.types.get(t) {
+        Some(Type::Int(w)) => format!("i{w}"),
+        Some(Type::Float) => "float".into(),
+        Some(Type::Half) => "half".into(),
+        Some(Type::Double) => "double".into(),
+        Some(Type::Void) => "void".into(),
+        Some(Type::Ptr(a)) => format!("ptr({a})"),
+        Some(Type::Vector(n, e)) => format!("<{n} x {}>", tipo(m, *e)),
+        Some(Type::Array(n, e)) => format!("[{n} x {}]", tipo(m, *e)),
+        Some(Type::Struct { elems, .. }) => format!("{{{}}}", elems.iter().map(|&e| tipo(m, e)).collect::<Vec<_>>().join(", ")),
+        Some(t) => format!("{t:?}"),
+        None => "?".into(),
+    }
+}
