+#!/bin/bash
+# llaveros.sh: prueba de los llaveros en el macOS completo. Crea un llavero de usuario y guarda y lee una contraseña
+# (funciona desde el 14 de octubre de 2026), y prueba el llavero del sistema: «systemkeychain -t» (desbloqueo con
+# /var/db/SystemKey, todavía «System unlock is NOT working») y show-keychain-info. Siempre limpia.
+DIAG="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; REPO="$(cd "$DIAG/../.." && pwd)"
+D="${TAHOE_DIAG_DIR:-$HOME/.cache/tahoe-diag}"; O="$D/llaveros"; rm -rf "$O"; mkdir -p "$O"
+cd "$REPO" || exit 1
+TAHOE_ROOT="${TAHOE_ROOT:-$HOME/macos26/completo/macOS}" TAHOE_BOOT_WAIT=10 timeout 400 tools/macos-shell.sh --launchd -c "sleep 60; rm -f /tmp/t.keychain*; \
+ security create-keychain -p x /tmp/t.keychain; echo create rc=\$?; \
+ security add-generic-password -a a -s s -w w /tmp/t.keychain; echo add rc=\$?; \
+ security find-generic-password -s s /tmp/t.keychain > /dev/null; echo find rc=\$?; \
+ /usr/sbin/systemkeychain -v -t; echo systemkeychain rc=\$?; \
+ security show-keychain-info /Library/Keychains/System.keychain; echo info rc=\$?" > "$O/out" 2>&1
+"$DIAG/clean.sh" > /dev/null 2>&1
+grep -av "^launchd\|Alarm" "$O/out"
diff --git a/tools/diag/memoria.py b/tools/diag/memoria.py
new file mode 100755
index 0000000..365d8ff
--- /dev/null
+++ b/tools/diag/memoria.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""memoria.py <smaps.1> <smaps.2>: qué memoria anónima creció entre dos fotos de /proc/<pid>/smaps del mismo proceso.
+
+Dice el total de Anonymous en cada foto y luego:
+  - regiones nuevas (no estaban en la primera), agrupadas por tamaño, permisos y nombre: muchas iguales indican
+    reservas que no se liberan (mmap / mach_vm_allocate / datos fuera de línea de mensajes);
+  - regiones que ya estaban y crecieron (el malloc del programa, una pila...), las que más.
+Las direcciones van en hexadecimal para buscarlas en el registro o con vmmap/sym.py.
+"""
+import re
+import sys
+from collections import defaultdict
+
+CAB = re.compile(r'^([0-9a-f]+)-([0-9a-f]+) (\S+) \S+ \S+ \S+\s*(.*)$')
+
+
+def leer(ruta):
+    reg = {}
+    cur = None
+    for linea in open(ruta, errors='replace'):
+        m = CAB.match(linea)
+        if m:
+            ini, fin = int(m.group(1), 16), int(m.group(2), 16)
+            cur = {'ini': ini, 'tam': fin - ini, 'perm': m.group(3), 'nombre': m.group(4) or '[anónima]', 'anon': 0}
+            reg[ini] = cur
+        elif cur and linea.startswith('Anonymous:'):
+            cur['anon'] = int(linea.split()[1])
+    return reg
+
+
+def mb(kb):
+    return f'{kb / 1024:.1f} MB'
+
+
+def main():
+    a, b = leer(sys.argv[1]), leer(sys.argv[2])
+    ta, tb = sum(r['anon'] for r in a.values()), sum(r['anon'] for r in b.values())
+    print(f'Anonymous: {mb(ta)} -> {mb(tb)} ({mb(tb - ta)} más), regiones {len(a)} -> {len(b)}')
+
+    nuevas = [r for k, r in b.items() if k not in a]
+    grupos = defaultdict(lambda: [0, 0, []])
+    for r in nuevas:
+        g = grupos[(r['tam'], r['perm'], r['nombre'])]
+        g[0] += 1
+        g[1] += r['anon']
+        g[2].append(r['ini'])
+    print(f'\nregiones nuevas: {len(nuevas)}, con {mb(sum(r["anon"] for r in nuevas))} anónimos')
+    for (tam, perm, nombre), (n, anon, dirs) in sorted(grupos.items(), key=lambda x: -x[1][1])[:15]:
+        ej = ' '.join(hex(d) for d in sorted(dirs)[:3])
+        print(f'  {n:5d} × {tam // 1024:8d} KB {perm} {nombre[:40]:40s} anon={mb(anon):>9s}  p. ej. {ej}')
+
+    crecen = []
+    for k, r in b.items():
+        if k in a and r['anon'] > a[k]['anon']:
+            crecen.append((r['anon'] - a[k]['anon'], r, a[k]))
+    crecen.sort(key=lambda x: -x[0])
+    print(f'\nregiones que crecieron: {len(crecen)}, con {mb(sum(c[0] for c in crecen))} más')
+    for d, r, ra in crecen[:15]:
+        cambio = f' (tamaño {ra["tam"] // 1024} -> {r["tam"] // 1024} KB)' if ra['tam'] != r['tam'] else ''
+        print(f'  +{mb(d):>9s} {hex(r["ini"])} {r["tam"] // 1024:8d} KB {r["perm"]} {r["nombre"][:40]}{cambio}')
+
+    idas = [r for k, r in a.items() if k not in b]
+    if idas:
+        print(f'\nregiones liberadas: {len(idas)}, con {mb(sum(r["anon"] for r in idas))} anónimos')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/diag/memoria.sh b/tools/diag/memoria.sh
new file mode 100755
index 0000000..99b46cc
--- /dev/null
+++ b/tools/diag/memoria.sh
@@ -0,0 +1,55 @@
+#!/bin/bash
+# memoria.sh <programa> [t1] [t2]: ¿qué memoria crece en un proceso de macOS? Arranca launchd (tools/macos-shell.sh
+# --launchd), busca el proceso por el programa de macOS que cargó (como hang.sh) y cada 5 s anota su RssAnon; en t1 y t2
+# (30 y 60 s desde el arranque) guarda /proc/<pid>/smaps y al final memoria.py dice qué regiones son nuevas o crecieron.
+# Siempre limpia. Variables:
+#   TAHOE_ROOT  sistema de macOS (por omisión la Recovery); TAHOE_RUN otro binario (A/B); DEPURAR=1 modo depuración
+#   MSGS/IOKS   programas cuyos mensajes Mach / actividad IOKit se trazan (como en discos.sh); al final se resumen
+#               con mensajes.py e iokit.py
+# Salida en ~/.cache/tahoe-diag: memoria.txt (muestreo), smaps.1, smaps.2, memoria.log (registro de este arranque).
+DIAG="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
+D="${TAHOE_DIAG_DIR:-$HOME/.cache/tahoe-diag}"; mkdir -p "$D"
+PROG="${1:?indica el programa de macOS (p. ej. WindowServer)}"; T1="${2:-30}"; T2="${3:-60}"
+export TAHOE_ROOT="${TAHOE_ROOT:-$HOME/macos26/base/macOS Base System}"
+LOG="${TAHOE_LOGFILE:-/tmp/tahoe-shell-$USER.log}"
+# como macos-shell.sh: si el registro pasa de TAHOE_LOG_MAX_MB se vacía ya (si lo vaciara él, «desde» quedaría fuera)
+if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt $(( ${TAHOE_LOG_MAX_MB:-300} * 1024 * 1024 )) ]; then : > "$LOG"; fi
+desde=$(( $( [ -f "$LOG" ] && wc -l < "$LOG" || echo 0) + 1 ))
+if [ -n "$MSGS" ]; then echo "$MSGS" > /dev/shm/tahoe-msg-trace; else rm -f /dev/shm/tahoe-msg-trace; fi
+if [ -n "$IOKS" ]; then echo "$IOKS" > /dev/shm/tahoe-iokit-trace; else rm -f /dev/shm/tahoe-iokit-trace; fi
+rm -f "$D/smaps.1" "$D/smaps.2"; : > "$D/memoria.txt"
+( TAHOE_BOOT_WAIT=5 timeout $(( T2 + 60 )) "$DIAG/../macos-shell.sh" ${DEPURAR:+--depurar} --launchd -c "sleep $(( T2 + 30 ))" \
+	> "$D/memoria.out" 2>&1 & )
+# Pid de Linux del proceso cuyo programa de macOS (el último ejecutable que cargó, tipo=2) es $PROG.
+pid_de() {
+	local ns s n p
+	for p in $(pgrep -x tahoe-run); do ns=$(readlink /proc/$p/ns/pid 2>/dev/null) && [ -n "$ns" ] && break; done
+	[ -z "$ns" ] && return
+	local progs; progs=$(tail -n +"$desde" "$LOG" 2>/dev/null | LC_ALL=C grep -ao "<[0-9]*> cargado [^ ]* .* tipo=2" |
+		awk '{gsub(/[<>]/,"",$1); p[$1]=$3} END{for (k in p) print k, p[k]}')
+	for s in /proc/[0-9]*/status; do
+		[ "$(readlink ${s%/status}/ns/pid 2>/dev/null)" = "$ns" ] || continue
+		n=$(awk '/^NSpid/{if (NF > 2) print $NF}' "$s" 2>/dev/null)
+		[ -n "$n" ] && [ "$(echo "$progs" | awk -v n="$n" '$1==n{print $2}')" = "$PROG" ] && { s=${s#/proc/}; echo "${s%/status} $n"; return; }
+	done
+}
+t=0
+while [ $t -lt $T2 ]; do
+	sleep 5; t=$((t + 5))
+	read -r P N < <(pid_de)
+	if [ -z "$P" ]; then echo "t=$t $PROG no está vivo" >> "$D/memoria.txt"; continue; fi
+	echo "t=$t pid=$P (macOS $N) $(awk '/^RssAnon|^RssShmem|^VmSize/{printf "%s %d MB  ", $1, $2/1024}' /proc/$P/status 2>/dev/null)" >> "$D/memoria.txt"
+	[ $t -ge "$T1" ] && [ ! -f "$D/smaps.1" ] && cp /proc/$P/smaps "$D/smaps.1" 2>/dev/null && echo "$N" > "$D/smaps.pid"
+done
+[ -n "$P" ] && cp /proc/$P/smaps "$D/smaps.2" 2>/dev/null
+[ -n "$P" ] && [ "$N" != "$(cat "$D/smaps.pid" 2>/dev/null)" ] && echo "(aviso: el pid cambió entre las fotos: $PROG se relanzó)" >> "$D/memoria.txt"
+"$DIAG/clean.sh" > /dev/null 2>&1
+rm -f /dev/shm/tahoe-msg-trace /dev/shm/tahoe-iokit-trace
+tail -n +"$desde" "$LOG" > "$D/memoria.log" 2>/dev/null
+echo "== muestreo de $PROG"; cat "$D/memoria.txt"
+grep -a "guardián" "$D/memoria.out" | head -2
+if [ -f "$D/smaps.1" ] && [ -f "$D/smaps.2" ]; then echo "== smaps entre t=$T1 y t=$T2"; python3 "$DIAG/memoria.py" "$D/smaps.1" "$D/smaps.2"
+else echo "== no hay dos fotos de smaps"; fi
+[ -n "$MSGS" ] && python3 "$DIAG/mensajes.py" "$D/memoria.log" | head -60
+[ -n "$IOKS" ] && python3 "$DIAG/iokit.py" "$D/memoria.log" | head -60
+echo "(muestreo: $D/memoria.txt; fotos: $D/smaps.1 $D/smaps.2; registro: $D/memoria.log)"
diff --git a/tools/diag/mensajes.py b/tools/diag/mensajes.py
new file mode 100755
index 0000000..16c1177
--- /dev/null
+++ b/tools/diag/mensajes.py
@@ -0,0 +1,223 @@
+#!/usr/bin/env python3
+# mensajes.py [-t] [-s programa] [registro]: conversación de mensajes Mach a partir de la traza «MSG» de tahoe-run
+# (procesos nombrados en /dev/shm/tahoe-msg-trace; tools/diag/discos.sh la activa con MSGS='prog1 prog2...').
+# Por omisión lee ~/.cache/tahoe-diag/discos.log.
+#
+# Para cada envío dice si llegó a su destino (hay una recepción de ese remitente con el mismo puerto e id) y, si pedía
+# respuesta (puerto de respuesta), si alguien la envió a ese puerto. Al final, el resumen por pareja de programas y la
+# lista de lo que se quedó a medias: envíos que nadie recibió y peticiones sin respuesta, que es donde se cuelga una
+# cadena (diskutil -> storagekitd -> diskarbitrationd -> fskitd...).
+#   -t           además, la conversación completa en orden (una línea por mensaje)
+#   -s prog      solo los mensajes en los que participa ese programa (puede repetirse)
+#   -x           con -t o -p, el contenido de los mensajes XPC descodificado ({clave: valor, ...}) si la traza guardó el
+#                cuerpo (líneas «MSG cuerpo», mensajes de hasta 1 KB)
+#   -p pid|prog  sigue un proceso: todos sus envíos y recepciones en orden (con un nombre, todos los pid con ese programa,
+#                p. ej. el diskarbitrationd de arranque y el relanzado)
+# Un destino sin traza (no está en la lista) sale como «(sin traza)»: se sabe que se envió, no si llegó.
+import os, re, sys
+from collections import Counter, defaultdict
+
+args = sys.argv[1:]
+full = "-t" in args
+xpc = "-x" in args
+solo = set()
+follow = set()
+rest = []
+i = 0
+while i < len(args):
+    if args[i] in ("-t", "-x"): pass
+    elif args[i] == "-s" and i + 1 < len(args): solo.add(args[i + 1]); i += 1
+    elif args[i] == "-p" and i + 1 < len(args): follow.add(args[i + 1]); i += 1
+    else: rest.append(args[i])
+    i += 1
+path = rest[0] if rest else os.path.expanduser(os.environ.get("TAHOE_DIAG_DIR", "~/.cache/tahoe-diag") + "/discos.log")
+
+snd_re = re.compile(r"MSG <(\d+)\.(\d+)> envía dest=(0x[0-9a-f]+)\(->(-?\d+)\) resp=(0x[0-9a-f]+) id=(-?\d+) tam=(\d+) bits=(0x[0-9a-f]+)( y espera)?(?: \| (.*))?")
+rcv_re = re.compile(r"MSG <(\d+)\.(\d+)> recibe en=(0x[0-9a-f]+) dest=(0x[0-9a-f]+) resp=(0x[0-9a-f]+) id=(-?\d+) tam=(\d+) de=(-?\d+) -> (0x[0-9a-f]+)")
+fail_re = re.compile(r"MSG <(\d+)\.(\d+)> envío a (0x[0-9a-f]+) id=(-?\d+) falló (0x[0-9a-f]+)")
+body_re = re.compile(r"MSG cuerpo <(\d+)\.(\d+)>: ([0-9a-f]+)")
+rbody_re = re.compile(r"MSG recibido <(\d+)\.(\d+)>: ([0-9a-f]+)")
+prog_re = re.compile(r"<(\d+)> cargado (\S+) .*tipo=2")
+
+progs = {}
+sends, recvs = [], []
+traced = set()
+with open(path, "rb") as f:
+    for n, raw in enumerate(f, 1):
+        l = raw.decode("utf-8", "replace")
+        m = prog_re.search(l)
+        if m and m.group(2) != "dyld": progs[m.group(1)] = m.group(2)
+        m = snd_re.search(l)
+        if m:
+            pid, tid, dest, to, resp, mid, size, bits, wait, txt = m.groups()
+            traced.add(pid)
+            sends.append(dict(n=n, pid=pid, tid=tid, dest=dest, to=to, resp=resp, id=int(mid), size=int(size),
+                              bits=bits, wait=bool(wait), txt=(txt or "")[:90], prog=progs.get(pid, "?"), recv=None, reply=None))
+            continue
+        m = body_re.search(l)
+        if m:                             # cuerpo del envío anterior de ese hilo
+            for x in reversed(sends[-50:]):
+                if x["pid"] == m.group(1) and x["tid"] == m.group(2): x["body"] = bytes.fromhex(m.group(3)[:len(m.group(3)) // 2 * 2]); break
+            continue
+        m = rbody_re.search(l)
+        if m:                             # cuerpo de la recepción anterior de ese hilo
+            for r in reversed(recvs[-50:]):
+                if r["pid"] == m.group(1) and r["tid"] == m.group(2): r["body"] = bytes.fromhex(m.group(3)[:len(m.group(3)) // 2 * 2]); break
+            continue
+        m = fail_re.search(l)
+        if m:                             # el envío anterior de ese hilo no entró en la cola (llena con plazo 0, destino muerto)
+            pid, tid, dest, mid, kr = m.groups()
+            for x in reversed(sends[-50:]):
+                if x["pid"] == pid and x["tid"] == tid and x["dest"] == dest and x["id"] == int(mid): x["fail"] = kr; break
+            continue
+        m = rcv_re.search(l)
+        if m:
+            pid, tid, en, dest, resp, mid, size, de, res = m.groups()
+            traced.add(pid)
+            recvs.append(dict(n=n, pid=pid, tid=tid, dest=dest, resp=resp, id=int(mid), size=int(size), de=de, res=res, used=False))
+
+if not sends and not recvs:
+    sys.exit(f"sin líneas MSG en {path} (¿se activó /dev/shm/tahoe-msg-trace con los nombres?)")
+
+# Formato de libxpc en el cable: «CPX@» (0x40585043), versión, y el objeto raíz (normalmente un diccionario). Cada objeto: tipo (u32)
+# y su contenido; los puertos van en descriptores aparte («puerto»). La traza guarda como mucho 400 bytes: lo que no
+# quepa sale como «(no descodificable ...)».
+def xpc_decode(b):
+    import struct
+    k = b.find(b"CPX@")                                     # número mágico 0x40585043 en little endian
+    if k < 0 or k + 8 > len(b): return None
+    pos = [k + 8]
+    def u32():
+        v = struct.unpack_from("<I", b, pos[0])[0]; pos[0] += 4; return v
+    def cstr():
+        e = b.index(b"\0", pos[0]); t = b[pos[0]:e].decode("utf-8", "replace"); pos[0] = (e + 4) & ~3; return t
+    def obj(depth=0):
+        t = u32()
+        if t == 0x1000: return "null"
+        if t == 0x2000: return "true" if u32() else "false"
+        if t in (0x3000, 0x4000, 0x7000):
+            v = struct.unpack_from("<q" if t == 0x3000 else "<Q", b, pos[0])[0]; pos[0] += 8
+            return str(v) if t != 0x4000 or v < 4096 else hex(v)
+        if t == 0x5000: v = struct.unpack_from("<d", b, pos[0])[0]; pos[0] += 8; return str(v)
+        if t in (0x8000, 0x9000):
+            n = u32(); raw = b[pos[0]:pos[0] + n]; pos[0] += (n + 3) & ~3
+            return repr(raw.rstrip(b"\0").decode("utf-8", "replace")) if t == 0x9000 else f"datos[{n}]"
+        if t == 0xa000: v = b[pos[0]:pos[0] + 16].hex(); pos[0] += 16; return "uuid:" + v
+        if t in (0xd000, 0x15000, 0xb000, 0xc000, 0x11000, 0x12000, 0x14000): return {0xd000: "puerto", 0x15000: "puerto-recv",
+            0xb000: "fd", 0xc000: "shmem", 0x11000: "conexión", 0x12000: "endpoint", 0x14000: "tubería"}[t]
+        if t in (0xe000, 0xf000):
+            u32(); n = u32()
+            if depth > 4: return "…"
+            if t == 0xe000: return "[" + ", ".join(obj(depth + 1) for _ in range(n)) + "]"
+            items = []
+            for _ in range(n):
+                key = cstr(); items.append(f"{key}: {obj(depth + 1)}")
+            return "{" + ", ".join(items) + "}"
+        raise ValueError(hex(t))
+    try: return obj()
+    except Exception as e: return f"(no descodificable: {e})"
+
+def name(pid): return f"{progs.get(pid, '?')}[{pid}]"
+
+# llegada: la primera recepción posterior, del mismo remitente, al mismo puerto y con el mismo id
+by_key = defaultdict(list)
+for r in recvs: by_key[(r["de"], r["dest"], r["id"])].append(r)
+for s in sends:
+    if s.get("fail"): continue
+    for r in by_key.get((s["pid"], s["dest"], s["id"]), []):
+        if not r["used"] and r["n"] > s["n"]: r["used"] = True; s["recv"] = r; break
+# respuesta: un envío posterior cuyo destino es el puerto de respuesta de la petición
+by_dest = defaultdict(list)
+for s in sends: by_dest[s["dest"]].append(s)
+# o, aunque quien responde no tenga traza, una recepción posterior del que preguntó en ese puerto de respuesta
+rx_by_port = defaultdict(list)
+for r in recvs: rx_by_port[(r["pid"], r["dest"])].append(r)
+for s in sends:
+    if s["resp"] != "0x0":
+        s["reply"] = next((x for x in by_dest.get(s["resp"], []) if x["n"] > s["n"]), None) or \
+                     next((r for r in rx_by_port.get((s["pid"], s["resp"]), []) if r["n"] > s["n"] and r["res"] == "0x0"), None)
+
+# Subsistemas MIG que aparecen en estas trazas (id = base del subsistema + número de rutina).
+MIG = {1000: "notifyd", 11600: "logd", 20000: "configd", 400: "bootstrap", 3200: "mach_port", 3400: "host_priv",
+       200: "host", 3800: "thread_act", 4800: "mach_vm", 2400: "clock", 6100: "DiskArbitration"}
+
+def kind(mid):
+    if mid in (64, 65, 66, 69, 70, 71, 72):
+        return {64: "aviso", 65: "aviso PORT_DELETED", 66: "aviso", 69: "aviso PORT_DESTROYED", 70: "aviso NO_SENDERS",
+                71: "aviso SEND_ONCE", 72: "aviso DEAD_NAME"}[mid]
+    if mid & 0x10000000 or mid & 0x40000000: return "XPC"
+    for base in sorted(MIG, reverse=True):
+        if base <= mid < base + 100: return f"MIG {MIG[base]}#{mid - base}"
+    return f"MIG {mid}" if mid >= 100 else f"id {mid}"
+
+# 0x10000004 MACH_SEND_TIMED_OUT: cola llena con plazo (en los puertos de despertar de CFRunLoop/dispatch, de cola 1,
+# es lo normal: ya hay un despertar pendiente). 0x10000003 INVALID_DEST: el destino ya no existe.
+FALLOS = {"0x10000004": "cola llena (plazo agotado)", "0x10000003": "destino inválido"}
+
+def state(s):
+    if s.get("fail"): return "no enviado: " + FALLOS.get(s["fail"], s["fail"])
+    if s["to"] not in traced: llegada = "(sin traza)"
+    elif s["recv"]: llegada = "recibido" if s["recv"]["res"] == "0x0" else f"recibido con error {s['recv']['res']}"
+    else: llegada = "NO RECIBIDO"
+    if s["resp"] == "0x0": return llegada
+    return llegada + (", respondido" if s["reply"] else ", SIN RESPUESTA")
+
+# Petición que espera respuesta: el puerto de respuesta va como derecho de envío único (MAKE/MOVE_SEND_ONCE, 21/18),
+# o el remitente se queda esperando en la misma llamada. Los avisos que se registran (puerto de respuesta con derecho de
+# envío normal) no cuentan: se contestan cuando pasa algo, si pasa.
+def espera_respuesta(s):
+    return s["resp"] != "0x0" and (s["wait"] or ((int(s["bits"], 16) >> 8) & 0x1f) in (18, 21))
+
+def interesa(s): return not solo or progs.get(s["pid"]) in solo or progs.get(s["to"]) in solo
+
+print(f"== procesos con traza: {', '.join(sorted({name(p) for p in traced}))}")
+if full:
+    print("== conversación")
+    for s in sends:
+        if interesa(s):
+            print(f"   {s['n']:>7} {name(s['pid']):>26} -> {name(s['to']):<26} {kind(s['id']):<16} {state(s)}"
+                  + (f"   «{s['txt']}»" if s["txt"] else ""))
+            if xpc and s.get("body"):
+                d = xpc_decode(s["body"])
+                if d: print(f"              {d[:600]}")
+
+if follow:
+    pids = {p for p in traced if p in follow or progs.get(p) in follow}
+    print(f"== seguimiento de {', '.join(sorted(name(p) for p in pids)) or '(nadie con traza)'}")
+    ev = [("->", x) for x in sends if x["pid"] in pids] + [("<-", r) for r in recvs if r["pid"] in pids]
+    for d, x in sorted(ev, key=lambda e: e[1]["n"]):
+        if d == "->":
+            print(f"   {x['n']:>7} {name(x['pid'])}.{x['tid']} envía a {name(x['to'])} {kind(x['id'])} tam={x['size']}: {state(x)}"
+                  + (f"   «{x['txt']}»" if x["txt"] and not (xpc and x.get("body")) else ""))
+            if xpc and x.get("body"):
+                d = xpc_decode(x["body"])
+                if d: print(f"              {d[:600]}")
+            rp = x.get("reply")
+            if xpc and rp and rp.get("body"):                 # la respuesta, si quien responde también tiene traza
+                d = xpc_decode(rp["body"])
+                if d: print(f"              respuesta (línea {rp['n']}): {d[:600]}")
+        else:
+            err = "" if x["res"] == "0x0" else f" ERROR {x['res']}"
+            print(f"   {x['n']:>7} {name(x['pid'])}.{x['tid']} recibe de {name(x['de'])} {kind(x['id'])} tam={x['size']} en {x['dest']}{err}")
+            if xpc and x.get("body"):
+                d = xpc_decode(x["body"])
+                if d: print(f"              {d[:600]}")
+
+print("== por pareja (mensajes, sin recibir, sin respuesta)")
+pairs = Counter(); lost = Counter(); unans = Counter()
+for s in sends:
+    if not interesa(s): continue
+    k = (name(s["pid"]), name(s["to"]))
+    pairs[k] += 1
+    if s["to"] in traced and not s["recv"] and not s.get("fail"): lost[k] += 1
+    if s["resp"] != "0x0" and not s["reply"]: unans[k] += 1
+for k, v in pairs.most_common(30):
+    print(f"   {k[0]:>26} -> {k[1]:<26} {v:>5} {lost[k]:>5} {unans[k]:>5}")
+
+print("== a medias (lo que puede colgar una cadena)")
+malos = [s for s in sends if interesa(s) and s["pid"] != s["to"] and
+         not s.get("fail") and ((s["to"] in traced and not s["recv"]) or (espera_respuesta(s) and not s["reply"]))]
+for s in malos[-40:]:
+    print(f"   línea {s['n']}: {name(s['pid'])} -> {name(s['to'])} {kind(s['id'])} (id {s['id']}): {state(s)}"
+          + (f"   «{s['txt']}»" if s["txt"] else ""))
+if not malos: print("   nada: todo lo enviado llegó y las peticiones que esperaban tuvieron respuesta")
