+          (f"discos sin anunciar {', '.join(atascados)}" if atascados else "todos los discos anunciados") +
+          (f"; esperan el aviso: {', '.join(sorted(set(pend)))}" if pend else ""))
+else:
+    print("VEREDICTO: correcto (discos anunciados y avisos idle enviados)")
