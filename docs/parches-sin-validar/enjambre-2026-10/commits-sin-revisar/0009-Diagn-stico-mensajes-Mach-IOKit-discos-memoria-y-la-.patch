+#!/bin/bash
+# bateria.sh [binario_anterior]: la batería fija que se pasa antes de dar por bueno un cambio. Con binario_anterior, antes
+# hace la comparación A/B del inventario corto (ab_recorrido.sh). Luego, con el tahoe-run del repo:
+#   1. diskutil list en la Recovery (discos.sh): debe decir «VEREDICTO: correcto» (cuelga a veces también sin cambios);
+#   2. el inventario corto (shell_survey.sh, 79 órdenes) en el macOS completo, dos veces: el arranque varía mucho;
+#   3. la memoria de WindowServer (memoria.sh, ~76 MB estable);
+#   4. cargo test --lib en tahoe-run/nucleo.
+# Salida en $TAHOE_DIAG_DIR/bateria (por omisión ~/.cache/tahoe-diag/bateria) y un resumen al final. Siempre limpia.
+DIAG="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; REPO="$(cd "$DIAG/../.." && pwd)"
+D="${TAHOE_DIAG_DIR:-$HOME/.cache/tahoe-diag}"; O="$D/bateria"; rm -rf "$O"; mkdir -p "$O"
+COMPLETO="${TAHOE_COMPLETO:-$HOME/macos26/completo/macOS}"
+cd "$REPO" || exit 1
+[ -n "$1" ] && "$DIAG/ab_recorrido.sh" "$1" > "$O/ab.txt" 2>&1
+DEPURAR=1 "$DIAG/discos.sh" > "$O/discos.txt" 2>&1; "$DIAG/clean.sh" > /dev/null 2>&1
+for i in 1 2; do TAHOE_ROOT="$COMPLETO" DEPURAR=1 tools/shell_survey.sh > "$O/recorrido$i.txt" 2>&1; "$DIAG/clean.sh" > /dev/null 2>&1; done
+TAHOE_ROOT="$COMPLETO" DEPURAR=1 "$DIAG/memoria.sh" WindowServer 60 120 > "$O/memoria.txt" 2>&1; "$DIAG/clean.sh" > /dev/null 2>&1
+(cd tahoe-run/nucleo && cargo test --lib 2>&1 | grep "test result") > "$O/cargo.txt"
+[ -s "$O/ab.txt" ] && cat "$O/ab.txt"
+grep -a -m1 "VEREDICTO\|COLGADA" "$O/discos.txt"
+for i in 1 2; do echo "recorrido $i: OK=$(grep -c '^OK' "$O/recorrido$i.txt") COLGADA=$(grep -c '^COLGADA' "$O/recorrido$i.txt") ERR=$(grep -c '^ERR' "$O/recorrido$i.txt")"; done
+grep "t=1[01][05]" "$O/memoria.txt" | tail -2
+cat "$O/cargo.txt"
+echo "procesos tahoe-run vivos al final: $(pgrep -c -x tahoe-run)"
diff --git a/tools/diag/caidas.py b/tools/diag/caidas.py
new file mode 100755
index 0000000..953e6c5
--- /dev/null
+++ b/tools/diag/caidas.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+# caidas.py [registro]: resumen de las caídas de un arranque (por omisión ~/.cache/tahoe-diag/msh.log).
+# Cuenta, por programa de macOS, los mensajes de aborto (abort <pid>: [librería] "motivo"), los motivos de los
+# informes de caída, las señales (SIGSEGV, SIGBUS, SIGILL) y las salidas con estado distinto de 0. Los volcados de "espera" y "traza" (STACKS) no son caídas.
+import collections, os, re, sys
+
+log = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.cache/tahoe-diag/msh.log")
+name = {}
+msgs = collections.Counter()
+sigs = collections.Counter()
+exits = collections.Counter()
+for l in open(log, errors="replace"):
+    m = re.match(r"tahoe-run: <(\d+)> cargado (\S+)", l)
+    if m and m.group(2) != "dyld":
+        name[m.group(1)] = m.group(2)        # el último programa cargado por ese pid
+        continue
+    m = re.search(r'abort <(\d+)>: \[([^\]]+)\] "(.*)"', l)
+    if m and m.group(3) != "abort() called":
+        msgs[(name.get(m.group(1), "?"), m.group(3)[:110])] += 1
+        continue
+    m = re.search(r'=== motivo: "(.*)"', l)
+    if m:
+        msgs[("?", m.group(1)[:110])] += 1
+    m = re.search(r"fin <(\d+)> \[([^\]]*)\] exit\((-?\d+)\)", l)
+    if m:
+        if m.group(3) != "0":
+            exits[(m.group(2), f"exit({m.group(3)})")] += 1
+        continue
+    m = re.search(r"(SIGSEGV|SIGBUS|SIGILL) <(\d+)>", l)
+    if m:
+        sigs[(name.get(m.group(2), "?"), m.group(1))] += 1
+for (n, msg), c in msgs.most_common(40):
+    print(f"{c:3} {n:28} {msg}")
+for (n, sig), c in sigs.most_common(20):
+    print(f"{c:3} {n:28} {sig}")
+for (n, st), c in exits.most_common(20):
+    print(f"{c:3} {n:28} {st}")
+if not msgs and not sigs and not exits:
+    print("sin caídas")
diff --git a/tools/diag/captura.py b/tools/diag/captura.py
new file mode 100755
index 0000000..59f8ef5
--- /dev/null
+++ b/tools/diag/captura.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+# captura.py [salida.png] [archivo]: guarda en PNG la pantalla emulada de macOS (la memoria de vídeo en la que dibuja
+# WindowServer: /dev/shm/tahoe-fb-<id>, por omisión la más reciente). Lee la cabecera "TFB1" de la última página del
+# archivo (ancho, alto, bytes por fila, formato 0 = B, G, R, X) como tools/tahoe-view. Sin dependencias (zlib).
+import glob, os, struct, sys, zlib
+
+out = sys.argv[1] if len(sys.argv) > 1 else "pantalla.png"
+files = [sys.argv[2]] if len(sys.argv) > 2 else sorted(glob.glob("/dev/shm/tahoe-fb-*"), key=os.path.getmtime)
+if not files:
+    sys.exit("no hay memoria de vídeo (/dev/shm/tahoe-fb-*): ¿está WindowServer en marcha?")
+with open(files[-1], "rb") as f:
+    data = f.read()
+magic, w, h, bpr, fmt = struct.unpack_from("<4sIIII", data, len(data) - 4096)
+if magic != b"TFB1" or fmt != 0:
+    sys.exit("cabecera desconocida en " + files[-1])
+rows = bytearray()
+used = 0
+for y in range(h):
+    line = data[y * bpr: y * bpr + w * 4]
+    rows.append(0)                                            # filtro PNG: ninguno
+    px = bytearray(w * 3)
+    px[0::3], px[1::3], px[2::3] = line[2::4], line[1::4], line[0::4]   # BGRX -> RGB
+    used += any(line)
+    rows += px
+
+
+def chunk(t, d):
+    return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
+
+
+png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) + \
+      chunk(b"IDAT", zlib.compress(bytes(rows), 6)) + chunk(b"IEND", b"")
+open(out, "wb").write(png)
+print(f"{out}: {w}x{h}, {used} de {h} filas con algo dibujado ({files[-1]})")
