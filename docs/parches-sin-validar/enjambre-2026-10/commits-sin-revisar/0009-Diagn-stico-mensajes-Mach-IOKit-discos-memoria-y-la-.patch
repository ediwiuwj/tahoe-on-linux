@@ -0,0 +1,13 @@
+#!/bin/bash
+# dk_calmo.sh [espera]: diskutil con el sistema ya asentado (no en pleno arranque, que tarda 2–3 min en calmarse).
+# Arranca el macOS completo, espera a que launchd responda y luego «espera» segundos más (150), y cronometra órdenes de
+# disco (repetidas) con su código de salida, tiempo y número de líneas. Siempre limpia.
+DIAG="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; REPO="$(cd "$DIAG/../.." && pwd)"
+D="${TAHOE_DIAG_DIR:-$HOME/.cache/tahoe-diag}"; O="$D/dk_calmo"; rm -rf "$O"; mkdir -p "$O"
+cd "$REPO" || exit 1
+C="w=0; while ! perl -e \"alarm 8; exec @ARGV\" launchctl print system >/dev/null 2>&1 && [ \$w -lt 180 ]; do sleep 3; w=\$((w+3)); done; echo listo \$w; sleep ${1:-150}
+for o in \"diskutil list\" \"diskutil list\" \"diskutil info /\" \"diskutil info /System/Volumes/Data\" \"diskutil apfs list\" \"diskutil info disk1s3\" \"diskutil list\" \"bless --info\" \"bless --info --getBoot\"; do s=\$(perl -MTime::HiRes=time -e \"printf q(%.1f), time\"); perl -e \"alarm 90; exec @ARGV\" sh -c \"\$o\" > /tmp/o.txt 2>&1; r=\$?; e=\$(perl -MTime::HiRes=time -e \"printf q(%.1f), time\"); echo \"rc=\$r t=\$(echo \"\$e - \$s\" | bc) lineas=\$(wc -l < /tmp/o.txt) \$o | \$(grep -m1 -i error /tmp/o.txt)\"; done"
+TAHOE_ROOT="${TAHOE_ROOT:-$HOME/macos26/completo/macOS}" TAHOE_BOOT_WAIT=10 timeout 900 tools/macos-shell.sh --depurar --launchd -c "$C" > "$O/out" 2>&1
+L=/tmp/tahoe-shell-$USER.log; n=$(grep -a -n "cargado launchd" "$L" | tail -1 | cut -d: -f1); tail -n +"$n" "$L" > "$O/boot.log"
+"$DIAG/clean.sh" > /dev/null 2>&1
+grep -a "^rc=\|^listo" "$O/out"
diff --git a/tools/diag/dsmos.py b/tools/diag/dsmos.py
new file mode 100755
index 0000000..7a31ea0
--- /dev/null
+++ b/tools/diag/dsmos.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""dsmos.py <macho> <salida>: copia de un ejecutable de macOS con el __TEXT protegido («Apple Protect»: loginwindow,
+Finder, Dock...) ya descifrado, para poder desensamblarlo (llvm-objdump). El mismo esquema que emu_dsmos.c: Blowfish en
+modo CBC por páginas de 4 KiB, vector inicial cero, salvo las 3 primeras páginas del archivo, con la clave OSK de 64 bytes
+de TAHOE_OSK_FILE o ~/.config/tahoe-run/osk. Si el archivo es universal, se queda con la parte x86_64.
+La copia descifrada es un binario de Apple: no se sube al repositorio (déjala en /tmp).
+"""
+import os
+import re
+import struct
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+UNPROTECTED = 0x3000
+MAGIC = 0x2e69cf40
+SG_PROTECTED_VERSION_1 = 0x8
+
+
+def bf_pi():
+    src = open(os.path.join(HERE, "..", "..", "tahoe-run", "bf_pi.h")).read()
+    return [int(x, 16) for x in re.findall(r"0x([0-9a-f]{8})", src)]
+
+
+class Blowfish:
+    def __init__(self, key):
+        pi = bf_pi()
+        self.p = pi[:18]
+        self.s = [pi[18 + 256 * i: 18 + 256 * (i + 1)] for i in range(4)]
+        j = 0
+        for i in range(18):
+            d = 0
+            for _ in range(4):
+                d = (d << 8) | key[j]
+                j = (j + 1) % len(key)
+            self.p[i] ^= d
+        l = r = 0
+        for i in range(0, 18, 2):
+            l, r = self.enc(l, r)
+            self.p[i], self.p[i + 1] = l, r
+        for s in range(4):
+            for i in range(0, 256, 2):
+                l, r = self.enc(l, r)
+                self.s[s][i], self.s[s][i + 1] = l, r
+
+    def f(self, x):
+        s = self.s
+        return (((s[0][x >> 24] + s[1][(x >> 16) & 0xff]) & 0xffffffff) ^ s[2][(x >> 8) & 0xff]) + s[3][x & 0xff] & 0xffffffff
+
+    def enc(self, a, b):
+        for i in range(16):
+            a ^= self.p[i]
+            b ^= self.f(a)
+            a, b = b, a
+        a, b = b, a
+        return a ^ self.p[17], b ^ self.p[16]
+
+    def dec(self, a, b):
+        for i in range(17, 1, -1):
+            a ^= self.p[i]
+            b ^= self.f(a)
+            a, b = b, a
+        a, b = b, a
+        return a ^ self.p[0], b ^ self.p[1]
+
+
+def dec_page(bf, pg):
+    out = bytearray(len(pg))
+    iv = b"\0" * 8
+    for o in range(0, len(pg) - 7, 8):
+        c = pg[o:o + 8]
+        l, r = struct.unpack(">II", c)
+        l, r = bf.dec(l, r)
+        p = struct.pack(">II", l, r)
+        out[o:o + 8] = bytes(x ^ y for x, y in zip(p, iv))
+        iv = c
+    out[len(pg) - len(pg) % 8:] = pg[len(pg) - len(pg) % 8:]
+    return bytes(out)
+
+
+def thin_x86(d):
+    if struct.unpack(">I", d[:4])[0] in (0xcafebabe,):
+        n = struct.unpack(">I", d[4:8])[0]
+        for i in range(n):
+            ct, _, off, sz, _ = struct.unpack(">IIIII", d[8 + i * 20:28 + i * 20])
+            if ct == 0x01000007:
+                return d[off:off + sz]
+        sys.exit("no hay parte x86_64")
+    return d
+
+
+def main():
+    src, dst = sys.argv[1], sys.argv[2]
+    kf = os.environ.get("TAHOE_OSK_FILE", os.path.expanduser("~/.config/tahoe-run/osk"))
+    key = open(kf, "rb").read(64)
+    if len(key) != 64:
+        sys.exit("clave OSK incompleta")
+    d = bytearray(thin_x86(open(src, "rb").read()))
+    ncmds = struct.unpack("<I", d[16:20])[0]
+    off = 32
+    bf = Blowfish(key)
+    for _ in range(ncmds):
+        cmd, sz = struct.unpack("<II", d[off:off + 8])
+        if cmd == 0x19:                                           # LC_SEGMENT_64
+            name = d[off + 8:off + 24].rstrip(b"\0").decode()
+            fileoff, filesize = struct.unpack("<QQ", d[off + 40:off + 56])
+            flags = struct.unpack("<I", d[off + 68:off + 72])[0]
+            if flags & SG_PROTECTED_VERSION_1:
+                start = 0 if fileoff >= UNPROTECTED else UNPROTECTED - fileoff
+                magic = struct.unpack("<I", d[fileoff + start:fileoff + start + 4])[0]
+                if magic != MAGIC:
+                    sys.exit(f"{name}: marca 0x{magic:08x} desconocida")
+                for o in range(start, filesize, 4096):
+                    a = fileoff + o
+                    b = fileoff + min(o + 4096, filesize)
+                    d[a:b] = dec_page(bf, bytes(d[a:b]))
+                flags &= ~SG_PROTECTED_VERSION_1
+                d[off + 68:off + 72] = struct.pack("<I", flags)
+                print(f"{name}: descifradas {(filesize - start + 4095) // 4096} páginas")
+        off += sz
+    open(dst, "wb").write(d)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/diag/entrada.py b/tools/diag/entrada.py
new file mode 100644
index 0000000..d255e7c
--- /dev/null
+++ b/tools/diag/entrada.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+# entrada.py <orden>...: manda teclado y ratón al macOS que corre (el mismo socket que usa tahoe-view, ver
+# tools/tahoe-view/src/entrada.rs). Para probar sin la ventana. Órdenes:
+#   tecla <uso hex>      pulsa y suelta esa tecla (uso HID de la página 7: 0x28 Intro, 0x2c espacio, 0x04 «a»...)
+#   texto <letras>       letras a-z, cifras y espacios (distribución estadounidense, sin mayúsculas)
+#   mueve <x> <y>        el puntero a ese píxel de la pantalla de macOS
+#   clic <x> <y>         mueve y hace clic con el botón izquierdo
+#   rueda <dy>           líneas de rueda (positivo hacia arriba)
+#   espera <s>           pausa
+# El socket es /dev/shm/tahoe-input-<id> del arranque más reciente (o TAHOE_INPUT).
+import glob, os, socket, struct, sys, time
+
+def ruta():
+    if os.environ.get("TAHOE_INPUT"): return os.environ["TAHOE_INPUT"]
+    s = sorted(glob.glob("/dev/shm/tahoe-input-*"), key=os.path.getmtime)
+    if not s: sys.exit("entrada.py: no hay /dev/shm/tahoe-input-* (¿WindowServer arrancado?)")
+    return s[-1]
+
+S = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM); R = ruta()
+def manda(t, a, b, c): S.sendto(struct.pack("<Iiii", t, a, b, c), R)
+def tecla(u): manda(1, 7, u, 1); time.sleep(0.03); manda(1, 7, u, 0); time.sleep(0.03)
+def uso(ch):
+    if "a" <= ch <= "z": return 4 + ord(ch) - ord("a")
+    if "1" <= ch <= "9": return 0x1e + ord(ch) - ord("1")
+    return {"0": 0x27, " ": 0x2c, "\n": 0x28}.get(ch)
+
+a = sys.argv[1:]
+while a:
+    o = a.pop(0)
+    if o == "tecla": tecla(int(a.pop(0), 16))
+    elif o == "texto":
+        for ch in a.pop(0):
+            u = uso(ch)
+            if u is None: sys.exit(f"entrada.py: «{ch}» no está en la tabla")
+            tecla(u)
+    elif o == "mueve": x, y = int(a.pop(0)), int(a.pop(0)); manda(2, x, y, 0)
+    elif o == "clic": x, y = int(a.pop(0)), int(a.pop(0)); manda(2, x, y, 0); time.sleep(0.05); manda(2, x, y, 1); time.sleep(0.08); manda(2, x, y, 0)
+    elif o == "rueda": manda(3, 0, int(a.pop(0)), 0)
+    elif o == "espera": time.sleep(float(a.pop(0)))
+    else: sys.exit(f"entrada.py: orden desconocida «{o}»")
diff --git a/tools/diag/hang.sh b/tools/diag/hang.sh
index a0c7470..3c21129 100755
--- a/tools/diag/hang.sh
+++ b/tools/diag/hang.sh
@@ -1,39 +1,85 @@
 #!/bin/bash
-# hang.sh '<orden de macOS>' <proceso> [segundos]: lanza la orden con msh.sh y, pasados los segundos (20) tras el arranque,
-# vuelca cada hilo del proceso de macOS llamado <proceso> (estado, llamada de Linux en curso, wchan y la instrucción,
-# simbolizada con sym.py si está en la caché de macOS o con addr2line si es código de tahoe-run). Siempre limpia.
+# hang.sh '<orden de macOS>' '<proceso> [proceso...]' [segundos]: lanza la orden con msh.sh y, pasados los segundos (20)
+# tras el arranque, vuelca cada hilo de los procesos de macOS con esos nombres (estado, llamada de Linux en curso, wchan y
+# la instrucción, simbolizada con sym.py si está en la caché de macOS o con addr2line si es código de tahoe-run). Los
+# procesos se buscan por el programa de macOS que cargaron (el registro dice "<pid de macOS> cargado <programa>"; el pid
+# de Linux se encuentra por NSpid), no por la línea de órdenes, que puede ser la del xpcproxy que lo lanzó. Si alguno no
+# está vivo, dice qué se sabe de él por el registro (si llegó a cargarse, sus mensajes de aborto). Siempre limpia.
 # Admite las variables de diagnóstico de msh.sh (el registro queda en msh.log). Con STACKS=<proceso> (el mismo), además
-# las pilas de macOS de cada hilo, simbolizadas.
+# las pilas de macOS de cada hilo, simbolizadas. ESPERA: segundos de arranque antes de la orden (12; el macOS completo
+# necesita más, p. ej. 60).
 DIAG="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
 D="${TAHOE_DIAG_DIR:-$HOME/.cache/tahoe-diag}"; mkdir -p "$D"
 RUN="${TAHOE_RUN:-$DIAG/../../tahoe-run/tahoe-run}"
-( "$DIAG/msh.sh" "$1" 12 $(( ${3:-20} + 40 )) > "$D/hang.out" 2>&1 & )
-sleep $(( 12 + 4 + ${3:-20} ))
+E=${ESPERA:-12}
+# msh.sh apaga el arranque en cuanto acaba la orden: se alarga con un sleep para que siga vivo cuando llegue el volcado.
+( "$DIAG/msh.sh" "$1; sleep $(( ${3:-20} + 30 ))" $E $(( E + ${3:-20} + 60 )) > "$D/hang.out" 2>&1 & )
+sleep $(( E + 4 + ${3:-20} ))
 # Línea de órdenes desde un hilo vivo: si el hilo principal terminó, /proc/<pid>/cmdline sale vacío
 # (y no vale [ -s ]: los archivos de /proc dicen tener tamaño 0).
