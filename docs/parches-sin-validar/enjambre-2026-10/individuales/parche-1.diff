+// mach_vm_region_recurse (id 4815): como mach_vm_region, pero además de la profundidad de anidamiento (los «submap» de
+// XNU). Aquí no hay submaps, así que la profundidad no cambia y la región es la misma.
+// La petición: cabecera (24) + NDR (8) + address (8, inout) + nesting_depth (4, inout) + count (4) = 48 bytes; lo comprobó
+// el cliente de macOS 26 (`_mach_vm_region_recurse` en la caché de dyld): NDR en +24, dirección en +32, profundidad en +40
+// y min(cuenta,19) en +44, y el mensaje mide 48 bytes.
+// La respuesta: cabecera (24) + NDR (8) + retcode (4) + address (8) + size (8) + nesting_depth (4) + count (4) +
+// info[count]: el tamaño es 60 + 4*count y el cliente lee la dirección en +36, el tamaño en +44, la profundidad en +52 y
+// el contador en +56.
+#define VR_RECURSE_SHORT_COUNT  13        // VM_REGION_SUBMAP_SHORT_INFO_COUNT_64
+#define VR_RECURSE_V0_COUNT     17        // VM_REGION_SUBMAP_INFO_V0_COUNT_64
+#define VR_RECURSE_V1_COUNT     18        // VM_REGION_SUBMAP_INFO_V1_COUNT_64
+#define VR_RECURSE_MAX_COUNT    19        // el arreglo del cliente: type vm_region_recurse_info_t = array[*:19] (mach_types.defs:573)
+static size_t mig_mach_vm_region_recurse(const struct hdr* req, const uint8_t* m, uint8_t* r) {
+	uint64_t addr = 0;
+	int32_t depth = 0, count = 0;
+	if (req->size < 48) return reply_begin(r, req, KERN_INVALID_ARG);
+	memcpy(&addr, m + 32, 8);                          // address (in/out)
+	memcpy(&depth, m + 40, 4);                         // nesting_depth (in/out)
+	memcpy(&count, m + 44, 4);                         // count (CountInOut de info)
+	// Como XNU (osfmk/vm/vm_map.c: vm_map_region_recurse_64): si el búfer no cabe ni la versión corta, KERN_INVALID_ARGUMENT;
+	// si sobra, se devuelve la versión que cabe (V0, V1 o V2 según lo que pidiera).
+	if (count < VR_RECURSE_SHORT_COUNT) return reply_begin(r, req, KERN_INVALID_ARG);
+	uint32_t need = VR_RECURSE_V0_COUNT;
+	if (count >= VR_RECURSE_V1_COUNT) need = VR_RECURSE_V1_COUNT;
+	if (need > VR_RECURSE_MAX_COUNT) need = VR_RECURSE_MAX_COUNT;    // el arreglo del cliente no da para más
+	int32_t pid = (int32_t)getpid();
+	int kt;
+	if (req->remote != 0x103 && !(kobj_lookup(req->remote, &kt, &pid) && (kt == KO_TASK || kt == KO_TASK_NAME)))
+		pid = (int32_t)getpid();
+	struct vregion vm;
+	if (!vm_region_of(pid, addr, &vm)) return reply_begin(r, req, KERN_NO_SPACE_);
+	// struct vm_region_submap_info_64 (osfmk/mach/vm_region.h:271), con su reparto real (los huecos también cuentan,
+	// porque XNU escribe la estructura tal cual en el búfer del cliente):
+	// protection (0), max_protection (4), inheritance (8), relleno (12), offset (16, 8 bytes), user_tag (24),
+	// pages_resident (28), pages_shared_now_private (32), pages_swapped_out (36), pages_dirtied (40), ref_count (44),
+	// shadow_depth (48), external_pager (50), share_mode (51), is_submap (52), behavior (56), object_id (60),
+	// user_wired_count (64), flags (66), pages_reusable (68).
+	uint32_t info[VR_RECURSE_V1_COUNT] = { 0 };
+	info[0] = (uint32_t)vm.prot;               // protection (0)
+	info[1] = (uint32_t)vm.prot;               // max_protection (4)
+	info[2] = 1;                               // inheritance: VM_INHERIT_COPY (8)
+	memcpy(info + 4, &vm.off, 8);              // offset (16): el desplazamiento del archivo
+	info[11] = 0;                              // ref_count (44)
+	info[12] = (uint32_t)(vm.shared ? 4 : 2) << 24;   // share_mode (51): SM_SHARED o SM_PRIVATE
+	info[13] = 0;                              // is_submap (52): aquí no hay submaps
+	info[16] = 0;                              // user_wired_count (64) y flags (66)
+	info[17] = 0;                              // pages_reusable (68)
+	if (mach_trace()) logf_("    MT pid=%d vm_region_recurse 0x%lx profundidad %d cuenta %d -> 0x%lx+0x%lx prot=%d\n",
+		(int)getpid(), (unsigned long)addr, depth, count, (unsigned long)vm.start, (unsigned long)(vm.end - vm.start), vm.prot);
+	size_t n = reply_begin(r, req, KERN_SUCCESS_);
+	uint64_t start = vm.start, size = vm.end - vm.start;
+	memcpy(r + n, &start, 8); n += 8;
+	memcpy(r + n, &size, 8); n += 8;
+	memcpy(r + n, &depth, 4); n += 4;
+	int32_t c32 = (int32_t)need; memcpy(r + n, &c32, 4); n += 4;
+	memcpy(r + n, info, need * 4); n += need * 4;
+	return n;
+}
+
+// mach_port_space_basic_info (id 3235): información básica del espacio IPC de una tarea.
+// La petición es simple: cabecera (24) + NDR (8) + argumentos; la tarea es el puerto remoto del mensaje (como en las
+// demás rutinas del subsistema mach_port: en mach_port_get_attributes, id 3217, el nombre del puerto está en +32, o sea
+// que la tarea no se repite en el cuerpo).
+// La respuesta es simple: cabecera (24) + NDR (8) + código de retorno (4) + ipc_info_space_basic_t (6 natural_t).
+static size_t mig_mach_port_space_basic_info(const struct hdr* req, const uint8_t* m, uint8_t* r) {
+	(void)m;
+	int32_t pid = (int32_t)getpid();
+	int kt;
+	if (req->remote != 0x103 && !(kobj_lookup(req->remote, &kt, &pid) && (kt == KO_TASK || kt == KO_TASK_NAME)))
+		pid = (int32_t)getpid();
+	uint32_t inuse = 0, tsize = 0;
+	port_space_counts(pid, &inuse, &tsize);
+	uint32_t info[6] = { 0 };
+	info[0] = 0xff;                 // iisb_genno_mask = MACH_PORT_NGEN(MACH_PORT_DEAD) (osfmk/ipc/port.h:72)
+	info[1] = tsize;                 // iisb_table_size
+	info[2] = 0;                     // iisb_table_next (sin uso en XNU)
+	info[3] = inuse;                 // iisb_table_inuse
+	size_t n = reply_begin(r, req, KERN_SUCCESS_);
+	memcpy(r + n, info, sizeof info);
+	return n + sizeof info;
+}
