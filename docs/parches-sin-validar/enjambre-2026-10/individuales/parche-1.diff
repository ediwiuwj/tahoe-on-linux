+// Estado del espacio IPC de un proceso: cuántas entradas (nombres de puerto) usa y de qué tamaño es la tabla.
+// En XNU cada tarea tiene su propia tabla de nombres (osfmk/ipc/ipc_space.c) y mach_port_space_basic_info
+// (osfmk/ipc/mach_debug.c:357) informa de su tamaño y de las entradas en uso. Una entrada es un nombre del espacio: un
+// derecho de recepción o un derecho de envío que el proceso tiene (los urefs no cuentan: en XNU es un nombre por entrada).
+// Aquí la tabla de puertos es única para todo el sistema: el «tamaño» es la marca más alta usada (los huecos se
+// reutilizan, como en XNU la tabla nunca encoge) y las «entradas en uso» son las del proceso: sus puertos y los derechos
+// de envío que tiene sobre los de otros.
+void port_space_counts(int32_t pid, uint32_t* inuse, uint32_t* tsize) {
+	uint32_t n = 0;
+	lock();
+	for (int i = 0; i < (int)shm->hiwater; i++)
+		if (shm->ports[i].used && shm->ports[i].owner == pid) n++;
+	for (int i = 0; i < (int)shm->sh_hw; i++)
+		if (shm->sh[i].port && shm->sh[i].holder == pid) n++;      // derechos de envío que tiene (uno por nombre)
+	*tsize = (uint32_t)shm->hiwater;
+	*inuse = n;
+	unlock();
+}
 static int owns(uint32_t name) { lock(); struct sport* p = find_locked(name); int r = p && p->owner == (int32_t)getpid(); unlock(); return r; }
