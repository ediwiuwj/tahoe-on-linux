+// task_policy_get (id 3421): la política de una tarea (el papel, el nivel de QoS, la supresión o el estado de importancia).
+// La petición: cabecera (24) + NDR (8) + flavor (4) + count (4) + get_default (4) = 44 bytes; la respuesta: cabecera (24) +
+// NDR (8) + retcode (4) + count (4) + info[count] + get_default (4) = 44 + 4*count bytes. (Lo comprobó el cliente de macOS 26:
+// `_task_policy_get` en la caché de dyld, que pide min(cuenta,16) y lee el get_default al final, en +40+4*count.)
+// En XNU (osfmk/kern/task_policy.c:575) hay cuatro sabores: TASK_CATEGORY_POLICY (1), TASK_SUPPRESSION_POLICY (3),
+// TASK_POLICY_STATE (4, que solo puede leer root), TASK_BASE_QOS_POLICY (8) y TASK_OVERRIDE_QOS_POLICY (9). Aquí las tareas no
+// tienen papel, QoS ni supresión: se devuelven los valores «sin especificar», que son los mismos que da XNU con get_default.
+#define TP_CATEGORY_POLICY      1        // TASK_CATEGORY_POLICY
+#define TP_SUPPRESSION_POLICY   3        // TASK_SUPPRESSION_POLICY
+#define TP_POLICY_STATE         4        // TASK_POLICY_STATE
+#define TP_BASE_QOS_POLICY      8        // TASK_BASE_QOS_POLICY
+#define TP_OVERRIDE_QOS_POLICY  9        // TASK_OVERRIDE_QOS_POLICY
+static size_t mig_task_policy_get(const struct hdr* req, const uint8_t* m, uint8_t* r) {
+	int32_t flavor = 0, count = 0, gd = 0;
+	if (req->size < 44) return reply_begin(r, req, KERN_INVALID_ARG);
+	memcpy(&flavor, m + 32, 4);                       // flavor
+	memcpy(&count, m + 36, 4);                        // count (CountInOut de info)
+	memcpy(&gd, m + 40, 4);                           // get_default (entrada y salida)
+	uint32_t info[16] = { 0 };
+	uint32_t need = 0;                                   // palabras que ocupa la estructura del sabor
+	if (flavor == TP_CATEGORY_POLICY) {
+		need = 1;
+		if (count < (int32_t)need) return reply_begin(r, req, KERN_INVALID_ARG);
+		info[0] = 0;                                  // role: TASK_UNSPECIFIED (task_policy.h:120)
+	} else if (flavor == TP_BASE_QOS_POLICY || flavor == TP_OVERRIDE_QOS_POLICY) {
+		need = 2;
+		if (count < (int32_t)need) return reply_begin(r, req, KERN_INVALID_ARG);
+		info[0] = 0;                                  // task_latency_qos_tier: LATENCY_QOS_TIER_UNSPECIFIED
+		info[1] = 0;                                  // task_throughput_qos_tier: THROUGHPUT_QOS_TIER_UNSPECIFIED
+	} else if (flavor == TP_SUPPRESSION_POLICY) {
+		need = 16;                                   // nada suprimido (task_policy_private.h:118)
+		if (count < (int32_t)need) return reply_begin(r, req, KERN_INVALID_ARG);
+	} else if (flavor == TP_POLICY_STATE) {
+		need = 16;                                   // requested, effective, pending... (task_policy_private.h:133)
+		if (count < (int32_t)need) return reply_begin(r, req, KERN_INVALID_ARG);
+		if (cred_euid() != 0) return reply_begin(r, req, 2 /* KERN_PROTECTION_FAILURE: solo root */);
+	} else return reply_begin(r, req, KERN_INVALID_ARG);   // sabor desconocido: como XNU
+	// XNU no cambia la cuenta (solo la comprueba): la respuesta lleva los mismos números que la petición (el cliente los
+	// limita a 16), y XNU escribe la estructura al principio del búfer. Aquí, lo mismo: los valores al principio y el resto a cero.
+	uint32_t out = (count > 16 ? 16 : (uint32_t)count);
+	size_t n = reply_begin(r, req, KERN_SUCCESS_);
+	memcpy(r + n, &out, 4); n += 4;
+	memcpy(r + n, info, out * 4); n += out * 4;
+	memcpy(r + n, &gd, 4); n += 4;                     // get_default: XNU no lo cambia, se devuelve el que pidió
+	return n;
+}
