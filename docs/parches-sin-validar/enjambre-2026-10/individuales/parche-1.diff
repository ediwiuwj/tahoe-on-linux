+// Indicadores de necp_open (bsd/net/necp.h:614).
+#define NECP_OPEN_FLAG_OBSERVER       0x01
+#define NECP_OPEN_FLAG_BACKGROUND     0x02
+#define NECP_OPEN_FLAG_PUSH_OBSERVER  0x04
+
+// Los descriptores de cliente NECP. En XNU sus operaciones de archivo no hacen nada (bsd/net/necp_client.c:413,
+// necp_fd_ops: fo_read = fo_no_read → ENXIO, fo_write = fo_no_write → ENXIO, fo_ioctl = fo_no_ioctl → ENOTTY;
+// fo_no_read y fo_no_write devuelven ENXIO en bsd/kern/kern_descrip.c:6268 y 6296, y fo_no_ioctl, ENOTTY, en 6337).
+// Aquí no hay políticas NECP (ni de filtros ni de proveedores de datos), así que el descriptor solo existe: se abre el de
+// /dev/null (para que se pueda cerrar como cualquier otro) y las llamadas de archivo se responden con esos errores.
+#define NECP_FDS 64
+static int necp_fds[NECP_FDS];
+int net_necp_fd(int fd) { for (int i = 0; i < NECP_FDS; i++) if (necp_fds[i] == fd) return 1; return 0; }
+void net_necp_fd_closed(int fd) { for (int i = 0; i < NECP_FDS; i++) if (necp_fds[i] == fd) necp_fds[i] = 0; }
+static void net_necp_fd_new(int fd) { for (int i = 0; i < NECP_FDS; i++) if (!necp_fds[i]) { necp_fds[i] = fd; return; } }
+
+// necp_open (syscall 501): en XNU (bsd/net/necp_client.c:8098, necp_open) abre un descriptor de cliente NECP con los
+// indicadores dados. Los indicadores de observador exigen el privilegio de estadísticas de red
+// (PRIV_NET_PRIVILEGED_NETWORK_STATISTICS) o el de skywalk: sin ellos, EACCES, como en XNU. Aquí el privilegio se
+// aproxima con «root» (uid 0), que es quien lo tiene en un Mac.
+static long net_necp_open(struct ctx* c) {
+	int flags = (int)c->a[0];
+	if (flags & (NECP_OPEN_FLAG_OBSERVER | NECP_OPEN_FLAG_PUSH_OBSERVER))
+		if (cred_euid() != 0) return -D_EACCES;
+	int fd = open("/dev/null", O_RDONLY | O_CLOEXEC);   // como en XNU, el descriptor se crea con FP_CLOEXEC
+	if (fd < 0) return err();
+	net_necp_fd_new(fd);
+	if (trace_all) logf_("    necp_open(0x%x) -> %d\n", flags, fd);
+	return fd;
+}
