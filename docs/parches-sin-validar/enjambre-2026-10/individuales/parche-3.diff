+// En XNU el nombre lo guarda la sesión (session.s_login, MAXLOGNAME bytes) y lo pone setlogin; getlogin lo devuelve
+// (bsd/kern/kern_prot.c:1566 y :1619). Aquí se guarda por sesión de Linux (getsid), que es lo más parecido a la sesión de
+// XNU: los procesos que comparten sesión comparten el nombre. Al principio es "root" (todo el arranque corre como root).
+#define MAXLOGNAME 255                               // XNU bsd/sys/param.h
+static struct { int usado; pid_t sid; char name[MAXLOGNAME + 1]; } login_ses[64];
+static pthread_mutex_t login_lock = PTHREAD_MUTEX_INITIALIZER;
+static void login_get(char* out, size_t cap) {
+	pid_t sid = getsid(0);
+	pthread_mutex_lock(&login_lock);
+	for (int i = 0; i < 64; i++)
+		if (login_ses[i].usado && login_ses[i].sid == sid) {
+			snprintf(out, cap, "%s", login_ses[i].name);
+			pthread_mutex_unlock(&login_lock);
+			return;
+		}
+	pthread_mutex_unlock(&login_lock);
+	snprintf(out, cap, "root");
