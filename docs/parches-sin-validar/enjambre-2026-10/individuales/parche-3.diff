+// Hasta que install_dispatch() no instala los manejadores, el emulador no atiende el SIGILL: si el proceso recibe uno
+// mientras mapea la caché o carga las imágenes, muere con 132 sin dejar rastro (así se perdían las caídas de login,
+// screen, kextutil...). Este manejador temprano anota la dirección de la instrucción ilegal (con addr2line se sabe qué
+// parte del emulador la ejecutó) y sale igual.
+static void on_sigill_early(int sig, siginfo_t* si, void* v) {
+	(void)sig; (void)si;
+	const uint8_t* ip = (const uint8_t*)((ucontext_t*)v)->uc_mcontext.gregs[REG_RIP];
+	uint8_t b[4] = { 0 };
+	safe_read((uint64_t)ip, b, 4);
+	logf_("    SIGILL <%d> en el arranque del emulador, rip=0x%llx (%02x %02x %02x %02x)\n", getpid(),
+	      (unsigned long long)(uintptr_t)ip, b[0], b[1], b[2], b[3]);
+	_exit(132);
+}
