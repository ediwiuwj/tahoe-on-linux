+static void login_set(const char* name) {
+	pid_t sid = getsid(0);
+	pthread_mutex_lock(&login_lock);
+	for (int i = 0; i < 64; i++) {
+		if (!login_ses[i].usado) {
+			login_ses[i].usado = 1; login_ses[i].sid = sid;
+			snprintf(login_ses[i].name, sizeof login_ses[i].name, "%s", name);
+			pthread_mutex_unlock(&login_lock);
+			return;
+		}
+		if (login_ses[i].sid == sid) {
+			snprintf(login_ses[i].name, sizeof login_ses[i].name, "%s", name);
+			pthread_mutex_unlock(&login_lock);
+			return;
+		}
+	}
+	pthread_mutex_unlock(&login_lock);
