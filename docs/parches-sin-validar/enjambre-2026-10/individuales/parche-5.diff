diff --git i/tahoe-run/tahoe.h w/tahoe-run/tahoe.h
index d30b47b..a4411a2 100644
--- i/tahoe-run/tahoe.h
+++ w/tahoe-run/tahoe.h
@@ -41,6 +41,49 @@ extern char cache_guest_path[1024];   // ruta de la caché vista desde macOS (si
 extern uint64_t cache_ino;
 void dsmos_unprotect(uint8_t* seg, uint64_t fileoff, uint64_t filesize, const char* path);   // emu_dsmos.c
 int sys_volume_present(int k);   // emu_fs.c: 1 si el volumen k (0 Data, 1 Preboot) del macOS completo está montado
+// Espacio de los volúmenes APFS emulados (emu_fs.c). El contenedor es el sistema de archivos del anfitrión donde vive
+// TAHOE_ROOT; cada volumen es una carpeta de ese sistema (el del sistema, el de datos y el Preboot). En APFS los volúmenes
+// comparten el espacio del contenedor: la capacidad de cada uno es la del contenedor (o su cuota, si tiene una) y el
+// «usado» de cada uno es el de sus archivos. Aquí el contenedor se reparte entre los volúmenes en cuotas proporcionales a
+// lo que ocupa cada uno (así cada volumen tiene su tamaño y las cifras cuadran); el usado lo mide tools/volsize.sh.
+enum { TAHOE_VOL_SYS = 0, TAHOE_VOL_DATA, TAHOE_VOL_PRE, TAHOE_VOL_N };
+struct tahoe_vol { uint64_t quota;      // capacidad del volumen (su parte del contenedor)
+                    uint64_t used;       // bytes que ocupa
+                    uint64_t free; };    // quota - used
+struct tahoe_volspace { uint64_t size, used, free;    // el contenedor
+                         int nvol; int medido;         // medido: hay medidas de lo que ocupa cada volumen
+                         struct tahoe_vol vol[TAHOE_VOL_N]; };
+void tahoe_vol_space(struct tahoe_volspace* vs);
+// Reparte la capacidad del contenedor entre los volúmenes, en proporción a lo que ocupa cada uno (emu_fs.c).
+//   size: la capacidad del contenedor; used: lo que usa el contenedor.
+//   vused[i]: lo que ocupa el volumen i; se ajusta a la baja si la medición no cuadra con el disco (una medición vieja:
+//     el disco se limpió después de medir), para que lo que ocupan los volúmenes sea lo que usa el contenedor.
+//   quota[i]: la parte de la capacidad del contenedor que le toca a cada volumen.
+// Invariantes: la suma de las cuotas es la capacidad del contenedor; ningún volumen tiene una cuota menor que lo que
+// ocupa (su libre nunca es negativo); si no hay nada usado, cada volumen se queda con el contenedor entero (que es lo que
+// se veía antes de repartir).
+static inline void tahoe_vol_quotas(uint64_t size, uint64_t used, uint64_t* vused, uint64_t* quota) {
+	uint64_t tot = 0;
+	for (int i = 0; i < TAHOE_VOL_N; i++) tot += vused[i];
+	if (tot > used) {                                   // la medición no cuadra con el disco: se ajusta a la baja
+		uint64_t acc = 0;
+		for (int i = 0; i < TAHOE_VOL_N; i++) {
+			vused[i] = (uint64_t)((__uint128_t)vused[i] * used / tot);
+			acc += vused[i];
+		}
+		vused[TAHOE_VOL_SYS] += used - acc;            // el resto va al volumen del sistema (la suma ha de ser exacta)
+		tot = used;
+	}
+	if (!used || !tot) { for (int i = 0; i < TAHOE_VOL_N; i++) quota[i] = size; return; }
+	uint64_t sum = 0;
+	for (int i = 0; i < TAHOE_VOL_N; i++) {
+		uint64_t q = (uint64_t)((__uint128_t)size * vused[i] / used);
+		q &= ~((1ULL << 20) - 1);                       // a megas enteras
+		if (q < vused[i]) q = vused[i];                 // nunca menos de lo que ocupa (su libre no puede ser negativo)
+		quota[i] = q; sum += q;
+	}
+	if (sum < size) quota[TAHOE_VOL_SYS] += size - sum; // lo que sobra (del redondeo) va al volumen del sistema
+}
 int cs_file_platform(int fd);     // emu_cs.c: 1 si el archivo lleva firma de plataforma de Apple, 0 si no, -1 sin firma
 void sys_volumes_mount(void);       // emu_fs.c: volúmenes Data y Preboot de un macOS completo (en el PID 1)
 extern const char *g_cache_path, *g_dyld_path, *g_self_exe;   // para relanzar tahoe-run en execve   // raíz del sistema de archivos de macOS 26 (TAHOE_ROOT)
diff --git i/test/vol_quotas.c w/test/vol_quotas.c
new file mode 100644
index 0000000..a24af91
--- /dev/null
+++ w/test/vol_quotas.c
@@ -0,0 +1,77 @@
+// Prueba del reparto de la capacidad del contenedor entre los volúmenes APFS emulados (tahoe_vol_quotas, tahoe.h).
+//
+//   clang -O1 -Wall -Wextra -o /tmp/vol_quotas test/vol_quotas.c -I tahoe-run
+//   /tmp/vol_quotas
+//
+// Lo que se comprueba (los invariantes que debe cumplir el reparto, para que las cifras que ve macOS cuadren):
+//   - la suma de las cuotas de los volúmenes es la capacidad del contenedor;
+//   - ningún volumen tiene una cuota menor que lo que ocupa (su espacio libre nunca es negativo);
+//   - lo que ocupan los volúmenes es lo que usa el contenedor;
+//   - si no hay medición (o no hay nada usado), cada volumen se queda con el contenedor entero (el comportamiento de
+//     antes de repartir);
+//   - si la medición no cuadra con el disco (está vieja), lo ocupado se ajusta a la baja y las cuotas siguen cabiendo en
+//     el contenedor.
+#include <stdint.h>
+#include <stdio.h>
+
+#include "tahoe.h"
+
+#define GIB (1ULL << 30)
+
+static int fallos;
+
+static void check(int ok, const char* what) {
+	if (!ok) { fprintf(stderr, "FALLO: %s\n", what); fallos++; }
+}
+
+// Reparte y comprueba los invariantes con una medida dada.
+static void caso(const char* nombre, uint64_t size, uint64_t used, uint64_t* vused) {
+	uint64_t q[TAHOE_VOL_N] = { 0, 0, 0 };
+	uint64_t tot = 0;
+	for (int i = 0; i < TAHOE_VOL_N; i++) tot += vused[i];
+	tahoe_vol_quotas(size, used, vused, q);
+	uint64_t suma = 0;
+	for (int i = 0; i < TAHOE_VOL_N; i++) suma += q[i];
+	check(suma == size, nombre);                                 // las cuotas caben en el contenedor
+	uint64_t suma_used = 0;
+	for (int i = 0; i < TAHOE_VOL_N; i++) {
+		check(q[i] >= vused[i], nombre);                        // el libre no puede ser negativo
+		suma_used += vused[i];
+	}
+	if (tot <= used) check(suma_used == used, nombre);           // lo que ocupan los volúmenes es lo que usa el contenedor
+	printf("  %-28s capacidad %6llu GiB  cuotas: %llu / %llu / %llu GiB   ocupado: %llu / %llu / %llu GiB\n", nombre,
+	       (unsigned long long)(size / GIB), (unsigned long long)(q[0] / GIB), (unsigned long long)(q[1] / GIB),
+	       (unsigned long long)(q[2] / GIB), (unsigned long long)(vused[0] / GIB), (unsigned long long)(vused[1] / GIB),
+	       (unsigned long long)(vused[2] / GIB));
+}
+
+int main(void) {
+	printf("reparto de la capacidad del contenedor entre los volúmenes:\n");
+	// Un macOS completo en un disco de 63,1 GB: el sistema ocupa 29 GB, los datos 10 GB y el preboot 200 MB.
+	{
+		uint64_t v[TAHOE_VOL_N] = { 29ULL * GIB, 10ULL * GIB, 200ULL << 20 };
+		caso("medida normal", 63100ULL << 20, 29ULL * GIB + 10ULL * GIB + (200ULL << 20), v);
+	}
+	// Un volumen que no ocupa nada (el preboot vacío): su cuota es 0 y la del sistema se queda con el resto.
+	{
+		uint64_t v[TAHOE_VOL_N] = { 40ULL * GIB, 0, 0 };
+		caso("volúmenes vacíos", 63100ULL << 20, 40ULL * GIB, v);
+	}
+	// Medición vieja: los volúmenes ocupan más que el disco (el disco se limpió después de medir). Lo ocupado se ajusta
+	// a la baja y las cuotas siguen cabiendo en el contenedor.
+	{
+		uint64_t v[TAHOE_VOL_N] = { 50ULL * GIB, 30ULL * GIB, 1ULL * GIB };
+		caso("medida mayor que el disco", 63100ULL << 20, 20ULL * GIB, v);
+	}
+	// Sin nada usado: cada volumen se queda con el contenedor entero (como antes de repartir).
+	{
+		uint64_t v[TAHOE_VOL_N] = { 0, 0, 0 };
+		uint64_t q[TAHOE_VOL_N] = { 0, 0, 0 };
+		tahoe_vol_quotas(63100ULL << 20, 0, v, q);
+		for (int i = 0; i < TAHOE_VOL_N; i++) check(q[i] == 63100ULL << 20, "sin uso: cada volumen, el disco entero");
+		printf("  %-28s los tres volúmenes con el disco entero\n", "sin uso");
+	}
+	if (fallos) { fprintf(stderr, "%d comprobaciones fallidas\n", fallos); return 1; }
+	printf("todas las comprobaciones bien\n");
+	return 0;
+}
diff --git i/tools/volsize.sh w/tools/volsize.sh
new file mode 100755
index 0000000..43953f9
--- /dev/null
+++ w/tools/volsize.sh
@@ -0,0 +1,45 @@
+#!/bin/bash
+# volsize.sh [raíz de macOS]: mide lo que ocupa cada volumen APFS emulado y lo deja en el archivo que lee el emulador
+# (~/.config/tahoe-run/volsize; con TAHOE_VOLFILE se cambia el sitio). El emulador (tahoe_vol_space, emu_fs.c) reparte la
+# capacidad del contenedor entre los volúmenes en proporción a lo que ocupa cada uno; sin estas medidas, todo el espacio
+# usado del disco se atribuye al volumen del sistema y los volúmenes de datos y Preboot salen con 0 B (como antes).
+#
+# Medir es lento (du sobre el árbol de cada volumen: del orden de minutos con un disco mecánico), así que se hace una vez,
+# con el macOS parado. Para volver a medir: volsize.sh otra vez (los números se quedan oldeados conforme crece el disco).
+#
+#   raíz de macOS:  por omisión $TAHOE_ROOT, o ~/macos26/completo/macOS.
+set -euo pipefail
+RAIZ="${1:-${TAHOE_ROOT:-$HOME/macos26/completo/macOS}}"
+SALIDA="${TAHOE_VOLFILE:-$HOME/.config/tahoe-run/volsize}"
+[ -d "$RAIZ" ] || { echo "no existe el directorio $RAIZ"; exit 1; }
+V="$RAIZ/System/Volumes"
+[ -d "$V" ] || { echo "$RAIZ no tiene System/Volumes: no es un macOS completo (no hay volúmenes que medir)"; exit 1; }
+# Bytes ocupados por un árbol (los bloques que tiene asignados, como los que cuenta el disco: du sin --apparent-size).
+# Los enlaces duros se cuentan una vez (du los recuerda) y los montajes de dentro no se siguen (du no cruza de sistema de
+# archivos), que es lo que quiere: el volumen de datos es la carpeta que monta sobre sí misma.
+du_bytes() { du -s --block-size=1 "$1" 2>/dev/null | cut -f1; }
+data=0; preboot=0
+for d in "$V"/*; do
+	[ -d "$d" ] || continue
+	case "$(basename "$d")" in
+		Data)    data=$(du_bytes "$d");;
+		Preboot) preboot=$(du_bytes "$d");;
+	esac
+done
+[ "$data" -gt 0 ] || { echo "no se ha podido medir $V/Data"; exit 1; }
+[ "$preboot" -gt 0 ] || { echo "no se ha podido medir $V/Preboot"; exit 1; }
+mkdir -p "$(dirname "$SALIDA")"
+tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
+{
+	echo "# Tamaño de los volúmenes APFS emulados (bytes), medido el $(date -Is)."
+	echo "# Lo lee tahoe_vol_space (emu_fs.c). El volumen del sistema ocupa lo que queda del disco."
+	echo "data $data"
+	echo "preboot $preboot"
+} > "$tmp"
+mv "$tmp" "$SALIDA"
+trap - EXIT
+echo "escrito $SALIDA"
+awk -v d="$data" -v p="$preboot" 'BEGIN {
+	printf "  datos   %13d bytes (%.2f GB)\n", d, d/1e9
+	printf "  preboot %13d bytes (%.2f GB)\n", p, p/1e9
+}'
