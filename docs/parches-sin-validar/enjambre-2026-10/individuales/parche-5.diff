+
+// ---- Espacio de los volúmenes APFS emulados
+// El contenedor APFS que ve macOS es el sistema de archivos del anfitrión donde vive TAHOE_ROOT (un disco virtual ext4 con
+// el macOS instalado). Los volúmenes del contenedor son carpetas de ese mismo sistema de archivos: el del sistema
+// (TAHOE_ROOT), el de datos (TAHOE_ROOT/System/Volumes/Data) y el Preboot (TAHOE_ROOT/System/Volumes/Preboot), que en un
+// macOS completo son volúmenes APFS aparte. En APFS los volúmenes comparten el espacio del contenedor: la capacidad de
+// cada uno es la del contenedor (salvo que tenga cuota) y el «usado» de cada uno es el de sus archivos.
+// Aquí el contenedor se reparte entre los volúmenes en cuotas proporcionales a lo que ocupa cada uno: así cada volumen
+// tiene su propio tamaño (y no el del contenedor, que es lo que se veía) y las cifras cuadran: lo que usan todos los
+// volúmenes es lo que usa el contenedor. El usado de cada volumen lo mide tools/volsize.sh (du sobre su árbol: tarda
+// minutos) y lo deja en un archivo; sin ese archivo, todo el usado del disco se atribuye al volumen del sistema (como
+// antes) y los volúmenes de datos y Preboot salen con 0 B.
+#define VOLFILE_SUFFIX "/.config/tahoe-run/volsize"
+static const char* volfile_path(void) {
+	const char* p = getenv("TAHOE_VOLFILE");
+	if (p && *p) return p;
+	static char path[1024]; static int known;
+	if (!known) {
+		known = 1;
+		const char* h = getenv("HOME");
+		snprintf(path, sizeof path, "%s%s", h && *h ? h : "/root", VOLFILE_SUFFIX);
+	}
+	return path;
+}
+// «data <bytes>» y «preboot <bytes>»: lo que ocupa cada volumen (lo escribe tools/volsize.sh). Los demás volúmenes de
+// System/Volumes (BaseSystem, Recovery, Update...) no se emulan: su espacio está dentro del árbol del sistema y va con él.
+static int vol_used_file(uint64_t* data, uint64_t* pre, uint64_t* other) {
+	FILE* f = fopen(volfile_path(), "r");
+	if (!f) return 0;
+	char line[256]; int got = 0;
+	while (fgets(line, sizeof line, f)) {
+		char key[32]; unsigned long long v;
+		if (sscanf(line, "%31s %llu", key, &v) != 2) continue;
+		if (!strcmp(key, "data")) { *data = v; got |= 1; }
+		else if (!strcmp(key, "preboot")) { *pre = v; got |= 2; }
+		else if (!strcmp(key, "other")) { *other = v; got |= 4; }
+	}
+	fclose(f);
+	return (got & 3) == 3;
+}
+void tahoe_vol_space(struct tahoe_volspace* vs) {
+	static struct tahoe_volspace cache; static int done; static int cached_full;
+	memset(vs, 0, sizeof *vs);
+	struct statfs sf;
+	uint64_t size = 0, used = 0;
+	if (tahoe_root && statfs(tahoe_root, &sf) == 0) {
+		uint64_t bs = sf.f_bsize ? (uint64_t)sf.f_bsize : 4096;
+		size = (uint64_t)sf.f_blocks * bs;
+		used = (uint64_t)(sf.f_blocks - sf.f_bfree) * bs;
+	}
+	if (!size) size = 64ULL << 30;
+	size &= ~4095ULL;
+	// Los volúmenes de datos y Preboot solo existen en un macOS completo (en la Recovery, /System/Volumes/Data es un tmpfs).
+	int full = sys_volume_present(0) && sys_volume_present(1);
+	if (done && cached_full == full) { *vs = cache; return; }   // ya está calculado (y los volúmenes no han cambiado)
+	uint64_t ud = 0, up = 0, uo = 0;
+	int medido = full && vol_used_file(&ud, &up, &uo);
+	// Si la medida no cabe en el disco (está vieja: el disco se limpió después de medir) no se usa: se queda lo de antes,
+	// con todo el disco en el volumen del sistema. Si cabe, el sistema se queda con lo que sobra.
+	if (medido && ud + up > used) medido = 0;
+	if (!medido) { ud = 0; up = 0; }
+	// El volumen del sistema es el árbol de la raíz de macOS: lo que queda del disco después de los volúmenes de datos y
+	// de preboot (que son carpetas dentro de él). Los demás volúmenes de System/Volumes (BaseSystem, Recovery, Update...)
+	// también están dentro del árbol del sistema, así que su espacio va con él («other»).
+	(void)uo;
+	uint64_t us = used > ud + up ? used - ud - up : 0;
+	vs->size = size; vs->used = used; vs->free = size > used ? size - used : 0;
+	vs->nvol = full ? 3 : 1;
+	vs->medido = medido;
+	const char* nq = getenv("TAHOE_VOL_QUOTA");
+	int quota = !(nq && !strcmp(nq, "0"));
+	uint64_t q[TAHOE_VOL_N] = { 0, 0, 0 };
+	// Sin medidas no hay cuotas: cada volumen se queda con la capacidad del contenedor (como en un Mac donde no se pone
+	// ninguna, y como se veía antes de repartirlas).
+	if (!quota || !medido) for (int i = 0; i < TAHOE_VOL_N; i++) q[i] = size;
+	else {
+		// El reparto puede ajustar la medida (si no cuadra con el disco): las cifras que se enseñan son las ajustadas.
+		uint64_t vused[TAHOE_VOL_N] = { us, ud, up };
+		tahoe_vol_quotas(size, used, vused, q);
+		us = vused[TAHOE_VOL_SYS]; ud = vused[TAHOE_VOL_DATA]; up = vused[TAHOE_VOL_PRE];
+	}
+	vs->vol[TAHOE_VOL_SYS].used = us;
+	vs->vol[TAHOE_VOL_DATA].used = ud;
+	vs->vol[TAHOE_VOL_PRE].used = up;
+	for (int i = 0; i < TAHOE_VOL_N; i++) {
+		vs->vol[i].quota = q[i];
+		vs->vol[i].free = q[i] > vs->vol[i].used ? q[i] - vs->vol[i].used : 0;
+	}
+	cache = *vs; done = 1; cached_full = full;
+}
