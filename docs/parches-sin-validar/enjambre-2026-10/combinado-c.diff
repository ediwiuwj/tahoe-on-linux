+// ---------------------------------------------------------------- mach_vm_region (id 4816)
+// Sabores de vm_region (osfmk/mach/vm_region.h) y tamaño de sus estructuras (en natural_t, como las cuenta XNU).
+#define VR_BASIC_INFO_64        9        // VM_REGION_BASIC_INFO_64
+#define VR_BASIC_INFO          10        // VM_REGION_BASIC_INFO (el viejo de 32 bits: XNU lo convierte al de 64)
+#define VR_EXTENDED_INFO       13        // VM_REGION_EXTENDED_INFO
+#define VR_BASIC_COUNT_64      10        // VM_REGION_BASIC_INFO_COUNT_64  (40 bytes / 4: la estructura tiene 8 bytes de «offset» y 4 de relleno)
+#define VR_EXTENDED_COUNT       9        // VM_REGION_EXTENDED_INFO_COUNT  (36 bytes / 4)
+
+// Una región del mapa de la tarea. Las de Linux: el invitado comparte el espacio de direcciones con el emulador, así que
+// /proc/<pid>/maps es el mapa de la tarea (lo que en XNU es su vm_map).
+struct vregion { uint64_t start, end, off; int prot, shared; };
+
+// Región que contiene la dirección; si no hay ninguna, la siguiente por encima (como XNU: «si la dirección indicada no
+// está asignada, se describe el siguiente intervalo de direcciones más alto», osfmk/mach/mach_vm.defs). Devuelve 0 si no
+// hay ninguna por encima (entonces XNU responde KERN_NO_SPACE).
+static int vm_region_of(int32_t pid, uint64_t addr, struct vregion* out) {
+	char path[64];
+	snprintf(path, sizeof path, "/proc/%d/maps", (int)pid);
+	FILE* f = fopen(path, "r");
+	if (!f) return 0;
+	char ln[512];
+	int found = 0;
+	uint64_t ns = 0, ne = 0, no = 0; int np = 0, nsh = 0, hay = 0;
+	while (fgets(ln, sizeof ln, f)) {
+		unsigned long lo, hi; char pr[8]; unsigned long long o;
+		if (sscanf(ln, "%lx-%lx %7s %llx", &lo, &hi, pr, &o) < 4) continue;
+		uint64_t s = (uint64_t)lo, e = (uint64_t)hi;
+		int p = (pr[0] == 'r' ? 1 : 0) | (pr[1] == 'w' ? 2 : 0) | (pr[2] == 'x' ? 4 : 0);
+		int sh = pr[3] == 's';                            // 's' = mapa compartido, 'p' = privado (como el «shared» de XNU)
+		if (s <= addr && addr < e) {                       // la región que contiene la dirección
+			out->start = s; out->end = e; out->off = (uint64_t)o; out->prot = p; out->shared = sh;
+			found = 1;
+			break;
+		}
+		if (s > addr) {                                    // la siguiente por encima (el mapa va ordenado)
+			ns = s; ne = e; no = (uint64_t)o; np = p; nsh = sh; hay = 1;
+			break;
+		}
+	}
+	fclose(f);
+	if (!found && hay) { out->start = ns; out->end = ne; out->off = no; out->prot = np; out->shared = nsh; found = 1; }
+	return found;
+}
+
+// mach_vm_region (id 4816): información de una región del espacio de direcciones de una tarea.
+// La petición es simple (sin descriptores): cabecera (24) + NDR (8) + argumentos, y los argumentos van en el orden de
+// mach_vm.defs: address (inout, 8), size (out, 8), flavor (4), count (4, el CountInOut de `info`). La tarea es el puerto
+// remoto del mensaje: las rutinas del subsistema mach_vm son «_external» en XNU (el sufijo lo añade KERNEL_SERVER,
+// osfmk/mach/mach_vm.defs:90), o sea que el objetivo es el puerto de destino y no un argumento del cuerpo.
+// O sea: cabecera (24) + NDR (24..31) + address (32..39) + flavor (40..43) + count (44..47) = 48 bytes. Lo comprobó el
+// cliente de macOS 26 (libsystem_kernel, `_mach_vm_region` de la caché de dyld): escribe el NDR en +24, la dirección en
+// +32, el sabor en +40 y min(cuenta,10) en +44, y el mensaje mide 48 bytes.
+// La respuesta es compleja: `object_name` es un puerto de salida -> cabecera (24) + nº de descriptores (4) + descriptor de
+// puerto (12) + NDR (8) + address (8) + size (8) + count (4) + info[count]. El mismo cliente comprueba ese reparto: la
+// respuesta debe medir 68 + 4*count bytes, el descriptor de puerto va en +28 (con la disposición en +38) y el contador en
+// +64; sin el bit «complejo» (0x80000000) en msgh_bits, el cliente toma la respuesta por un error.
+static size_t mig_mach_vm_region(const struct hdr* req, const uint8_t* m, uint8_t* r) {
+	uint64_t addr = 0;
+	int32_t flavor = 0, count = 0;
+	if (req->size < 48) return reply_begin(r, req, KERN_INVALID_ARG);   // petición corta: faltan los argumentos
+	memcpy(&addr, m + 32, 8);                          // address (in/out)
+	memcpy(&flavor, m + 40, 4);                        // flavor
+	memcpy(&count, m + 44, 4);                         // count (CountInOut de info)
+	if (flavor == VR_BASIC_INFO) flavor = VR_BASIC_INFO_64;   // como XNU (osfmk/vm/vm_user.c:1452)
+	uint32_t need = 0;
+	if (flavor == VR_BASIC_INFO_64) need = VR_BASIC_COUNT_64;
+	else if (flavor == VR_EXTENDED_INFO) need = VR_EXTENDED_COUNT;
+	else return reply_begin(r, req, KERN_INVALID_ARG);        // sabor desconocido: como XNU (vm_map.c: «default»)
+	// XNU solo comprueba que la cuenta quepa (osfmk/vm/vm_map.c: «if (*count < VM_REGION_BASIC_INFO_COUNT_64)»): si no,
+	// KERN_INVALID_ARGUMENT. Si sobra, devuelve la cuenta que necesita y el cliente se queda con lo que pidió.
+	if (count < (int32_t)need) return reply_begin(r, req, KERN_INVALID_ARG);
+	int32_t pid = (int32_t)getpid();
+	int kt;
+	if (req->remote != 0x103 && !(kobj_lookup(req->remote, &kt, &pid) && (kt == KO_TASK || kt == KO_TASK_NAME)))
+		pid = (int32_t)getpid();
+	struct vregion vm;
+	if (!vm_region_of(pid, addr, &vm)) return reply_begin(r, req, KERN_NO_SPACE_);   // no hay nada por encima
+	uint32_t info[VR_BASIC_COUNT_64] = { 0 };
+	if (flavor == VR_BASIC_INFO_64) {
+		// struct vm_region_basic_info_64 (osfmk/mach/vm_region.h:88), con su reparto real: protection (0),
+		// max_protection (4), inheritance (8), shared (12), reserved (16), 4 bytes de relleno (20), offset (24, 8 bytes),
+		// behavior (32), user_wired_count (36) y 2 de relleno (38). XNU escribe la estructura tal cual en el búfer del
+		// cliente (vm_map.c: «basic = (vm_region_basic_info_64_t) info»), así que el relleno también cuenta.
+		info[0] = (uint32_t)vm.prot;              // protección actual (los bits de Linux son los de vm_prot_t)
+		info[1] = (uint32_t)vm.prot;              // protección máxima: en Linux no hay más que la actual
+		info[2] = 1;                              // VM_INHERIT_COPY (Linux no tiene atributo de herencia)
+		info[3] = (uint32_t)vm.shared;            // shared: el mapa es compartido (MAP_SHARED) si el Kernel lo dice
+		info[4] = 0;                              // reserved (is_sub_map)
+		memcpy(info + 6, &vm.off, 8);             // offset dentro del objeto (el desplazamiento del archivo)
+		info[8] = 0;                              // VM_BEHAVIOR_DEFAULT
+		info[9] = 0;                              // user_wired_count
+	} else {
+		// struct vm_region_extended_info (osfmk/mach/vm_region.h:186): protección, etiqueta y páginas.
+		info[0] = (uint32_t)vm.prot;              // protection
+		info[1] = 0;                              // user_tag
+		info[2] = 0;                              // pages_resident (XNU también lo deja a cero sin objeto de memoria)
+		info[3] = 0;                              // pages_shared_now_private
+		info[4] = 0;                              // pages_swapped_out
+		info[5] = 0;                              // pages_dirtied
+		info[6] = 0;                              // ref_count
+		info[7] = 0;                              // shadow_depth, external_pager y share_mode
+		info[8] = 0;                              // pages_reusable
+	}
+	if (mach_trace()) logf_("    MT pid=%d vm_region 0x%lx sabor %d cuenta %d -> 0x%lx+0x%lx prot=%d\n",
+		(int)getpid(), (unsigned long)addr, flavor, count, (unsigned long)vm.start, (unsigned long)(vm.end - vm.start), vm.prot);
+	// Respuesta compleja: el puerto de salida `object_name` va en un descriptor (aquí nulo: no hay objetos de memoria).
+	struct hdr nh = { .bits = 0x80000000u, .size = 0, .remote = 0, .local = 0, .voucher = 0, .id = req->id + 100 };
+	memcpy(r, &nh, sizeof nh);
+	uint32_t one = 1; memcpy(r + 24, &one, 4);
+	uint8_t desc[12] = { 0 };
+	desc[10] = 17;                                  // MACH_MSG_TYPE_COPY_SEND: el derecho de envío que se devuelve
+	desc[11] = 0;                                   // MACH_MSG_PORT_DESCRIPTOR
+	memcpy(r + 28, desc, 12);
