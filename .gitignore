# Binarios de Apple: no redistribuir
base/
*.dmg
*.chunklist
*.metallib
build*/
target/

# Python
__pycache__/
*.pyc

# Rust: target/ y los directorios de compilación alternativos (target-b/)
target/
target-*/

# tahoe-run
tahoe-run/tahoe-run
tahoe-run/sysnames.h
tahoe-run/bf_pi.h

# Binarios y volcados locales de tahoe-run (comparaciones A/B y copias de trabajo)
tahoe-run/tahoe-run.*
tahoe-run/*.orig
tahoe-run/*.rej

# Volcados de diagnóstico locales
tahoe-run/ss.out

# Parches fallidos de la iteración local
*.orig
*.rej

# Binario compilado de tools/pty_run.c (se compila con: cc -o tools/pty_run tools/pty_run.c -lutil)
tools/pty_run
